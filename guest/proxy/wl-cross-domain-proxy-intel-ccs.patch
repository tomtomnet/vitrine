+/// An Intel compressed (CCS) modifier (vendor 0x01: Y/Yf CCS, Gen12 RC/MC CCS, and the 4-tiled DG2, MTL, LNL and
+/// BMG CCS ones). Battlemage's display takes them only from a buffer with 64 KiB physical alignment
+/// (xe_display_bo.c: intel_fb_needs_64k_phys), which the guest's buffers - made by the host's Xe native context -
+/// lack: the nested KWin's output buffer never reached the plane on an Arc Pro B50 (2026-10-22), as AMD DCC did.
+fn is_intel_ccs(modifier: u64) -> bool {
+    modifier >> 56 == 0x01 && matches!(modifier & 0x00ff_ffff_ffff_ffff, 4..=8 | 10..=17)
+}
+
 /// --drop-dcc-modifiers: whether a modifier is left out of the tranches the proxy forwards - every AMD DCC
-/// one, or with --keep-displayable-dcc only the render-only ones.
+/// one (or with --keep-displayable-dcc only the render-only ones) and every Intel CCS one.
 fn dcc_left_out(modifier: u64) -> bool {
-    is_amd_dcc(modifier)
-        && !(super::KEEP_DISPLAYABLE_DCC.load(std::sync::atomic::Ordering::Relaxed) && is_amd_displayable_dcc(modifier))
+    (is_amd_dcc(modifier)
+        && !(super::KEEP_DISPLAYABLE_DCC.load(std::sync::atomic::Ordering::Relaxed) && is_amd_displayable_dcc(modifier)))
+        || is_intel_ccs(modifier)
 }
 
