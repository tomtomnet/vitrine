--- a/src/clock.rs
+++ b/src/clock.rs
@@ -0,0 +1,450 @@
+//! Translation of host presentation timestamps into the guest's clock domain.
+//!
+//! `wp_presentation_feedback.presented` carries the time at which the host
+//! compositor showed a frame, in the host's presentation clock (usually
+//! CLOCK_MONOTONIC). Across a VM boundary that clock is not the guest's: the
+//! host's CLOCK_MONOTONIC is ahead of the guest's by roughly the host uptime at
+//! VM start. Compositors and clients that schedule frames from these
+//! timestamps (nested KWin plans `last_presentation + N * vblank` against its
+//! own clock) then wait for hours and freeze.
+//!
+//! The proxy estimates `offset = host clock - guest clock` from the timestamps
+//! themselves. A presented event always reaches the guest after the
+//! presentation happened, so each sample `host_presented - guest_arrival` is a
+//! lower bound of the true offset, off by the delivery latency. The estimate is
+//! the maximum of recent samples: it moves up at once when a sample is higher,
+//! and moves down at `decay_ppm` of elapsed time so it can follow slow drift.
+//! Translated timestamps are therefore never later than the guest's arrival
+//! time, and are late by the smallest recent delivery latency at most.
+//! A run of samples far below the estimate means the clocks stepped apart
+//! (for example after a VM pause), and resynchronizes the estimate.
+
+use std::{cell::RefCell, rc::Rc};
+
+use log::{debug, info, warn};
+use wayland_server::backend::protocol::{Argument, Message};
+
+pub type SharedClock = Rc<RefCell<ClockTranslator>>;
+
+const NSEC_PER_SEC: i64 = 1_000_000_000;
+/// Samples this far below the estimate count towards a resynchronization.
+const STEP_NS: i64 = 50_000_000;
+/// Number of consecutive low samples that trigger a resynchronization.
+const STEP_STREAK: u32 = 4;
+
+#[derive(Debug, Clone)]
+pub struct ClockConfig {
+    /// Apply the estimated offset to host timestamps.
+    pub translate: bool,
+    /// Debug: added to every host timestamp before anything else, in ns.
+    /// Simulates a host clock that runs ahead (positive) or behind (negative).
+    pub inject_ns: i64,
+    /// Downward drift the estimate can follow, in parts per million.
+    pub decay_ppm: i64,
+    /// Seconds between statistics lines at info level, 0 disables them.
+    pub log_interval_s: i64,
+}
+
+impl Default for ClockConfig {
+    fn default() -> Self {
+        ClockConfig {
+            translate: true,
+            inject_ns: 0,
+            decay_ppm: 1000,
+            log_interval_s: 10,
+        }
+    }
+}
+
+/// Max-filter offset estimator with slow downward decay. Pure, for testing.
+#[derive(Debug, Clone)]
+pub struct OffsetEstimator {
+    decay_ppm: i64,
+    estimate: Option<i64>,
+    last_now: i64,
+    low_streak: u32,
+    pub resyncs: u64,
+}
+
+impl OffsetEstimator {
+    pub fn new(decay_ppm: i64) -> Self {
+        OffsetEstimator {
+            decay_ppm: decay_ppm.max(0),
+            estimate: None,
+            last_now: 0,
+            low_streak: 0,
+            resyncs: 0,
+        }
+    }
+
+    pub fn estimate(&self) -> Option<i64> {
+        self.estimate
+    }
+
+    pub fn reset(&mut self) {
+        self.estimate = None;
+        self.low_streak = 0;
+    }
+
+    /// Feeds one sample (`host_timestamp - guest_now`) taken at guest time
+    /// `now`, returns the new estimate.
+    pub fn update(&mut self, sample: i64, now: i64) -> i64 {
+        let est = match self.estimate {
+            None => sample,
+            Some(prev) => {
+                let elapsed = (now - self.last_now).max(0) as i128;
+                let decay = (elapsed * self.decay_ppm as i128 / 1_000_000) as i64;
+                let decayed = prev.saturating_sub(decay);
+                if sample < prev.saturating_sub(STEP_NS) {
+                    self.low_streak += 1;
+                } else {
+                    self.low_streak = 0;
+                }
+                if self.low_streak >= STEP_STREAK {
+                    self.low_streak = 0;
+                    self.resyncs += 1;
+                    warn!(
+                        "clock: host and guest clocks stepped apart by {:.3} ms, resynchronizing",
+                        (prev - sample) as f64 / 1e6
+                    );
+                    sample
+                } else {
+                    decayed.max(sample)
+                }
+            }
+        };
+        self.estimate = Some(est);
+        self.last_now = now;
+        est
+    }
+}
+
+pub struct ClockTranslator {
+    cfg: ClockConfig,
+    clock_id: libc::clockid_t,
+    estimator: OffsetEstimator,
+    warned_no_estimate: bool,
+    // statistics since the last log line
+    stat_since: Option<i64>,
+    stat_n: u64,
+    stat_lag_min: i64,
+    stat_lag_max: i64,
+    stat_lag_sum: i128,
+    total: u64,
+}
+
+pub fn clock_name(id: libc::clockid_t) -> &'static str {
+    match id {
+        libc::CLOCK_REALTIME => "CLOCK_REALTIME",
+        libc::CLOCK_MONOTONIC => "CLOCK_MONOTONIC",
+        libc::CLOCK_MONOTONIC_RAW => "CLOCK_MONOTONIC_RAW",
+        libc::CLOCK_BOOTTIME => "CLOCK_BOOTTIME",
+        libc::CLOCK_TAI => "CLOCK_TAI",
+        _ => "unknown clock",
+    }
+}
+
+fn now_ns(clock: libc::clockid_t) -> i64 {
+    let mut ts = libc::timespec {
+        tv_sec: 0,
+        tv_nsec: 0,
+    };
+    // SAFETY: valid pointer to a timespec
+    if unsafe { libc::clock_gettime(clock, &mut ts) } != 0 {
+        // An unknown clock id from the host: fall back to CLOCK_MONOTONIC.
+        unsafe { libc::clock_gettime(libc::CLOCK_MONOTONIC, &mut ts) };
+    }
+    ts.tv_sec as i64 * NSEC_PER_SEC + ts.tv_nsec as i64
+}
+
+fn split_timestamp(ns: i64) -> (u32, u32, u32) {
+    let ns = ns.max(0);
+    let sec = (ns / NSEC_PER_SEC) as u64;
+    let nsec = (ns % NSEC_PER_SEC) as u32;
+    ((sec >> 32) as u32, sec as u32, nsec)
+}
+
+fn join_timestamp(hi: u32, lo: u32, nsec: u32) -> i64 {
+    let sec = ((hi as u64) << 32) | lo as u64;
+    (sec as i128 * NSEC_PER_SEC as i128 + nsec as i128).min(i64::MAX as i128) as i64
+}
+
+impl ClockTranslator {
+    pub fn new(cfg: ClockConfig) -> Self {
+        info!(
+            "clock: presentation timestamp translation {}{}",
+            if cfg.translate { "on" } else { "OFF" },
+            if cfg.inject_ns != 0 {
+                format!(
+                    ", debug offset {:+.3} s injected into host timestamps",
+                    cfg.inject_ns as f64 / 1e9
+                )
+            } else {
+                String::new()
+            }
+        );
+        ClockTranslator {
+            estimator: OffsetEstimator::new(cfg.decay_ppm),
+            cfg,
+            clock_id: libc::CLOCK_MONOTONIC,
+            warned_no_estimate: false,
+            stat_since: None,
+            stat_n: 0,
+            stat_lag_min: i64::MAX,
+            stat_lag_max: i64::MIN,
+            stat_lag_sum: 0,
+            total: 0,
+        }
+    }
+
+    pub fn shared(cfg: ClockConfig) -> SharedClock {
+        Rc::new(RefCell::new(Self::new(cfg)))
+    }
+
+    fn set_clock_id(&mut self, id: u32) {
+        let id = id as libc::clockid_t;
+        if id != self.clock_id {
+            info!(
+                "clock: host presentation clock is {} ({}), estimate reset",
+                clock_name(id),
+                id
+            );
+            self.clock_id = id;
+            self.estimator.reset();
+        } else {
+            debug!("clock: host presentation clock is {} ({})", clock_name(id), id);
+        }
+    }
+
+    /// Now, in the presentation clock (the guest's; ns).
+    pub fn now(&self) -> i64 {
+        now_ns(self.clock_id)
+    }
+
+    /// Host timestamp (ns) of a presented frame -> guest timestamp (ns).
+    pub fn host_to_guest(&mut self, host_ns: i64) -> i64 {
+        let host_ns = host_ns.saturating_add(self.cfg.inject_ns);
+        let now = now_ns(self.clock_id);
+        let sample = host_ns - now;
+        let first = self.estimator.estimate().is_none();
+        let est = self.estimator.update(sample, now);
+        if first {
+            info!(
+                "clock: first presentation sample, host - guest offset {:+.6} s{}",
+                est as f64 / 1e9,
+                if self.cfg.translate { "" } else { " (NOT applied)" }
+            );
+        }
+        self.record(est - sample, now, est);
+        if self.cfg.translate {
+            host_ns - est
+        } else {
+            host_ns
+        }
+    }
+
+    /// Host timestamp (ns) of something long past when its event arrives -> guest timestamp (ns),
+    /// with the current estimate and without taking it as a sample (content_update_ready: when
+    /// the host had the frame, a refresh or more before the event).
+    pub fn host_to_guest_past(&self, host_ns: i64) -> i64 {
+        let host_ns = host_ns.saturating_add(self.cfg.inject_ns);
+        match (self.cfg.translate, self.estimator.estimate()) {
+            (true, Some(est)) => host_ns - est,
+            _ => host_ns,
+        }
+    }
+
+    /// Guest timestamp (ns) chosen by a client -> host timestamp (ns).
+    pub fn guest_to_host(&mut self, guest_ns: i64) -> i64 {
+        let est = if self.cfg.translate {
+            match self.estimator.estimate() {
+                Some(est) => est,
+                None => {
+                    if !self.warned_no_estimate {
+                        warn!("clock: guest timestamp before any presentation sample, passed unchanged");
+                        self.warned_no_estimate = true;
+                    }
+                    0
+                }
+            }
+        } else {
+            0
+        };
+        guest_ns.saturating_add(est).saturating_sub(self.cfg.inject_ns)
+    }
+
+    fn record(&mut self, lag: i64, now: i64, est: i64) {
+        self.total += 1;
+        if self.cfg.log_interval_s <= 0 {
+            return;
+        }
+        let since = *self.stat_since.get_or_insert(now);
+        self.stat_n += 1;
+        self.stat_lag_min = self.stat_lag_min.min(lag);
+        self.stat_lag_max = self.stat_lag_max.max(lag);
+        self.stat_lag_sum += lag as i128;
+        if now - since >= self.cfg.log_interval_s * NSEC_PER_SEC {
+            info!(
+                "clock: offset {:+.6} s ({}), {} samples in {:.1} s, arrival lag over best min/mean/max {:.3}/{:.3}/{:.3} ms, resyncs {}",
+                est as f64 / 1e9,
+                if self.cfg.translate { "applied" } else { "NOT applied" },
+                self.stat_n,
+                (now - since) as f64 / 1e9,
+                self.stat_lag_min as f64 / 1e6,
+                (self.stat_lag_sum / self.stat_n as i128) as f64 / 1e6,
+                self.stat_lag_max as f64 / 1e6,
+                self.estimator.resyncs
+            );
+            self.stat_since = Some(now);
+            self.stat_n = 0;
+            self.stat_lag_min = i64::MAX;
+            self.stat_lag_max = i64::MIN;
+            self.stat_lag_sum = 0;
+        }
+    }
+
+    /// Rewrites host -> guest events that carry presentation-clock timestamps.
+    pub fn filter_event<Fd>(&mut self, interface: &str, event: &str, msg: &mut Message<u32, Fd>) {
+        match (interface, event) {
+            ("wp_presentation", "clock_id") => {
+                if let [Argument::Uint(id)] = msg.args.as_slice() {
+                    self.set_clock_id(*id);
+                }
+            }
+            ("wp_presentation_feedback", "content_update_ready") => {
+                // content_update_ready(tv_sec_hi, tv_sec_lo, tv_nsec), version 4 (ours)
+                if let [Argument::Uint(hi), Argument::Uint(lo), Argument::Uint(nsec)] = msg.args.as_slice() {
+                    let guest = self.host_to_guest_past(join_timestamp(*hi, *lo, *nsec));
+                    let (hi, lo, nsec) = split_timestamp(guest);
+                    msg.args[0] = Argument::Uint(hi);
+                    msg.args[1] = Argument::Uint(lo);
+                    msg.args[2] = Argument::Uint(nsec);
+                }
+            }
+            ("wp_presentation_feedback", "presented") => {
+                // presented(tv_sec_hi, tv_sec_lo, tv_nsec, refresh, seq_hi, seq_lo, flags)
+                if let [
+                    Argument::Uint(hi),
+                    Argument::Uint(lo),
+                    Argument::Uint(nsec),
+                    ..,
+                ] = msg.args.as_slice()
+                {
+                    let host = join_timestamp(*hi, *lo, *nsec);
+                    let guest = self.host_to_guest(host);
+                    let (hi, lo, nsec) = split_timestamp(guest);
+                    msg.args[0] = Argument::Uint(hi);
+                    msg.args[1] = Argument::Uint(lo);
+                    msg.args[2] = Argument::Uint(nsec);
+                }
+            }
+            _ => {}
+        }
+    }
+
+    /// Rewrites guest -> host requests that carry presentation-clock timestamps.
+    pub fn filter_request<Fd>(&mut self, interface: &str, request: &str, msg: &mut Message<u32, Fd>) {
+        if let ("wp_commit_timer_v1", "set_timestamp") = (interface, request) {
+            if let [Argument::Uint(hi), Argument::Uint(lo), Argument::Uint(nsec)] =
+                msg.args.as_slice()
+            {
+                let guest = join_timestamp(*hi, *lo, *nsec);
+                let (hi, lo, nsec) = split_timestamp(self.guest_to_host(guest));
+                msg.args[0] = Argument::Uint(hi);
+                msg.args[1] = Argument::Uint(lo);
+                msg.args[2] = Argument::Uint(nsec);
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Deterministic pseudo-random delivery latency in [0.05, 3.05) ms.
+    fn lag(i: u64) -> i64 {
+        let x = i.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+        50_000 + ((x >> 33) % 3_000_000) as i64
+    }
+
+    #[test]
+    fn converges_to_offset_and_never_in_future() {
+        let offset: i64 = 5 * 3600 * NSEC_PER_SEC; // host 5 h ahead
+        let vblank = 4_166_667; // 240 Hz
+        let mut est = OffsetEstimator::new(1000);
+        let (mut worst, mut sum, mut n) = (0, 0i64, 0i64);
+        for i in 0..2400u64 {
+            let guest_present = 1_000 * NSEC_PER_SEC + i as i64 * vblank;
+            let host_present = guest_present + offset;
+            let arrival = guest_present + lag(i);
+            let e = est.update(host_present - arrival, arrival);
+            let translated = host_present - e;
+            assert!(translated <= arrival, "translated timestamp is in the future");
+            assert!(translated >= guest_present, "estimate above the true offset");
+            if i > 240 {
+                let err = translated - guest_present;
+                worst = worst.max(err);
+                sum += err;
+                n += 1;
+            }
+        }
+        // The error is the best recent latency plus the decay since it was
+        // seen: far below the 3 ms worst-case latency of the samples.
+        assert!(worst < 1_000_000, "worst error {worst} ns");
+        assert!(sum / n < 350_000, "mean error {} ns", sum / n);
+    }
+
+    #[test]
+    fn follows_slow_drift_both_ways() {
+        let vblank = 16_666_667; // 60 Hz
+        for drift_ppm in [-300i64, 300] {
+            let mut est = OffsetEstimator::new(1000);
+            let (mut worst, mut sum, mut n) = (0, 0i64, 0i64);
+            for i in 0..36_000u64 {
+                // ten minutes
+                let guest_present = i as i64 * vblank;
+                let offset = 3600 * NSEC_PER_SEC + guest_present * drift_ppm / 1_000_000;
+                let arrival = guest_present + lag(i);
+                let e = est.update(guest_present + offset - arrival, arrival);
+                // error of the translated timestamp: >= 0 means late
+                let err = offset - e;
+                assert!(err >= -1_000, "drift {drift_ppm} ppm: estimate above offset: {err}");
+                if i > 600 {
+                    worst = worst.max(err);
+                    sum += err;
+                    n += 1;
+                }
+            }
+            assert!(worst < 3_100_000, "drift {drift_ppm} ppm: worst error {worst} ns");
+            assert!(sum / n < 600_000, "drift {drift_ppm} ppm: mean error {} ns", sum / n);
+        }
+    }
+
+    #[test]
+    fn resyncs_after_step() {
+        let mut est = OffsetEstimator::new(1000);
+        let vblank = 4_166_667;
+        let mut t = 0;
+        for i in 0..100u64 {
+            t = i as i64 * vblank;
+            est.update(10 * NSEC_PER_SEC - lag(i), t + lag(i));
+        }
+        // guest clock jumps 2 s ahead (offset drops by 2 s)
+        for i in 100..110u64 {
+            t += vblank;
+            est.update(8 * NSEC_PER_SEC - lag(i), t + lag(i));
+        }
+        let e = est.estimate().unwrap();
+        assert!((e - 8 * NSEC_PER_SEC).abs() < 5_000_000, "estimate {e}");
+        assert_eq!(est.resyncs, 1);
+    }
+
+    #[test]
+    fn timestamp_split_roundtrip() {
+        for ns in [0i64, 1, 999_999_999, 1_000_000_000, 5 * 3600 * NSEC_PER_SEC + 123] {
+            let (hi, lo, nsec) = split_timestamp(ns);
+            assert_eq!(join_timestamp(hi, lo, nsec), ns);
+        }
+    }
+}
