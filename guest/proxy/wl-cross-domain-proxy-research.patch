+
+    #[test]
+    fn transfers_end_at_end_of_file_and_respect_their_limits() {
+        // read_all: data written in pieces, then closed
+        let (r, w) = pipe().unwrap();
+        let writer = std::thread::spawn(move || {
+            for _ in 0..40 {
+                rustix::io::write(&w, &[7u8; 10000]).unwrap();
+            }
+        });
+        let data = read_all(&r, MAX_SIZE, Duration::from_secs(5)).unwrap();
+        writer.join().unwrap();
+        assert_eq!(data.len(), 400_000);
+        // over the limit
+        let (r, w) = pipe().unwrap();
+        rustix::io::write(&w, &[1u8; 100]).unwrap();
+        drop(w);
+        assert!(read_all(&r, 50, Duration::from_secs(1)).is_err());
+        // a writer that never closes: timeout
+        let (r, w) = pipe().unwrap();
+        let t = Instant::now();
+        assert_eq!(read_all(&r, 50, Duration::from_millis(100)).unwrap_err().kind(), io::ErrorKind::TimedOut);
+        assert!(t.elapsed() < Duration::from_secs(2));
+        drop(w);
+        // write_all into a pipe drained by another thread, larger than the pipe
+        let (r, w) = pipe().unwrap();
+        let reader = std::thread::spawn(move || read_all(&r, MAX_SIZE, Duration::from_secs(5)).unwrap());
+        write_all(w, &vec![3u8; 1 << 20], Duration::from_secs(5)).unwrap();
+        assert_eq!(reader.join().unwrap().len(), 1 << 20);
+        // a reader that went away: an error, no signal
+        let (r, w) = pipe().unwrap();
+        drop(r);
+        assert!(write_all(w, b"x", Duration::from_secs(1)).is_err());
+    }
+
+    fn ev(sender: u32, args: Args) -> Message<u32, OwnedFd> {
+        Message {
+            sender_id: sender,
+            opcode: 0,
+            args,
+        }
+    }
+
+    fn s(v: &str) -> Argument<u32, OwnedFd> {
