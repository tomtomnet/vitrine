--- a/src/wl_proto/presentation_v3.rs
+++ b/src/wl_proto/presentation_v3.rs
@@ -0,0 +1,137 @@
+//! `wp_presentation` version 3: the wayland-protocols crate stops at version 2. Version 3 is
+//! the proposal of wayland-protocols merge request 454 (Xaver Hugl, open as of 2026-10-07):
+//! `wp_presentation_feedback.content_update_deadline`, sent just before `presented`, says how
+//! long before the presentation the host compositor latched the frame - a nested compositor
+//! (the guest's KWin) plans its next commit from it instead of guessing from frame callbacks.
+//!
+//! Version 4 (experimental, ours): `content_update_ready(tv_sec_hi, tv_sec_lo, tv_nsec)`, sent
+//! before the deadline - when the host first considered the content update's buffers ready, after
+//! Michel Dänzer's proposal on the same merge request (host KWin h5, patch 0016; 2026-10-08).
+//!
+//! The descriptors follow what wayland-scanner generates for the XML (requests and events in
+//! protocol order; `arg_interfaces` lists the `object` arguments, a `new_id` names its interface
+//! in `child_interface`), with the one event added. A host without version 3 offers 2 or less,
+//! and the proxy then offers no more to the guest.
+
+use wayland_server::backend::protocol::{AllowNull, ArgumentType, Interface, MessageDesc};
+use wayland_server::protocol::__interfaces::{WL_OUTPUT_INTERFACE, WL_SURFACE_INTERFACE};
+
+pub static WP_PRESENTATION_INTERFACE: Interface = Interface {
+    name: "wp_presentation",
+    version: 4,
+    requests: &[
+        MessageDesc {
+            name: "destroy",
+            signature: &[],
+            since: 1,
+            is_destructor: true,
+            child_interface: None,
+            arg_interfaces: &[],
+        },
+        MessageDesc {
+            name: "feedback",
+            signature: &[ArgumentType::Object(AllowNull::No), ArgumentType::NewId],
+            since: 1,
