@@ -0,0 +1,633 @@
+//! What the proxy adds on top of plain message forwarding, shared by both
+//! transports (virtio-gpu cross-domain and the local test transport).
+//!
+//! * Object id translation. The proxy owns the host object ids
+//!   `2..=OWN_IDS + 1` of each connection, for objects of its own (a registry,
+//!   keyboard shortcut inhibitors); every other client-side id of the guest is
+//!   shifted by `OWN_IDS` on the host connection. libwayland-server only
+//!   accepts a new client id that is free and at most one past the highest id
+//!   in use; a constant shift keeps that true, provided the proxy's range is
+//!   taken before the guest's first request (`Session::startup`).
+//! * Keyboard shortcut capture ([`shortcuts`]) and the pointer grab that goes
+//!   with it ([`grab`]).
+//! * The host/guest clipboard ([`clipboard`]).
+//! * The fence gate ([`fence`]).
+//! * A guard for host seats that lose their pointer or keyboard ([`seat`]).
+//! * Live numbers (fps, latencies) in the window title ([`stats`]), and the
+//!   stats overlay inside the guest's desktop ([`overlay`]).
+
+mod clipboard;
+mod fence;
+mod grab;
+mod seat;
+mod shell;
+mod opaque;
+mod overlay;
+mod resize;
+mod shortcuts;
+mod stats;
+
+pub use clipboard::{ClipboardConfig, ClipboardMode};
+pub use fence::{FenceConfig, FenceGate};
+pub use overlay::OverlayConfig;
+pub use shortcuts::{Chord, ShortcutConfig};
+pub use stats::{CsvLog, StatsConfig, StatsMode};
+
+use std::collections::HashMap;
+use std::io;
+use std::os::fd::{AsFd, AsRawFd, BorrowedFd, FromRawFd, OwnedFd};
+
+use log::{debug, warn};
+use smallvec::smallvec;
+use wayland_server::backend::protocol::{Argument, Interface, Message};
+use wayland_server::protocol::__interfaces::{WL_DISPLAY_INTERFACE, WL_REGISTRY_INTERFACE};
+
+use crate::clock::SharedClock;
+use crate::wl_proto::{Data, Object, ObjectMap};
+use clipboard::Clipboard;
+use grab::Grab;
+use overlay::Overlay;
+use resize::Resize;
+use seat::SeatGuard;
+use shell::Shell;
+use shortcuts::Shortcuts;
+use stats::Stats;
+
+/// Number of host object ids the proxy keeps for itself: `2..=OWN_IDS + 1`.
+pub const OWN_IDS: u32 = 16;
+const FIRST_OWN: u32 = 2;
+const SERVER_ID_START: u32 = 0xFF00_0000;
+
+/// A message the proxy sends to the host on its own behalf (host ids, no fds).
+pub type HostRequest = Message<u32, OwnedFd>;
+
+/// Guest object id -> host object id (client-side ids from 2 are shifted).
+pub fn guest_to_host(id: u32) -> u32 {
+    if (FIRST_OWN..SERVER_ID_START).contains(&id) {
+        id + OWN_IDS
+    } else {
+        id
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum HostId {
+    /// An object of the guest (its guest id).
+    Guest(u32),
+    /// An object the proxy created itself (its host id).
+    Own(u32),
+}
+
+/// Host object id -> whose object it is.
+pub fn host_to_guest(id: u32) -> HostId {
+    if (FIRST_OWN..SERVER_ID_START).contains(&id) {
+        if id < FIRST_OWN + OWN_IDS {
+            HostId::Own(id)
+        } else {
+            HostId::Guest(id - OWN_IDS)
+        }
+    } else {
+        HostId::Guest(id)
+    }
+}
+
+fn map_ids<Fd>(msg: &mut Message<u32, Fd>, f: impl Fn(u32) -> u32) {
+    msg.sender_id = f(msg.sender_id);
+    for arg in msg.args.iter_mut() {
+        match arg {
+            Argument::Object(id) | Argument::NewId(id) => *id = f(*id),
+            _ => {}
+        }
+    }
+}
+
+/// Rewrites a guest request (after any transformation) into host ids.
+pub fn request_to_host<Fd>(msg: &mut Message<u32, Fd>) {
+    map_ids(msg, guest_to_host);
+}
+
+/// Opcode of a request by name.
+pub(crate) fn request_opcode(interface: &Interface, name: &str) -> u16 {
+    interface
+        .requests
+        .iter()
+        .position(|r| r.name == name)
+        .unwrap_or_else(|| panic!("{}.{} does not exist", interface.name, name)) as u16
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum OwnKind {
+    Registry,
+    Callback,
+    Seat,
+    InhibitManager,
+    Inhibitor,
+    Region,
+    DataDeviceManager,
+    DataDevice,
+    DataSource,
+    /// created by the host (a server id), see [`OwnObjects::add_server`]
+    DataOffer,
+    PointerConstraints,
+    Confinement,
+}
+
+struct OwnObject {
+    interface: &'static Interface,
+    kind: OwnKind,
+}
+
+/// The proxy's own objects on the host connection, by host id.
+pub(crate) struct OwnObjects {
+    objects: HashMap<u32, OwnObject>,
+    free: Vec<u32>,
+    /// objects the host created for the proxy (server ids, outside the id shift)
+    server: HashMap<u32, OwnObject>,
+}
+
+impl OwnObjects {
+    fn new() -> Self {
+        OwnObjects {
+            objects: HashMap::new(),
+            free: Vec::new(),
+            server: HashMap::new(),
+        }
+    }
+
+    /// An object the host created for the proxy (a server id from a new_id
+    /// event on one of the proxy's objects): its events go to the proxy until
+    /// [`OwnObjects::remove_server`] (the host sends no delete_id for them).
+    pub(crate) fn add_server(&mut self, id: u32, interface: &'static Interface, kind: OwnKind) {
+        self.server.insert(id, OwnObject { interface, kind });
+    }
+
+    pub(crate) fn remove_server(&mut self, id: u32) {
+        self.server.remove(&id);
+    }
+
+    pub(crate) fn server_kind(&self, id: u32) -> Option<OwnKind> {
+        self.server.get(&id).map(|o| o.kind)
+    }
+
+    /// Takes a free id for a new object, `None` while all are in use.
+    pub(crate) fn alloc(&mut self, interface: &'static Interface, kind: OwnKind) -> Option<u32> {
+        let id = self.free.pop()?;
+        self.objects.insert(id, OwnObject { interface, kind });
+        Some(id)
+    }
+
+    fn deleted(&mut self, id: u32) {
+        if self.objects.remove(&id).is_some() {
+            self.free.push(id);
+        }
+    }
+
+    fn get(&self, id: u32) -> Option<&OwnObject> {
+        self.objects.get(&id)
+    }
+}
+
+#[derive(Debug, Clone)]
+pub struct SessionConfig {
+    pub shortcuts: ShortcutConfig,
+    pub fences: FenceConfig,
+    pub stats: StatsConfig,
+    /// Seconds between statistics lines at info level, 0 disables them.
+    pub stats_interval_s: i64,
+    /// --opaque-toplevels (see opaque.rs)
+    pub opaque_toplevels: bool,
+    /// --clipboard (see clipboard.rs)
+    pub clipboard: ClipboardConfig,
+    /// --title-label (see shell.rs)
+    pub title_label: Option<String>,
+    /// --resize-settle-ms (see resize.rs), zero for off
+    pub resize_settle: std::time::Duration,
+    /// --overlay-command and co. (see overlay.rs)
+    pub overlay: OverlayConfig,
+}
+
+impl Default for SessionConfig {
+    fn default() -> Self {
+        SessionConfig {
+            shortcuts: ShortcutConfig::default(),
+            fences: FenceConfig::default(),
+            stats: StatsConfig::default(),
+            stats_interval_s: 10,
+            opaque_toplevels: false,
+            clipboard: ClipboardConfig::default(),
+            title_label: None,
+            resize_settle: std::time::Duration::ZERO,
+            overlay: OverlayConfig::default(),
+        }
+    }
+}
+
+/// Per-connection state (one guest client, one host connection).
+pub struct Session {
+    own: OwnObjects,
+    shortcuts: Shortcuts,
+    grab: Grab,
+    clipboard: Clipboard,
+    seat: SeatGuard,
+    shell: Shell,
+    resize: Resize,
+    opaque: opaque::Opaque,
+    stats: Stats,
+    overlay: Overlay,
+    clock: SharedClock,
+    pub fences: FenceGate,
+    /// readable when the fence gate or the statistics timer need [`Session::dispatch`]
+    epoll: OwnedFd,
+    stats_timer: Option<OwnedFd>,
+}
+
+fn epoll_add(epoll: &OwnedFd, fd: BorrowedFd<'_>) -> io::Result<()> {
+    let mut ev = libc::epoll_event {
+        events: libc::EPOLLIN as u32,
+        u64: fd.as_raw_fd() as u64,
+    };
+    // SAFETY: valid epoll fd and event
+    if unsafe { libc::epoll_ctl(epoll.as_raw_fd(), libc::EPOLL_CTL_ADD, fd.as_raw_fd(), &mut ev) } < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(())
+}
+
+fn periodic_timer(period_ns: i64) -> io::Result<OwnedFd> {
+    // SAFETY: plain syscalls, results checked
+    let fd = unsafe { libc::timerfd_create(libc::CLOCK_MONOTONIC, libc::TFD_NONBLOCK | libc::TFD_CLOEXEC) };
+    if fd < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let fd = unsafe { OwnedFd::from_raw_fd(fd) };
+    let ts = libc::timespec {
+        tv_sec: (period_ns / 1_000_000_000) as libc::time_t,
+        tv_nsec: (period_ns % 1_000_000_000) as libc::c_long,
+    };
+    let spec = libc::itimerspec {
+        it_interval: ts,
+        it_value: ts,
+    };
+    // SAFETY: valid timerfd and spec
+    if unsafe { libc::timerfd_settime(fd.as_raw_fd(), 0, &spec, std::ptr::null_mut()) } < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(fd)
+}
+
+impl Session {
+    pub fn new(cfg: &SessionConfig, clock: SharedClock) -> io::Result<Self> {
+        let fences = FenceGate::new(cfg.fences.clone(), cfg.stats_interval_s)?;
+        let stats = Stats::new(cfg.stats.clone(), cfg.stats_interval_s);
+        // SAFETY: plain syscall, result checked
+        let epoll = unsafe { libc::epoll_create1(libc::EPOLL_CLOEXEC) };
+        if epoll < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        let epoll = unsafe { OwnedFd::from_raw_fd(epoll) };
+        epoll_add(&epoll, fences.fd())?;
+        let clipboard = Clipboard::new(cfg.clipboard.clone())?;
+        epoll_add(&epoll, clipboard.fd())?;
+        let resize = Resize::new(cfg.resize_settle)?;
+        if let Some(fd) = resize.fd() {
+            epoll_add(&epoll, fd)?;
+        }
+        let overlay = Overlay::new(cfg.overlay.clone())?;
+        if let Some(fd) = overlay.fd() {
+            epoll_add(&epoll, fd)?;
+        }
+        let stats_timer = if stats.active() {
+            let timer = periodic_timer(stats.interval_ns())?;
+            epoll_add(&epoll, timer.as_fd())?;
+            Some(timer)
+        } else {
+            None
+        };
+        Ok(Session {
+            own: OwnObjects::new(),
+            shortcuts: Shortcuts::new(cfg.shortcuts.clone()),
+            grab: Grab::new(cfg.shortcuts.enabled && cfg.shortcuts.grab_pointer),
+            clipboard,
+            seat: SeatGuard::default(),
+            shell: Shell::with_label(cfg.title_label.clone()),
+            resize,
+            opaque: opaque::Opaque::new(cfg.opaque_toplevels),
+            stats,
+            overlay,
+            clock,
+            fences,
+            epoll,
+            stats_timer,
+        })
+    }
+
+    /// Readable when [`Session::dispatch`] has work: register it in the event loop.
+    pub fn fd(&self) -> BorrowedFd<'_> {
+        self.epoll.as_fd()
+    }
+
+    /// A guest request (guest ids), in arrival order: into the fence gate.
+    pub fn push_request(&mut self, msg: Message<u32, OwnedFd>, obj: Object<Data>) {
+        let received = self.clock.borrow().now();
+        self.fences.push(msg, obj, received);
+    }
+
+    /// The next guest request that may be forwarded now, and when it arrived.
+    pub fn pop_request(&mut self) -> Option<(Message<u32, OwnedFd>, Object<Data>, i64)> {
+        self.fences.pop()
+    }
+
+    /// Fence readiness, the clipboard's transfers, the resize settle timer and
+    /// the statistics timer; `out` receives requests of the proxy (host ids,
+    /// title updates) to send to the host now, `to_guest` events (guest ids) to
+    /// deliver to the guest.
+    pub fn dispatch(&mut self, out: &mut Vec<HostRequest>, to_guest: &mut Vec<Message<u32, OwnedFd>>) {
+        self.fences.dispatch();
+        self.clipboard.dispatch(&mut self.own, out);
+        self.resize.dispatch(out, to_guest);
+        if self.overlay.fd().is_some() {
+            let now = self.clock.borrow().now();
+            self.overlay.dispatch(&mut self.stats, now);
+        }
+        let Some(timer) = &self.stats_timer else { return };
+        let mut expirations = [0u8; 8];
+        // SAFETY: reading the expiration count of a non-blocking timerfd
+        let n = unsafe { libc::read(timer.as_raw_fd(), expirations.as_mut_ptr().cast(), 8) };
+        if n != 8 {
+            return;
+        }
+        let now = self.clock.borrow().now();
+        if let Some(text) = self.stats.tick(now) {
+            if self.stats.mode() != StatsMode::Off {
+                self.shell.set_stats(Some(text), out);
+            }
+        }
+    }
+
+    /// Requests to send to the host before any guest message: they create the
+    /// proxy's registry and take the rest of its id range with wl_display.sync
+    /// callbacks, which the host frees at once (their delete_id makes the ids
+    /// available to the proxy).
+    pub fn startup(&mut self) -> Vec<HostRequest> {
+        let get_registry = request_opcode(&WL_DISPLAY_INTERFACE, "get_registry");
+        let sync = request_opcode(&WL_DISPLAY_INTERFACE, "sync");
+        let callback = WL_DISPLAY_INTERFACE.requests[sync as usize]
+            .child_interface
+            .expect("wl_display.sync creates a wl_callback");
+        let mut out = vec![Message {
+            sender_id: 1,
+            opcode: get_registry,
+            args: smallvec![Argument::NewId(FIRST_OWN)],
+        }];
+        self.own.objects.insert(
+            FIRST_OWN,
+            OwnObject {
+                interface: &WL_REGISTRY_INTERFACE,
+                kind: OwnKind::Registry,
+            },
+        );
+        for id in FIRST_OWN + 1..FIRST_OWN + OWN_IDS {
+            out.push(Message {
+                sender_id: 1,
+                opcode: sync,
+                args: smallvec![Argument::NewId(id)],
+            });
+            self.own.objects.insert(
+                id,
+                OwnObject {
+                    interface: callback,
+                    kind: OwnKind::Callback,
+                },
+            );
+        }
+        out
+    }
+
+    /// Interface of a host object id, for parsing host events.
+    pub fn interface_of(&self, host_id: u32, guest: &ObjectMap<Data>) -> Option<&'static Interface> {
+        if let Some(own) = self.own.server.get(&host_id) {
+            return Some(own.interface);
+        }
+        match host_to_guest(host_id) {
+            HostId::Own(id) => self.own.get(id).map(|o| o.interface),
+            HostId::Guest(id) => guest.find(id).map(|o| o.interface),
+        }
+    }
+
+    /// A guest request (guest ids) about to be forwarded, in order, read from
+    /// the guest at `received`. May rewrite it; `pre` and `post` receive
+    /// requests of the proxy (host ids) to send before and after it. Returns
+    /// false when it must not reach the host (`pre` and `post` still go).
+    pub fn before_request(
+        &mut self,
+        msg: &mut Message<u32, OwnedFd>,
+        obj: &Object<Data>,
+        received: i64,
+        pre: &mut Vec<HostRequest>,
+        post: &mut Vec<HostRequest>,
+    ) -> bool {
+        let interface = obj.interface.name;
+        let name = obj.interface.requests[msg.opcode as usize].name;
+        self.seat
+            .on_request(interface, name, msg.sender_id, obj.version, msg);
+        // first: the hooks below see the window as the host does
+        if !self.resize.on_request(interface, name, msg, pre, post) {
+            return false;
+        }
+        self.shortcuts
+            .on_request(interface, name, msg, &self.shell, &mut self.own, pre, post);
+        let captured = !self.shortcuts.released();
+        self.grab
+            .on_request(interface, name, msg, &self.shell, captured, &mut self.own, pre, post);
+        self.opaque
+            .on_request(interface, name, msg, &self.shell, &mut self.own, pre);
+        if self.stats.active() {
+            let now = self.clock.borrow().now();
+            let toplevel = self.shell.is_toplevel_surface(msg.sender_id);
+            self.stats.on_request(interface, name, msg, received, now, toplevel);
+        }
+        // last: the hooks above see the toplevels before this request
+        self.shell.on_request(interface, name, msg);
+        true
+    }
+
+    /// A host event about to reach the guest: guest ids, every filter applied
+    /// (presentation timestamps in the guest's clock).
+    pub fn event_to_guest(&mut self, msg: &Message<u32, OwnedFd>, obj: &Object<Data>) {
+        if self.stats.active() {
+            let now = self.clock.borrow().now();
+            let event = obj.interface.events[msg.opcode as usize].name;
+            self.stats.on_event(obj.interface.name, event, msg, now);
+        }
+    }
+
+    /// A host event (host ids). Returns it rewritten into guest ids, or `None`
+    /// if it was for the proxy. `before` receives events (guest ids) to deliver
+    /// to the guest ahead of it, `out` requests of the proxy (host ids) to send
+    /// to the host now.
+    pub fn host_event(
+        &mut self,
+        mut msg: Message<u32, OwnedFd>,
+        interface: &'static Interface,
+        before: &mut Vec<Message<u32, OwnedFd>>,
+        out: &mut Vec<HostRequest>,
+    ) -> Option<Message<u32, OwnedFd>> {
+        let event = interface.events[msg.opcode as usize].name;
+        if let Some(kind) = self.own.server_kind(msg.sender_id) {
+            self.clipboard
+                .on_own_event(kind, msg.sender_id, event, &mut msg, &mut self.own, out);
+            return None;
+        }
+        if let HostId::Own(id) = host_to_guest(msg.sender_id) {
+            let kind = self.own.get(id).map(|o| o.kind);
+            if let Some(kind) = kind {
+                self.shortcuts
+                    .on_own_event(kind, id, event, &msg, &mut self.own, out);
+                self.grab.on_own_event(kind, event, &msg);
+                self.clipboard
+                    .on_own_event(kind, id, event, &mut msg, &mut self.own, out);
+            }
+            return None;
+        }
+        if msg.sender_id == 1 {
+            match event {
+                "delete_id" => {
+                    let Some(Argument::Uint(id)) = msg.args.first_mut() else {
+                        return Some(msg);
+                    };
+                    match host_to_guest(*id) {
+                        HostId::Own(own) => {
+                            self.own.deleted(own);
+                            return None;
+                        }
+                        HostId::Guest(guest) => *id = guest,
+                    }
+                    return Some(msg);
+                }
+                "error" => {
+                    if let Some(Argument::Object(id)) = msg.args.first() {
+                        if let HostId::Own(own) = host_to_guest(*id) {
+                            warn!(
+                                "host protocol error on the proxy's own object {own} ({:?})",
+                                self.own.get(own).map(|o| o.interface.name)
+                            );
+                        }
+                    }
+                }
+                _ => {}
+            }
+        }
+        map_ids(&mut msg, |id| match host_to_guest(id) {
+            HostId::Guest(g) => g,
+            // only wl_display.error can name one of them; point it at wl_display
+            HostId::Own(_) => 1,
+        });
+        self.fences.on_host_event(interface.name, event, &msg);
+        self.seat.on_event(interface.name, event, &msg, before);
+        self.clipboard
+            .on_event(interface.name, event, &msg, &mut self.own, out);
+        let keep_from_guest = self
+            .shortcuts
+            .on_event(interface.name, event, &mut msg, &self.shell, &mut self.own, out);
+        if self.shortcuts.take_overlay_toggle() {
+            let now = self.clock.borrow().now();
+            self.overlay.toggle(&mut self.stats, now);
+        }
+        self.shell.set_released(self.shortcuts.released(), out);
+        let captured = !self.shortcuts.released();
+        self.grab
+            .on_event(interface.name, event, &msg, &self.shell, captured, &mut self.own, out);
+        // the capture follows the pointer (shortcuts.rs): grab.rs knows the toplevel under it
+        self.shortcuts
+            .set_pointer_over(self.grab.over(), &self.shell, &mut self.own, out);
+        self.shell.set_outside(self.shortcuts.pointer_outside(), out);
+        // last: the hooks above see host coordinates and the host's configures
+        let held = self.resize.on_event(interface.name, event, &mut msg, before, out);
+        debug!("host event {}@{}.{}", interface.name, msg.sender_id, event);
+        if keep_from_guest || held {
+            return None;
+        }
+        Some(msg)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn id_translation_is_a_bijection_outside_the_own_range() {
+        assert_eq!(guest_to_host(0), 0);
+        assert_eq!(guest_to_host(1), 1);
+        assert_eq!(guest_to_host(2), 2 + OWN_IDS);
+        assert_eq!(guest_to_host(SERVER_ID_START), SERVER_ID_START);
+        assert_eq!(guest_to_host(SERVER_ID_START + 7), SERVER_ID_START + 7);
+        for g in [2u32, 3, 17, 18, 1000, 0x00f0_0000] {
+            assert_eq!(host_to_guest(guest_to_host(g)), HostId::Guest(g));
+        }
+        for h in FIRST_OWN..FIRST_OWN + OWN_IDS {
+            assert_eq!(host_to_guest(h), HostId::Own(h));
+        }
+        assert_eq!(host_to_guest(FIRST_OWN + OWN_IDS), HostId::Guest(2));
+        assert_eq!(host_to_guest(1), HostId::Guest(1));
+        assert_eq!(host_to_guest(0), HostId::Guest(0));
+    }
+
+    /// Replays libwayland's id rules: a client (the guest) allocates ids the way
+    /// libwayland-client does, the server (the host) checks them the way
+    /// libwayland-server does, with the proxy's range taken first.
+    #[test]
+    fn shifted_ids_satisfy_the_server_allocation_rule() {
+        // server side: entries[i] = in use
+        let mut server: Vec<bool> = vec![true, true]; // 0 reserved, 1 = wl_display
+        let server_new = |id: u32, server: &mut Vec<bool>| -> bool {
+            let i = id as usize;
+            if i > server.len() {
+                return false;
+            }
+            if i == server.len() {
+                server.push(true);
+                return true;
+            }
+            if server[i] {
+                return false;
+            }
+            server[i] = true;
+            true
+        };
+        // the proxy's startup: registry + callbacks
+        let clock = crate::clock::ClockTranslator::shared(crate::clock::ClockConfig::default());
+        let mut session = Session::new(&SessionConfig::default(), clock).unwrap();
+        for m in session.startup() {
+            let Argument::NewId(id) = m.args[0] else { panic!() };
+            assert!(server_new(id, &mut server), "startup id {id}");
+        }
+        // callbacks are destroyed by the server at once
+        for id in FIRST_OWN + 1..FIRST_OWN + OWN_IDS {
+            server[id as usize] = false;
+        }
+        // client side: libwayland-client's allocator (free list LIFO, else append)
+        let mut client_len: u32 = 2;
+        let mut client_free: Vec<u32> = Vec::new();
+        let mut live: Vec<u32> = Vec::new();
+        let mut rng = 12345u64;
+        for step in 0..20000 {
+            rng = rng.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+            let destroy = !live.is_empty() && (rng >> 33) % 3 == 0;
+            if destroy {
+                let k = ((rng >> 40) as usize) % live.len();
+                let g = live.swap_remove(k);
+                // server destroys the object, sends delete_id; client frees the id
+                server[guest_to_host(g) as usize] = false;
+                client_free.push(g);
+            } else {
+                let g = client_free.pop().unwrap_or_else(|| {
+                    client_len += 1;
+                    client_len - 1
+                });
+                assert!(server_new(guest_to_host(g), &mut server), "step {step}: id {g}");
+                live.push(g);
+            }
+        }
+    }
+}
diff -ruN a/src/session/opaque.rs b/src/session/opaque.rs
--- a/src/session/opaque.rs
+++ b/src/session/opaque.rs
@@ -0,0 +1,143 @@
+//! `--opaque-toplevels`: forwarded toplevels are declared opaque to the host.
+//!
+//! A nested KWin renders its output into an ARGB buffer (KWin's format choice
+//! puts formats with alpha first) and never sets an opaque region on its
+//! window, although a desktop has no transparency. The host compositor then
+//! treats the window as translucent: KWin 6.7 puts a full-screen surface
+//! straight on the screen only while it updates quickly (one frame every 50 ms
+//! or faster) unless it is opaque, so the first frames of every burst - the
+//! one answering a key press among them - are composited, at the composited
+//! frame's earlier deadline.
+//!
+//! On the first commit of each toplevel's surface the proxy creates a region of
+//! its own on the host (through the guest's wl_compositor), sets it as the
+//! surface's opaque region and destroys it; the state stays with the surface.
+//! The guest never sees the region.
+//!
+//! The same for the **first subsurface of a toplevel's surface**: a nested KWin
+//! (Wayland backend) shows a one-pixel black buffer on its toplevel's own
+//! surface and its whole rendered output on a subsurface (the primary layer,
+//! created first; four overlay layers follow and are left alone - a guest
+//! window put on one of them may be translucent). Declaring only the toplevel
+//! surface opaque changed nothing (laptop, 2026-10-05): the host's KWin saw
+//! the layer as translucent and composited it whenever it had not updated
+//! quickly in the last 100 frames - the start of every animation
+//! (2026-10-06, KWin 6.8 isCandidate()).
+
+use std::collections::{HashMap, HashSet};
+use std::os::fd::OwnedFd;
+
+use log::{debug, info};
+use smallvec::smallvec;
+use wayland_server::backend::protocol::{Argument, Message};
+use wayland_server::protocol::__interfaces::{
+    WL_COMPOSITOR_INTERFACE, WL_REGION_INTERFACE, WL_SURFACE_INTERFACE,
+};
+
+use super::shell::Shell;
+use super::{HostRequest, OwnKind, OwnObjects, guest_to_host, request_opcode};
+
+/// Larger than any surface, small enough for every compositor's region code.
+const EXTENT: i32 = 1 << 15;
+
+#[derive(Default)]
+pub(super) struct Opaque {
+    enabled: bool,
+    /// the guest's wl_compositor (guest id), from its create_surface
+    compositor: Option<u32>,
+    /// surfaces (guest ids) already declared opaque
+    done: HashSet<u32>,
+    /// parent surface -> its first subsurface's surface (guest ids)
+    first_child: HashMap<u32, u32>,
+}
+
+impl Opaque {
+    pub(super) fn new(enabled: bool) -> Self {
+        Opaque {
+            enabled,
+            ..Default::default()
+        }
+    }
+
+    /// A guest request (guest ids) about to be forwarded: `pre` receives the
+    /// proxy's requests (host ids) to send before it.
+    pub(super) fn on_request(
+        &mut self,
+        interface: &str,
+        request: &str,
+        msg: &Message<u32, OwnedFd>,
+        shell: &Shell,
+        own: &mut OwnObjects,
+        pre: &mut Vec<HostRequest>,
+    ) {
+        if !self.enabled {
+            return;
+        }
+        match (interface, request) {
+            ("wl_compositor", "create_surface") => self.compositor = Some(msg.sender_id),
+            ("wl_subcompositor", "get_subsurface") => {
+                if let [_, Argument::Object(surface), Argument::Object(parent)] = msg.args.as_slice() {
+                    self.first_child.entry(*parent).or_insert(*surface);
+                }
+            }
+            ("wl_surface", "destroy") => {
+                let surface = msg.sender_id;
+                self.done.remove(&surface);
+                self.first_child.remove(&surface);
+                self.first_child.retain(|_, child| *child != surface);
+            }
+            ("wl_surface", "commit") => {
+                let surface = msg.sender_id;
+                if self.done.contains(&surface) {
+                    return;
+                }
+                // the toplevel's own surface, or the first subsurface of one (a
+                // nested compositor's primary layer)
+                let layer_of = self
+                    .first_child
+                    .iter()
+                    .find(|(parent, child)| **child == surface && shell.is_toplevel_surface(**parent))
+                    .map(|(parent, _)| *parent);
+                if !shell.is_toplevel_surface(surface) && layer_of.is_none() {
+                    return;
+                }
+                let Some(compositor) = self.compositor else { return };
+                let Some(region) = own.alloc(&WL_REGION_INTERFACE, OwnKind::Region) else {
+                    debug!("opaque: no free proxy object id yet");
+                    return;
+                };
+                pre.push(Message {
+                    sender_id: guest_to_host(compositor),
+                    opcode: request_opcode(&WL_COMPOSITOR_INTERFACE, "create_region"),
+                    args: smallvec![Argument::NewId(region)],
+                });
+                pre.push(Message {
+                    sender_id: region,
+                    opcode: request_opcode(&WL_REGION_INTERFACE, "add"),
+                    args: smallvec![
+                        Argument::Int(0),
+                        Argument::Int(0),
+                        Argument::Int(EXTENT),
+                        Argument::Int(EXTENT)
+                    ],
+                });
+                pre.push(Message {
+                    sender_id: guest_to_host(surface),
+                    opcode: request_opcode(&WL_SURFACE_INTERFACE, "set_opaque_region"),
+                    args: smallvec![Argument::Object(region)],
+                });
+                pre.push(Message {
+                    sender_id: region,
+                    opcode: request_opcode(&WL_REGION_INTERFACE, "destroy"),
+                    args: smallvec![],
+                });
+                self.done.insert(surface);
+                match layer_of {
+                    Some(parent) => info!("opaque: surface {surface}, the first subsurface of toplevel surface {parent}, declared opaque to the host"),
+                    None => info!("opaque: toplevel surface {surface} declared opaque to the host"),
+                }
+            }
+            _ => {}
+        }
+    }
+}
diff -ruN a/src/session/overlay.rs b/src/session/overlay.rs
--- a/src/session/overlay.rs
+++ b/src/session/overlay.rs
@@ -0,0 +1,329 @@
+//! The stats overlay, like Looking Glass's: the numbers of [`super::stats`]
+//! and graphs of the last frames' intervals, drawn inside the guest's desktop
+//! by a small client of the nested compositor (a layer-shell window), so that
+//! the host still gets one buffer per frame and can put it straight on the
+//! screen.
+//!
+//! The overlay chord (default Ctrl+Alt+S, with --overlay-command) shows and
+//! hides it. Shown, the proxy starts the command (`sh -c`, in a process group
+//! of its own, with `CROSVM_DESKTOP_STATS_FILE` in its environment) and
+//! rewrites that JSON file every --overlay-interval-ms; hidden, it ends the
+//! command's process group and removes the file. Nothing is started, tracked
+//! or written while it is hidden, apart from what --stats and --stats-log ask
+//! for anyway.
+//!
+//! The command starts with no signal blocked and none of the proxy's file
+//! descriptors but 0-2: the proxy blocks SIGINT and SIGTERM for its signalfd,
+//! a mask that fork and exec pass on, and the first version's overlay then
+//! ignored the SIGTERM that hides it while the proxy waited for it to exit -
+//! the whole forwarded desktop froze (2026-10-08). Hiding never waits more
+//! than [`EXIT_WAIT`] either: SIGKILL after it.
+//!
+//! The file, rewritten whole (a rename) at each update:
+//!
+//! ```text
+//! {"fps":239.8,"ups":240.0,"burst_fps":240.0,"burst_ups":240.0,"dropped":0,"refresh_hz":240.00,
+//!  "frame":[5.10,7.92],"input":[9.80,12.10],"hold":[0.21,0.35],
+//!  "present_ms":[4.17,4.16,...],"commit_ms":[4.17,4.18,...]}
+//! ```
+//!
+//! fps = frames the host presented per second, ups = frames the guest
+//! committed per second (its updates), dropped = frames the host discarded
+//! per second; frame, input and hold are median and p99 in ms (null when
+//! there was nothing to measure), as in the window title's detail mode;
+//! present_ms are the intervals between the last presented frames (host
+//! presentation times: a refresh shown twice is twice the period), commit_ms
+//! those between the guest's last commits, oldest first. The overlay's own
+//! repaints count too: four frames a second on an idle desktop (stats-overlay.qml
+//! reads the file at 4 Hz: each repaint is a frame the nested compositor
+//! composites, and at 10 Hz the overlay doubled the repeated refreshes of a
+//! launcher loop, 2.1 -> 4.4 %, whether it drew on the GPU or in software).
+
+use std::fs;
+use std::io::{self, Write};
+use std::os::fd::{AsFd, AsRawFd, BorrowedFd, FromRawFd, OwnedFd};
+use std::os::unix::process::CommandExt;
+use std::path::PathBuf;
+use std::process::{Child, Command, Stdio};
+use std::time::{Duration, Instant};
+
+use log::{info, warn};
+
+use super::stats::Stats;
+
+/// How long hiding waits for the command to end after SIGTERM, before SIGKILL.
+const EXIT_WAIT: Duration = Duration::from_millis(200);
+
+/// Ends the command's process group: SIGTERM, then SIGKILL if it is still
+/// there after [`EXIT_WAIT`]; never blocks longer than that.
+fn end(mut child: Child) {
+    let group = -(child.id() as libc::pid_t);
+    // SAFETY: plain syscall
+    unsafe { libc::kill(group, libc::SIGTERM) };
+    let deadline = Instant::now() + EXIT_WAIT;
+    loop {
+        match child.try_wait() {
+            Ok(Some(_)) => return,
+            Ok(None) if Instant::now() < deadline => std::thread::sleep(Duration::from_millis(5)),
+            _ => break,
+        }
+    }
+    warn!("overlay: the command did not end on SIGTERM, killed");
+    // SAFETY: plain syscall
+    unsafe { libc::kill(group, libc::SIGKILL) };
+    let _ = child.wait();
+}
+
+#[derive(Debug, Clone)]
+pub struct OverlayConfig {
+    /// Started with `sh -c` while the overlay is shown; `None`: no overlay.
+    pub command: Option<String>,
+    /// The JSON file the command reads.
+    pub file: PathBuf,
+    /// Updates of the file, in ns.
+    pub interval_ns: i64,
+}
+
+impl Default for OverlayConfig {
+    fn default() -> Self {
+        let dir = std::env::var_os("XDG_RUNTIME_DIR").unwrap_or_else(|| "/tmp".into());
+        OverlayConfig {
+            command: None,
+            file: PathBuf::from(dir).join("crosvm-desktop-stats.json"),
+            interval_ns: 250_000_000,
+        }
+    }
+}
+
+pub(super) struct Overlay {
+    cfg: OverlayConfig,
+    /// armed while shown; None without a command
+    timer: Option<OwnedFd>,
+    child: Option<Child>,
+}
+
+fn timerfd() -> io::Result<OwnedFd> {
+    // SAFETY: plain syscall, result checked
+    let fd = unsafe { libc::timerfd_create(libc::CLOCK_MONOTONIC, libc::TFD_NONBLOCK | libc::TFD_CLOEXEC) };
+    if fd < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    // SAFETY: a new fd we own
+    Ok(unsafe { OwnedFd::from_raw_fd(fd) })
+}
+
+/// Arms `fd` to expire every `period_ns`, or disarms it (0).
+fn set_timer(fd: &OwnedFd, period_ns: i64) {
+    let ts = libc::timespec {
+        tv_sec: (period_ns / 1_000_000_000) as libc::time_t,
+        tv_nsec: (period_ns % 1_000_000_000) as libc::c_long,
+    };
+    let spec = libc::itimerspec {
+        it_interval: ts,
+        it_value: ts,
+    };
+    // SAFETY: valid timerfd and spec
+    if unsafe { libc::timerfd_settime(fd.as_raw_fd(), 0, &spec, std::ptr::null_mut()) } < 0 {
+        warn!("overlay: timerfd_settime failed: {}", io::Error::last_os_error());
+    }
+}
+
+impl Overlay {
+    pub(super) fn new(cfg: OverlayConfig) -> io::Result<Self> {
+        let timer = if cfg.command.is_some() { Some(timerfd()?) } else { None };
+        Ok(Overlay {
+            cfg,
+            timer,
+            child: None,
+        })
+    }
+
+    /// The update timer, for the session's event loop (none without an overlay).
+    pub(super) fn fd(&self) -> Option<BorrowedFd<'_>> {
+        self.timer.as_ref().map(|t| t.as_fd())
+    }
+
+    pub(super) fn shown(&self) -> bool {
+        self.child.is_some()
+    }
+
+    /// The overlay chord.
+    pub(super) fn toggle(&mut self, stats: &mut Stats, now: i64) {
+        if self.shown() {
+            self.hide(stats);
+            info!("overlay: hidden");
+        } else {
+            self.show(stats, now);
+        }
+    }
+
+    fn show(&mut self, stats: &mut Stats, now: i64) {
+        let (Some(command), Some(timer)) = (&self.cfg.command, &self.timer) else {
+            return;
+        };
+        stats.set_overlay(true);
+        // the first numbers are there when the overlay starts reading
+        self.write(stats, now);
+        let mut cmd = Command::new("sh");
+        cmd.arg("-c")
+            .arg(command)
+            .env("CROSVM_DESKTOP_STATS_FILE", &self.cfg.file)
+            .stdin(Stdio::null())
+            .process_group(0);
+        // SAFETY: async-signal-safe calls only, between fork and exec
+        unsafe {
+            cmd.pre_exec(|| {
+                // the proxy's blocked signals (SIGINT, SIGTERM for its signalfd) would stay blocked
+                let mut none: libc::sigset_t = std::mem::zeroed();
+                libc::sigemptyset(&mut none);
+                libc::sigprocmask(libc::SIG_SETMASK, &none, std::ptr::null_mut());
+                // and its descriptors (sockets, dma-bufs, the lock file) open
+                libc::syscall(libc::SYS_close_range, 3u32, u32::MAX, 0u32);
+                Ok(())
+            });
+        }
+        match cmd.spawn() {
+            Ok(child) => {
+                info!("overlay: shown (pid {}, {})", child.id(), self.cfg.file.display());
+                self.child = Some(child);
+                set_timer(timer, self.cfg.interval_ns);
+            }
+            Err(err) => {
+                warn!("overlay: cannot start {command:?}: {err}");
+                stats.set_overlay(false);
+                let _ = fs::remove_file(&self.cfg.file);
+            }
+        }
+    }
+
+    fn hide(&mut self, stats: &mut Stats) {
+        if let Some(timer) = &self.timer {
+            set_timer(timer, 0);
+        }
+        if let Some(child) = self.child.take() {
+            // the whole group: sh and what it started
+            end(child);
+        }
+        stats.set_overlay(false);
+        let _ = fs::remove_file(&self.cfg.file);
+    }
+
+    /// The update timer expired: the file again, unless the command ended by
+    /// itself (then the overlay is hidden).
+    pub(super) fn dispatch(&mut self, stats: &mut Stats, now: i64) {
+        let Some(timer) = &self.timer else { return };
+        let mut expirations = [0u8; 8];
+        // SAFETY: reading the expiration count of a non-blocking timerfd
+        let n = unsafe { libc::read(timer.as_raw_fd(), expirations.as_mut_ptr().cast(), 8) };
+        if n != 8 {
+            return;
+        }
+        let ended = match self.child.as_mut().map(|c| c.try_wait()) {
+            Some(Ok(Some(status))) => Some(status.to_string()),
+            Some(Err(err)) => Some(err.to_string()),
+            _ => None,
+        };
+        if let Some(why) = ended {
+            warn!("overlay: the command ended ({why}), hidden");
+            self.child = None;
+            self.hide(stats);
+            return;
+        }
+        if self.shown() {
+            self.write(stats, now);
+        }
+    }
+
+    fn write(&self, stats: &mut Stats, now: i64) {
+        let json = stats.overlay_json(now);
+        let mut tmp = self.cfg.file.clone().into_os_string();
+        tmp.push(".tmp");
+        let res = fs::File::create(&tmp)
+            .and_then(|mut f| f.write_all(json.as_bytes()))
+            .and_then(|_| fs::rename(&tmp, &self.cfg.file));
+        if let Err(err) = res {
+            warn!("overlay: writing {} failed: {err}", self.cfg.file.display());
+        }
+    }
+}
+
+impl Drop for Overlay {
+    fn drop(&mut self) {
+        if let Some(child) = self.child.take() {
+            end(child);
+            let _ = fs::remove_file(&self.cfg.file);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::session::stats::StatsConfig;
+
+    fn overlay(command: &str, file: &str) -> Overlay {
+        Overlay::new(OverlayConfig {
+            command: Some(command.to_owned()),
+            file: std::env::temp_dir().join(file),
+            interval_ns: 100_000_000,
+        })
+        .unwrap()
+    }
+
+    fn status_field(pid: u32, field: &str) -> String {
+        fs::read_to_string(format!("/proc/{pid}/status"))
+            .unwrap()
+            .lines()
+            .find_map(|l| l.strip_prefix(field).map(|v| v.trim().to_owned()))
+            .unwrap()
+    }
+
+    /// The proxy blocks SIGINT and SIGTERM (its signalfd); the command must not
+    /// inherit that, nor the proxy's descriptors, and hiding must end it at once.
+    #[test]
+    fn command_starts_clean_and_hiding_ends_it() {
+        // SAFETY: test thread's own signal mask
+        unsafe {
+            let mut set: libc::sigset_t = std::mem::zeroed();
+            libc::sigemptyset(&mut set);
+            libc::sigaddset(&mut set, libc::SIGTERM);
+            libc::sigaddset(&mut set, libc::SIGINT);
+            libc::pthread_sigmask(libc::SIG_BLOCK, &set, std::ptr::null_mut());
+        }
+        let leaked = fs::File::open("/proc/self/status").unwrap(); // CLOEXEC in Rust: open one without
+        // SAFETY: dup without CLOEXEC, closed below
+        let raw = unsafe { libc::dup(leaked.as_raw_fd()) };
+        let mut stats = Stats::new(StatsConfig::default(), 0);
+        let mut o = overlay("exec sleep 30", "overlay-test-clean.json");
+        o.toggle(&mut stats, 0);
+        let pid = o.child.as_ref().unwrap().id();
+        std::thread::sleep(Duration::from_millis(100));
+        assert_eq!(status_field(pid, "SigBlk:"), "0000000000000000");
+        let fds: Vec<String> = fs::read_dir(format!("/proc/{pid}/fd"))
+            .unwrap()
+            .map(|e| e.unwrap().file_name().into_string().unwrap())
+            .collect();
+        assert!(fds.iter().all(|f| ["0", "1", "2"].contains(&f.as_str())), "{fds:?}");
+        assert!(o.cfg.file.exists());
+        let t = Instant::now();
+        o.toggle(&mut stats, 0);
+        assert!(t.elapsed() < EXIT_WAIT, "{:?}", t.elapsed());
+        assert!(!o.shown() && !o.cfg.file.exists());
+        // SAFETY: the dup above
+        unsafe { libc::close(raw) };
+    }
+
+    /// A command that ignores SIGTERM is killed after EXIT_WAIT: hiding never hangs.
+    #[test]
+    fn a_command_ignoring_sigterm_is_killed() {
+        let mut stats = Stats::new(StatsConfig::default(), 0);
+        let mut o = overlay("trap '' TERM; sleep 30; true", "overlay-test-ignore.json");
+        o.toggle(&mut stats, 0);
+        std::thread::sleep(Duration::from_millis(100));
+        let t = Instant::now();
+        o.toggle(&mut stats, 0);
+        let took = t.elapsed();
+        assert!(took >= EXIT_WAIT && took < EXIT_WAIT * 3, "{took:?}");
+        assert!(!o.shown());
+    }
+}
diff -ruN a/src/session/resize.rs b/src/session/resize.rs
--- a/src/session/resize.rs
+++ b/src/session/resize.rs
@@ -0,0 +1,1130 @@
+//! `--resize-settle-ms`: the host window takes a new size at once, the guest
+//! gets it once the window has settled - as QEMU's SDL display does (QEMU tells
+//! its guest a new display size after a second without changes).
+//!
+//! A nested KWin (Wayland backend) turns every configure of its window into an
+//! output mode change: up to one per refresh while the window's edge is
+//! dragged, one per full-screen toggle. Each change replaces the output's
+//! kde_output_device_mode_v2 objects, and KWin frees a removed mode's id at
+//! once; a client that still holds the old object when the next change reuses
+//! the id dies on a protocol error ("not a valid new object id ... mode(n)").
+//! Plasma's shell did, at every drag of the window's edge and at quick
+//! Ctrl+Alt+F (2026-10-08). Resizing a desktop is costly anyway: panels,
+//! wallpaper and windows lay themselves out again at every step.
+//!
+//! While a new size is held back, the proxy acknowledges the host's configure
+//! itself and shows the guest's frames scaled to the new size, aspect ratio
+//! kept and centered (the window's own surface - a one-pixel black buffer in a
+//! nested KWin - is stretched over the rest): it rewrites the guest's window
+//! geometry, the viewport destination of the window's surface and the
+//! positions and viewport destinations of its subsurfaces, and maps pointer,
+//! touch, tablet and drag-and-drop coordinates back into the guest's. Once the
+//! size has not changed for the settle time and no interactive resize is going
+//! on, the last configure goes to the guest, which then renders at that size;
+//! its acknowledgement of it is dropped (the proxy sent one already).
+//!
+//! The proxy's acknowledgement needs a commit. When nothing of the guest is
+//! pending on the window's surfaces, the proxy commits them itself; otherwise
+//! the acknowledgement goes out with the guest's next commit of the window
+//! (after 100 ms without one, the proxy commits anyway).
+//!
+//! Configures that keep the size the guest has (focus changes, mostly) reach
+//! the guest as 0x0 ("your choice"): a nested KWin makes a new output mode for
+//! each configure with a size, the same size included. The proxy commits after
+//! the guest's acknowledgement of one when nothing else is pending, so that the
+//! host applies the new states without waiting for the guest's next frame.
+
+use std::collections::HashMap;
+use std::io;
+use std::os::fd::{AsFd, AsRawFd, BorrowedFd, FromRawFd, OwnedFd};
+
+use log::{debug, info};
+use smallvec::smallvec;
+use wayland_protocols::wp::viewporter::server::__interfaces::WP_VIEWPORT_INTERFACE;
+use wayland_protocols::xdg::shell::server::__interfaces::{XDG_SURFACE_INTERFACE, XDG_TOPLEVEL_INTERFACE};
+use wayland_server::backend::protocol::{Argument, Interface, Message};
+use wayland_server::protocol::__interfaces::{WL_SUBSURFACE_INTERFACE, WL_SURFACE_INTERFACE};
+
+use super::{HostRequest, guest_to_host, request_opcode};
+
+/// xdg_toplevel.state.resizing
+const RESIZING: u32 = 3;
+/// The proxy's acknowledgement waits this long for a commit of the guest.
+const OWE_TIMEOUT_NS: i64 = 100_000_000;
+/// Sizes reach the guest at least this far apart: each one lays the desktop
+/// out again, and two quick ones were what killed Plasma's shell.
+const MIN_GAP_NS: i64 = 1_000_000_000;
+
+fn now_ns() -> i64 {
+    let mut ts = libc::timespec { tv_sec: 0, tv_nsec: 0 };
+    // SAFETY: valid timespec
+    unsafe { libc::clock_gettime(libc::CLOCK_MONOTONIC, &mut ts) };
+    ts.tv_sec as i64 * 1_000_000_000 + ts.tv_nsec as i64
+}
+
+/// `a` is a later configure serial than `b`.
+fn newer(a: u32, b: u32) -> bool {
+    (a.wrapping_sub(b) as i32) > 0
+}
+
+fn event_opcode(interface: &Interface, name: &str) -> u16 {
+    interface
+        .events
+        .iter()
+        .position(|e| e.name == name)
+        .unwrap_or_else(|| panic!("{}.{} does not exist", interface.name, name)) as u16
+}
+
+fn resizing(states: &[u8]) -> bool {
+    states
+        .chunks_exact(4)
+        .any(|c| u32::from_ne_bytes([c[0], c[1], c[2], c[3]]) == RESIZING)
+}
+
+/// From the guest's window to the size the host expects.
+#[derive(Debug, Clone, Copy, PartialEq)]
+struct Map {
+    /// the window size the host expects
+    w: i32,
+    h: i32,
+    /// the guest's content: uniform scale, centered at this offset
+    s: f64,
+    ox: f64,
+    oy: f64,
+    /// the window's own surface: stretched over the whole window
+    sx: f64,
+    sy: f64,
+}
+
+impl Map {
+    fn new(expect: (i32, i32), guest: (i32, i32)) -> Option<Map> {
+        if expect == guest || guest.0 <= 0 || guest.1 <= 0 || expect.0 <= 0 || expect.1 <= 0 {
+            return None;
+        }
+        let sx = expect.0 as f64 / guest.0 as f64;
+        let sy = expect.1 as f64 / guest.1 as f64;
+        let s = sx.min(sy);
+        Some(Map {
+            w: expect.0,
+            h: expect.1,
+            s,
+            ox: (expect.0 as f64 - guest.0 as f64 * s) / 2.0,
+            oy: (expect.1 as f64 - guest.1 as f64 * s) / 2.0,
+            sx,
+            sy,
+        })
+    }
+
+    /// A subsurface's rectangle (its position in its parent, guest coordinates)
+    /// in host coordinates; `direct`: a child of the window's own surface.
+    fn child(&self, (x, y): (i32, i32), (w, h): (i32, i32), direct: bool) -> ((i32, i32), (i32, i32)) {
+        let (ox, oy) = if direct { (self.ox, self.oy) } else { (0.0, 0.0) };
+        let x0 = (ox + x as f64 * self.s).round() as i32;
+        let y0 = (oy + y as f64 * self.s).round() as i32;
+        let x1 = (ox + (x + w) as f64 * self.s).round() as i32;
+        let y1 = (oy + (y + h) as f64 * self.s).round() as i32;
+        ((x0, y0), ((x1 - x0).max(1), (y1 - y0).max(1)))
+    }
+
+    /// The window's own surface: its viewport destination.
+    fn root_dest(&self, (w, h): (i32, i32)) -> (i32, i32) {
+        (((w as f64 * self.sx).round() as i32).max(1), ((h as f64 * self.sy).round() as i32).max(1))
+    }
+
+    /// A point on a surface of the window (host coordinates) in the guest's.
+    fn to_guest(&self, x: f64, y: f64, root: bool) -> (f64, f64) {
+        if root {
+            ((x - self.ox) / self.s, (y - self.oy) / self.s)
+        } else {
+            (x / self.s, y / self.s)
+        }
+    }
+}
+
+#[derive(Default)]
+struct Surf {
+    viewport: Option<u32>,
+    /// the guest's viewport destination
+    dest: Option<(i32, i32)>,
+    /// wl_subsurface and parent, for a subsurface
+    sub: Option<(u32, u32)>,
+    /// the guest's subsurface position
+    position: (i32, i32),
+}
+
+/// A held configure: size, states, serial.
+type Held = (i32, i32, Vec<u8>, u32);
+
+struct Win {
+    xdg_surface: u32,
+    surface: u32,
+    /// the guest's window geometry
+    geometry: Option<(i32, i32, i32, i32)>,
+    /// the last size (not 0x0) sent to the guest
+    told: Option<(i32, i32)>,
+    /// the window size the host expects, once the proxy acknowledged a configure
+    expect: Option<(i32, i32)>,
+    /// xdg_toplevel.configure waiting for its xdg_surface.configure
+    building: Option<(i32, i32, Vec<u8>)>,
+    /// the last configure the proxy acknowledged and the guest has not had yet
+    held: Option<Held>,
+    resizing: bool,
+    /// when `held` goes to the guest
+    deadline: Option<i64>,
+    /// when the guest last got a size held for it
+    last_sent: Option<i64>,
+    /// that size, until the guest shows a frame at it (for the log)
+    sent_size: Option<(i32, i32)>,
+    /// the latest serial the proxy acknowledged itself
+    acked: Option<u32>,
+    /// a serial the proxy acknowledges with the next commit, and until when it waits for the guest's
+    owe: Option<(u32, i64)>,
+    /// the guest has requests on the window's surfaces not committed yet
+    dirty: bool,
+    /// the scaling changed with the guest's own requests: its next commit carries all of the
+    /// window's state again (the guest does not repeat what it thinks the host has - a nested
+    /// KWin's layer keeps its subsurface position, so the offset of a hold stayed after it)
+    restate_pending: bool,
+    /// a 0x0 configure sent to the guest: commit after its acknowledgement
+    commit_after_ack: Option<u32>,
+}
+
+impl Win {
+    fn new(xdg_surface: u32, surface: u32) -> Self {
+        Win {
+            xdg_surface,
+            surface,
+            geometry: None,
+            told: None,
+            expect: None,
+            building: None,
+            held: None,
+            resizing: false,
+            deadline: None,
+            last_sent: None,
+            sent_size: None,
+            acked: None,
+            owe: None,
+            dirty: false,
+            restate_pending: false,
+            commit_after_ack: None,
+        }
+    }
+
+    fn map(&self) -> Option<Map> {
+        let (_, _, w, h) = self.geometry?;
+        Map::new(self.expect?, (w, h))
+    }
+
+    fn next_deadline(&self) -> Option<i64> {
+        match (self.deadline, self.owe.map(|(_, t)| t)) {
+            (Some(a), Some(b)) => Some(a.min(b)),
+            (a, b) => a.or(b),
+        }
+    }
+}
+
+pub(super) struct Resize {
+    settle_ns: i64,
+    timer: Option<OwnedFd>,
+    /// xdg_surface -> wl_surface
+    xdg_surfaces: HashMap<u32, u32>,
+    /// xdg_toplevel -> its window
+    wins: HashMap<u32, Win>,
+    surfaces: HashMap<u32, Surf>,
+    /// wp_viewport -> wl_surface
+    viewports: HashMap<u32, u32>,
+    /// wl_subsurface -> wl_surface
+    subsurfaces: HashMap<u32, u32>,
+    /// other objects made for a surface (presentation feedback, commit timer, ...) -> wl_surface
+    bound: HashMap<u32, u32>,
+    /// pointer, tablet tool, data device -> the surface they are on
+    focus: HashMap<u32, u32>,
+    /// (wl_touch, touch point) -> surface
+    touches: HashMap<(u32, i32), u32>,
+}
+
+impl Resize {
+    /// `settle`: zero leaves configures alone.
+    pub(super) fn new(settle: std::time::Duration) -> io::Result<Self> {
+        let settle_ns = settle.as_nanos() as i64;
+        let timer = if settle_ns > 0 {
+            // SAFETY: plain syscall, result checked
+            let fd = unsafe { libc::timerfd_create(libc::CLOCK_MONOTONIC, libc::TFD_NONBLOCK | libc::TFD_CLOEXEC) };
+            if fd < 0 {
+                return Err(io::Error::last_os_error());
+            }
+            // SAFETY: a new fd we own
+            Some(unsafe { OwnedFd::from_raw_fd(fd) })
+        } else {
+            None
+        };
+        Ok(Resize {
+            settle_ns,
+            timer,
+            xdg_surfaces: HashMap::new(),
+            wins: HashMap::new(),
+            surfaces: HashMap::new(),
+            viewports: HashMap::new(),
+            subsurfaces: HashMap::new(),
+            bound: HashMap::new(),
+            focus: HashMap::new(),
+            touches: HashMap::new(),
+        })
+    }
+
+    /// The settle timer, for the session's epoll; `None` when off.
+    pub(super) fn fd(&self) -> Option<BorrowedFd<'_>> {
+        self.timer.as_ref().map(|t| t.as_fd())
+    }
+
+    fn enabled(&self) -> bool {
+        self.settle_ns > 0
+    }
+
+    /// The window surface a surface belongs to (itself or an ancestor).
+    fn root(&self, mut surface: u32) -> u32 {
+        for _ in 0..16 {
+            match self.surfaces.get(&surface).and_then(|s| s.sub) {
+                Some((_, parent)) => surface = parent,
+                None => break,
+            }
+        }
+        surface
+    }
+
+    fn win_of_surface(&self, surface: u32) -> Option<u32> {
+        let root = self.root(surface);
+        self.wins.iter().find(|(_, w)| w.surface == root).map(|(t, _)| *t)
+    }
+
+    fn win_of_xdg(&self, xdg_surface: u32) -> Option<u32> {
+        self.wins.iter().find(|(_, w)| w.xdg_surface == xdg_surface).map(|(t, _)| *t)
+    }
+
+    /// The surface a request is about, for the pending-state bookkeeping.
+    fn subject(&self, interface: &str, msg: &Message<u32, OwnedFd>) -> Option<u32> {
+        match interface {
+            "wl_surface" => Some(msg.sender_id),
+            "wp_viewport" => self.viewports.get(&msg.sender_id).copied(),
+            "wl_subsurface" => self.subsurfaces.get(&msg.sender_id).copied(),
+            _ => self.bound.get(&msg.sender_id).copied().or_else(|| {
+                msg.args.iter().find_map(|a| match a {
+                    Argument::Object(id) if self.wins.values().any(|w| w.surface == *id) || self.surfaces.contains_key(id) => {
+                        Some(*id)
+                    }
+                    _ => None,
+                })
+            }),
+        }
+    }
+
+    /// The proxy's requests (host ids) that show the guest's current state as
+    /// the host expects it: window geometry, viewport destinations, subsurface
+    /// positions and the subsurfaces' commits, then `ack` and, with
+    /// `commit_root`, the window surface's commit.
+    fn restate(&self, toplevel: u32, ack: Option<u32>, commit_root: bool, out: &mut Vec<HostRequest>) {
+        let Some(win) = self.wins.get(&toplevel) else { return };
+        let map = win.map();
+        if let Some((x, y, w, h)) = win.geometry {
+            let (w, h) = map.map_or((w, h), |m| (m.w, m.h));
+            out.push(Message {
+                sender_id: guest_to_host(win.xdg_surface),
+                opcode: request_opcode(&XDG_SURFACE_INTERFACE, "set_window_geometry"),
+                args: smallvec![Argument::Int(x), Argument::Int(y), Argument::Int(w), Argument::Int(h)],
+            });
+        }
+        if let Some(surf) = self.surfaces.get(&win.surface) {
+            if let (Some(viewport), Some(dest)) = (surf.viewport, surf.dest) {
+                let (w, h) = map.map_or(dest, |m| m.root_dest(dest));
+                out.push(set_destination(viewport, w, h));
+            }
+        }
+        // the subsurfaces, deepest first: their state is cached until their parent's commit
+        let mut children: Vec<(usize, u32)> = self
+            .surfaces
+            .iter()
+            .filter(|(id, s)| s.sub.is_some() && self.root(**id) == win.surface)
+            .map(|(id, _)| (self.depth(*id), *id))
+            .collect();
+        children.sort_by(|a, b| b.cmp(a));
+        for (depth, id) in children {
+            let surf = &self.surfaces[&id];
+            let Some((sub, _)) = surf.sub else { continue };
+            let (position, dest) = match (map, surf.dest) {
+                (Some(m), Some(dest)) => {
+                    let (p, d) = m.child(surf.position, dest, depth == 1);
+                    (p, Some(d))
+                }
+                (Some(m), None) => (m.child(surf.position, (1, 1), depth == 1).0, None),
+                (None, dest) => (surf.position, dest),
+            };
+            out.push(Message {
+                sender_id: guest_to_host(sub),
+                opcode: request_opcode(&WL_SUBSURFACE_INTERFACE, "set_position"),
+                args: smallvec![Argument::Int(position.0), Argument::Int(position.1)],
+            });
+            if let (Some(viewport), Some((w, h))) = (surf.viewport, dest) {
+                out.push(set_destination(viewport, w, h));
+            }
+            out.push(commit(id));
+        }
+        if let Some(serial) = ack {
+            out.push(Message {
+                sender_id: guest_to_host(win.xdg_surface),
+                opcode: request_opcode(&XDG_SURFACE_INTERFACE, "ack_configure"),
+                args: smallvec![Argument::Uint(serial)],
+            });
+        }
+        if commit_root {
+            out.push(commit(win.surface));
+        }
+    }
+
+    fn depth(&self, mut surface: u32) -> usize {
+        let mut depth = 0;
+        while let Some((_, parent)) = self.surfaces.get(&surface).and_then(|s| s.sub) {
+            depth += 1;
+            surface = parent;
+            if depth > 16 {
+                break;
+            }
+        }
+        depth
+    }
+
+    /// The proxy acknowledges `serial` for the guest: at once if nothing of the
+    /// guest is pending on the window, else with its next commit.
+    fn acknowledge(&mut self, toplevel: u32, serial: u32, now: i64, out: &mut Vec<HostRequest>) {
+        let Some(win) = self.wins.get_mut(&toplevel) else { return };
+        win.acked = Some(serial);
+        if win.dirty {
+            win.owe = Some((serial, now + OWE_TIMEOUT_NS));
+        } else {
+            win.owe = None;
+            win.restate_pending = false;
+            self.restate(toplevel, Some(serial), true, out);
+        }
+    }
+
+    /// A guest request (guest ids) about to be forwarded, after the requests
+    /// before it; may rewrite it. `pre` and `post` receive the proxy's requests
+    /// (host ids) to send before and after it. Returns false to drop it.
+    pub(super) fn on_request(
+        &mut self,
+        interface: &str,
+        request: &str,
+        msg: &mut Message<u32, OwnedFd>,
+        pre: &mut Vec<HostRequest>,
+        post: &mut Vec<HostRequest>,
+    ) -> bool {
+        if !self.enabled() {
+            return true;
+        }
+        let sender = msg.sender_id;
+        // the guest's pending state on a window's surfaces
+        let committed_root = interface == "wl_surface" && request == "commit" && self.wins.values().any(|w| w.surface == sender);
+        if !committed_root && !(interface == "xdg_surface" && request == "ack_configure") {
+            if let Some(t) = self.subject(interface, msg).and_then(|s| self.win_of_surface(s)) {
+                self.wins.get_mut(&t).unwrap().dirty = true;
+            }
+        }
+        match (interface, request) {
+            ("xdg_wm_base", "get_xdg_surface") => {
+                if let [Argument::NewId(xdg), Argument::Object(surface)] = msg.args[..] {
+                    self.xdg_surfaces.insert(xdg, surface);
+                }
+            }
+            ("xdg_surface", "get_toplevel") => {
+                if let (Some(Argument::NewId(toplevel)), Some(&surface)) = (msg.args.first(), self.xdg_surfaces.get(&sender)) {
+                    self.wins.insert(*toplevel, Win::new(sender, surface));
+                }
+            }
+            ("xdg_surface", "set_window_geometry") => {
+                if let (Some(t), [Argument::Int(x), Argument::Int(y), Argument::Int(w), Argument::Int(h)]) =
+                    (self.win_of_xdg(sender), &msg.args[..])
+                {
+                    let win = self.wins.get_mut(&t).unwrap();
+                    let before = win.map();
+                    win.geometry = Some((*x, *y, *w, *h));
+                    win.dirty = true;
+                    if win.sent_size == Some((*w, *h)) {
+                        win.sent_size = None;
+                        if let Some(t0) = win.last_sent {
+                            info!("resize: the guest shows {w}x{h} {} ms after it got the size", (now_ns() - t0) / 1_000_000);
+                        }
+                    }
+                    if win.expect == Some((*w, *h)) {
+                        // the guest renders at the size the host expects: nothing to scale any more
+                        win.expect = None;
+                    }
+                    let after = win.map();
+                    if after != before {
+                        win.restate_pending = true;
+                    }
+                    if let Some(m) = after {
+                        msg.args[2] = Argument::Int(m.w);
+                        msg.args[3] = Argument::Int(m.h);
+                    }
+                }
+            }
+            ("xdg_surface", "ack_configure") => {
+                if let (Some(t), [Argument::Uint(serial)]) = (self.win_of_xdg(sender), &msg.args[..]) {
+                    let serial = *serial;
+                    let win = self.wins.get_mut(&t).unwrap();
+                    if win.acked.is_some_and(|a| !newer(serial, a)) {
+                        debug!("resize: the guest acknowledges configure {serial}, the proxy did already");
+                        return false;
+                    }
+                    let was_dirty = win.dirty;
+                    win.dirty = true;
+                    if win.commit_after_ack.is_some_and(|s| !newer(s, serial)) {
+                        win.commit_after_ack = None;
+                        if !was_dirty {
+                            post.push(commit(win.surface));
+                            win.dirty = false;
+                        }
+                    }
+                }
+            }
+            ("xdg_toplevel", "destroy") => {
+                self.wins.remove(&sender);
+            }
+            ("xdg_surface", "destroy") => {
+                self.xdg_surfaces.remove(&sender);
+                self.wins.retain(|_, w| w.xdg_surface != sender);
+            }
+            ("wp_viewporter", "get_viewport") => {
+                if let [Argument::NewId(viewport), Argument::Object(surface)] = msg.args[..] {
+                    self.viewports.insert(viewport, surface);
+                    let surf = self.surfaces.entry(surface).or_default();
+                    surf.viewport = Some(viewport);
+                    surf.dest = None;
+                }
+            }
+            ("wp_viewport", "set_destination") => {
+                if let (Some(&surface), [Argument::Int(w), Argument::Int(h)]) = (self.viewports.get(&sender), &msg.args[..]) {
+                    let dest = (*w > 0 && *h > 0).then_some((*w, *h));
+                    self.surfaces.entry(surface).or_default().dest = dest;
+                    if let (Some(dest), Some(t)) = (dest, self.win_of_surface(surface)) {
+                        let win = &self.wins[&t];
+                        if let Some(m) = win.map() {
+                            let (w, h) = if surface == win.surface {
+                                m.root_dest(dest)
+                            } else {
+                                let surf = &self.surfaces[&surface];
+                                m.child(surf.position, dest, self.depth(surface) == 1).1
+                            };
+                            msg.args[0] = Argument::Int(w);
+                            msg.args[1] = Argument::Int(h);
+                        }
+                    }
+                }
+            }
+            ("wp_viewport", "destroy") => {
+                if let Some(surface) = self.viewports.remove(&sender) {
+                    if let Some(surf) = self.surfaces.get_mut(&surface) {
+                        surf.viewport = None;
+                        surf.dest = None;
+                    }
+                }
+            }
+            ("wl_subcompositor", "get_subsurface") => {
+                if let [Argument::NewId(sub), Argument::Object(surface), Argument::Object(parent)] = msg.args[..] {
+                    self.subsurfaces.insert(sub, surface);
+                    let surf = self.surfaces.entry(surface).or_default();
+                    surf.sub = Some((sub, parent));
+                    surf.position = (0, 0);
+                }
+            }
+            ("wl_subsurface", "set_position") => {
+                if let (Some(&surface), [Argument::Int(x), Argument::Int(y)]) = (self.subsurfaces.get(&sender), &msg.args[..]) {
+                    self.surfaces.entry(surface).or_default().position = (*x, *y);
+                    if let Some(t) = self.win_of_surface(surface) {
+                        if let Some(m) = self.wins[&t].map() {
+                            let surf = &self.surfaces[&surface];
+                            let (p, _) = m.child(surf.position, surf.dest.unwrap_or((1, 1)), self.depth(surface) == 1);
+                            msg.args[0] = Argument::Int(p.0);
+                            msg.args[1] = Argument::Int(p.1);
+                        }
+                    }
+                }
+            }
+            ("wl_subsurface", "destroy") => {
+                if let Some(surface) = self.subsurfaces.remove(&sender) {
+                    if let Some(surf) = self.surfaces.get_mut(&surface) {
+                        surf.sub = None;
+                    }
+                }
+            }
+            ("wl_surface", "commit") if committed_root => {
+                let t = self.win_of_surface(sender).unwrap();
+                let win = self.wins.get_mut(&t).unwrap();
+                let restate = std::mem::take(&mut win.restate_pending);
+                if let Some((serial, _)) = win.owe.take() {
+                    debug!("resize: configure {serial} acknowledged with the guest's commit");
+                    self.restate(t, Some(serial), false, pre);
+                } else if restate {
+                    debug!("resize: the scaling changed: the window's state again");
+                    self.restate(t, None, false, pre);
+                }
+                self.wins.get_mut(&t).unwrap().dirty = false;
+                self.rearm();
+            }
+            ("wl_surface", "destroy") => {
+                self.surfaces.remove(&sender);
+                self.wins.retain(|_, w| w.surface != sender);
+                self.focus.retain(|_, s| *s != sender);
+                self.touches.retain(|_, s| *s != sender);
+                self.bound.retain(|_, s| *s != sender);
+            }
+            (_, "destroy") => {
+                self.bound.remove(&sender);
+            }
+            // a presentation feedback has no requests and goes away with its last event
+            ("wp_presentation", "feedback") => {}
+            _ => {
+                // objects made for a surface: their requests are that surface's pending state
+                let new = msg.args.iter().find_map(|a| match a {
+                    Argument::NewId(id) => Some(*id),
+                    _ => None,
+                });
+                let surface = msg.args.iter().find_map(|a| match a {
+                    Argument::Object(id) if self.win_of_surface(*id).is_some() => Some(*id),
+                    _ => None,
+                });
+                if let (Some(new), Some(surface)) = (new, surface) {
+                    self.bound.insert(new, surface);
+                }
+            }
+        }
+        true
+    }
+
+    /// A host event (guest ids, the other hooks applied) about to reach the
+    /// guest. `before` receives events (guest ids) to deliver ahead of it,
+    /// `out` the proxy's requests (host ids) to send now. Returns true to keep
+    /// it from the guest.
+    pub(super) fn on_event(
+        &mut self,
+        interface: &str,
+        event: &str,
+        msg: &mut Message<u32, OwnedFd>,
+        before: &mut Vec<Message<u32, OwnedFd>>,
+        out: &mut Vec<HostRequest>,
+    ) -> bool {
+        if !self.enabled() {
+            return false;
+        }
+        let sender = msg.sender_id;
+        match (interface, event) {
+            ("xdg_toplevel", "configure") => {
+                if let (Some(win), [Argument::Int(w), Argument::Int(h), Argument::Array(states)]) =
+                    (self.wins.get_mut(&sender), &msg.args[..])
+                {
+                    // goes to the guest with its xdg_surface.configure, or not at all
+                    win.building = Some((*w, *h, states.to_vec()));
+                    return true;
+                }
+            }
+            ("xdg_surface", "configure") => {
+                if let (Some(t), [Argument::Uint(serial)]) = (self.win_of_xdg(sender), &msg.args[..]) {
+                    return self.configure(t, *serial, now_ns(), before, out);
+                }
+            }
+            ("wl_pointer", "enter") | ("wl_data_device", "enter") => {
+                if let Some(Argument::Object(surface)) = msg.args.get(1) {
+                    self.focus.insert(sender, *surface);
+                    self.scale_point(*surface, msg, 2);
+                }
+            }
+            ("wl_pointer", "leave") | ("wl_data_device", "leave") | ("wl_data_device", "drop") | ("zwp_tablet_tool_v2", "proximity_out") => {
+                self.focus.remove(&sender);
+            }
+            ("wl_pointer", "motion") | ("wl_data_device", "motion") => {
+                if let Some(&surface) = self.focus.get(&sender) {
+                    self.scale_point(surface, msg, 1);
+                }
+            }
+            ("zwp_tablet_tool_v2", "proximity_in") => {
+                if let Some(Argument::Object(surface)) = msg.args.get(2) {
+                    self.focus.insert(sender, *surface);
+                }
+            }
+            ("zwp_tablet_tool_v2", "motion") => {
+                if let Some(&surface) = self.focus.get(&sender) {
+                    self.scale_point(surface, msg, 0);
+                }
+            }
+            ("wl_touch", "down") => {
+                if let (Some(Argument::Object(surface)), Some(Argument::Int(id))) = (msg.args.get(2), msg.args.get(3)) {
+                    let surface = *surface;
+                    self.touches.insert((sender, *id), surface);
+                    self.scale_point(surface, msg, 4);
+                }
+            }
+            ("wl_touch", "motion") => {
+                if let Some(Argument::Int(id)) = msg.args.get(1) {
+                    if let Some(&surface) = self.touches.get(&(sender, *id)) {
+                        self.scale_point(surface, msg, 2);
+                    }
+                }
+            }
+            ("wl_touch", "up") => {
+                if let Some(Argument::Int(id)) = msg.args.get(2) {
+                    self.touches.remove(&(sender, *id));
+                }
+            }
+            ("wl_touch", "cancel") => {
+                self.touches.retain(|(touch, _), _| *touch != sender);
+            }
+            _ => {}
+        }
+        false
+    }
+
+    /// Host coordinates at args[at], args[at + 1] (wl_fixed) into the guest's.
+    fn scale_point(&self, surface: u32, msg: &mut Message<u32, OwnedFd>, at: usize) {
+        let Some(t) = self.win_of_surface(surface) else { return };
+        let win = &self.wins[&t];
+        let Some(m) = win.map() else { return };
+        if let (Some(Argument::Fixed(x)), Some(Argument::Fixed(y))) = (msg.args.get(at), msg.args.get(at + 1)) {
+            let (gx, gy) = m.to_guest(*x as f64 / 256.0, *y as f64 / 256.0, surface == win.surface);
+            msg.args[at] = Argument::Fixed((gx * 256.0).round() as i32);
+            msg.args[at + 1] = Argument::Fixed((gy * 256.0).round() as i32);
+        }
+    }
+
+    /// The host's xdg_surface.configure of a window: to the guest now (with its
+    /// xdg_toplevel.configure ahead of it), or acknowledged by the proxy and held.
+    fn configure(
+        &mut self,
+        toplevel: u32,
+        serial: u32,
+        now: i64,
+        before: &mut Vec<Message<u32, OwnedFd>>,
+        out: &mut Vec<HostRequest>,
+    ) -> bool {
+        let win = self.wins.get_mut(&toplevel).unwrap();
+        let Some((w, h, states)) = win.building.take() else {
+            return false;
+        };
+        let was_resizing = std::mem::replace(&mut win.resizing, resizing(&states));
+        let size = (w, h);
+        // the size the guest was last told, or else the one it shows
+        let told = win.told.or(win.geometry.map(|(_, _, w, h)| (w, h)));
+        if win.geometry.is_none() || told.is_none() || size == (0, 0) {
+            // before the window is up, or the guest's choice: as it comes
+            if size != (0, 0) {
+                win.told = Some(size);
+            }
+            before.push(toplevel_configure(toplevel, size, states));
+            return false;
+        }
+        win.told = told;
+        if Some(size) == win.told {
+            if win.expect.is_none_or(|e| e == size) && win.held.is_none() {
+                // nothing to resize: the states only
+                win.commit_after_ack = Some(serial);
+                before.push(toplevel_configure(toplevel, (0, 0), states));
+                return false;
+            }
+            // back to the size the guest has, before it got another one
+            debug!("resize: back to {}x{} (configure {serial})", w, h);
+            win.expect = Some(size);
+            win.held = None;
+            win.deadline = None;
+            self.acknowledge(toplevel, serial, now, out);
+            self.rearm();
+            return true;
+        }
+        // a new size: the host gets it now, the guest once it settles
+        if win.expect != Some(size) || (was_resizing && !win.resizing) || win.deadline.is_none() {
+            let not_before = win.last_sent.map_or(i64::MIN, |t| t + MIN_GAP_NS);
+            win.deadline = Some((now + self.settle_ns).max(not_before));
+        }
+        if win.expect != Some(size) {
+            debug!("resize: {}x{} held for the guest (configure {serial}, resizing {})", w, h, win.resizing);
+        }
+        win.expect = Some(size);
+        win.held = Some((w, h, states, serial));
+        self.acknowledge(toplevel, serial, now, out);
+        self.rearm();
+        true
+    }
+
+    /// The settle timer: held sizes that settled go to the guest (`to_guest`,
+    /// guest ids); acknowledgements that waited too long for the guest's commit
+    /// go out with a commit of the proxy (`out`, host ids).
+    pub(super) fn dispatch(&mut self, out: &mut Vec<HostRequest>, to_guest: &mut Vec<Message<u32, OwnedFd>>) {
+        let Some(timer) = &self.timer else { return };
+        let mut expirations = [0u8; 8];
+        // SAFETY: reading the expiration count of a non-blocking timerfd
+        let n = unsafe { libc::read(timer.as_raw_fd(), expirations.as_mut_ptr().cast(), 8) };
+        if n != 8 {
+            return;
+        }
+        self.fire(now_ns(), out, to_guest);
+    }
+
+    fn fire(&mut self, now: i64, out: &mut Vec<HostRequest>, to_guest: &mut Vec<Message<u32, OwnedFd>>) {
+        let toplevels: Vec<u32> = self.wins.keys().copied().collect();
+        for t in toplevels {
+            let win = self.wins.get_mut(&t).unwrap();
+            if let Some((serial, until)) = win.owe {
+                if until <= now {
+                    debug!("resize: no commit of the guest for configure {serial}: the proxy commits");
+                    win.owe = None;
+                    win.dirty = false;
+                    self.restate(t, Some(serial), true, out);
+                }
+            }
+            let win = self.wins.get_mut(&t).unwrap();
+            if !win.deadline.is_some_and(|d| d <= now) {
+                continue;
+            }
+            if win.resizing {
+                win.deadline = Some(now + self.settle_ns);
+                continue;
+            }
+            win.deadline = None;
+            win.last_sent = Some(now);
+            if let Some((w, h, states, serial)) = win.held.take() {
+                let size = if win.told == Some((w, h)) { (0, 0) } else { (w, h) };
+                info!("resize: the window settled at {w}x{h}: the guest resizes");
+                if size != (0, 0) {
+                    win.told = Some(size);
+                    win.sent_size = Some(size);
+                }
+                to_guest.push(toplevel_configure(t, size, states));
+                to_guest.push(Message {
+                    sender_id: win.xdg_surface,
+                    opcode: event_opcode(&XDG_SURFACE_INTERFACE, "configure"),
+                    args: smallvec![Argument::Uint(serial)],
+                });
+            }
+        }
+        self.rearm();
+    }
+
+    fn rearm(&self) {
+        let Some(timer) = &self.timer else { return };
+        let next = self.wins.values().filter_map(Win::next_deadline).min();
+        let value = match next {
+            // 0 would disarm it: a deadline already past fires at once
+            Some(t) => libc::timespec {
+                tv_sec: (t / 1_000_000_000) as libc::time_t,
+                tv_nsec: (t % 1_000_000_000).max(1) as libc::c_long,
+            },
+            None => libc::timespec { tv_sec: 0, tv_nsec: 0 },
+        };
+        let spec = libc::itimerspec {
+            it_interval: libc::timespec { tv_sec: 0, tv_nsec: 0 },
+            it_value: value,
+        };
+        // SAFETY: valid timerfd and spec
+        unsafe { libc::timerfd_settime(timer.as_raw_fd(), libc::TFD_TIMER_ABSTIME, &spec, std::ptr::null_mut()) };
+    }
+}
+
+fn toplevel_configure(toplevel: u32, (w, h): (i32, i32), states: Vec<u8>) -> Message<u32, OwnedFd> {
+    Message {
+        sender_id: toplevel,
+        opcode: event_opcode(&XDG_TOPLEVEL_INTERFACE, "configure"),
+        args: smallvec![Argument::Int(w), Argument::Int(h), Argument::Array(Box::new(states))],
+    }
+}
+
+fn set_destination(viewport: u32, w: i32, h: i32) -> HostRequest {
+    Message {
+        sender_id: guest_to_host(viewport),
+        opcode: request_opcode(&WP_VIEWPORT_INTERFACE, "set_destination"),
+        args: smallvec![Argument::Int(w), Argument::Int(h)],
+    }
+}
+
+fn commit(surface: u32) -> HostRequest {
+    Message {
+        sender_id: guest_to_host(surface),
+        opcode: request_opcode(&WL_SURFACE_INTERFACE, "commit"),
+        args: smallvec![],
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const WM: u32 = 4;
+    const SURFACE: u32 = 3;
+    const XDG: u32 = 10;
+    const TOPLEVEL: u32 = 11;
+    const VIEWPORT: u32 = 12;
+    const LAYER: u32 = 13;
+    const SUB: u32 = 14;
+    const LAYER_VIEWPORT: u32 = 15;
+    const POINTER: u32 = 20;
+    const MS: i64 = 1_000_000;
+
+    fn msg(sender: u32, args: smallvec::SmallVec<[Argument<u32, OwnedFd>; 4]>) -> Message<u32, OwnedFd> {
+        Message { sender_id: sender, opcode: 0, args }
+    }
+
+    fn req(r: &mut Resize, interface: &str, request: &str, sender: u32, args: smallvec::SmallVec<[Argument<u32, OwnedFd>; 4]>) -> (bool, Message<u32, OwnedFd>, Vec<HostRequest>, Vec<HostRequest>) {
+        let mut m = msg(sender, args);
+        let (mut pre, mut post) = (Vec::new(), Vec::new());
+        let fwd = r.on_request(interface, request, &mut m, &mut pre, &mut post);
+        (fwd, m, pre, post)
+    }
+
+    /// A nested KWin's frame: window geometry and viewport of its surface, the
+    /// primary layer (a subsurface with a viewport) committed, then its surface.
+    fn frame(r: &mut Resize, w: i32, h: i32) -> Vec<Message<u32, OwnedFd>> {
+        let mut sent = Vec::new();
+        let mut each = |r: &mut Resize, interface: &str, request: &str, sender: u32, args| {
+            let (fwd, m, pre, _) = req(r, interface, request, sender, args);
+            assert!(fwd);
+            sent.extend(pre.into_iter().map(|p| Message { sender_id: p.sender_id, opcode: p.opcode, args: p.args }));
+            sent.push(m);
+        };
+        each(r, "xdg_surface", "set_window_geometry", XDG, smallvec![Argument::Int(0), Argument::Int(0), Argument::Int(w), Argument::Int(h)]);
+        each(r, "wp_viewport", "set_destination", VIEWPORT, smallvec![Argument::Int(w), Argument::Int(h)]);
+        each(r, "wp_viewport", "set_destination", LAYER_VIEWPORT, smallvec![Argument::Int(w), Argument::Int(h)]);
+        each(r, "wl_subsurface", "set_position", SUB, smallvec![Argument::Int(0), Argument::Int(0)]);
+        each(r, "wl_surface", "commit", LAYER, smallvec![]);
+        each(r, "wl_surface", "commit", SURFACE, smallvec![]);
+        sent
+    }
+
+    fn configure(r: &mut Resize, w: i32, h: i32, states: &[u32], serial: u32, now: i64) -> (bool, Vec<Message<u32, OwnedFd>>, Vec<HostRequest>) {
+        let mut before = Vec::new();
+        let mut out = Vec::new();
+        let states: Vec<u8> = states.iter().flat_map(|s| s.to_ne_bytes()).collect();
+        let mut tc = msg(TOPLEVEL, smallvec![Argument::Int(w), Argument::Int(h), Argument::Array(Box::new(states))]);
+        assert!(r.on_event("xdg_toplevel", "configure", &mut tc, &mut before, &mut out), "the toplevel part waits");
+        let held = r.configure(TOPLEVEL, serial, now, &mut before, &mut out);
+        (held, before, out)
+    }
+
+    fn window(settle_ms: u64) -> Resize {
+        let mut r = Resize::new(std::time::Duration::from_millis(settle_ms)).unwrap();
+        req(&mut r, "xdg_wm_base", "get_xdg_surface", WM, smallvec![Argument::NewId(XDG), Argument::Object(SURFACE)]);
+        req(&mut r, "xdg_surface", "get_toplevel", XDG, smallvec![Argument::NewId(TOPLEVEL)]);
+        req(&mut r, "wp_viewporter", "get_viewport", 5, smallvec![Argument::NewId(VIEWPORT), Argument::Object(SURFACE)]);
+        req(&mut r, "wl_subcompositor", "get_subsurface", 6, smallvec![Argument::NewId(SUB), Argument::Object(LAYER), Argument::Object(SURFACE)]);
+        req(&mut r, "wp_viewporter", "get_viewport", 5, smallvec![Argument::NewId(LAYER_VIEWPORT), Argument::Object(LAYER)]);
+        // the first configure goes to the guest as it is
+        let (held, before, out) = configure(&mut r, 1280, 800, &[], 1, 0);
+        assert!(!held && out.is_empty());
+        assert!(matches!(before[0].args[..], [Argument::Int(1280), Argument::Int(800), _]));
+        assert!(req(&mut r, "xdg_surface", "ack_configure", XDG, smallvec![Argument::Uint(1)]).0);
+        frame(&mut r, 1280, 800);
+        r
+    }
+
+    fn named(m: &HostRequest, interface: &Interface, request: &str) -> bool {
+        m.opcode == request_opcode(interface, request)
+    }
+
+    fn ints(m: &HostRequest) -> Vec<i32> {
+        m.args.iter().filter_map(|a| if let Argument::Int(v) = a { Some(*v) } else { None }).collect()
+    }
+
+    #[test]
+    fn off_leaves_everything_alone() {
+        let mut r = Resize::new(std::time::Duration::ZERO).unwrap();
+        assert!(r.fd().is_none());
+        let mut m = msg(TOPLEVEL, smallvec![Argument::Int(1), Argument::Int(1), Argument::Array(Box::new(vec![]))]);
+        assert!(!r.on_event("xdg_toplevel", "configure", &mut m, &mut Vec::new(), &mut Vec::new()));
+    }
+
+    #[test]
+    fn same_size_reaches_the_guest_as_0x0_and_is_committed_after_its_ack() {
+        let mut r = window(500);
+        let (held, before, out) = configure(&mut r, 1280, 800, &[4], 2, 0);
+        assert!(!held && out.is_empty());
+        assert!(matches!(before[0].args[..], [Argument::Int(0), Argument::Int(0), _]));
+        let (fwd, _, _, post) = req(&mut r, "xdg_surface", "ack_configure", XDG, smallvec![Argument::Uint(2)]);
+        assert!(fwd);
+        assert_eq!(post.len(), 1);
+        assert!(named(&post[0], &WL_SURFACE_INTERFACE, "commit") && post[0].sender_id == guest_to_host(SURFACE));
+    }
+
+    #[test]
+    fn a_new_size_is_shown_scaled_at_once_and_reaches_the_guest_when_settled() {
+        let mut r = window(500);
+        // full screen: 1920x1080 for a 1280x800 guest -> scale 1.35, 864 px wide, 0 down, 108 in
+        let (held, before, out) = configure(&mut r, 1920, 1080, &[2], 3, 0);
+        assert!(held && before.is_empty(), "nothing for the guest yet");
+        let geom = out.iter().find(|m| named(m, &XDG_SURFACE_INTERFACE, "set_window_geometry")).unwrap();
+        assert_eq!(ints(geom), vec![0, 0, 1920, 1080]);
+        let root_dest = out.iter().find(|m| m.sender_id == guest_to_host(VIEWPORT)).unwrap();
+        assert_eq!(ints(root_dest), vec![1920, 1080]);
+        let pos = out.iter().find(|m| m.sender_id == guest_to_host(SUB)).unwrap();
+        assert_eq!(ints(pos), vec![96, 0]);
+        let dest = out.iter().find(|m| m.sender_id == guest_to_host(LAYER_VIEWPORT)).unwrap();
+        assert_eq!(ints(dest), vec![1728, 1080]);
+        let order: Vec<&str> = out
+            .iter()
+            .filter_map(|m| {
+                if named(m, &XDG_SURFACE_INTERFACE, "ack_configure") {
+                    Some("ack")
+                } else if named(m, &WL_SURFACE_INTERFACE, "commit") && m.args.is_empty() && m.sender_id == guest_to_host(LAYER) {
+                    Some("layer")
+                } else if m.sender_id == guest_to_host(SURFACE) {
+                    Some("root")
+                } else {
+                    None
+                }
+            })
+            .collect();
+        assert_eq!(order, vec!["layer", "ack", "root"]);
+
+        // the guest's next frame, still 1280x800, is rewritten the same way
+        let sent = frame(&mut r, 1280, 800);
+        assert_eq!(ints(&sent[0]), vec![0, 0, 1920, 1080]);
+        assert_eq!(ints(&sent[2]), vec![1728, 1080]);
+        assert_eq!(ints(&sent[3]), vec![96, 0]);
+
+        // the pointer at the window's center is at the guest's center
+        let mut enter = msg(POINTER, smallvec![Argument::Uint(9), Argument::Object(LAYER), Argument::Fixed(864 * 256), Argument::Fixed(540 * 256)]);
+        assert!(!r.on_event("wl_pointer", "enter", &mut enter, &mut Vec::new(), &mut Vec::new()));
+        assert!(matches!(enter.args[..], [_, _, Argument::Fixed(x), Argument::Fixed(y)] if x == 640 * 256 && y == 400 * 256));
+        let mut motion = msg(POINTER, smallvec![Argument::Uint(0), Argument::Fixed(0), Argument::Fixed(1080 * 256)]);
+        r.on_event("wl_pointer", "motion", &mut motion, &mut Vec::new(), &mut Vec::new());
+        assert!(matches!(motion.args[..], [_, Argument::Fixed(0), Argument::Fixed(y)] if y == 800 * 256));
+
+        // not settled yet
+        let (mut out, mut to_guest) = (Vec::new(), Vec::new());
+        r.fire(499 * MS, &mut out, &mut to_guest);
+        assert!(to_guest.is_empty());
+        r.fire(500 * MS, &mut out, &mut to_guest);
+        assert_eq!(to_guest.len(), 2);
+        assert!(matches!(to_guest[0].args[..], [Argument::Int(1920), Argument::Int(1080), _]));
+        assert!(matches!(to_guest[1].args[..], [Argument::Uint(3)]));
+        // its acknowledgement is the proxy's already
+        assert!(!req(&mut r, "xdg_surface", "ack_configure", XDG, smallvec![Argument::Uint(3)]).0);
+        // a frame at the new size goes through untouched
+        let sent = frame(&mut r, 1920, 1080);
+        assert_eq!(ints(&sent[0]), vec![0, 0, 1920, 1080]);
+        assert_eq!(ints(&sent[2]), vec![1920, 1080]);
+        assert_eq!(ints(&sent[3]), vec![0, 0]);
+        let mut motion = msg(POINTER, smallvec![Argument::Uint(0), Argument::Fixed(5 * 256), Argument::Fixed(7 * 256)]);
+        r.on_event("wl_pointer", "motion", &mut motion, &mut Vec::new(), &mut Vec::new());
+        assert!(matches!(motion.args[..], [_, Argument::Fixed(x), Argument::Fixed(y)] if x == 5 * 256 && y == 7 * 256));
+    }
+
+    /// A nested KWin's layer (KWayland) sends its subsurface position only when it changes: at
+    /// (0, 0) never again. The offset of a hold must not stay once the guest has the new size.
+    #[test]
+    fn the_hold_leaves_nothing_behind_when_the_guest_skips_unchanged_requests() {
+        let mut r = window(200);
+        // windowed 1280x800 -> 1600x800 wide: content at x 160, unscaled height
+        let (_, _, out) = configure(&mut r, 1600, 800, &[], 3, 0);
+        let pos = out.iter().find(|m| m.sender_id == guest_to_host(SUB)).unwrap();
+        assert_eq!(ints(pos), vec![160, 0]);
+        let (mut out, mut to_guest) = (Vec::new(), Vec::new());
+        r.fire(200 * MS, &mut out, &mut to_guest);
+        assert!(!req(&mut r, "xdg_surface", "ack_configure", XDG, smallvec![Argument::Uint(3)]).0);
+        // the guest's frame at the new size, without set_position (unchanged for it)
+        let mut sent = Vec::new();
+        for (interface, request, sender, args) in [
+            ("xdg_surface", "set_window_geometry", XDG, smallvec![Argument::Int(0), Argument::Int(0), Argument::Int(1600), Argument::Int(800)]),
+            ("wp_viewport", "set_destination", VIEWPORT, smallvec![Argument::Int(1600), Argument::Int(800)]),
+            ("wp_viewport", "set_destination", LAYER_VIEWPORT, smallvec![Argument::Int(1600), Argument::Int(800)]),
+            ("wl_surface", "commit", LAYER, smallvec![]),
+            ("wl_surface", "commit", SURFACE, smallvec![]),
+        ] {
+            let (fwd, mut m, pre, _) = req(&mut r, interface, request, sender, args);
+            assert!(fwd);
+            sent.extend(pre);
+            // the guest's own request in host ids, like the proxy's
+            m.sender_id = guest_to_host(m.sender_id);
+            sent.push(m);
+        }
+        // before the window's commit, the layer is put back at (0, 0) and committed
+        let commit_at = sent.iter().rposition(|m| m.sender_id == guest_to_host(SURFACE)).unwrap();
+        let pos_at = sent.iter().rposition(|m| m.sender_id == guest_to_host(SUB)).expect("position restated");
+        assert!(pos_at < commit_at);
+        assert_eq!(ints(&sent[pos_at]), vec![0, 0]);
+        let dest = sent.iter().rfind(|m| m.sender_id == guest_to_host(LAYER_VIEWPORT)).unwrap();
+        assert_eq!(ints(dest), vec![1600, 800]);
+        // and only once: the next frame has the guest's own requests only (guest ids)
+        let sent = frame(&mut r, 1600, 800);
+        assert!(sent.iter().all(|m| m.sender_id < guest_to_host(2)), "nothing of the proxy's");
+    }
+
+    #[test]
+    fn toggling_back_before_it_settles_never_resizes_the_guest() {
+        let mut r = window(500);
+        configure(&mut r, 1920, 1080, &[2], 3, 0);
+        let (held, before, out) = configure(&mut r, 1280, 800, &[], 4, 100 * MS);
+        assert!(held && before.is_empty());
+        let geom = out.iter().find(|m| named(m, &XDG_SURFACE_INTERFACE, "set_window_geometry")).unwrap();
+        assert_eq!(ints(geom), vec![0, 0, 1280, 800]);
+        assert!(out.iter().any(|m| named(m, &XDG_SURFACE_INTERFACE, "ack_configure") && matches!(m.args[..], [Argument::Uint(4)])));
+        let (mut out, mut to_guest) = (Vec::new(), Vec::new());
+        r.fire(10_000 * MS, &mut out, &mut to_guest);
+        assert!(to_guest.is_empty());
+        // older acknowledgements of the guest never reach the host
+        assert!(!req(&mut r, "xdg_surface", "ack_configure", XDG, smallvec![Argument::Uint(3)]).0);
+    }
+
+    #[test]
+    fn mid_frame_the_acknowledgement_waits_for_the_guests_commit() {
+        let mut r = window(500);
+        // the guest is half way through a frame
+        req(&mut r, "xdg_surface", "set_window_geometry", XDG, smallvec![Argument::Int(0), Argument::Int(0), Argument::Int(1280), Argument::Int(800)]);
+        let (held, _, out) = configure(&mut r, 1920, 1080, &[2], 3, 0);
+        assert!(held && out.is_empty(), "nothing before the guest's commit");
+        let (fwd, _, pre, _) = req(&mut r, "wl_surface", "commit", SURFACE, smallvec![]);
+        assert!(fwd);
+        assert!(pre.iter().any(|m| named(m, &XDG_SURFACE_INTERFACE, "ack_configure")));
+        assert!(!pre.iter().any(|m| m.sender_id == guest_to_host(SURFACE)), "the guest's own commit follows");
+        // a guest that never commits: the proxy does after 100 ms
+        req(&mut r, "wl_surface", "frame", SURFACE, smallvec![Argument::NewId(30)]);
+        configure(&mut r, 1600, 900, &[], 4, 200 * MS);
+        let (mut out, mut to_guest) = (Vec::new(), Vec::new());
+        r.fire(250 * MS, &mut out, &mut to_guest);
+        assert!(out.is_empty());
+        r.fire(300 * MS, &mut out, &mut to_guest);
+        assert!(out.iter().any(|m| named(m, &XDG_SURFACE_INTERFACE, "ack_configure")));
+        assert!(out.last().is_some_and(|m| m.sender_id == guest_to_host(SURFACE) && named(m, &WL_SURFACE_INTERFACE, "commit")));
+    }
+
+    #[test]
+    fn sizes_reach_the_guest_a_second_apart() {
+        let mut r = window(200);
+        configure(&mut r, 1920, 1080, &[2], 3, 0);
+        let (mut out, mut to_guest) = (Vec::new(), Vec::new());
+        r.fire(200 * MS, &mut out, &mut to_guest);
+        assert_eq!(to_guest.len(), 2, "one toggle: 200 ms");
+        assert!(!req(&mut r, "xdg_surface", "ack_configure", XDG, smallvec![Argument::Uint(3)]).0);
+        frame(&mut r, 1920, 1080);
+        // out again 100 ms later: not before a second after the last one
+        configure(&mut r, 1280, 800, &[], 4, 300 * MS);
+        to_guest.clear();
+        r.fire(500 * MS, &mut out, &mut to_guest);
+        assert!(to_guest.is_empty());
+        r.fire(1_200 * MS, &mut out, &mut to_guest);
+        assert!(matches!(to_guest[0].args[..], [Argument::Int(1280), Argument::Int(800), _]));
+    }
+
+    #[test]
+    fn an_interactive_resize_holds_until_it_ends() {
+        let mut r = window(500);
+        for (i, w) in [1300, 1350, 1400].into_iter().enumerate() {
+            assert!(configure(&mut r, w, 800, &[3, 4], 3 + i as u32, i as i64 * 10 * MS).0);
+        }
+        let (mut out, mut to_guest) = (Vec::new(), Vec::new());
+        r.fire(5_000 * MS, &mut out, &mut to_guest);
+        assert!(to_guest.is_empty(), "still resizing");
+        // the button is let go: same size, no resizing state
+        assert!(configure(&mut r, 1400, 800, &[4], 6, 6_000 * MS).0);
+        r.fire(6_400 * MS, &mut out, &mut to_guest);
+        assert!(to_guest.is_empty());
+        r.fire(6_500 * MS, &mut out, &mut to_guest);
+        assert!(matches!(to_guest[0].args[..], [Argument::Int(1400), Argument::Int(800), _]));
+        assert!(matches!(to_guest[1].args[..], [Argument::Uint(6)]));
+    }
+}
diff -ruN a/src/session/seat.rs b/src/session/seat.rs
--- a/src/session/seat.rs
+++ b/src/session/seat.rs
@@ -0,0 +1,136 @@
+//! Guard for host seats that lose their pointer or keyboard.
+//!
+//! When a host seat loses a capability (for example the only mouse is a
+//! Bluetooth mouse that went to sleep), KWin 6.7 announces the new
+//! capabilities without sending wl_pointer.leave first. Nested KWin's Wayland
+//! backend (6.7 and master) keeps the entered wl_pointer in its cursor and only
+//! clears it on leave, so it destroys the pointer and then uses it: a crash
+//! (KWayland Pointer::setCursor) that ends the whole nested session. The proxy
+//! sends the guest the missing leave (and frame) events itself, just before
+//! the capabilities event that drops the device. Same for the keyboard.
+
+use std::collections::HashMap;
+use std::os::fd::OwnedFd;
+
+use log::info;
+use smallvec::smallvec;
+use wayland_server::backend::protocol::{Argument, Message};
+use wayland_server::protocol::__interfaces::{WL_KEYBOARD_INTERFACE, WL_POINTER_INTERFACE};
+
+const CAP_POINTER: u32 = 1;
+const CAP_KEYBOARD: u32 = 2;
+
+fn event_opcode(interface: &wayland_server::backend::protocol::Interface, name: &str) -> u16 {
+    interface
+        .events
+        .iter()
+        .position(|e| e.name == name)
+        .unwrap_or_else(|| panic!("{}.{} does not exist", interface.name, name)) as u16
+}
+
+struct Device {
+    seat: u32,
+    version: u32,
+    /// entered/focused surface and the serial of that enter
+    focus: Option<(u32, u32)>,
+}
+
+#[derive(Default)]
+pub(super) struct SeatGuard {
+    pointers: HashMap<u32, Device>,
+    keyboards: HashMap<u32, Device>,
+}
+
+impl SeatGuard {
+    /// A guest request (guest ids) being forwarded.
+    pub(super) fn on_request(&mut self, interface: &str, request: &str, sender: u32, version: u32, msg: &Message<u32, OwnedFd>) {
+        let new_id = || match msg.args.first() {
+            Some(Argument::NewId(id)) => Some(*id),
+            _ => None,
+        };
+        match (interface, request) {
+            ("wl_seat", "get_pointer") => {
+                if let Some(id) = new_id() {
+                    self.pointers.insert(id, Device { seat: sender, version, focus: None });
+                }
+            }
+            ("wl_seat", "get_keyboard") => {
+                if let Some(id) = new_id() {
+                    self.keyboards.insert(id, Device { seat: sender, version, focus: None });
+                }
+            }
+            ("wl_pointer", "release") => {
+                self.pointers.remove(&sender);
+            }
+            ("wl_keyboard", "release") => {
+                self.keyboards.remove(&sender);
+            }
+            _ => {}
+        }
+    }
+
+    /// A host event (guest ids) about to be forwarded; `before` receives
+    /// events for the guest to deliver ahead of it.
+    pub(super) fn on_event(
+        &mut self,
+        interface: &str,
+        event: &str,
+        msg: &Message<u32, OwnedFd>,
+        before: &mut Vec<Message<u32, OwnedFd>>,
+    ) {
+        match (interface, event) {
+            ("wl_pointer", "enter") | ("wl_keyboard", "enter") => {
+                let map = if interface == "wl_pointer" { &mut self.pointers } else { &mut self.keyboards };
+                if let (Some(dev), Some(Argument::Uint(serial)), Some(Argument::Object(surface))) =
+                    (map.get_mut(&msg.sender_id), msg.args.first(), msg.args.get(1))
+                {
+                    dev.focus = Some((*surface, *serial));
+                }
+            }
+            ("wl_pointer", "leave") | ("wl_keyboard", "leave") => {
+                let map = if interface == "wl_pointer" { &mut self.pointers } else { &mut self.keyboards };
+                if let Some(dev) = map.get_mut(&msg.sender_id) {
+                    dev.focus = None;
+                }
+            }
+            ("wl_seat", "capabilities") => {
+                let Some(Argument::Uint(caps)) = msg.args.first() else {
+                    return;
+                };
+                let seat = msg.sender_id;
+                if caps & CAP_POINTER == 0 {
+                    for (id, dev) in self.pointers.iter_mut().filter(|(_, d)| d.seat == seat) {
+                        if let Some((surface, serial)) = dev.focus.take() {
+                            info!("seat: the host seat lost its pointer, sending the guest the leave it omits");
+                            before.push(Message {
+                                sender_id: *id,
+                                opcode: event_opcode(&WL_POINTER_INTERFACE, "leave"),
+                                args: smallvec![Argument::Uint(serial), Argument::Object(surface)],
+                            });
+                            if dev.version >= 5 {
+                                before.push(Message {
+                                    sender_id: *id,
+                                    opcode: event_opcode(&WL_POINTER_INTERFACE, "frame"),
+                                    args: smallvec![],
+                                });
+                            }
+                        }
+                    }
+                }
+                if caps & CAP_KEYBOARD == 0 {
+                    for (id, dev) in self.keyboards.iter_mut().filter(|(_, d)| d.seat == seat) {
+                        if let Some((surface, serial)) = dev.focus.take() {
+                            info!("seat: the host seat lost its keyboard, sending the guest the leave it omits");
+                            before.push(Message {
+                                sender_id: *id,
+                                opcode: event_opcode(&WL_KEYBOARD_INTERFACE, "leave"),
+                                args: smallvec![Argument::Uint(serial), Argument::Object(surface)],
+                            });
+                        }
+                    }
+                }
+            }
+            _ => {}
+        }
+    }
+}
diff -ruN a/src/session/shell.rs b/src/session/shell.rs
--- a/src/session/shell.rs
+++ b/src/session/shell.rs
@@ -0,0 +1,194 @@
+//! The guest's xdg-shell toplevels and their titles, as the host sees them.
+//!
+//! The proxy decorates a toplevel's title for the host: a suffix while the
+//! keyboard shortcuts are released ([`super::shortcuts`]) and the live
+//! numbers ([`super::stats`]). The guest's own title is kept and the host gets
+//! `guest title + suffixes`; the guest never sees the change.
+
+use std::collections::HashMap;
+use std::ffi::CString;
+use std::os::fd::OwnedFd;
+
+use smallvec::smallvec;
+use wayland_protocols::xdg::shell::server::__interfaces::XDG_TOPLEVEL_INTERFACE;
+use wayland_server::backend::protocol::{Argument, Message};
+
+use super::{HostRequest, guest_to_host, request_opcode};
+
+#[derive(Default)]
+pub(super) struct Shell {
+    /// xdg_surface -> wl_surface (guest ids)
+    xdg_surfaces: HashMap<u32, u32>,
+    /// xdg_toplevel -> (wl_surface, the guest's title) (guest ids)
+    toplevels: HashMap<u32, (u32, Option<CString>)>,
+    released: bool,
+    /// capture off while the pointer is outside the focused window (shortcuts.rs)
+    outside: bool,
+    stats: Option<String>,
+    /// --title-label: "[label] " before every title, to tell VMs apart on the host
+    label: Option<String>,
+}
+
+impl Shell {
+    pub(super) fn with_label(label: Option<String>) -> Self {
+        Shell {
+            label: label.filter(|l| !l.is_empty()),
+            ..Default::default()
+        }
+    }
+
+    pub(super) fn is_toplevel_surface(&self, surface: u32) -> bool {
+        self.toplevels.values().any(|(s, _)| *s == surface)
+    }
+
+    pub(super) fn surface_of(&self, toplevel: u32) -> Option<u32> {
+        self.toplevels.get(&toplevel).map(|(s, _)| *s)
+    }
+
+    /// The wl_surface (guest id) of an xdg_surface.
+    pub(super) fn surface_of_xdg(&self, xdg_surface: u32) -> Option<u32> {
+        self.xdg_surfaces.get(&xdg_surface).copied()
+    }
+
+    /// The xdg_toplevel (guest id) of a wl_surface with that role.
+    pub(super) fn toplevel_of(&self, surface: u32) -> Option<u32> {
+        self.toplevels.iter().find(|(_, (s, _))| *s == surface).map(|(t, _)| *t)
+    }
+
+    fn compose(&self, title: &CString) -> CString {
+        let mut bytes = Vec::new();
+        if let Some(label) = &self.label {
+            bytes.extend_from_slice(format!("[{label}] ").as_bytes());
+        }
+        bytes.extend_from_slice(title.as_bytes());
+        if self.released {
+            bytes.extend_from_slice(" \u{2014} host shortcuts (refocus to capture)".as_bytes());
+        } else if self.outside {
+            bytes.extend_from_slice(" \u{2014} host shortcuts (pointer outside)".as_bytes());
+        }
+        if let Some(stats) = &self.stats {
+            bytes.extend_from_slice(" \u{2014} ".as_bytes());
+            bytes.extend_from_slice(stats.as_bytes());
+        }
+        CString::new(bytes).unwrap_or_else(|_| title.clone())
+    }
+
+    /// A guest request (guest ids) about to be forwarded; rewrites set_title.
+    /// Runs after the other hooks, which may still need the state before it.
+    pub(super) fn on_request(&mut self, interface: &str, request: &str, msg: &mut Message<u32, OwnedFd>) {
+        match (interface, request) {
+            ("xdg_wm_base", "get_xdg_surface") => {
+                if let [Argument::NewId(xdg), Argument::Object(surface)] = msg.args[..] {
+                    self.xdg_surfaces.insert(xdg, surface);
+                }
+            }
+            ("xdg_surface", "get_toplevel") => {
+                if let (Some(Argument::NewId(toplevel)), Some(surface)) =
+                    (msg.args.first(), self.xdg_surfaces.get(&msg.sender_id))
+                {
+                    self.toplevels.insert(*toplevel, (*surface, None));
+                }
+            }
+            ("xdg_toplevel", "set_title") => {
+                let toplevel = msg.sender_id;
+                if let Some(Argument::Str(Some(title))) = msg.args.first_mut() {
+                    let original = (**title).clone();
+                    **title = self.compose(&original);
+                    if let Some(t) = self.toplevels.get_mut(&toplevel) {
+                        t.1 = Some(original);
+                    }
+                }
+            }
+            ("xdg_toplevel", "destroy") => {
+                self.toplevels.remove(&msg.sender_id);
+            }
+            ("xdg_surface", "destroy") => {
+                self.xdg_surfaces.remove(&msg.sender_id);
+            }
+            ("wl_surface", "destroy") => {
+                let surface = msg.sender_id;
+                self.toplevels.retain(|_, (s, _)| *s != surface);
+                self.xdg_surfaces.retain(|_, s| *s != surface);
+            }
+            _ => {}
+        }
+    }
+
+    fn update(&self, out: &mut Vec<HostRequest>) {
+        for (toplevel, (_, title)) in &self.toplevels {
+            if let Some(title) = title {
+                out.push(Message {
+                    sender_id: guest_to_host(*toplevel),
+                    opcode: request_opcode(&XDG_TOPLEVEL_INTERFACE, "set_title"),
+                    args: smallvec![Argument::Str(Some(Box::new(self.compose(title))))],
+                });
+            }
+        }
+    }
+
+    /// The shortcuts' released state changed: new titles for the host.
+    pub(super) fn set_released(&mut self, released: bool, out: &mut Vec<HostRequest>) {
+        if self.released != released {
+            self.released = released;
+            self.update(out);
+        }
+    }
+
+    /// The capture is off (or on again) because the pointer left (came back to)
+    /// the focused window: new titles for the host.
+    pub(super) fn set_outside(&mut self, outside: bool, out: &mut Vec<HostRequest>) {
+        if self.outside != outside {
+            self.outside = outside;
+            self.update(out);
+        }
+    }
+
+    /// New numbers (or none): new titles for the host.
+    pub(super) fn set_stats(&mut self, stats: Option<String>, out: &mut Vec<HostRequest>) {
+        if self.stats != stats {
+            self.stats = stats;
+            self.update(out);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn msg(sender: u32, args: smallvec::SmallVec<[Argument<u32, OwnedFd>; 4]>) -> Message<u32, OwnedFd> {
+        Message {
+            sender_id: sender,
+            opcode: 0,
+            args,
+        }
+    }
+
+    #[test]
+    fn titles_are_decorated_for_the_host_only() {
+        let mut sh = Shell::default();
+        sh.on_request("xdg_wm_base", "get_xdg_surface", &mut msg(4, smallvec![Argument::NewId(10), Argument::Object(3)]));
+        sh.on_request("xdg_surface", "get_toplevel", &mut msg(10, smallvec![Argument::NewId(11)]));
+        assert!(sh.is_toplevel_surface(3));
+        let mut out = Vec::new();
+        sh.set_stats(Some("240 fps \u{b7} 5.1 ms".into()), &mut out);
+        assert!(out.is_empty(), "no title known yet");
+        let mut set = msg(11, smallvec![Argument::Str(Some(Box::new(CString::new("KWin").unwrap())))]);
+        sh.on_request("xdg_toplevel", "set_title", &mut set);
+        let Argument::Str(Some(t)) = &set.args[0] else { panic!() };
+        assert_eq!(t.to_str().unwrap(), "KWin \u{2014} 240 fps \u{b7} 5.1 ms");
+        sh.set_released(true, &mut out);
+        let Argument::Str(Some(t)) = &out[0].args[0] else { panic!() };
+        assert_eq!(out[0].sender_id, guest_to_host(11));
+        assert_eq!(
+            t.to_str().unwrap(),
+            "KWin \u{2014} host shortcuts (refocus to capture) \u{2014} 240 fps \u{b7} 5.1 ms"
+        );
+        out.clear();
+        sh.set_released(true, &mut out);
+        assert!(out.is_empty(), "unchanged");
+        sh.on_request("wl_surface", "destroy", &mut msg(3, smallvec![]));
+        sh.set_stats(None, &mut out);
+        assert!(out.is_empty() && !sh.is_toplevel_surface(3));
+    }
+}
diff -ruN a/src/session/shortcuts.rs b/src/session/shortcuts.rs
--- a/src/session/shortcuts.rs
+++ b/src/session/shortcuts.rs
@@ -0,0 +1,874 @@
+//! Keyboard shortcut capture for forwarded windows, like a VM window.
+//!
+//! The host compositor handles its own shortcuts (Meta, Alt+Tab, ...) before
+//! the focused window sees them, unless that window's surface has a
+//! zwp_keyboard_shortcuts_inhibitor_v1. Nested KWin asks for one only while it
+//! grabs the pointer (Right Ctrl). The proxy therefore creates an inhibitor of
+//! its own on every forwarded xdg_toplevel surface when it gets keyboard
+//! focus; the host applies it only while that surface is focused. This works
+//! for any nested compositor or client.
+//!
+//! KWin 6.7 grants every inhibitor at once (`active`) and never revokes one,
+//! and has no key of its own to break it, so the proxy provides the escape: a
+//! key chord (default Meta+Shift+Esc, KDE's own chord for releasing captured
+//! input) releases the capture until the window next gets keyboard focus; then
+//! it is captured again, like a VM window. While capture is on, the host sees
+//! no shortcut, so any chord reaches the proxy. While released, the chord
+//! captures again only if the host does not keep it for itself: Plasma 6.7
+//! binds Meta+Shift+Esc (leave input capture), Meta+Esc (System Monitor),
+//! Meta+Ctrl+Esc (Kill Window) and Meta+F1..F10, among others. The window
+//! title says when capture is released. The chord's key events still reach the
+//! guest; the proxy only watches them.
+//!
+//! The capture follows the pointer by default (2026-10-12, the user: "behave
+//! like SDL"): QEMU's SDL window grabs the keyboard only while it has the
+//! pointer, so with the pointer on the window's title bar or another window the
+//! host's Alt+Tab and Meta work even though the window keeps the keyboard focus.
+//! The proxy likewise drops its inhibitor while the pointer is outside the
+//! focused toplevel (grab.rs tracks which toplevel is under the pointer,
+//! subsurfaces included) and creates it again when the pointer comes back; the
+//! title says so. In full screen the pointer is always inside. Off with
+//! --no-follow-pointer (capture whenever focused, as before).
+//!
+//! A second chord (default Ctrl+Alt+F, QEMU's) toggles full screen: the
+//! proxy asks the host to take the focused toplevel out of full screen (and
+//! releases the capture, as the first chord does) or back into it (and
+//! captures again) - the nested compositor asked for full screen itself and
+//! sizes its output after the host's configure either way. Unlike the first
+//! chord, its last key never reaches the guest (QEMU keeps Ctrl+Alt+F too):
+//! with Meta+Shift+Esc a host that binds the chord itself may never pass it on
+//! (2026-10-08, host KWin 6.7.91: the chord did nothing in full screen).
+//!
+//! A third chord (default Ctrl+Alt+S, only with --overlay-command) shows or
+//! hides the stats overlay (overlay.rs); its last key never reaches the guest
+//! either.
+//!
+//! The host refuses a second inhibitor for the same surface and seat
+//! (`already_inhibited` kills the connection), so the proxy destroys its own
+//! before the guest's own request goes through, and restores it after the
+//! guest destroys its own.
+
+use std::collections::{HashMap, HashSet};
+use std::ffi::CString;
+use std::os::fd::OwnedFd;
+use std::str::FromStr;
+
+use log::{debug, info, warn};
+use smallvec::smallvec;
+use wayland_protocols::wp::keyboard_shortcuts_inhibit::zv1::server::__interfaces::ZWP_KEYBOARD_SHORTCUTS_INHIBIT_MANAGER_V1_INTERFACE;
+use wayland_protocols::xdg::shell::server::__interfaces::XDG_TOPLEVEL_INTERFACE;
+use wayland_server::backend::protocol::{Argument, Message};
+use wayland_server::protocol::__interfaces::{WL_REGISTRY_INTERFACE, WL_SEAT_INTERFACE};
+
+use super::shell::Shell;
+use super::{FIRST_OWN, HostRequest, OwnKind, OwnObjects, guest_to_host, request_opcode};
+
+const MOD_CTRL: u8 = 1;
+const MOD_SHIFT: u8 = 2;
+const MOD_ALT: u8 = 4;
+const MOD_META: u8 = 8;
+
+/// Modifier group of an evdev key code, 0 for other keys.
+fn modifier_of(key: u32) -> u8 {
+    match key {
+        29 | 97 => MOD_CTRL,   // KEY_LEFTCTRL, KEY_RIGHTCTRL
+        42 | 54 => MOD_SHIFT,  // KEY_LEFTSHIFT, KEY_RIGHTSHIFT
+        56 | 100 => MOD_ALT,   // KEY_LEFTALT, KEY_RIGHTALT
+        125 | 126 => MOD_META, // KEY_LEFTMETA, KEY_RIGHTMETA
+        _ => 0,
+    }
+}
+
+fn key_code(name: &str) -> Option<u32> {
+    const LETTERS: [u32; 26] = [
+        30, 48, 46, 32, 18, 33, 34, 35, 23, 36, 37, 38, 50, 49, 24, 25, 16, 19, 31, 20, 22, 47,
+        17, 45, 21, 44,
+    ];
+    let code = match name {
+        "esc" | "escape" => 1,
+        "tab" => 15,
+        "space" => 57,
+        "enter" | "return" => 28,
+        "backspace" => 14,
+        "insert" | "ins" => 110,
+        "delete" | "del" => 111,
+        "home" => 102,
+        "end" => 107,
+        "pageup" | "pgup" => 104,
+        "pagedown" | "pgdn" => 109,
+        "pause" | "break" => 119,
+        "scrolllock" => 70,
+        "print" | "sysrq" => 99,
+        "f11" => 87,
+        "f12" => 88,
+        "0" => 11,
+        _ => {
+            if let Some(n) = name.strip_prefix("key") {
+                return n.parse().ok();
+            }
+            if let Some(n) = name.strip_prefix('f').and_then(|n| n.parse::<u32>().ok()) {
+                return (1..=10).contains(&n).then_some(58 + n);
+            }
+            let b = name.as_bytes();
+            if b.len() == 1 && b[0].is_ascii_lowercase() {
+                return Some(LETTERS[(b[0] - b'a') as usize]);
+            }
+            if b.len() == 1 && (b'1'..=b'9').contains(&b[0]) {
+                return Some((b[0] - b'1') as u32 + 2);
+            }
+            return None;
+        }
+    };
+    Some(code)
+}
+
+/// A key chord such as `meta+shift+esc`: modifiers (ctrl, shift, alt,
+/// meta/super) and one other key, by name or as `keyN` (evdev code N).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Chord {
+    mods: u8,
+    key: u32,
+    text: String,
+}
+
+impl FromStr for Chord {
+    type Err = String;
+
+    fn from_str(s: &str) -> Result<Self, String> {
+        let mut mods = 0;
+        let mut key = None;
+        let mut text = Vec::new();
+        for part in s.split('+').map(|p| p.trim().to_ascii_lowercase()) {
+            let m = match part.as_str() {
+                "ctrl" | "control" => MOD_CTRL,
+                "shift" => MOD_SHIFT,
+                "alt" => MOD_ALT,
+                "meta" | "super" | "win" | "logo" => MOD_META,
+                _ => 0,
+            };
+            if m != 0 {
+                mods |= m;
+                text.push(match m {
+                    MOD_CTRL => "Ctrl".to_owned(),
+                    MOD_SHIFT => "Shift".to_owned(),
+                    MOD_ALT => "Alt".to_owned(),
+                    _ => "Meta".to_owned(),
+                });
+                continue;
+            }
+            if key.is_some() {
+                return Err(format!("{s}: more than one non-modifier key"));
+            }
+            let code = key_code(&part).ok_or_else(|| format!("{s}: unknown key {part:?}"))?;
+            if modifier_of(code) != 0 {
+                return Err(format!("{s}: the last key must not be a modifier"));
+            }
+            key = Some(code);
+            let mut name = part.clone();
+            if let Some(first) = name.get_mut(0..1) {
+                first.make_ascii_uppercase();
+            }
+            text.push(name);
+        }
+        let key = key.ok_or_else(|| format!("{s}: no key"))?;
+        Ok(Chord {
+            mods,
+            key,
+            text: text.join("+"),
+        })
+    }
+}
+
+impl std::fmt::Display for Chord {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str(&self.text)
+    }
+}
+
+impl Chord {
+    /// `key` was just pressed, with `pressed` held (including `key`).
+    fn matches(&self, key: u32, pressed: &HashSet<u32>) -> bool {
+        key == self.key && pressed.iter().fold(0, |m, k| m | modifier_of(*k)) == self.mods
+    }
+}
+
+#[derive(Debug, Clone)]
+pub struct ShortcutConfig {
+    /// Create inhibitors (capture the host's shortcuts) at all.
+    pub enabled: bool,
+    /// Chord that releases capture until the next keyboard focus, `None`
+    /// for none.
+    pub toggle: Option<Chord>,
+    /// Chord that takes the focused toplevel out of full screen (releasing
+    /// capture) or back into it (capturing again), `None` for none.
+    pub fullscreen: Option<Chord>,
+    /// Chord that shows or hides the stats overlay, `None` for none (no
+    /// overlay command).
+    pub overlay: Option<Chord>,
+    /// While capturing, also confine the host pointer to the window, as QEMU's
+    /// SDL window does: the host's Meta + mouse actions then reach the guest
+    /// (see grab.rs).
+    pub grab_pointer: bool,
+    /// Capture only while the pointer is over the focused window, as QEMU's
+    /// SDL window does: the host's shortcuts work with the pointer on the title
+    /// bar or elsewhere.
+    pub follow_pointer: bool,
+}
+
+impl Default for ShortcutConfig {
+    fn default() -> Self {
+        ShortcutConfig {
+            enabled: false,
+            toggle: Some("meta+shift+esc".parse().unwrap()),
+            fullscreen: Some("ctrl+alt+f".parse().unwrap()),
+            overlay: None,
+            grab_pointer: true,
+            follow_pointer: true,
+        }
+    }
+}
+
+pub(super) struct Shortcuts {
+    cfg: ShortcutConfig,
+    /// capture released with the chord, until the next keyboard enter
+    released: bool,
+    manager_global: Option<u32>,
+    seat_global: Option<u32>,
+    manager: Option<u32>,
+    seat: Option<u32>,
+    /// wl_surface (guest id) -> the proxy's inhibitor (host id)
+    own_inhibitors: HashMap<u32, u32>,
+    /// the guest's own inhibitors: inhibitor -> wl_surface (guest ids)
+    guest_inhibitors: HashMap<u32, u32>,
+    focus: Option<u32>,
+    /// toplevel surface under the host pointer (guest id; grab.rs tracks it)
+    pointer_over: Option<u32>,
+    pressed: HashSet<u32>,
+    /// xdg_toplevels (guest ids) the host's last configure showed in full screen
+    fullscreen: HashSet<u32>,
+    /// their size in full screen, from that configure
+    full_size: HashMap<u32, (i32, i32)>,
+    /// toplevels the chord took out of full screen, until the host's configure
+    leaving: HashSet<u32>,
+    /// keys whose press the proxy kept from the guest: their release too
+    swallowed: HashSet<u32>,
+    /// the overlay chord was pressed: for the session to act on
+    overlay_toggled: bool,
+    warned: bool,
+}
+
+impl Shortcuts {
+    pub(super) fn new(cfg: ShortcutConfig) -> Self {
+        Shortcuts {
+            cfg,
+            released: false,
+            manager_global: None,
+            seat_global: None,
+            manager: None,
+            seat: None,
+            own_inhibitors: HashMap::new(),
+            guest_inhibitors: HashMap::new(),
+            focus: None,
+            pointer_over: None,
+            pressed: HashSet::new(),
+            fullscreen: HashSet::new(),
+            full_size: HashMap::new(),
+            leaving: HashSet::new(),
+            swallowed: HashSet::new(),
+            overlay_toggled: false,
+            warned: false,
+        }
+    }
+
+    /// The overlay chord was pressed since the last call.
+    pub(super) fn take_overlay_toggle(&mut self) -> bool {
+        std::mem::take(&mut self.overlay_toggled)
+    }
+
+    /// Capture released with the chord (the window title says so).
+    pub(super) fn released(&self) -> bool {
+        self.released
+    }
+
+    /// The capture is off only because the pointer is outside the focused
+    /// window (the window title says so).
+    pub(super) fn pointer_outside(&self) -> bool {
+        self.cfg.enabled
+            && self.cfg.follow_pointer
+            && !self.released
+            && self.focus.is_some()
+            && self.pointer_over != self.focus
+    }
+
+    /// The toplevel surface under the host pointer changed. With
+    /// `follow_pointer` the capture follows it: the focused window's inhibitor
+    /// goes when the pointer leaves it and comes back with the pointer.
+    pub(super) fn set_pointer_over(
+        &mut self,
+        over: Option<u32>,
+        shell: &Shell,
+        own: &mut OwnObjects,
+        out: &mut Vec<HostRequest>,
+    ) {
+        if self.pointer_over == over {
+            return;
+        }
+        self.pointer_over = over;
+        let Some(focus) = self.focus.filter(|_| self.cfg.enabled && self.cfg.follow_pointer) else {
+            return;
+        };
+        if over == Some(focus) {
+            if self.wants_inhibitor(focus, shell) {
+                self.create_inhibitor(focus, own, out);
+            }
+        } else if self.own_inhibitors.contains_key(&focus) {
+            self.destroy_inhibitor(focus, out);
+            info!("shortcuts: the pointer left the focused window, the host's shortcuts work until it comes back");
+        }
+    }
+
+    fn wants_inhibitor(&self, surface: u32, shell: &Shell) -> bool {
+        self.cfg.enabled
+            && !self.released
+            && (!self.cfg.follow_pointer || self.pointer_over == Some(surface))
+            && shell.is_toplevel_surface(surface)
+            && !self.own_inhibitors.contains_key(&surface)
+            && !self.guest_inhibitors.values().any(|s| *s == surface)
+    }
+
+    fn bind(&self, name: u32, interface: &str, version: u32, id: u32) -> HostRequest {
+        Message {
+            sender_id: FIRST_OWN, // the proxy's registry
+            opcode: request_opcode(&WL_REGISTRY_INTERFACE, "bind"),
+            args: smallvec![
+                Argument::Uint(name),
+                Argument::Str(Some(Box::new(CString::new(interface).unwrap()))),
+                Argument::Uint(version),
+                Argument::NewId(id),
+            ],
+        }
+    }
+
+    fn create_inhibitor(&mut self, surface: u32, own: &mut OwnObjects, out: &mut Vec<HostRequest>) {
+        let inhibitor_interface = ZWP_KEYBOARD_SHORTCUTS_INHIBIT_MANAGER_V1_INTERFACE.requests
+            [request_opcode(&ZWP_KEYBOARD_SHORTCUTS_INHIBIT_MANAGER_V1_INTERFACE, "inhibit_shortcuts") as usize]
+            .child_interface
+            .expect("inhibit_shortcuts creates an inhibitor");
+        if self.manager.is_none() || self.seat.is_none() {
+            let (Some(manager_name), Some(seat_name)) = (self.manager_global, self.seat_global) else {
+                if !self.warned {
+                    self.warned = true;
+                    warn!("shortcuts: the host has no zwp_keyboard_shortcuts_inhibit_manager_v1, its shortcuts stay active");
+                }
+                return;
+            };
+            if self.manager.is_none() {
+                let Some(id) = own.alloc(&ZWP_KEYBOARD_SHORTCUTS_INHIBIT_MANAGER_V1_INTERFACE, OwnKind::InhibitManager) else {
+                    debug!("shortcuts: no free proxy object id yet");
+                    return;
+                };
+                out.push(self.bind(manager_name, "zwp_keyboard_shortcuts_inhibit_manager_v1", 1, id));
+                self.manager = Some(id);
+            }
+            if self.seat.is_none() {
+                let Some(id) = own.alloc(&WL_SEAT_INTERFACE, OwnKind::Seat) else {
+                    debug!("shortcuts: no free proxy object id yet");
+                    return;
+                };
+                out.push(self.bind(seat_name, "wl_seat", 1, id));
+                self.seat = Some(id);
+            }
+        }
+        let (Some(manager), Some(seat)) = (self.manager, self.seat) else {
+            return;
+        };
+        let Some(id) = own.alloc(inhibitor_interface, OwnKind::Inhibitor) else {
+            debug!("shortcuts: no free proxy object id for an inhibitor");
+            return;
+        };
+        out.push(Message {
+            sender_id: manager,
+            opcode: request_opcode(&ZWP_KEYBOARD_SHORTCUTS_INHIBIT_MANAGER_V1_INTERFACE, "inhibit_shortcuts"),
+            args: smallvec![
+                Argument::NewId(id),
+                Argument::Object(guest_to_host(surface)),
+                Argument::Object(seat),
+            ],
+        });
+        self.own_inhibitors.insert(surface, id);
+        info!("shortcuts: capturing the host's keyboard shortcuts for surface {surface}");
+    }
+
+    fn destroy_inhibitor(&mut self, surface: u32, out: &mut Vec<HostRequest>) {
+        if let Some(id) = self.own_inhibitors.remove(&surface) {
+            // zwp_keyboard_shortcuts_inhibitor_v1.destroy; the id stays taken
+            // until the host's delete_id
+            out.push(Message {
+                sender_id: id,
+                opcode: 0,
+                args: smallvec![],
+            });
+            debug!("shortcuts: inhibitor {id} of surface {surface} destroyed");
+        }
+    }
+
+    fn toggle(&mut self, shell: &Shell, own: &mut OwnObjects, out: &mut Vec<HostRequest>) {
+        self.released = !self.released;
+        if self.released {
+            let surfaces: Vec<u32> = self.own_inhibitors.keys().copied().collect();
+            for s in surfaces {
+                self.destroy_inhibitor(s, out);
+            }
+            info!("shortcuts: released, the host's shortcuts are active until the window is focused again");
+        } else {
+            if let Some(focus) = self.focus {
+                if self.wants_inhibitor(focus, shell) {
+                    self.create_inhibitor(focus, own, out);
+                }
+            }
+            info!("shortcuts: captured again");
+        }
+    }
+
+    /// The fullscreen chord on `surface`: out of full screen with the capture
+    /// released, or back into it with the capture on. The host's configure
+    /// says which state it ended in; the nested compositor follows it.
+    fn toggle_fullscreen(&mut self, surface: u32, shell: &Shell, own: &mut OwnObjects, out: &mut Vec<HostRequest>) {
+        let Some(toplevel) = shell.toplevel_of(surface) else {
+            return;
+        };
+        if self.fullscreen.contains(&toplevel) {
+            out.push(Message {
+                sender_id: guest_to_host(toplevel),
+                opcode: request_opcode(&XDG_TOPLEVEL_INTERFACE, "unset_fullscreen"),
+                args: smallvec![],
+            });
+            self.leaving.insert(toplevel);
+            info!("shortcuts: fullscreen chord, leaving full screen");
+            if !self.released {
+                self.toggle(shell, own, out);
+            }
+        } else {
+            out.push(Message {
+                sender_id: guest_to_host(toplevel),
+                opcode: request_opcode(&XDG_TOPLEVEL_INTERFACE, "set_fullscreen"),
+                args: smallvec![Argument::Object(0)],
+            });
+            info!("shortcuts: fullscreen chord, back to full screen");
+            if self.released {
+                self.toggle(shell, own, out);
+            }
+        }
+    }
+
+    /// A guest request (guest ids) about to be forwarded; `shell` is still in
+    /// the state before it.
+    pub(super) fn on_request(
+        &mut self,
+        interface: &str,
+        request: &str,
+        msg: &mut Message<u32, OwnedFd>,
+        shell: &Shell,
+        own: &mut OwnObjects,
+        pre: &mut Vec<HostRequest>,
+        post: &mut Vec<HostRequest>,
+    ) {
+        match (interface, request) {
+            ("xdg_toplevel", "destroy") => {
+                // one role per surface: its inhibitor goes with the toplevel
+                if let Some(surface) = shell.surface_of(msg.sender_id) {
+                    self.destroy_inhibitor(surface, pre);
+                }
+            }
+            ("wl_surface", "destroy") => {
+                self.destroy_inhibitor(msg.sender_id, pre);
+                if self.focus == Some(msg.sender_id) {
+                    self.focus = None;
+                }
+            }
+            ("zwp_keyboard_shortcuts_inhibit_manager_v1", "inhibit_shortcuts") => {
+                if let [Argument::NewId(inhibitor), Argument::Object(surface), _] = msg.args[..] {
+                    // the host allows one inhibitor per surface and seat
+                    self.destroy_inhibitor(surface, pre);
+                    self.guest_inhibitors.insert(inhibitor, surface);
+                    debug!("shortcuts: the guest inhibits shortcuts itself on surface {surface}");
+                }
+            }
+            ("zwp_keyboard_shortcuts_inhibitor_v1", "destroy") => {
+                if let Some(surface) = self.guest_inhibitors.remove(&msg.sender_id) {
+                    if self.focus == Some(surface) && self.wants_inhibitor(surface, shell) {
+                        self.create_inhibitor(surface, own, post);
+                    }
+                }
+            }
+            _ => {}
+        }
+    }
+
+    /// A host event (already in guest ids) on one of the guest's objects;
+    /// true when the guest must not get it (the fullscreen chord's key). May
+    /// rewrite it: a toplevel the chord takes out of full screen gets a size.
+    pub(super) fn on_event(
+        &mut self,
+        interface: &str,
+        event: &str,
+        msg: &mut Message<u32, OwnedFd>,
+        shell: &Shell,
+        own: &mut OwnObjects,
+        out: &mut Vec<HostRequest>,
+    ) -> bool {
+        if interface == "xdg_toplevel" && event == "configure" {
+            let toplevel = msg.sender_id;
+            if let [Argument::Int(w), Argument::Int(h), Argument::Array(ref states)] = msg.args[..] {
+                // xdg_toplevel.state.fullscreen = 2
+                let full = states
+                    .chunks_exact(4)
+                    .any(|s| u32::from_ne_bytes([s[0], s[1], s[2], s[3]]) == 2);
+                debug!("shortcuts: toplevel {toplevel} configured {w}x{h}, full screen {full}");
+                if full {
+                    self.fullscreen.insert(toplevel);
+                    if w > 0 && h > 0 {
+                        self.full_size.insert(toplevel, (w, h));
+                    }
+                } else {
+                    self.fullscreen.remove(&toplevel);
+                    // Out of full screen at the chord, a window that started in full screen
+                    // gets 0x0 (its size is the client's to choose), and a nested KWin keeps
+                    // its output size then: no new frame, so the host never applies the state
+                    // (2026-10-08: the window stayed in full screen). It gets four fifths of
+                    // its full-screen size instead, resizes and draws.
+                    if self.leaving.remove(&toplevel) && w == 0 && h == 0 {
+                        if let Some(&(fw, fh)) = self.full_size.get(&toplevel) {
+                            let (nw, nh) = (fw * 4 / 5, fh * 4 / 5);
+                            msg.args[0] = Argument::Int(nw);
+                            msg.args[1] = Argument::Int(nh);
+                            info!("shortcuts: out of full screen at {nw}x{nh} (the host left the size to the guest)");
+                        }
+                    }
+                }
+            }
+            return false;
+        }
+        if interface != "wl_keyboard" {
+            return false;
+        }
+        match event {
+            "enter" => {
+                if let [Argument::Uint(_), Argument::Object(surface), Argument::Array(ref keys)] =
+                    msg.args[..]
+                {
+                    self.focus = Some(surface);
+                    if self.released && shell.is_toplevel_surface(surface) {
+                        // focused again: capture again, like a VM window
+                        self.released = false;
+                        info!("shortcuts: window focused again, capturing again");
+                    }
+                    self.pressed = keys
+                        .chunks_exact(4)
+                        .map(|k| u32::from_ne_bytes([k[0], k[1], k[2], k[3]]))
+                        .collect();
+                    debug!("shortcuts: keyboard enter on surface {surface}, keys held {:?}", self.pressed);
+                    if self.cfg.follow_pointer && self.pointer_over != Some(surface) {
+                        // focused with the pointer elsewhere: captured once the pointer comes in
+                        self.destroy_inhibitor(surface, out);
+                    }
+                    if self.wants_inhibitor(surface, shell) {
+                        self.create_inhibitor(surface, own, out);
+                    }
+                }
+            }
+            "leave" => {
+                debug!("shortcuts: keyboard leave");
+                self.focus = None;
+                self.pressed.clear();
+                self.swallowed.clear();
+            }
+            "key" => {
+                if let [_, _, Argument::Uint(key), Argument::Uint(state)] = msg.args[..] {
+                    debug!("shortcuts: key {key} state {state}, focus {:?}", self.focus);
+                    match state {
+                        1 => {
+                            self.pressed.insert(key);
+                            // with or without capture: the host binds no such chord
+                            if self.focus.is_some()
+                                && self.cfg.overlay.as_ref().is_some_and(|c| c.matches(key, &self.pressed))
+                            {
+                                self.overlay_toggled = true;
+                                self.swallowed.insert(key);
+                                return true;
+                            }
+                            if let Some(focus) = self.focus.filter(|_| self.cfg.enabled) {
+                                if self.cfg.fullscreen.as_ref().is_some_and(|c| c.matches(key, &self.pressed)) {
+                                    // every toggle resizes the window at once; with
+                                    // --resize-settle-ms the guest follows once it settles
+                                    self.toggle_fullscreen(focus, shell, own, out);
+                                    self.swallowed.insert(key);
+                                    return true;
+                                }
+                                if self.cfg.toggle.as_ref().is_some_and(|c| c.matches(key, &self.pressed)) {
+                                    self.toggle(shell, own, out);
+                                }
+                            }
+                        }
+                        0 => {
+                            self.pressed.remove(&key);
+                            if self.swallowed.remove(&key) {
+                                return true;
+                            }
+                        }
+                        _ => {
+                            // repeated
+                            if self.swallowed.contains(&key) {
+                                return true;
+                            }
+                        }
+                    }
+                }
+            }
+            _ => {}
+        }
+        false
+    }
+
+    /// An event on one of the proxy's own objects.
+    pub(super) fn on_own_event(
+        &mut self,
+        kind: OwnKind,
+        id: u32,
+        event: &str,
+        msg: &Message<u32, OwnedFd>,
+        _own: &mut OwnObjects,
+        _out: &mut Vec<HostRequest>,
+    ) {
+        match (kind, event) {
+            (OwnKind::Registry, "global") => {
+                if let [Argument::Uint(name), Argument::Str(Some(ref interface)), Argument::Uint(_)] =
+                    msg.args[..]
+                {
+                    match interface.to_bytes() {
+                        b"zwp_keyboard_shortcuts_inhibit_manager_v1" => {
+                            self.manager_global.get_or_insert(name);
+                        }
+                        b"wl_seat" => {
+                            self.seat_global.get_or_insert(name);
+                        }
+                        _ => {}
+                    }
+                }
+            }
+            (OwnKind::Registry, "global_remove") => {
+                if let [Argument::Uint(name)] = msg.args[..] {
+                    if self.manager_global == Some(name) {
+                        self.manager_global = None;
+                    }
+                    if self.seat_global == Some(name) {
+                        self.seat_global = None;
+                    }
+                }
+            }
+            (OwnKind::Inhibitor, "active") => {
+                info!("shortcuts: the host granted shortcut capture (inhibitor {id})");
+            }
+            (OwnKind::Inhibitor, "inactive") => {
+                info!("shortcuts: the host restored its own shortcuts (inhibitor {id})");
+            }
+            _ => {}
+        }
+    }
+}
