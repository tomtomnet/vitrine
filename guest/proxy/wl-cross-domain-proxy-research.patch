+#[cfg(test)]
+mod tests {
+    use super::*;
+    use smallvec::smallvec;
+
+    fn cfg() -> StatsConfig {
+        StatsConfig {
+            mode: StatsMode::Title,
+            ..StatsConfig::default()
+        }
+    }
+
+    fn feedback(surface: u32, id: u32) -> Message<u32, OwnedFd> {
+        Message {
+            sender_id: 5,
+            opcode: 1,
+            args: smallvec![Argument::Object(surface), Argument::NewId(id)],
+        }
+    }
+    fn commit(surface: u32) -> Message<u32, OwnedFd> {
+        Message {
+            sender_id: surface,
+            opcode: 6,
+            args: smallvec![],
+        }
+    }
+    fn presented(id: u32, at: i64) -> Message<u32, OwnedFd> {
+        let sec = (at / 1_000_000_000) as u64;
+        Message {
+            sender_id: id,
+            opcode: 1,
+            args: smallvec![
+                Argument::Uint((sec >> 32) as u32),
+                Argument::Uint(sec as u32),
+                Argument::Uint((at % 1_000_000_000) as u32),
+                Argument::Uint(4_166_666),
+                Argument::Uint(0),
+                Argument::Uint(0),
+                Argument::Uint(0x7)
+            ],
+        }
+    }
+    fn key(state: u32) -> Message<u32, OwnedFd> {
+        Message {
+            sender_id: 9,
+            opcode: 3,
+            args: smallvec![
+                Argument::Uint(1),
+                Argument::Uint(2),
+                Argument::Uint(30),
+                Argument::Uint(state)
+            ],
+        }
+    }
+
+    #[test]
+    fn percentiles_pick_ranks() {
+        let mut v: Vec<i64> = (1..=100).collect();
+        assert_eq!(percentiles(&mut v), Some((50, 99)));
+        let mut v = vec![7];
+        assert_eq!(percentiles(&mut v), Some((7, 7)));
+        assert_eq!(percentiles(&mut []), None);
+    }
+
+    /// 240 frames at 240 Hz, each presented 5 ms after its commit, one key
+    /// press 1 ms before every 10th commit, one frame discarded.
+    #[test]
+    fn frames_latencies_and_title() {
+        let mut s = Stats::new(cfg(), 0);
+        let surface = 3;
+        let t0 = 10_000_000_000i64;
+        let period = 4_166_667i64;
+        for i in 0..240i64 {
+            let t = t0 + i * period;
+            let id = 1000 + i as u32;
+            if i % 10 == 0 {
+                s.on_event("wl_keyboard", "key", &key(1), t - 1_000_000);
+                s.on_event("wl_keyboard", "key", &key(0), t - 900_000); // release: ignored
+            }
+            s.on_request("wp_presentation", "feedback", &feedback(surface, id), t, t, true);
+            s.on_request("wl_surface", "commit", &commit(surface), t, t + 200_000, true);
+            if i == 100 {
+                s.on_event("wp_presentation_feedback", "discarded", &presented(id, 0), t + 5_000_000);
+            } else {
+                s.on_event("wp_presentation_feedback", "presented", &presented(id, t + 5_000_000), t + 5_100_000);
+            }
+        }
+        let now = t0 + 240 * period;
+        let sum = s.summary(now);
+        assert_eq!(sum.presented, 239);
+        assert_eq!(sum.commits, 240);
+        assert_eq!(sum.dropped, 1);
+        assert_eq!(sum.frame, Some((5_000_000, 5_000_000)));
+        assert_eq!(sum.input, Some((6_000_000, 6_000_000)));
+        assert_eq!(sum.hold, Some((200_000, 200_000)));
+        assert_eq!(sum.text(StatsMode::Title), "239 fps \u{b7} 5.0 ms \u{b7} input 6.0 ms \u{b7} 1 dropped");
+        assert_eq!(
+            sum.text(StatsMode::Detail),
+            "239 fps (240 commits, 1 dropped) \u{b7} frame 5.0/5.0 ms \u{b7} input 6.0/6.0 ms \u{b7} hold 0.20/0.20 ms"
+        );
+        // unchanged text: no title update
+        assert!(s.tick(now).is_some());
+        assert!(s.tick(now).is_none());
+        // one second later everything has left the window
+        let later = now + 2_000_000_000;
+        assert_eq!(s.summary(later).text(StatsMode::Title), "0 fps");
+    }
+
+    #[test]
+    fn overlay_json_has_rates_latencies_and_intervals() {
+        let mut s = Stats::new(StatsConfig::default(), 0);
+        assert!(!s.active());
+        s.set_overlay(true);
+        assert!(s.active());
+        let t0 = 20_000_000_000i64;
+        let period = 4_166_667i64;
+        for i in 0..4i64 {
+            let t = t0 + i * period;
+            let id = 100 + i as u32;
+            s.on_request("wp_presentation", "feedback", &feedback(3, id), t, t, true);
+            s.on_request("wl_surface", "commit", &commit(3), t, t, true);
+            // the third frame is shown a refresh late
+            let shown = t + 5_000_000 + if i >= 2 { period } else { 0 };
+            s.on_event("wp_presentation_feedback", "presented", &presented(id, shown), shown + 100_000);
+        }
+        let json = s.overlay_json(t0 + 4 * period);
+        assert!(json.starts_with("{\"fps\":4.0,\"ups\":4.0,\"burst_fps\":null,\"burst_ups\":null,\"dropped\":0,\"refresh_hz\":240.00,"), "{json}");
+        assert!(json.contains("\"input\":null"), "{json}");
+        assert!(json.contains("\"present_ms\":[4.17,8.33,4.17]"), "{json}");
+        assert!(json.contains("\"commit_ms\":[4.17,4.17,4.17]"), "{json}");
+        s.set_overlay(false);
+        assert!(!s.active());
+    }
+
+    #[test]
+    fn overlay_burst_rate_is_the_animation_s_own() {
+        let mut s = Stats::new(StatsConfig::default(), 0);
+        s.set_overlay(true);
+        let t0 = 30_000_000_000i64;
+        let period = 4_166_667i64;
+        // a lone frame, a pause, then a 20-frame animation at 240 Hz
+        let mut frame = |s: &mut Stats, id: u32, t: i64| {
+            s.on_request("wp_presentation", "feedback", &feedback(3, id), t, t, true);
+            s.on_request("wl_surface", "commit", &commit(3), t, t, true);
+            s.on_event("wp_presentation_feedback", "presented", &presented(id, t + 5_000_000), t + 5_100_000);
+        };
+        frame(&mut s, 1, t0);
+        for i in 0..20i64 {
+            frame(&mut s, 10 + i as u32, t0 + 300_000_000 + i * period);
+        }
+        let end = t0 + 300_000_000 + 20 * period;
+        let json = s.overlay_json(end);
+        assert!(json.contains("\"burst_fps\":240.0,\"burst_ups\":240.0"), "{json}");
+        // over half a second later the burst is history
+        assert!(s.overlay_json(end + 600_000_000).contains("\"burst_fps\":null"));
+    }
+
+    #[test]
+    fn inputs_without_a_timely_frame_are_not_counted() {
+        let mut s = Stats::new(cfg(), 0);
+        let t = 50_000_000_000i64;
+        s.on_event("wl_pointer", "motion", &key(0), t);
+        // the next frame comes 400 ms later
+        let c = t + 400_000_000;
+        s.on_request("wp_presentation", "feedback", &feedback(3, 7), c, c, true);
+        s.on_request("wl_surface", "commit", &commit(3), c, c, true);
+        s.on_event("wp_presentation_feedback", "presented", &presented(7, c + 4_000_000), c + 4_100_000);
+        assert_eq!(s.summary(c + 5_000_000).input, None);
+    }
+
+    #[test]
+    fn non_toplevel_commits_do_not_count() {
+        let mut s = Stats::new(cfg(), 0);
+        let t = 1_000_000_000i64;
+        s.on_request("wp_presentation", "feedback", &feedback(4, 8), t, t, false);
+        s.on_request("wl_surface", "commit", &commit(4), t, t, false);
+        s.on_event("wp_presentation_feedback", "presented", &presented(8, t + 1), t + 2);
+        let sum = s.summary(t + 3);
+        assert_eq!((sum.commits, sum.presented), (0, 0));
+        assert!(s.requested.is_empty() && s.frames.is_empty());
+    }
+}
