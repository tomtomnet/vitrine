+    #[test]
+    fn modes_and_types() {
+        assert_eq!("focus".parse::<ClipboardMode>(), Ok(ClipboardMode::Focus));
+        assert_eq!("Text".parse::<ClipboardMode>(), Ok(ClipboardMode::Text));
+        assert_eq!("off".parse::<ClipboardMode>(), Ok(ClipboardMode::Off));
+        assert!("both".parse::<ClipboardMode>().is_err());
+        let m = |v: &[&str]| v.iter().map(|s| s.to_string()).collect::<Vec<_>>();
+        assert_eq!(best_text(&m(&["TEXT", "text/plain;charset=UTF-8", PNG])), Some("text/plain;charset=UTF-8"));
+        assert_eq!(best_text(&m(&["STRING", "text/plain"])), Some("text/plain"));
+        assert_eq!(best_text(&m(&[PNG, "text/html"])), None);
+        assert!(is_text("UTF8_STRING") && !is_text("text/html"));
+        assert_eq!(offered_types(false, true), vec![PNG, MARKER.as_str()]);
+        // another proxy's marker (a second nested desktop) is not this one's
+        assert!(MARKER.starts_with(MARKER_BASE) && MARKER.len() > MARKER_BASE.len());
+        assert!(!has(&m(&["application/x-wl-cross-domain-proxy;instance=0000000000000001"]), &MARKER));
+        assert!(has(&m(&[MARKER.as_str()]), &MARKER));
+        assert_eq!(offered_types(true, false).len(), TEXT_TYPES.len() + 1);
