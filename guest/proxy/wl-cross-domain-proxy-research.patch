+    /// The host side against a scripted host: data device at the first focus,
+    /// the host's selection read (text) and set in a guest (a socket pair
+    /// standing for the nested compositor), the guest's own selection coming
+    /// back to the host recognised.
+    #[test]
+    fn host_selection_reaches_the_guest_and_its_echo_stops() {
+        let mut own = OwnObjects::new();
+        own.free.extend(FIRST_OWN + 1..FIRST_OWN + 16);
+        let mut cb = Clipboard::new(ClipboardConfig {
+            mode: ClipboardMode::Focus,
+            guest_display: "/nonexistent".to_owned(),
+        })
+        .unwrap();
+        let mut out = Vec::new();
+        let mut global = |name: u32, iface: &str, version: u32| {
+            let mut msg = ev(FIRST_OWN, smallvec![Argument::Uint(name), s(iface), Argument::Uint(version)]);
+            cb.on_own_event(OwnKind::Registry, FIRST_OWN, "global", &mut msg, &mut own, &mut out);
+        };
+        global(5, "wl_seat", 9);
+        global(6, "wl_data_device_manager", 3);
+        // the guest end: a socket pair; the clipboard's side gets the guest's globals below
+        let (ours, theirs) = UnixStream::pair().unwrap();
+        ours.set_nonblocking(true).unwrap();
+        let client = GuestClient::new(ours).unwrap();
+        epoll_add(&cb.epoll, client.sock.as_fd()).unwrap();
+        cb.guest = Some(client);
+        cb.guest_tried = Some(Instant::now());
+        // focus: data device on the host
+        let enter = ev(30, smallvec![Argument::Uint(77), Argument::Object(3), Argument::Array(Box::new(vec![]))]);
+        cb.on_event("wl_keyboard", "enter", &enter, &mut own, &mut out);
+        assert!(cb.focused && cb.serial == Some(77));
+        assert_eq!(named(&out, cb.manager.unwrap(), &WL_DATA_DEVICE_MANAGER_INTERFACE, "get_data_device").len(), 1);
+        let device = cb.device.unwrap();
+        out.clear();
+
+        // the host's selection: text offered, read through a pipe
+        let offer = 0xff00_0001;
+        let mut m = ev(device, smallvec![Argument::NewId(offer)]);
+        cb.on_own_event(OwnKind::DataDevice, device, "data_offer", &mut m, &mut own, &mut out);
+        assert_eq!(own.server_kind(offer), Some(OwnKind::DataOffer));
+        for mime in ["text/plain", "text/plain;charset=utf-8"] {
+            let mut m = ev(offer, smallvec![s(mime)]);
+            cb.on_own_event(OwnKind::DataOffer, offer, "offer", &mut m, &mut own, &mut out);
+        }
+        let mut m = ev(device, smallvec![Argument::Object(offer)]);
+        cb.on_own_event(OwnKind::DataDevice, device, "selection", &mut m, &mut own, &mut out);
+        let receive = out.pop().unwrap();
+        assert_eq!(receive.sender_id, offer);
+        let [Argument::Str(Some(ref mime)), Argument::Fd(ref fd)] = receive.args[..] else { panic!() };
+        assert_eq!(mime.to_bytes(), b"text/plain;charset=utf-8");
+        rustix::io::write(fd, b"hello from the host").unwrap();
+        drop(receive);
+        // the reader thread reports; the guest is not ready yet: pending
+        let t = Instant::now();
+        while cb.guest_pending.is_none() && t.elapsed() < Duration::from_secs(5) {
+            std::thread::sleep(Duration::from_millis(5));
+            cb.dispatch(&mut own, &mut out);
+        }
+        assert_eq!(cb.guest_pending.as_ref().unwrap().text.as_deref().map(|t| t.as_slice()), Some(&b"hello from the host"[..]));
+
+        // the nested compositor's globals make the guest client ready: the pending selection is set
+        let mut guest = BufferedSocket::new(Socket::from(theirs));
+        let registry_global = |name: u32, iface: &str| Message {
+            sender_id: 2,
+            opcode: 0,
+            args: smallvec![Argument::Uint(name), s(iface), Argument::Uint(1)],
+        };
+        guest.write_message(&registry_global(1, "wl_seat")).unwrap();
+        guest.write_message(&registry_global(2, "ext_data_control_manager_v1")).unwrap();
+        guest.flush().unwrap();
+        let t = Instant::now();
+        while cb.guest_current.is_none() && t.elapsed() < Duration::from_secs(5) {
+            std::thread::sleep(Duration::from_millis(5));
+            cb.dispatch(&mut own, &mut out);
+        }
+        let source = cb.guest_current.expect("the host's selection set in the guest");
+        // the requests the nested compositor got: registry, sync, binds, device, source, offers, set_selection
+        std::thread::sleep(Duration::from_millis(20));
+        let _ = guest.fill_incoming_buffers();
+        let mut names = Vec::new();
+        let interfaces: [(u32, &'static Interface); 6] = [
+            (1, &WL_DISPLAY_INTERFACE),
+            (2, &WL_REGISTRY_INTERFACE),
+            (4, &WL_SEAT_INTERFACE),
+            (5, &EXT_DATA_CONTROL_MANAGER_V1_INTERFACE),
+            (6, &EXT_DATA_CONTROL_DEVICE_V1_INTERFACE),
+            (source, &EXT_DATA_CONTROL_SOURCE_V1_INTERFACE),
+        ];
+        let lookup = |id: u32| interfaces.iter().find(|(i, _)| *i == id).map(|(_, f)| *f);
+        while let Ok(msg) = guest.read_one_message(|id, op| lookup(id).and_then(|f| f.requests.get(op as usize)).map(|r| r.signature)) {
+            let iface = lookup(msg.sender_id).unwrap();
+            names.push(format!("{}.{}", iface.name, iface.requests[msg.opcode as usize].name));
+        }
+        assert_eq!(names.iter().filter(|n| *n == "ext_data_control_source_v1.offer").count(), TEXT_TYPES.len() + 1);
+        assert_eq!(names.last().map(String::as_str), Some("ext_data_control_device_v1.set_selection"));
+
+        // the nested compositor cancels a source twice (KWin 6.8 did): one destroy, one event
+        let mut events = Vec::new();
+        let client = cb.guest.as_mut().unwrap();
+        let spare = client.set_selection(&["text/plain"]).unwrap().unwrap();
+        for _ in 0..2 {
+            client.handle(Message { sender_id: spare, opcode: 1, args: smallvec![] }, &mut events).unwrap();
+        }
+        assert_eq!(events.iter().filter(|e| matches!(e, GuestEvent::Cancelled { source } if *source == spare)).count(), 1);
+        assert!(client.dying.contains(&spare));
+        client.handle(Message { sender_id: 1, opcode: 1, args: smallvec![Argument::Uint(spare)] }, &mut events).unwrap();
+        assert!(!client.dying.contains(&spare) && client.free_ids.contains(&spare));
+        client.flush().unwrap();
+        // the old offer and the request stream: one destroy of the spare source
+        std::thread::sleep(Duration::from_millis(20));
+        let _ = guest.fill_incoming_buffers();
+        let mut destroys = 0;
+        while let Ok(msg) = guest.read_one_message(|id, op| {
+            if id == spare {
+                EXT_DATA_CONTROL_SOURCE_V1_INTERFACE.requests.get(op as usize).map(|r| r.signature)
+            } else {
+                lookup(id).and_then(|f| f.requests.get(op as usize)).map(|r| r.signature)
+            }
+        }) {
+            if msg.sender_id == spare && msg.opcode == request_opcode(&EXT_DATA_CONTROL_SOURCE_V1_INTERFACE, "destroy") {
+                destroys += 1;
+            }
+        }
+        assert_eq!(destroys, 1);
+        // the proxy's own source is still the one it set
+        cb.guest_current = Some(source);
+
+        // the guest pastes: the source writes the host's text
+        let (r, w) = pipe().unwrap();
+        cb.on_guest_event(GuestEvent::Send { source, mime: "UTF8_STRING".to_owned(), fd: w }, &mut out);
+        assert_eq!(read_all(&r, MAX_SIZE, Duration::from_secs(5)).unwrap(), b"hello from the host");
+
+        // the same host selection offered again at the next focus: not set again
+        let before = cb.guest_current;
+        let offer2 = 0xff00_0002;
+        let mut m = ev(device, smallvec![Argument::NewId(offer2)]);
+        cb.on_own_event(OwnKind::DataDevice, device, "data_offer", &mut m, &mut own, &mut out);
+        let mut m = ev(offer2, smallvec![s("text/plain;charset=utf-8")]);
+        cb.on_own_event(OwnKind::DataOffer, offer2, "offer", &mut m, &mut own, &mut out);
+        out.clear();
+        let mut m = ev(device, smallvec![Argument::Object(offer2)]);
+        cb.on_own_event(OwnKind::DataDevice, device, "selection", &mut m, &mut own, &mut out);
+        // the old offer destroyed, the new one read
+        assert_eq!(named(&out, offer, &WL_DATA_OFFER_INTERFACE, "destroy").len(), 1);
+        assert_eq!(own.server_kind(offer), None);
+        let receive = out.pop().unwrap();
+        let [_, Argument::Fd(ref fd)] = receive.args[..] else { panic!() };
+        rustix::io::write(fd, b"hello from the host").unwrap();
+        drop(receive);
+        let t = Instant::now();
+        while t.elapsed() < Duration::from_millis(300) {
+            std::thread::sleep(Duration::from_millis(5));
+            cb.dispatch(&mut own, &mut out);
+        }
+        assert_eq!(cb.guest_current, before);
+
+        // the guest's selection set by the proxy comes back (marker): nothing is read
+        cb.on_guest_event(GuestEvent::Selection { offer: 0xff00_0100, mimes: vec![MARKER.clone()] }, &mut out);
+        assert!(cb.guest_read.is_none());
+        // a selection made in the guest while focused is read (here: no guest compositor to answer)
+        cb.on_guest_event(
+            GuestEvent::Selection { offer: 0xff00_0101, mimes: vec!["text/plain".to_owned()] },
+            &mut out,
+        );
+        assert!(cb.guest_read.is_some());
+        assert_eq!(cb.guest_current, None);
+    }
+
+    /// The guest -> host side: the guest's selection read, set on the host with
+    /// the last input serial, served when the host asks; the host's echo is
+    /// recognised; nothing crosses while the window is not focused.
+    #[test]
+    fn guest_selection_reaches_the_host_only_while_focused() {
+        let mut own = OwnObjects::new();
+        own.free.extend(FIRST_OWN + 1..FIRST_OWN + 16);
+        let mut cb = Clipboard::new(ClipboardConfig {
+            mode: ClipboardMode::Focus,
+            guest_display: "/nonexistent".to_owned(),
+        })
+        .unwrap();
+        let mut out = Vec::new();
+        for (name, iface) in [(5, "wl_seat"), (6, "wl_data_device_manager")] {
+            let mut msg = ev(FIRST_OWN, smallvec![Argument::Uint(name), s(iface), Argument::Uint(3)]);
+            cb.on_own_event(OwnKind::Registry, FIRST_OWN, "global", &mut msg, &mut own, &mut out);
+        }
+        let enter = ev(30, smallvec![Argument::Uint(10), Argument::Object(3), Argument::Array(Box::new(vec![]))]);
+        cb.on_event("wl_keyboard", "enter", &enter, &mut own, &mut out);
+        let key = ev(30, smallvec![Argument::Uint(11), Argument::Uint(0), Argument::Uint(46), Argument::Uint(1)]);
+        cb.on_event("wl_keyboard", "key", &key, &mut own, &mut out);
+        out.clear();
+
+        // the guest's selection, read (as the threads would report it)
+        cb.guest_generation = 1;
+        cb.guest_read = Some(GuestRead {
+            generation: 1,
+            text: Part::Reading,
+            png: Part::Reading,
+        });
+        cb.on_done(Done::Guest { generation: 1, png: false, data: Some(b"copied in the guest".to_vec()) }, &mut own, &mut out);
+        assert!(out.is_empty(), "waits for the image");
+        cb.on_done(Done::Guest { generation: 1, png: true, data: Some(vec![0x89, b'P', b'N', b'G']) }, &mut own, &mut out);
+        let set = named(&out, cb.device.unwrap(), &WL_DATA_DEVICE_INTERFACE, "set_selection");
+        assert_eq!(set.len(), 1);
+        let [Argument::Object(source), Argument::Uint(serial)] = set[0].args[..] else { panic!() };
+        assert_eq!(serial, 11);
+        assert_eq!(named(&out, source, &WL_DATA_SOURCE_INTERFACE, "offer").len(), TEXT_TYPES.len() + 2);
+        out.clear();
+
+        // the host pastes text, then the image
+        for (mime, want) in [("text/plain;charset=utf-8", &b"copied in the guest"[..]), (PNG, &[0x89, b'P', b'N', b'G'][..])] {
+            let (r, w) = pipe().unwrap();
+            let mut send = ev(source, smallvec![s(mime), Argument::Fd(w)]);
+            cb.on_own_event(OwnKind::DataSource, source, "send", &mut send, &mut own, &mut out);
+            drop(send);
+            assert_eq!(read_all(&r, MAX_SIZE, Duration::from_secs(5)).unwrap(), want);
+        }
+
+        // the host offers it back (marker): not read
+        let offer = 0xff00_0009;
+        let device = cb.device.unwrap();
+        let mut m = ev(device, smallvec![Argument::NewId(offer)]);
+        cb.on_own_event(OwnKind::DataDevice, device, "data_offer", &mut m, &mut own, &mut out);
+        for mime in offered_types(true, true) {
+            let mut m = ev(offer, smallvec![s(mime)]);
+            cb.on_own_event(OwnKind::DataOffer, offer, "offer", &mut m, &mut own, &mut out);
+        }
+        let mut m = ev(device, smallvec![Argument::Object(offer)]);
+        cb.on_own_event(OwnKind::DataDevice, device, "selection", &mut m, &mut own, &mut out);
+        assert!(named(&out, offer, &WL_DATA_OFFER_INTERFACE, "receive").is_empty());
+
+        // the same content again (a clipboard manager in the guest): not set again
+        cb.guest_generation = 2;
+        cb.guest_read = Some(GuestRead { generation: 2, text: Part::Read(Some(b"copied in the guest".to_vec())), png: Part::Read(Some(vec![0x89, b'P', b'N', b'G'])) });
+        out.clear();
+        cb.offer_to_host(&mut own, &mut out);
+        assert!(out.is_empty());
+
+        // not focused: a new guest selection stays in the guest
+        let leave = ev(30, smallvec![Argument::Uint(12), Argument::Object(3)]);
+        cb.on_event("wl_keyboard", "leave", &leave, &mut own, &mut out);
+        cb.on_guest_event(GuestEvent::Selection { offer: 0xff00_0200, mimes: vec!["text/plain".to_owned()] }, &mut out);
+        assert!(cb.guest_read.is_none());
+
+        // the host cancels the proxy's selection: destroyed, once even if cancelled twice
+        for _ in 0..2 {
+            let mut m = ev(source, smallvec![]);
+            cb.on_own_event(OwnKind::DataSource, source, "cancelled", &mut m, &mut own, &mut out);
+        }
+        assert_eq!(named(&out, source, &WL_DATA_SOURCE_INTERFACE, "destroy").len(), 1);
+        assert!(cb.host_current.is_none());
+    }
+}
diff -ruN a/src/session/fence.rs b/src/session/fence.rs
--- a/src/session/fence.rs
+++ b/src/session/fence.rs
@@ -0,0 +1,577 @@
+//! Fence gate: a guest commit of a dma-buf reaches the host only once the
+//! rendering into that buffer has finished.
+//!
+//! Wayland clients rely on implicit sync: the compositor waits for the write
+//! fences in a dma-buf's reservation object before it samples the buffer
+//! (KWin exports them with DMA_BUF_IOCTL_EXPORT_SYNC_FILE, see its
+//! `Transaction::watchDmaBuf`). Across the VM boundary the host's buffer has no
+//! such fence: with DRM native context, the guest's GPU work is submitted to
+//! the host driver by virglrenderer, and neither the Xe native context
+//! (`xe_ccmd_exec` attaches its out-fence to no dma-buf) nor host Xe itself
+//! (exec fences are DMA_RESV_USAGE_BOOKKEEP) marks the exported buffer, so the
+//! host compositor samples it at once, possibly before or while the guest's
+//! frame is drawn: partially drawn frames, where freshly cleared (transparent)
+//! regions flash. In the guest the fence exists: guest Mesa (iris) imports each
+//! batch's out-fence into the guest dma-buf, and the virtio-gpu fence behind
+//! it signals when the host GPU has finished the batch.
+//!
+//! So the gate does in the guest what the host compositor would do: at a
+//! wl_surface.commit that attaches a dma-buf, it exports the buffer's pending
+//! write fences as sync files and holds this and every later request of the
+//! connection (order is preserved) until they signal. Events from the host
+//! keep flowing meanwhile. A timeout forwards the commit anyway, so a GPU hang
+//! cannot freeze the connection.
+
+use std::collections::{HashMap, HashSet, VecDeque};
+use std::io;
+use std::mem;
+use std::os::fd::{AsFd, AsRawFd, BorrowedFd, FromRawFd, OwnedFd, RawFd};
+use std::time::{Duration, Instant};
+
+use log::{debug, info, warn};
+use wayland_server::backend::protocol::{Argument, Message};
+
+use crate::wl_proto::{Data, Object};
+
+#[derive(Debug, Clone)]
+pub struct FenceConfig {
+    /// Wait for dma-buf fences before forwarding commits.
+    pub enabled: bool,
+    /// Longest wait before a commit is forwarded anyway.
+    pub timeout: Duration,
+}
+
+impl Default for FenceConfig {
+    fn default() -> Self {
+        FenceConfig {
+            enabled: true,
+            timeout: Duration::from_millis(1000),
+        }
+    }
+}
+
+// <linux/dma-buf.h>
+const DMA_BUF_SYNC_READ: u32 = 1 << 0;
+#[repr(C)]
+struct DmaBufExportSyncFile {
+    flags: u32,
+    fd: i32,
+}
+// _IOWR('b', 2, struct dma_buf_export_sync_file)
+const DMA_BUF_IOCTL_EXPORT_SYNC_FILE: libc::c_ulong = 0xC008_6202;
+
+/// epoll data of the timeout timer.
+const TIMER_TOKEN: u64 = u64::MAX;
+
+fn readable(fd: BorrowedFd<'_>) -> bool {
+    let mut pfd = libc::pollfd {
+        fd: fd.as_raw_fd(),
+        events: libc::POLLIN,
+        revents: 0,
+    };
+    // SAFETY: one valid pollfd
+    let n = unsafe { libc::poll(&mut pfd, 1, 0) };
+    n > 0 && pfd.revents & libc::POLLIN != 0
+}
+
+/// Sync file of the fences a reader of this dma-buf must wait for.
+fn export_wait_sync_file(fd: BorrowedFd<'_>) -> io::Result<OwnedFd> {
+    let mut arg = DmaBufExportSyncFile {
+        flags: DMA_BUF_SYNC_READ,
+        fd: -1,
+    };
+    // SAFETY: the ioctl writes a new fd into `arg`
+    let r = unsafe { libc::ioctl(fd.as_raw_fd(), DMA_BUF_IOCTL_EXPORT_SYNC_FILE, &mut arg) };
+    if r < 0 || arg.fd < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    // SAFETY: fresh fd from the kernel
+    Ok(unsafe { OwnedFd::from_raw_fd(arg.fd) })
+}
+
+#[derive(Default)]
+struct Stats {
+    since: Option<Instant>,
+    commits: u64,
+    waited: u64,
+    timeouts: u64,
+    wait_sum: Duration,
+    wait_max: Duration,
+    total_commits: u64,
+    total_waited: u64,
+}
+
+pub struct FenceGate {
+    cfg: FenceConfig,
+    stats_interval: Duration,
+    epoll: OwnedFd,
+    timer: OwnedFd,
+    /// zwp_linux_buffer_params_v1 -> plane fds (dups)
+    params: HashMap<u32, Vec<OwnedFd>>,
+    /// params with a pending `create` (the host answers with `created`)
+    creating: HashSet<u32>,
+    /// dma-buf wl_buffer -> plane fds
+    buffers: HashMap<u32, Vec<OwnedFd>>,
+    /// wl_surface -> buffer attached since its last commit
+    attached: HashMap<u32, u32>,
+    /// guest requests in arrival order, with the time the proxy read them
+    queue: VecDeque<(Message<u32, OwnedFd>, Object<Data>, i64)>,
+    /// sync files (or dma-bufs) the head commit waits for, registered in `epoll`
+    waiting: Vec<OwnedFd>,
+    wait_started: Option<Instant>,
+    /// forward the head commit without checking (its wait is over)
+    release_head: bool,
+    stats: Stats,
+    warned_export: bool,
+}
+
+impl FenceGate {
+    pub fn new(cfg: FenceConfig, stats_interval_s: i64) -> io::Result<Self> {
+        // SAFETY: plain syscalls, results checked
+        let epoll = unsafe { libc::epoll_create1(libc::EPOLL_CLOEXEC) };
+        if epoll < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        let epoll = unsafe { OwnedFd::from_raw_fd(epoll) };
+        let timer = unsafe {
+            libc::timerfd_create(libc::CLOCK_MONOTONIC, libc::TFD_NONBLOCK | libc::TFD_CLOEXEC)
+        };
+        if timer < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        let timer = unsafe { OwnedFd::from_raw_fd(timer) };
+        let gate = FenceGate {
+            cfg,
+            stats_interval: Duration::from_secs(stats_interval_s.max(0) as u64),
+            epoll,
+            timer,
+            params: HashMap::new(),
+            creating: HashSet::new(),
+            buffers: HashMap::new(),
+            attached: HashMap::new(),
+            queue: VecDeque::new(),
+            waiting: Vec::new(),
+            wait_started: None,
+            release_head: false,
+            stats: Stats::default(),
+            warned_export: false,
+        };
+        gate.epoll_add(gate.timer.as_raw_fd(), TIMER_TOKEN)?;
+        Ok(gate)
+    }
+
+    /// Readable while a fence of the current wait (or its timeout) is ready;
+    /// register it in the event loop and call [`FenceGate::dispatch`].
+    pub fn fd(&self) -> BorrowedFd<'_> {
+        self.epoll.as_fd()
+    }
+
+    fn epoll_add(&self, fd: RawFd, token: u64) -> io::Result<()> {
+        let mut ev = libc::epoll_event {
+            events: libc::EPOLLIN as u32,
+            u64: token,
+        };
+        // SAFETY: valid epoll fd and event
+        if unsafe { libc::epoll_ctl(self.epoll.as_raw_fd(), libc::EPOLL_CTL_ADD, fd, &mut ev) } < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        Ok(())
+    }
+
+    fn epoll_del(&self, fd: RawFd) {
+        // SAFETY: valid epoll fd; a missing fd is harmless
+        unsafe {
+            libc::epoll_ctl(self.epoll.as_raw_fd(), libc::EPOLL_CTL_DEL, fd, std::ptr::null_mut());
+        }
+    }
+
+    fn arm_timer(&self, after: Option<Duration>) {
+        let d = after.unwrap_or_default();
+        let spec = libc::itimerspec {
+            it_interval: libc::timespec { tv_sec: 0, tv_nsec: 0 },
+            it_value: libc::timespec {
+                tv_sec: d.as_secs() as libc::time_t,
+                tv_nsec: d.subsec_nanos() as libc::c_long,
+            },
+        };
+        // SAFETY: valid timerfd and spec; zero disarms
+        unsafe { libc::timerfd_settime(self.timer.as_raw_fd(), 0, &spec, std::ptr::null_mut()) };
+    }
+
+    /// Queues a guest request (guest ids), in arrival order; `received` is
+    /// when the proxy read it (kept for the statistics).
+    pub fn push(&mut self, msg: Message<u32, OwnedFd>, obj: Object<Data>, received: i64) {
+        self.queue.push_back((msg, obj, received));
+    }
+
+    #[allow(dead_code)]
+    pub fn is_waiting(&self) -> bool {
+        self.wait_started.is_some()
+    }
+
+    /// Next request that may be forwarded now, with the time it was read,
+    /// `None` while the queue is empty or the head commit waits for its buffer.
+    pub fn pop(&mut self) -> Option<(Message<u32, OwnedFd>, Object<Data>, i64)> {
+        if self.wait_started.is_some() {
+            return None;
+        }
+        let (msg, obj, _) = self.queue.front()?;
+        let request = obj.interface.requests[msg.opcode as usize].name;
+        if !self.release_head && obj.interface.name == "wl_surface" && request == "commit" {
+            if let Some(fds) = self
+                .attached
+                .get(&msg.sender_id)
+                .and_then(|buffer| self.buffers.get(buffer))
+            {
+                self.stats.commits += 1;
+                self.stats.total_commits += 1;
+                if self.cfg.enabled {
+                    let mut pending = Vec::new();
+                    for fd in fds {
+                        if readable(fd.as_fd()) {
+                            continue;
+                        }
+                        match export_wait_sync_file(fd.as_fd()) {
+                            Ok(sync_file) => pending.push(sync_file),
+                            Err(err) => {
+                                if !self.warned_export {
+                                    self.warned_export = true;
+                                    warn!("fences: DMA_BUF_IOCTL_EXPORT_SYNC_FILE failed ({err}), polling the dma-buf instead");
+                                }
+                                match fd.try_clone() {
+                                    Ok(dup) => pending.push(dup),
+                                    Err(err) => warn!("fences: dup failed: {err}"),
+                                }
+                            }
+                        }
+                    }
+                    if !pending.is_empty() && self.start_wait(pending) {
+                        return None;
+                    }
+                }
+            }
+        }
+        self.release_head = false;
+        let (msg, obj, received) = self.queue.pop_front()?;
+        self.observe(&msg, &obj);
+        self.maybe_log();
+        Some((msg, obj, received))
+    }
+
+    fn start_wait(&mut self, pending: Vec<OwnedFd>) -> bool {
+        for fd in &pending {
+            if let Err(err) = self.epoll_add(fd.as_raw_fd(), fd.as_raw_fd() as u64) {
+                warn!("fences: epoll_ctl failed ({err}), not waiting");
+                for fd in &pending {
+                    self.epoll_del(fd.as_raw_fd());
+                }
+                return false;
+            }
+        }
+        self.waiting = pending;
+        self.wait_started = Some(Instant::now());
+        self.arm_timer(Some(self.cfg.timeout));
+        self.stats.waited += 1;
+        self.stats.total_waited += 1;
+        true
+    }
+
+    fn finish_wait(&mut self, timed_out: bool) {
+        let Some(started) = self.wait_started.take() else {
+            return;
+        };
+        let waited = started.elapsed();
+        self.arm_timer(None);
+        for fd in mem::take(&mut self.waiting) {
+            self.epoll_del(fd.as_raw_fd());
+        }
+        self.stats.wait_sum += waited;
+        self.stats.wait_max = self.stats.wait_max.max(waited);
+        if timed_out {
+            self.stats.timeouts += 1;
+            warn!(
+                "fences: a dma-buf was not ready after {} ms, forwarding its commit anyway",
+                waited.as_millis()
+            );
+        } else {
+            debug!("fences: waited {:.3} ms", waited.as_secs_f64() * 1e3);
+        }
+        self.release_head = true;
+    }
+
+    /// Handles readiness of [`FenceGate::fd`].
+    pub fn dispatch(&mut self) {
+        loop {
+            let mut events: [libc::epoll_event; 8] = unsafe { mem::zeroed() };
+            // SAFETY: valid epoll fd and buffer
+            let n = unsafe { libc::epoll_wait(self.epoll.as_raw_fd(), events.as_mut_ptr(), 8, 0) };
+            if n <= 0 {
+                break;
+            }
+            let mut timed_out = false;
+            for ev in &events[..n as usize] {
+                if ev.u64 == TIMER_TOKEN {
+                    let mut buf = [0u8; 8];
+                    // SAFETY: reading the expiration count of the timerfd
+                    unsafe { libc::read(self.timer.as_raw_fd(), buf.as_mut_ptr().cast(), 8) };
+                    timed_out = self.wait_started.is_some();
+                } else {
+                    let fd = ev.u64 as RawFd;
+                    self.epoll_del(fd);
+                    self.waiting.retain(|w| w.as_raw_fd() != fd);
+                }
+            }
+            if timed_out {
+                self.finish_wait(true);
+            } else if self.wait_started.is_some() && self.waiting.is_empty() {
+                self.finish_wait(false);
+            }
+        }
+    }
+
+    /// Tracks dma-buf buffers and attachments, for requests being forwarded.
+    fn observe(&mut self, msg: &Message<u32, OwnedFd>, obj: &Object<Data>) {
+        let request = obj.interface.requests[msg.opcode as usize].name;
+        match (obj.interface.name, request) {
+            ("zwp_linux_buffer_params_v1", "add") => {
+                if let Some(Argument::Fd(fd)) = msg.args.first() {
+                    match fd.try_clone() {
+                        Ok(dup) => self.params.entry(msg.sender_id).or_default().push(dup),
+                        Err(err) => warn!("fences: dup of a dma-buf failed: {err}"),
+                    }
+                }
+            }
+            ("zwp_linux_buffer_params_v1", "create_immed") => {
+                if let Some(Argument::NewId(buffer)) = msg.args.first() {
+                    if let Some(fds) = self.params.remove(&msg.sender_id) {
+                        self.buffers.insert(*buffer, fds);
+                    }
+                }
+            }
+            ("zwp_linux_buffer_params_v1", "create") => {
+                self.creating.insert(msg.sender_id);
+            }
+            ("zwp_linux_buffer_params_v1", "destroy") => {
+                if !self.creating.contains(&msg.sender_id) {
+                    self.params.remove(&msg.sender_id);
+                }
+            }
+            ("wl_buffer", "destroy") => {
+                self.buffers.remove(&msg.sender_id);
+            }
+            ("wl_surface", "attach") => match msg.args.first() {
+                Some(Argument::Object(buffer)) if *buffer != 0 => {
+                    self.attached.insert(msg.sender_id, *buffer);
+                }
+                _ => {
+                    self.attached.remove(&msg.sender_id);
+                }
+            },
+            ("wl_surface", "commit") | ("wl_surface", "destroy") => {
+                self.attached.remove(&msg.sender_id);
+            }
+            _ => {}
+        }
+    }
+
+    /// Host events (guest ids) that complete a dma-buf creation.
+    pub fn on_host_event(&mut self, interface: &str, event: &str, msg: &Message<u32, OwnedFd>) {
+        match (interface, event) {
+            ("zwp_linux_buffer_params_v1", "created") => {
+                self.creating.remove(&msg.sender_id);
+                if let (Some(Argument::NewId(buffer)), Some(fds)) =
+                    (msg.args.first(), self.params.remove(&msg.sender_id))
+                {
+                    self.buffers.insert(*buffer, fds);
+                }
+            }
+            ("zwp_linux_buffer_params_v1", "failed") => {
+                self.creating.remove(&msg.sender_id);
+                self.params.remove(&msg.sender_id);
+            }
+            _ => {}
+        }
+    }
+
+    fn maybe_log(&mut self) {
+        if self.stats_interval.is_zero() {
+            return;
+        }
+        let now = Instant::now();
+        let since = *self.stats.since.get_or_insert(now);
+        if now.duration_since(since) < self.stats_interval || self.stats.commits == 0 {
+            return;
+        }
+        let s = &self.stats;
+        let mean_ms = if s.waited > 0 {
+            s.wait_sum.as_secs_f64() * 1e3 / s.waited as f64
+        } else {
+            0.0
+        };
+        info!(
+            "fences: {} dma-buf commits in {:.0} s, {} ({:.1} %) waited for rendering, mean {:.3} ms, max {:.3} ms, {} timeouts{} (total {} of {})",
+            s.commits,
+            now.duration_since(since).as_secs_f64(),
+            s.waited,
+            100.0 * s.waited as f64 / s.commits as f64,
+            mean_ms,
+            s.wait_max.as_secs_f64() * 1e3,
+            s.timeouts,
+            if self.cfg.enabled { "" } else { " [gate off: counted, not waited]" },
+            s.total_waited,
+            s.total_commits,
+        );
+        let (tc, tw) = (s.total_commits, s.total_waited);
+        self.stats = Stats {
+            since: Some(now),
+            total_commits: tc,
+            total_waited: tw,
+            ..Stats::default()
+        };
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use smallvec::smallvec;
+    use wayland_protocols::wp::linux_dmabuf::zv1::server::__interfaces::ZWP_LINUX_BUFFER_PARAMS_V1_INTERFACE;
+    use wayland_server::protocol::__interfaces::{WL_BUFFER_INTERFACE, WL_SURFACE_INTERFACE};
+
+    fn obj(interface: &'static wayland_server::backend::protocol::Interface) -> Object<Data> {
+        Object {
+            interface,
+            version: 5,
+            data: Data,
+        }
+    }
+    fn op(interface: &wayland_server::backend::protocol::Interface, name: &str) -> u16 {
+        super::super::request_opcode(interface, name)
+    }
+
+    /// A pipe stands in for a dma-buf: its read end is "readable" (fences
+    /// signalled) once data is written. EXPORT_SYNC_FILE fails on a pipe, so
+    /// this also covers the polling fallback.
+    #[test]
+    fn commit_waits_for_the_buffer_and_keeps_order() {
+        let mut gate = FenceGate::new(FenceConfig::default(), 0).unwrap();
+        let (r, w) = std::io::pipe().unwrap();
+        let params = 40;
+        let buffer = 41;
+        let surface = 42;
+        let fd: OwnedFd = r.into();
+        gate.push(
+            Message {
+                sender_id: params,
+                opcode: op(&ZWP_LINUX_BUFFER_PARAMS_V1_INTERFACE, "add"),
+                args: smallvec![
+                    Argument::Fd(fd),
+                    Argument::Uint(0),
+                    Argument::Uint(0),
+                    Argument::Uint(4096),
+                    Argument::Uint(0),
+                    Argument::Uint(0)
+                ],
+            },
+            obj(&ZWP_LINUX_BUFFER_PARAMS_V1_INTERFACE),
+            0,
+        );
+        gate.push(
+            Message {
+                sender_id: params,
+                opcode: op(&ZWP_LINUX_BUFFER_PARAMS_V1_INTERFACE, "create_immed"),
+                args: smallvec![
+                    Argument::NewId(buffer),
+                    Argument::Int(64),
+                    Argument::Int(64),
+                    Argument::Uint(0x34325258),
+                    Argument::Uint(0)
+                ],
+            },
+            obj(&ZWP_LINUX_BUFFER_PARAMS_V1_INTERFACE),
+            0,
+        );
+        gate.push(
+            Message {
+                sender_id: surface,
+                opcode: op(&WL_SURFACE_INTERFACE, "attach"),
+                args: smallvec![Argument::Object(buffer), Argument::Int(0), Argument::Int(0)],
+            },
+            obj(&WL_SURFACE_INTERFACE),
+            0,
+        );
+        gate.push(
+            Message {
+                sender_id: surface,
+                opcode: op(&WL_SURFACE_INTERFACE, "commit"),
+                args: smallvec![],
+            },
+            obj(&WL_SURFACE_INTERFACE),
+            0,
+        );
+        gate.push(
+            Message {
+                sender_id: buffer,
+                opcode: op(&WL_BUFFER_INTERFACE, "destroy"),
+                args: smallvec![],
+            },
+            obj(&WL_BUFFER_INTERFACE),
+            0,
+        );
+        // add, create_immed, attach pass; the commit waits
+        for _ in 0..3 {
+            assert!(gate.pop().is_some());
+        }
+        assert!(gate.pop().is_none());
+        assert!(gate.is_waiting());
+        assert!(!readable(gate.fd()));
+        // the "rendering" finishes
+        use std::io::Write;
+        (&w).write_all(b"x").unwrap();
+        assert!(readable(gate.fd()));
+        gate.dispatch();
+        assert!(!gate.is_waiting());
+        let (commit, o, _) = gate.pop().unwrap();
+        assert_eq!(o.interface.name, "wl_surface");
+        assert_eq!(commit.opcode, op(&WL_SURFACE_INTERFACE, "commit"));
+        let (destroy, o, _) = gate.pop().unwrap();
+        assert_eq!(o.interface.name, "wl_buffer");
+        assert_eq!(destroy.sender_id, buffer);
+        assert!(gate.pop().is_none());
+        assert_eq!(gate.stats.total_waited, 1);
+    }
+
+    #[test]
+    fn timeout_forwards_the_commit() {
+        let mut gate = FenceGate::new(
+            FenceConfig {
+                enabled: true,
+                timeout: Duration::from_millis(30),
+            },
+            0,
+        )
+        .unwrap();
+        let (r, _w) = std::io::pipe().unwrap();
+        let fd: OwnedFd = r.into();
+        gate.buffers.insert(7, vec![fd]);
+        gate.attached.insert(8, 7);
+        gate.push(
+            Message {
+                sender_id: 8,
+                opcode: op(&WL_SURFACE_INTERFACE, "commit"),
+                args: smallvec![],
+            },
+            obj(&WL_SURFACE_INTERFACE),
+            0,
+        );
+        assert!(gate.pop().is_none());
+        let t0 = Instant::now();
+        while !readable(gate.fd()) {
+            assert!(t0.elapsed() < Duration::from_secs(2));
+            std::thread::sleep(Duration::from_millis(5));
+        }
+        gate.dispatch();
+        assert!(gate.pop().is_some());
+        assert_eq!(gate.stats.timeouts, 1);
+    }
+}
diff -ruN a/src/session/grab.rs b/src/session/grab.rs
--- a/src/session/grab.rs
+++ b/src/session/grab.rs
@@ -0,0 +1,454 @@
+//! Pointer grab, as QEMU's SDL window does it (2026-10-08).
+//!
+//! Host KWin 6.8 handles Meta + mouse (left drag moves a window, right drag
+//! resizes it, middle, the wheel) before the window under the pointer,
+//! whatever that window's keyboard shortcuts inhibitor says - but not while the
+//! pointer is constrained (`input.cpp`, `isConstrained()`). QEMU's SDL window
+//! grabs an absolute pointer while it is over the guest (`SDL_SetWindowGrab`, a
+//! pointer confinement on Wayland), which is why Super + right drag resizes a
+//! guest window there and did not in the nested desktop.
+//!
+//! While a forwarded toplevel has the keyboard focus with the host's shortcuts
+//! captured ([`super::shortcuts`]), the pointer is over it and Meta is held (the
+//! modifier of KWin's window actions; only then: an A/B of a confinement held
+//! all the time left keys and typing ~0.7 ms slower in 3 of 4 pairs, 2026-10-08),
+//! the proxy confines the host pointer to the toplevel's surface
+//! (zwp_pointer_constraints_v1, through the guest's own wl_pointer). As QEMU's
+//! SDL window, it lets go within 3 logical pixels of the window's edge and
+//! takes the pointer again 6 pixels inside, so the pointer can leave a windowed
+//! desktop (the window's size comes from nested KWin's
+//! xdg_surface.set_window_geometry; no size, no grab). A surface takes one
+//! pointer constraint (`already_constrained` ends the connection): the proxy
+//! gives its own up before the guest locks or confines the pointer itself
+//! (nested KWin's Right Ctrl) and takes it again after the guest lets go.
+
+use std::collections::HashMap;
+use std::ffi::CString;
+use std::os::fd::OwnedFd;
+
+use log::{debug, info};
+use smallvec::smallvec;
+use wayland_protocols::wp::pointer_constraints::zv1::server::__interfaces::{
+    ZWP_CONFINED_POINTER_V1_INTERFACE, ZWP_POINTER_CONSTRAINTS_V1_INTERFACE,
+};
+use wayland_server::backend::protocol::{Argument, Message};
+use wayland_server::protocol::__interfaces::WL_REGISTRY_INTERFACE;
+
+use super::shell::Shell;
+use super::{FIRST_OWN, HostRequest, OwnKind, OwnObjects, guest_to_host, request_opcode};
+
+/// QEMU's SDL borders (ui/sdl2.c SDL2_GRAB_RELEASE_BORDER, SDL2_GRAB_ACQUIRE_BORDER).
+const RELEASE_BORDER: f64 = 3.0;
+const ACQUIRE_BORDER: f64 = 6.0;
+/// zwp_pointer_constraints_v1.lifetime.persistent
+const PERSISTENT: u32 = 2;
+
+pub(super) struct Grab {
+    enabled: bool,
+    global: Option<u32>,
+    manager: Option<u32>,
+    /// the proxy's confinement: (own id, toplevel surface, guest id)
+    confinement: Option<(u32, u32)>,
+    /// subsurface -> parent surface (guest ids)
+    parents: HashMap<u32, u32>,
+    /// window geometry size by toplevel surface (guest ids, logical pixels)
+    sizes: HashMap<u32, (f64, f64)>,
+    /// the guest's own locks and confinements: id -> toplevel surface
+    guest_constraints: HashMap<u32, u32>,
+    /// the guest's wl_pointer that has the pointer focus
+    pointer: Option<u32>,
+    /// toplevel surface under the pointer, and the pointer's position on it
+    over: Option<u32>,
+    pos: (f64, f64),
+    /// toplevel surface with the keyboard focus
+    keyboard: Option<u32>,
+    /// Meta keys held (evdev 125, 126)
+    meta: u8,
+    warned: bool,
+}
+
+fn fixed(arg: &Argument<u32, OwnedFd>) -> Option<f64> {
+    match arg {
+        Argument::Fixed(v) => Some(*v as f64 / 256.0),
+        _ => None,
+    }
+}
+
+impl Grab {
+    pub(super) fn new(enabled: bool) -> Self {
+        Grab {
+            enabled,
+            global: None,
+            manager: None,
+            confinement: None,
+            parents: HashMap::new(),
+            sizes: HashMap::new(),
+            guest_constraints: HashMap::new(),
+            pointer: None,
+            over: None,
+            pos: (0.0, 0.0),
+            keyboard: None,
+            meta: 0,
+            warned: false,
+        }
+    }
+
+    /// The toplevel surface under the pointer (guest id), for shortcuts.rs.
+    pub(super) fn over(&self) -> Option<u32> {
+        self.over
+    }
+
+    /// The toplevel surface a surface belongs to (itself or through subsurfaces).
+    fn toplevel_surface(&self, mut surface: u32, shell: &Shell) -> Option<u32> {
+        for _ in 0..8 {
+            if shell.is_toplevel_surface(surface) {
+                return Some(surface);
+            }
+            surface = *self.parents.get(&surface)?;
+        }
+        None
+    }
+
+    /// Whether the pointer is far enough inside the window to (keep) grab(bing) it.
+    fn inside(&self, surface: u32, grabbed: bool) -> bool {
+        let Some(&(w, h)) = self.sizes.get(&surface) else {
+            return false;
+        };
+        let border = if grabbed { RELEASE_BORDER } else { ACQUIRE_BORDER };
+        let (x, y) = self.pos;
+        x >= border && y >= border && x < w - border && y < h - border
+    }
+
+    fn release(&mut self, out: &mut Vec<HostRequest>) {
+        if let Some((id, surface)) = self.confinement.take() {
+            out.push(Message {
+                sender_id: id,
+                opcode: request_opcode(&ZWP_CONFINED_POINTER_V1_INTERFACE, "destroy"),
+                args: smallvec![],
+            });
+            debug!("grab: pointer released (surface {surface})");
+        }
+    }
+
+    /// Grabs or releases as the state asks; `captured`: the host's shortcuts are captured.
+    fn update(&mut self, captured: bool, own: &mut OwnObjects, out: &mut Vec<HostRequest>) {
+        let target = match (self.keyboard, self.over, self.pointer) {
+            (Some(k), Some(o), Some(_)) if k == o => Some(k),
+            _ => None,
+        };
+        let want = target.filter(|&s| {
+            self.enabled
+                && captured
+                && self.meta != 0
+                && !self.guest_constraints.values().any(|g| *g == s)
+                && self.inside(s, self.confinement.is_some_and(|(_, c)| c == s))
+        });
+        if self.confinement.map(|(_, s)| s) == want {
+            return;
+        }
+        self.release(out);
+        let (Some(surface), Some(pointer)) = (want, self.pointer) else {
+            return;
+        };
+        if self.manager.is_none() {
+            let Some(name) = self.global else {
+                if !self.warned {
+                    self.warned = true;
+                    info!("grab: the host has no zwp_pointer_constraints_v1, its Meta + mouse actions stay its own");
+                }
+                return;
+            };
+            let Some(id) = own.alloc(&ZWP_POINTER_CONSTRAINTS_V1_INTERFACE, OwnKind::PointerConstraints) else {
+                return;
+            };
+            out.push(Message {
+                sender_id: FIRST_OWN,
+                opcode: request_opcode(&WL_REGISTRY_INTERFACE, "bind"),
+                args: smallvec![
+                    Argument::Uint(name),
+                    Argument::Str(Some(Box::new(CString::new("zwp_pointer_constraints_v1").unwrap()))),
+                    Argument::Uint(1),
+                    Argument::NewId(id),
+                ],
+            });
+            self.manager = Some(id);
+        }
+        let Some(id) = own.alloc(&ZWP_CONFINED_POINTER_V1_INTERFACE, OwnKind::Confinement) else {
+            debug!("grab: no free proxy object id");
+            return;
+        };
+        out.push(Message {
+            sender_id: self.manager.unwrap(),
+            opcode: request_opcode(&ZWP_POINTER_CONSTRAINTS_V1_INTERFACE, "confine_pointer"),
+            args: smallvec![
+                Argument::NewId(id),
+                Argument::Object(guest_to_host(surface)),
+                Argument::Object(guest_to_host(pointer)),
+                Argument::Object(0),
+                Argument::Uint(PERSISTENT),
+            ],
+        });
+        self.confinement = Some((id, surface));
+        debug!("grab: pointer confined to surface {surface}");
+    }
+
+    /// A guest request (guest ids) about to be forwarded; `shell` is still in
+    /// the state before it.
+    pub(super) fn on_request(
+        &mut self,
+        interface: &str,
+        request: &str,
+        msg: &Message<u32, OwnedFd>,
+        shell: &Shell,
+        captured: bool,
+        own: &mut OwnObjects,
+        pre: &mut Vec<HostRequest>,
+        post: &mut Vec<HostRequest>,
+    ) {
+        match (interface, request) {
+            ("wl_subcompositor", "get_subsurface") => {
+                if let [Argument::NewId(_), Argument::Object(surface), Argument::Object(parent)] = msg.args[..] {
+                    self.parents.insert(surface, parent);
+                }
+            }
+            ("xdg_surface", "set_window_geometry") => {
+                if let (Some(surface), [_, _, Argument::Int(w), Argument::Int(h)]) =
+                    (shell.surface_of_xdg(msg.sender_id), &msg.args[..])
+                {
+                    self.sizes.insert(surface, (*w as f64, *h as f64));
+                }
+            }
+            ("zwp_pointer_constraints_v1", "lock_pointer") | ("zwp_pointer_constraints_v1", "confine_pointer") => {
+                if let [Argument::NewId(id), Argument::Object(surface), ..] = msg.args[..] {
+                    let top = self.toplevel_surface(surface, shell).unwrap_or(surface);
+                    if self.confinement.is_some_and(|(_, s)| s == top || s == surface) {
+                        // one constraint per surface: the guest's own grab first
+                        self.release(pre);
+                    }
+                    self.guest_constraints.insert(id, top);
+                    debug!("grab: the guest constrains the pointer itself on surface {surface}");
+                }
+            }
+            ("zwp_locked_pointer_v1", "destroy") | ("zwp_confined_pointer_v1", "destroy") => {
+                if self.guest_constraints.remove(&msg.sender_id).is_some() {
+                    self.update(captured, own, post);
+                }
+            }
+            ("wl_pointer", "release") => {
+                if self.pointer == Some(msg.sender_id) {
+                    self.pointer = None;
+                    self.release(pre);
+                }
+            }
+            ("wl_surface", "destroy") => {
+                let surface = msg.sender_id;
+                if self.confinement.is_some_and(|(_, s)| s == surface) {
+                    self.release(pre);
+                }
+                self.parents.remove(&surface);
+                self.sizes.remove(&surface);
+                if self.over == Some(surface) {
+                    self.over = None;
+                }
+                if self.keyboard == Some(surface) {
+                    self.keyboard = None;
+                }
+            }
+            _ => {}
+        }
+    }
+
+    /// A host event (already in guest ids) on one of the guest's objects.
+    pub(super) fn on_event(
+        &mut self,
+        interface: &str,
+        event: &str,
+        msg: &Message<u32, OwnedFd>,
+        shell: &Shell,
+        captured: bool,
+        own: &mut OwnObjects,
+        out: &mut Vec<HostRequest>,
+    ) {
+        match (interface, event) {
+            ("wl_pointer", "enter") => {
+                if let [_, Argument::Object(surface), ref x, ref y] = msg.args[..] {
+                    self.pointer = Some(msg.sender_id);
+                    self.over = self.toplevel_surface(surface, shell);
+                    self.pos = (fixed(x).unwrap_or(0.0), fixed(y).unwrap_or(0.0));
+                }
+            }
+            ("wl_pointer", "leave") => {
+                self.over = None;
+            }
+            ("wl_pointer", "motion") => {
+                if let [_, ref x, ref y] = msg.args[..] {
+                    self.pos = (fixed(x).unwrap_or(self.pos.0), fixed(y).unwrap_or(self.pos.1));
+                }
+            }
+            ("wl_keyboard", "enter") => {
+                if let [_, Argument::Object(surface), Argument::Array(ref keys)] = msg.args[..] {
+                    self.keyboard = self.toplevel_surface(surface, shell);
+                    self.meta = keys
+                        .chunks_exact(4)
+                        .map(|k| u32::from_ne_bytes([k[0], k[1], k[2], k[3]]))
+                        .filter(|k| *k == 125 || *k == 126)
+                        .fold(0, |m, k| m | if k == 125 { 1 } else { 2 });
+                }
+            }
+            ("wl_keyboard", "leave") => {
+                self.keyboard = None;
+                self.meta = 0;
+            }
+            ("wl_keyboard", "key") => {
+                if let [_, _, Argument::Uint(key), Argument::Uint(state)] = msg.args[..] {
+                    let bit = match key {
+                        125 => 1,
+                        126 => 2,
+                        _ => 0,
+                    };
+                    match state {
+                        1 => self.meta |= bit,
+                        0 => self.meta &= !bit,
+                        _ => {}
+                    }
+                }
+            }
+            ("wl_pointer", "frame") | ("wl_pointer", "button") => {}
+            _ => return,
+        }
+        self.update(captured, own, out);
+    }
+
+    /// An event on one of the proxy's own objects.
+    pub(super) fn on_own_event(&mut self, kind: OwnKind, event: &str, msg: &Message<u32, OwnedFd>) {
+        match (kind, event) {
+            (OwnKind::Registry, "global") => {
+                if let [Argument::Uint(name), Argument::Str(Some(ref interface)), _] = msg.args[..] {
+                    if interface.to_bytes() == b"zwp_pointer_constraints_v1" {
+                        self.global.get_or_insert(name);
+                    }
+                }
+            }
+            (OwnKind::Registry, "global_remove") => {
+                if let [Argument::Uint(name)] = msg.args[..] {
+                    if self.global == Some(name) {
+                        self.global = None;
+                    }
+                }
+            }
+            (OwnKind::Confinement, "confined") => debug!("grab: the host confined the pointer"),
+            (OwnKind::Confinement, "unconfined") => debug!("grab: the host unconfined the pointer"),
+            _ => {}
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn m(sender: u32, args: smallvec::SmallVec<[Argument<u32, OwnedFd>; 4]>) -> Message<u32, OwnedFd> {
+        Message {
+            sender_id: sender,
+            opcode: 0,
+            args,
+        }
+    }
+
+    fn fx(v: f64) -> Argument<u32, OwnedFd> {
+        Argument::Fixed((v * 256.0) as i32)
+    }
+
+    fn confines(out: &[HostRequest]) -> usize {
+        out.iter()
+            .filter(|r| r.opcode == request_opcode(&ZWP_POINTER_CONSTRAINTS_V1_INTERFACE, "confine_pointer") && matches!(r.args.first(), Some(Argument::NewId(_))) && r.args.len() == 5)
+            .count()
+    }
+
+    fn releases(out: &[HostRequest], id: u32) -> usize {
+        out.iter().filter(|r| r.sender_id == id && r.opcode == 0 && r.args.is_empty()).count()
+    }
+
+    #[test]
+    fn grabs_over_the_focused_window_and_lets_go_at_its_edge_and_for_the_guest() {
+        // a toplevel (surface 3, xdg_surface 10) with its output on subsurface 39, 1600x900
+        let mut sh = Shell::default();
+        sh.on_request("xdg_wm_base", "get_xdg_surface", &mut m(4, smallvec![Argument::NewId(10), Argument::Object(3)]));
+        sh.on_request("xdg_surface", "get_toplevel", &mut m(10, smallvec![Argument::NewId(11)]));
+        let mut own = OwnObjects::new();
+        own.free.extend(FIRST_OWN + 1..FIRST_OWN + 16);
+        let mut g = Grab::new(true);
+        let (mut pre, mut post, mut out) = (Vec::new(), Vec::new(), Vec::new());
+        let mut global = m(FIRST_OWN, smallvec![Argument::Uint(9), Argument::Str(Some(Box::new(CString::new("zwp_pointer_constraints_v1").unwrap()))), Argument::Uint(1)]);
+        g.on_own_event(OwnKind::Registry, "global", &mut global);
+        g.on_request("wl_subcompositor", "get_subsurface", &m(5, smallvec![Argument::NewId(40), Argument::Object(39), Argument::Object(3)]), &sh, true, &mut own, &mut pre, &mut post);
+        g.on_request("xdg_surface", "set_window_geometry", &m(10, smallvec![Argument::Int(0), Argument::Int(0), Argument::Int(1600), Argument::Int(900)]), &sh, true, &mut own, &mut pre, &mut post);
+
+        // keyboard focus, the pointer over the output subsurface: no grab until Meta is held
+        g.on_event("wl_keyboard", "enter", &m(30, smallvec![Argument::Uint(1), Argument::Object(3), Argument::Array(Box::new(vec![]))]), &sh, true, &mut own, &mut out);
+        assert_eq!(confines(&out), 0);
+        g.on_event("wl_pointer", "enter", &m(20, smallvec![Argument::Uint(2), Argument::Object(39), fx(800.0), fx(450.0)]), &sh, true, &mut own, &mut out);
+        assert_eq!(confines(&out), 0);
+        g.on_event("wl_keyboard", "key", &m(30, smallvec![Argument::Uint(3), Argument::Uint(0), Argument::Uint(125), Argument::Uint(1)]), &sh, true, &mut own, &mut out);
+        assert_eq!(confines(&out), 1);
+        let (id, surface) = g.confinement.unwrap();
+        assert_eq!(surface, 3);
+        let confine = out.iter().find(|r| r.args.len() == 5).unwrap();
+        assert!(matches!(confine.args[..], [_, Argument::Object(s), Argument::Object(p), Argument::Object(0), Argument::Uint(PERSISTENT)] if s == guest_to_host(3) && p == guest_to_host(20)));
+        out.clear();
+
+        // towards the edge: still grabbed 4 px inside, released 2 px inside, not taken again at 5
+        g.on_event("wl_pointer", "motion", &m(20, smallvec![Argument::Uint(0), fx(1596.0), fx(450.0)]), &sh, true, &mut own, &mut out);
+        assert!(out.is_empty());
+        g.on_event("wl_pointer", "motion", &m(20, smallvec![Argument::Uint(0), fx(1598.0), fx(450.0)]), &sh, true, &mut own, &mut out);
+        assert_eq!(releases(&out, id), 1);
+        assert!(g.confinement.is_none());
+        out.clear();
+        g.on_event("wl_pointer", "motion", &m(20, smallvec![Argument::Uint(0), fx(1595.0), fx(450.0)]), &sh, true, &mut own, &mut out);
+        assert!(out.is_empty());
+        g.on_event("wl_pointer", "motion", &m(20, smallvec![Argument::Uint(0), fx(1500.0), fx(450.0)]), &sh, true, &mut own, &mut out);
+        assert_eq!(confines(&out), 1);
+        let (id, _) = g.confinement.unwrap();
+        out.clear();
+
+        // the guest locks the pointer itself (nested KWin's Right Ctrl): the proxy's goes first
+        g.on_request("zwp_pointer_constraints_v1", "lock_pointer", &m(50, smallvec![Argument::NewId(60), Argument::Object(3), Argument::Object(20), Argument::Object(0), Argument::Uint(2)]), &sh, true, &mut own, &mut pre, &mut post);
+        assert_eq!(releases(&pre, id), 1);
+        pre.clear();
+        g.on_event("wl_pointer", "motion", &m(20, smallvec![Argument::Uint(0), fx(800.0), fx(450.0)]), &sh, true, &mut own, &mut out);
+        assert!(out.is_empty(), "no grab while the guest has its own");
+        g.on_request("zwp_locked_pointer_v1", "destroy", &m(60, smallvec![]), &sh, true, &mut own, &mut pre, &mut post);
+        assert_eq!(confines(&post), 1);
+        let (id, _) = g.confinement.unwrap();
+        post.clear();
+
+        // Meta let go: released; held again: grabbed
+        g.on_event("wl_keyboard", "key", &m(30, smallvec![Argument::Uint(3), Argument::Uint(0), Argument::Uint(125), Argument::Uint(0)]), &sh, true, &mut own, &mut out);
+        assert_eq!(releases(&out, id), 1);
+        g.on_event("wl_keyboard", "key", &m(30, smallvec![Argument::Uint(3), Argument::Uint(0), Argument::Uint(126), Argument::Uint(1)]), &sh, true, &mut own, &mut out);
+        assert_eq!(confines(&out), 1);
+        let (id, _) = g.confinement.unwrap();
+        out.clear();
+
+        // shortcuts released (Meta+Shift+Esc), then the keyboard focus leaves: no grab
+        g.on_event("wl_keyboard", "key", &m(30, smallvec![Argument::Uint(3), Argument::Uint(0), Argument::Uint(1), Argument::Uint(1)]), &sh, false, &mut own, &mut out);
+        assert_eq!(releases(&out, id), 1);
+        out.clear();
+        g.on_event("wl_keyboard", "key", &m(30, smallvec![Argument::Uint(3), Argument::Uint(0), Argument::Uint(1), Argument::Uint(0)]), &sh, true, &mut own, &mut out);
+        assert_eq!(confines(&out), 1);
+        let (id, _) = g.confinement.unwrap();
+        out.clear();
+        g.on_event("wl_keyboard", "leave", &m(30, smallvec![Argument::Uint(4), Argument::Object(3)]), &sh, true, &mut own, &mut out);
+        assert_eq!(releases(&out, id), 1);
+        assert!(g.confinement.is_none());
+
+        // off: never
+        let mut off = Grab::new(false);
+        off.on_own_event(OwnKind::Registry, "global", &mut global);
+        off.on_request("xdg_surface", "set_window_geometry", &m(10, smallvec![Argument::Int(0), Argument::Int(0), Argument::Int(1600), Argument::Int(900)]), &sh, true, &mut own, &mut pre, &mut post);
+        off.on_event("wl_keyboard", "enter", &m(30, smallvec![Argument::Uint(1), Argument::Object(3), Argument::Array(Box::new(vec![]))]), &sh, true, &mut own, &mut out);
+        off.on_event("wl_pointer", "enter", &m(20, smallvec![Argument::Uint(2), Argument::Object(3), fx(800.0), fx(450.0)]), &sh, true, &mut own, &mut out);
+        off.on_event("wl_keyboard", "key", &m(30, smallvec![Argument::Uint(3), Argument::Uint(0), Argument::Uint(125), Argument::Uint(1)]), &sh, true, &mut own, &mut out);
+        assert!(off.confinement.is_none());
+    }
+}
