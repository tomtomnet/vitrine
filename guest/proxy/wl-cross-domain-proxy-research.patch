+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn chords() {
+        let c: Chord = "meta+shift+esc".parse().unwrap();
+        assert_eq!(c.to_string(), "Meta+Shift+Esc");
+        let held = |keys: &[u32]| keys.iter().copied().collect::<HashSet<u32>>();
+        assert!(c.matches(1, &held(&[125, 42, 1])));
+        assert!(c.matches(1, &held(&[126, 54, 1])));
+        assert!(!c.matches(1, &held(&[125, 1]))); // Shift missing
+        assert!(!c.matches(1, &held(&[125, 42, 29, 1]))); // Ctrl extra
+        assert!(!c.matches(15, &held(&[125, 42, 15])));
+        let c: Chord = "Ctrl+Alt+F12".parse().unwrap();
+        assert!(c.matches(88, &held(&[29, 56, 88])));
+        assert_eq!("super+key119".parse::<Chord>().unwrap().key, 119);
+        assert_eq!("meta+q".parse::<Chord>().unwrap().key, 16);
+        assert!("meta+shift".parse::<Chord>().is_err());
+        assert!("meta+nosuchkey".parse::<Chord>().is_err());
+    }
+
+    fn ev(sender: u32, args: smallvec::SmallVec<[Argument<u32, OwnedFd>; 4]>) -> Message<u32, OwnedFd> {
+        Message {
+            sender_id: sender,
+            opcode: 0,
+            args,
+        }
+    }
+
+    #[test]
+    fn overlay_chord_is_reported_and_kept_from_the_guest() {
+        let sh = Shell::default();
+        let mut own = OwnObjects::new();
+        let mut out = Vec::new();
+        let key = |k: u32, state: u32| {
+            ev(20, smallvec![Argument::Uint(2), Argument::Uint(0), Argument::Uint(k), Argument::Uint(state)])
+        };
+        let enter = || ev(20, smallvec![Argument::Uint(1), Argument::Object(3), Argument::Array(Box::new(vec![]))]);
+        // without an overlay (no chord), Ctrl+Alt+S is the guest's
+        let mut sc = Shortcuts::new(ShortcutConfig::default());
+        sc.on_event("wl_keyboard", "enter", &mut enter(), &sh, &mut own, &mut out);
+        sc.on_event("wl_keyboard", "key", &mut key(29, 1), &sh, &mut own, &mut out);
+        sc.on_event("wl_keyboard", "key", &mut key(56, 1), &sh, &mut own, &mut out);
+        assert!(!sc.on_event("wl_keyboard", "key", &mut key(31, 1), &sh, &mut own, &mut out));
+        assert!(!sc.take_overlay_toggle());
+        // with one, even without shortcut capture
+        let mut sc = Shortcuts::new(ShortcutConfig {
+            overlay: Some("ctrl+alt+s".parse().unwrap()),
+            ..Default::default()
+        });
+        sc.on_event("wl_keyboard", "enter", &mut enter(), &sh, &mut own, &mut out);
+        assert!(!sc.on_event("wl_keyboard", "key", &mut key(29, 1), &sh, &mut own, &mut out));
+        assert!(!sc.on_event("wl_keyboard", "key", &mut key(56, 1), &sh, &mut own, &mut out));
+        assert!(sc.on_event("wl_keyboard", "key", &mut key(31, 1), &sh, &mut own, &mut out));
+        assert!(sc.take_overlay_toggle());
+        assert!(!sc.take_overlay_toggle());
+        assert!(sc.on_event("wl_keyboard", "key", &mut key(31, 2), &sh, &mut own, &mut out)); // repeat
+        assert!(sc.on_event("wl_keyboard", "key", &mut key(31, 0), &sh, &mut own, &mut out));
+        assert!(!sc.take_overlay_toggle());
+        // S alone is a key like any other
+        sc.on_event("wl_keyboard", "key", &mut key(56, 0), &sh, &mut own, &mut out);
+        sc.on_event("wl_keyboard", "key", &mut key(29, 0), &sh, &mut own, &mut out);
+        assert!(!sc.on_event("wl_keyboard", "key", &mut key(31, 1), &sh, &mut own, &mut out));
+        assert!(!sc.take_overlay_toggle());
+    }
+
+    #[test]
+    fn capture_follows_the_pointer_like_an_sdl_window() {
+        let mut sh = Shell::default();
+        sh.on_request("xdg_wm_base", "get_xdg_surface", &mut ev(4, smallvec![Argument::NewId(10), Argument::Object(3)]));
+        sh.on_request("xdg_surface", "get_toplevel", &mut ev(10, smallvec![Argument::NewId(11)]));
+        let mut own = OwnObjects::new();
+        own.free.extend(FIRST_OWN + 1..FIRST_OWN + 16);
+        let mut sc = Shortcuts::new(ShortcutConfig {
+            enabled: true,
+            ..Default::default()
+        });
+        let mut out = Vec::new();
+        let global = |name: u32, iface: &str| {
+            ev(FIRST_OWN, smallvec![Argument::Uint(name), Argument::Str(Some(Box::new(CString::new(iface).unwrap()))), Argument::Uint(1)])
+        };
+        sc.on_own_event(OwnKind::Registry, FIRST_OWN, "global", &global(7, "zwp_keyboard_shortcuts_inhibit_manager_v1"), &mut own, &mut out);
+        sc.on_own_event(OwnKind::Registry, FIRST_OWN, "global", &global(8, "wl_seat"), &mut own, &mut out);
+        let inhibits = |out: &[HostRequest]| {
+            out.iter()
+                .filter(|m| m.opcode == request_opcode(&ZWP_KEYBOARD_SHORTCUTS_INHIBIT_MANAGER_V1_INTERFACE, "inhibit_shortcuts") && m.args.len() == 3)
+                .count()
+        };
+        let destroys = |out: &[HostRequest]| out.iter().filter(|m| m.opcode == 0 && m.args.is_empty()).count();
+
+        // focused with the pointer elsewhere (Alt+Tab into the window): no capture yet
+        let mut enter = ev(20, smallvec![Argument::Uint(1), Argument::Object(3), Argument::Array(Box::new(vec![]))]);
+        sc.on_event("wl_keyboard", "enter", &mut enter, &sh, &mut own, &mut out);
+        assert_eq!(inhibits(&out), 0);
+        assert!(sc.pointer_outside());
+        // the pointer comes in: captured
+        sc.set_pointer_over(Some(3), &sh, &mut own, &mut out);
+        assert_eq!(inhibits(&out), 1);
+        assert!(!sc.pointer_outside());
+        // onto the title bar (the surface's pointer leave): released, still focused
+        out.clear();
+        sc.set_pointer_over(None, &sh, &mut own, &mut out);
+        assert_eq!(destroys(&out), 1);
+        assert!(sc.pointer_outside());
+        // back: captured again; the same toplevel again changes nothing
+        out.clear();
+        sc.set_pointer_over(Some(3), &sh, &mut own, &mut out);
+        sc.set_pointer_over(Some(3), &sh, &mut own, &mut out);
+        assert_eq!(inhibits(&out), 1);
+
+        // --no-follow-pointer: captured on focus, wherever the pointer is
+        let mut own = OwnObjects::new();
+        own.free.extend(FIRST_OWN + 1..FIRST_OWN + 16);
+        let mut sc = Shortcuts::new(ShortcutConfig {
+            enabled: true,
+            follow_pointer: false,
+            ..Default::default()
+        });
+        let mut out = Vec::new();
+        sc.on_own_event(OwnKind::Registry, FIRST_OWN, "global", &global(7, "zwp_keyboard_shortcuts_inhibit_manager_v1"), &mut own, &mut out);
+        sc.on_own_event(OwnKind::Registry, FIRST_OWN, "global", &global(8, "wl_seat"), &mut own, &mut out);
+        let mut enter = ev(20, smallvec![Argument::Uint(1), Argument::Object(3), Argument::Array(Box::new(vec![]))]);
+        sc.on_event("wl_keyboard", "enter", &mut enter, &sh, &mut own, &mut out);
+        assert_eq!(inhibits(&out), 1);
+        out.clear();
+        sc.set_pointer_over(None, &sh, &mut own, &mut out);
+        assert_eq!(destroys(&out), 0);
+        assert!(!sc.pointer_outside());
+    }
