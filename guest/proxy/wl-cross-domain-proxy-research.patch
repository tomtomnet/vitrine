+    fn named<'a>(out: &'a [HostRequest], sender: u32, interface: &Interface, request: &str) -> Vec<&'a HostRequest> {
+        out.iter()
+            .filter(|m| m.sender_id == sender && m.opcode == request_opcode(interface, request))
