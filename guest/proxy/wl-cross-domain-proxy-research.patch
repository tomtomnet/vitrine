diff -ruN a/src/session/clipboard.rs b/src/session/clipboard.rs
--- a/src/session/clipboard.rs
+++ b/src/session/clipboard.rs
@@ -0,0 +1,1612 @@
+//! Host/guest clipboard for a forwarded nested desktop, with the semantics of
+//! VM tools (and of the plasma-vm container): the host's clipboard reaches the
+//! guest when the forwarded window gets the keyboard focus, and while it has
+//! it; what is copied in the guest reaches the host only if it was copied while
+//! the window had the focus. Text and PNG images (`--clipboard text`: text
+//! only); no primary selection, no drag and drop.
+//!
+//! Host side: the proxy's own `wl_data_device` on the nested compositor's host
+//! connection. A compositor offers its selection to the data devices of the
+//! client with the keyboard focus - the nested compositor's connection while
+//! the window is focused - so the proxy sees the host's clipboard exactly then.
+//! It sets the host's selection with its own `wl_data_source` and the serial of
+//! the last input event the window got.
+//!
+//! Guest side: a client connection of the proxy to the nested compositor
+//! (`--clipboard-guest-display`, wayland-0 by default) with
+//! `ext_data_control_manager_v1`, which reads and sets the guest's selection
+//! whatever has the focus in the guest (KWin 6.8 offers it to every client
+//! that is not sandboxed).
+//!
+//! The host's text is read as soon as the host offers it; its image only when
+//! a guest application asks for it: the host offers its selection again at
+//! every focus change, and a screenshot in the host's clipboard would cross
+//! at every click into the window otherwise. What the guest copies is read at
+//! once (inside the guest) and kept until the host asks for it.
+//!
+//! Every selection the proxy sets offers a private MIME type as well: its own
+//! selection coming back from the other side is recognised and not copied
+//! again. Content equal to what last crossed is not set again either (a
+//! clipboard manager setting the same content again, the host offering its
+//! unchanged selection at a focus change).
+//!
+//! Transfers run in threads: a reader drains its pipe whatever the peer does
+//! (the cross-domain transport writes the host's data into the proxy's pipe
+//! with blocking writes, in the event loop), a writer feeds a peer at its pace.
+
+use std::collections::hash_map::DefaultHasher;
+use std::collections::{HashMap, HashSet};
+use std::ffi::CString;
+use std::hash::{Hash, Hasher};
+use std::io;
+use std::os::fd::{AsFd, AsRawFd, BorrowedFd, FromRawFd, OwnedFd};
+use std::os::unix::net::UnixStream;
+use std::path::{Path, PathBuf};
+use std::str::FromStr;
+use std::sync::Arc;
+use std::sync::mpsc::{Receiver, Sender, channel};
+use std::time::{Duration, Instant};
+
+use log::{debug, info, warn};
+use smallvec::{SmallVec, smallvec};
+use wayland_protocols::ext::data_control::v1::server::__interfaces::{
+    EXT_DATA_CONTROL_DEVICE_V1_INTERFACE, EXT_DATA_CONTROL_MANAGER_V1_INTERFACE,
+    EXT_DATA_CONTROL_OFFER_V1_INTERFACE, EXT_DATA_CONTROL_SOURCE_V1_INTERFACE,
+};
+use wayland_server::backend::protocol::{Argument, Interface, Message};
+use wayland_server::protocol::__interfaces::{
+    WL_CALLBACK_INTERFACE, WL_DATA_DEVICE_INTERFACE, WL_DATA_DEVICE_MANAGER_INTERFACE,
+    WL_DATA_OFFER_INTERFACE, WL_DATA_SOURCE_INTERFACE, WL_DISPLAY_INTERFACE,
+    WL_REGISTRY_INTERFACE, WL_SEAT_INTERFACE,
+};
+
+use super::{FIRST_OWN, HostRequest, OwnKind, OwnObjects, SERVER_ID_START, request_opcode};
+use crate::wl_proto::{BufferedSocket, MessageParseError, Socket};
+
+/// Offered with every selection the proxy sets, on either side - with this proxy's own instance
+/// number: its own selection coming back is recognised, another proxy's (a second nested desktop's
+/// on the same host) is not. One marker for every proxy made a copy in one VM never reach another
+/// VM: its proxy took the host's selection for its own (2026-10-10).
+const MARKER_BASE: &str = "application/x-wl-cross-domain-proxy";
+static MARKER: std::sync::LazyLock<String> = std::sync::LazyLock::new(|| {
+    let mut h = DefaultHasher::new();
+    std::process::id().hash(&mut h);
+    std::time::SystemTime::now().hash(&mut h);
+    format!("{MARKER_BASE};instance={:016x}", h.finish())
+});
+/// Text types, in order of preference when reading; all of them are offered.
+const TEXT_TYPES: [&str; 5] = [
+    "text/plain;charset=utf-8",
+    "UTF8_STRING",
+    "text/plain",
+    "TEXT",
+    "STRING",
+];
+const PNG: &str = "image/png";
+/// Larger selections do not cross.
+const MAX_SIZE: usize = 64 << 20;
+const READ_TIMEOUT: Duration = Duration::from_secs(5);
+const WRITE_TIMEOUT: Duration = Duration::from_secs(30);
+/// Between two attempts to connect to the nested compositor.
+const RETRY: Duration = Duration::from_secs(2);
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ClipboardMode {
+    Off,
+    /// Text and images, following the window's keyboard focus.
+    Focus,
+    /// Text only, following the window's keyboard focus.
+    Text,
+}
+
+impl FromStr for ClipboardMode {
+    type Err = String;
+
+    fn from_str(s: &str) -> Result<Self, String> {
+        match s.trim().to_ascii_lowercase().as_str() {
+            "off" | "0" | "no" => Ok(ClipboardMode::Off),
+            "focus" | "on" | "1" | "yes" => Ok(ClipboardMode::Focus),
+            "text" => Ok(ClipboardMode::Text),
+            other => Err(format!("{other}: expected off, focus or text")),
+        }
+    }
+}
+
+#[derive(Debug, Clone)]
+pub struct ClipboardConfig {
+    pub mode: ClipboardMode,
+    /// The nested compositor's display: a name in $XDG_RUNTIME_DIR or a path.
+    pub guest_display: String,
+}
+
+impl Default for ClipboardConfig {
+    fn default() -> Self {
+        ClipboardConfig {
+            mode: ClipboardMode::Off,
+            guest_display: "wayland-0".to_owned(),
+        }
+    }
+}
+
+fn is_text(mime: &str) -> bool {
+    TEXT_TYPES.iter().any(|t| t.eq_ignore_ascii_case(mime))
+}
+
+/// The text type to read from an offer of `mimes`.
+fn best_text(mimes: &[String]) -> Option<&str> {
+    TEXT_TYPES
+        .iter()
+        .find_map(|t| mimes.iter().find(|m| m.eq_ignore_ascii_case(t)))
+        .map(String::as_str)
+}
+
+fn has(mimes: &[String], mime: &str) -> bool {
+    mimes.iter().any(|m| m.eq_ignore_ascii_case(mime))
+}
+
+fn hash_of(text: Option<&[u8]>, png: Option<&[u8]>) -> u64 {
+    let mut h = DefaultHasher::new();
+    text.hash(&mut h);
+    png.hash(&mut h);
+    h.finish()
+}
+
+/// The MIME types of a selection the proxy sets: text, image, marker.
+fn offered_types(text: bool, png: bool) -> Vec<&'static str> {
+    let mut types = Vec::new();
+    if text {
+        types.extend(TEXT_TYPES);
+    }
+    if png {
+        types.push(PNG);
+    }
+    types.push(MARKER.as_str());
+    types
+}
+
+/// "N bytes of text, a M byte image" for the log; an image of unknown size is read later.
+fn describe(text: Option<usize>, image: Option<Option<usize>>) -> String {
+    let mut parts = Vec::new();
+    if let Some(n) = text {
+        parts.push(format!("{n} bytes of text"));
+    }
+    match image {
+        Some(Some(n)) => parts.push(format!("a {n} byte image")),
+        Some(None) => parts.push("an image, read when asked".to_owned()),
+        None => {}
+    }
+    parts.join(", ")
+}
+
+fn set_nonblocking(fd: BorrowedFd<'_>) -> io::Result<()> {
+    // SAFETY: fcntl on a valid descriptor
+    let flags = unsafe { libc::fcntl(fd.as_raw_fd(), libc::F_GETFL) };
+    if flags < 0 || unsafe { libc::fcntl(fd.as_raw_fd(), libc::F_SETFL, flags | libc::O_NONBLOCK) } < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(())
+}
+
+fn wait_for(fd: BorrowedFd<'_>, flags: rustix::event::PollFlags, deadline: Instant) -> io::Result<()> {
+    let left = deadline.saturating_duration_since(Instant::now());
+    if left.is_zero() {
+        return Err(io::ErrorKind::TimedOut.into());
+    }
+    let timeout = rustix::event::Timespec {
+        tv_sec: left.as_secs() as _,
+        tv_nsec: left.subsec_nanos() as _,
+    };
+    let mut fds = [rustix::event::PollFd::new(&fd, flags)];
+    match rustix::event::poll(&mut fds, Some(&timeout)) {
+        Ok(0) => Err(io::ErrorKind::TimedOut.into()),
+        Ok(_) | Err(rustix::io::Errno::INTR) => Ok(()),
+        Err(e) => Err(e.into()),
+    }
+}
+
+/// Everything until end of file, at most `limit` bytes, within `timeout`.
+fn read_all(fd: &OwnedFd, limit: usize, timeout: Duration) -> io::Result<Vec<u8>> {
+    set_nonblocking(fd.as_fd())?;
+    let deadline = Instant::now() + timeout;
+    let mut data = Vec::new();
+    let mut buf = vec![0u8; 64 << 10];
+    loop {
+        match rustix::io::read(fd, &mut buf[..]) {
+            Ok(0) => return Ok(data),
+            Ok(n) => {
+                if data.len() + n > limit {
+                    return Err(io::Error::other(format!("more than {limit} bytes")));
+                }
+                data.extend_from_slice(&buf[..n]);
+            }
+            Err(rustix::io::Errno::AGAIN) => wait_for(fd.as_fd(), rustix::event::PollFlags::IN, deadline)?,
+            Err(rustix::io::Errno::INTR) => {}
+            Err(e) => return Err(e.into()),
+        }
+    }
+}
+
+/// All of `data`, within `timeout`; the descriptor is closed when it returns.
+fn write_all(fd: OwnedFd, mut data: &[u8], timeout: Duration) -> io::Result<()> {
+    set_nonblocking(fd.as_fd())?;
+    let deadline = Instant::now() + timeout;
+    while !data.is_empty() {
+        match rustix::io::write(&fd, data) {
+            Ok(n) => data = &data[n..],
+            Err(rustix::io::Errno::AGAIN) => wait_for(fd.as_fd(), rustix::event::PollFlags::OUT, deadline)?,
+            Err(rustix::io::Errno::INTR) => {}
+            Err(e) => return Err(e.into()),
+        }
+    }
+    Ok(())
+}
+
+fn pipe() -> io::Result<(OwnedFd, OwnedFd)> {
+    Ok(rustix::pipe::pipe_with(rustix::pipe::PipeFlags::CLOEXEC)?)
+}
+
+fn spawn(name: &str, f: impl FnOnce() + Send + 'static) {
+    if let Err(e) = std::thread::Builder::new().name(name.to_owned()).spawn(f) {
+        warn!("clipboard: no thread for a transfer: {e}");
+    }
+}
+
+/// Feeds `data` to a reader in a thread.
+fn spawn_writer(fd: OwnedFd, data: Arc<Vec<u8>>, what: &'static str) {
+    spawn("clipboard-write", move || {
+        match write_all(fd, &data, WRITE_TIMEOUT) {
+            Ok(()) => debug!("clipboard: {} bytes of {what} written", data.len()),
+            Err(e) => debug!("clipboard: writing {what}: {e}"),
+        }
+    });
+}
+
+/// A transfer that finished in a thread.
+#[derive(Debug)]
+enum Done {
+    /// The host's text, read when the host offered it.
+    HostText { generation: u64, data: Option<Vec<u8>> },
+    /// Part of the guest's selection (`png` or text).
+    Guest { generation: u64, png: bool, data: Option<Vec<u8>> },
+}
+
+/// Wakes the event loop (the clipboard's epoll) when a thread is done.
+#[derive(Clone)]
+struct Notify {
+    tx: Sender<Done>,
+    wake: Arc<OwnedFd>,
+}
+
+impl Notify {
+    fn send(&self, done: Done) {
+        let _ = self.tx.send(done);
+        let one = 1u64;
+        // SAFETY: writing 8 bytes to an eventfd
+        unsafe { libc::write(self.wake.as_raw_fd(), (&one as *const u64).cast(), 8) };
+    }
+
+    /// Reads `fd` to its end in a thread, then reports `make(data)`.
+    fn read(&self, fd: OwnedFd, make: impl FnOnce(Option<Vec<u8>>) -> Done + Send + 'static) {
+        let notify = self.clone();
+        spawn("clipboard-read", move || {
+            let data = read_all(&fd, MAX_SIZE, READ_TIMEOUT)
+                .inspect_err(|e| warn!("clipboard: reading a selection: {e}"))
+                .ok();
+            notify.send(make(data));
+        });
+    }
+}
+
+/// Where a part of the guest's selection stands while it is read.
+#[derive(Debug)]
+enum Part {
+    Unused,
+    Reading,
+    Read(Option<Vec<u8>>),
+}
+
+impl Part {
+    fn done(&self) -> bool {
+        !matches!(self, Part::Reading)
+    }
+
+    fn take(&mut self) -> Option<Vec<u8>> {
+        match std::mem::replace(self, Part::Unused) {
+            Part::Read(data) => data.filter(|d| !d.is_empty()),
+            _ => None,
+        }
+    }
+}
+
+/// The guest's selection being read, to offer to the host.
+struct GuestRead {
+    generation: u64,
+    text: Part,
+    png: Part,
+}
+
+/// What a selection of the proxy on the host offers.
+struct HostSource {
+    text: Option<Arc<Vec<u8>>>,
+    png: Option<Arc<Vec<u8>>>,
+}
+
+/// What a selection of the proxy in the guest offers: the host's text, and its
+/// image if it has one (read from the host's current offer when asked).
+struct GuestSource {
+    text: Option<Arc<Vec<u8>>>,
+    png: bool,
+}
+
+pub(super) struct Clipboard {
+    cfg: ClipboardConfig,
+    /// readable when [`Clipboard::dispatch`] has work: the threads' eventfd and the guest connection
+    epoll: OwnedFd,
+    notify: Notify,
+    rx: Receiver<Done>,
+    /// the forwarded window has the host's keyboard focus
+    focused: bool,
+    /// serial of the last input event the window got (for set_selection)
+    serial: Option<u32>,
+    warned: bool,
+
+    // host side (host ids)
+    manager_global: Option<(u32, u32)>,
+    seat_global: Option<u32>,
+    manager: Option<u32>,
+    device: Option<u32>,
+    /// the host's offers (server ids) and their MIME types
+    host_offers: HashMap<u32, Vec<String>>,
+    host_selection: Option<u32>,
+    host_dnd: Option<u32>,
+    host_generation: u64,
+    /// the proxy's selections on the host (own ids)
+    host_sources: HashMap<u32, HostSource>,
+    host_current: Option<u32>,
+    /// content hash of what the proxy last set on the host
+    host_hash: Option<u64>,
+
+    // guest side
+    guest: Option<GuestClient>,
+    guest_tried: Option<Instant>,
+    guest_sources: HashMap<u32, GuestSource>,
+    guest_current: Option<u32>,
+    /// (text hash, image) of what the proxy last set in the guest
+    guest_applied: Option<(u64, bool)>,
+    /// the host's selection, waiting for the guest connection
+    guest_pending: Option<GuestSource>,
+    guest_generation: u64,
+    guest_read: Option<GuestRead>,
+}
+
+fn epoll_add(epoll: &OwnedFd, fd: BorrowedFd<'_>) -> io::Result<()> {
+    let mut ev = libc::epoll_event {
+        events: libc::EPOLLIN as u32,
+        u64: fd.as_raw_fd() as u64,
+    };
+    // SAFETY: valid epoll fd and event
+    if unsafe { libc::epoll_ctl(epoll.as_raw_fd(), libc::EPOLL_CTL_ADD, fd.as_raw_fd(), &mut ev) } < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(())
+}
+
+impl Clipboard {
+    pub(super) fn new(cfg: ClipboardConfig) -> io::Result<Self> {
+        // SAFETY: plain syscalls, results checked
+        let epoll = unsafe { libc::epoll_create1(libc::EPOLL_CLOEXEC) };
+        if epoll < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        let epoll = unsafe { OwnedFd::from_raw_fd(epoll) };
+        let wake = unsafe { libc::eventfd(0, libc::EFD_NONBLOCK | libc::EFD_CLOEXEC) };
+        if wake < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        let wake = unsafe { OwnedFd::from_raw_fd(wake) };
+        epoll_add(&epoll, wake.as_fd())?;
+        let (tx, rx) = channel();
+        Ok(Clipboard {
+            cfg,
+            epoll,
+            notify: Notify {
+                tx,
+                wake: Arc::new(wake),
+            },
+            rx,
+            focused: false,
+            serial: None,
+            warned: false,
+            manager_global: None,
+            seat_global: None,
+            manager: None,
+            device: None,
+            host_offers: HashMap::new(),
+            host_selection: None,
+            host_dnd: None,
+            host_generation: 0,
+            host_sources: HashMap::new(),
+            host_current: None,
+            host_hash: None,
+            guest: None,
+            guest_tried: None,
+            guest_sources: HashMap::new(),
+            guest_current: None,
+            guest_applied: None,
+            guest_pending: None,
+            guest_generation: 0,
+            guest_read: None,
+        })
+    }
+
+    /// Readable when [`Clipboard::dispatch`] has work.
+    pub(super) fn fd(&self) -> BorrowedFd<'_> {
+        self.epoll.as_fd()
+    }
+
+    /// A thread finished or the nested compositor sent something.
+    fn pending(&self) -> bool {
+        let mut events = [libc::epoll_event { events: 0, u64: 0 }; 2];
+        // SAFETY: valid epoll fd and buffer
+        unsafe { libc::epoll_wait(self.epoll.as_raw_fd(), events.as_mut_ptr(), 2, 0) > 0 }
+    }
+
+    fn enabled(&self) -> bool {
+        self.cfg.mode != ClipboardMode::Off
+    }
+
+    fn images(&self) -> bool {
+        self.cfg.mode == ClipboardMode::Focus
+    }
+
+    /// The host's data device, created at the window's first keyboard focus
+    /// (the host then offers its selection to it at once).
+    fn start(&mut self, own: &mut OwnObjects, out: &mut Vec<HostRequest>) {
+        if self.device.is_some() {
+            return;
+        }
+        let (Some((manager_name, manager_version)), Some(seat_name)) = (self.manager_global, self.seat_global) else {
+            if !self.warned {
+                self.warned = true;
+                warn!("clipboard: the host has no wl_data_device_manager or wl_seat, no clipboard");
+            }
+            return;
+        };
+        let (Some(seat), Some(manager), Some(device)) = (
+            own.alloc(&WL_SEAT_INTERFACE, OwnKind::Seat),
+            own.alloc(&WL_DATA_DEVICE_MANAGER_INTERFACE, OwnKind::DataDeviceManager),
+            own.alloc(&WL_DATA_DEVICE_INTERFACE, OwnKind::DataDevice),
+        ) else {
+            // the ids taken stay unused; not worth more code for 16 ids
+            warn!("clipboard: no free proxy object ids, no clipboard");
+            self.cfg.mode = ClipboardMode::Off;
+            return;
+        };
+        out.push(bind(seat_name, "wl_seat", 1, seat));
+        out.push(bind(manager_name, "wl_data_device_manager", manager_version.min(3), manager));
+        out.push(Message {
+            sender_id: manager,
+            opcode: request_opcode(&WL_DATA_DEVICE_MANAGER_INTERFACE, "get_data_device"),
+            args: smallvec![Argument::NewId(device), Argument::Object(seat)],
+        });
+        self.manager = Some(manager);
+        self.device = Some(device);
+        info!(
+            "clipboard: on ({}), with the nested compositor at {}",
+            if self.images() { "text and images" } else { "text" },
+            self.cfg.guest_display
+        );
+    }
+
+    fn guest_path(&self) -> Option<PathBuf> {
+        if self.cfg.guest_display.contains('/') {
+            return Some(PathBuf::from(&self.cfg.guest_display));
+        }
+        std::env::var_os("XDG_RUNTIME_DIR").map(|dir| Path::new(&dir).join(&self.cfg.guest_display))
+    }
+
+    /// Connects to the nested compositor if not connected (at most every [`RETRY`]).
+    fn connect_guest(&mut self) {
+        if self.guest.is_some() || self.guest_tried.is_some_and(|t| t.elapsed() < RETRY) {
+            return;
+        }
+        self.guest_tried = Some(Instant::now());
+        let Some(path) = self.guest_path() else {
+            warn!("clipboard: XDG_RUNTIME_DIR is not set, give --clipboard-guest-display as a path");
+            return;
+        };
+        match GuestClient::connect(&path) {
+            Ok(client) => {
+                if let Err(e) = epoll_add(&self.epoll, client.sock.as_fd()) {
+                    warn!("clipboard: {e}");
+                    return;
+                }
+                debug!("clipboard: connected to the nested compositor at {}", path.display());
+                self.guest = Some(client);
+            }
+            Err(e) => warn!("clipboard: cannot connect to the nested compositor at {}: {e}", path.display()),
+        }
+    }
+
+    /// A host event (guest ids) on one of the guest's objects: keyboard focus
+    /// and input serials.
+    pub(super) fn on_event(
+        &mut self,
+        interface: &str,
+        event: &str,
+        msg: &Message<u32, OwnedFd>,
+        own: &mut OwnObjects,
+        out: &mut Vec<HostRequest>,
+    ) {
+        if !self.enabled() {
+            return;
+        }
+        match (interface, event) {
+            ("wl_keyboard", "enter") => {
+                if let Some(Argument::Uint(serial)) = msg.args.first() {
+                    self.serial = Some(*serial);
+                }
+                self.focused = true;
+                self.start(own, out);
+                self.connect_guest();
+            }
+            ("wl_keyboard", "leave") => {
+                self.focused = false;
+            }
+            ("wl_keyboard", "key") | ("wl_pointer", "button") => {
+                if let Some(Argument::Uint(serial)) = msg.args.first() {
+                    self.serial = Some(*serial);
+                }
+            }
+            _ => {}
+        }
+    }
+
+    /// An event on one of the proxy's own objects (`id` is a host id).
+    pub(super) fn on_own_event(
+        &mut self,
+        kind: OwnKind,
+        id: u32,
+        event: &str,
+        msg: &mut Message<u32, OwnedFd>,
+        own: &mut OwnObjects,
+        out: &mut Vec<HostRequest>,
+    ) {
+        match (kind, event) {
+            (OwnKind::Registry, "global") => {
+                if let [Argument::Uint(name), Argument::Str(Some(ref interface)), Argument::Uint(version)] = msg.args[..] {
+                    match interface.to_bytes() {
+                        b"wl_data_device_manager" => {
+                            self.manager_global.get_or_insert((name, version));
+                        }
+                        b"wl_seat" => {
+                            self.seat_global.get_or_insert(name);
+                        }
+                        _ => {}
+                    }
+                }
+            }
+            (OwnKind::Registry, "global_remove") => {
+                if let [Argument::Uint(name)] = msg.args[..] {
+                    if self.manager_global.is_some_and(|(n, _)| n == name) {
+                        self.manager_global = None;
+                    }
+                    if self.seat_global == Some(name) {
+                        self.seat_global = None;
+                    }
+                }
+            }
+            (OwnKind::DataDevice, "data_offer") => {
+                if let [Argument::NewId(offer)] = msg.args[..] {
+                    own.add_server(offer, &WL_DATA_OFFER_INTERFACE, OwnKind::DataOffer);
+                    self.host_offers.insert(offer, Vec::new());
+                }
+            }
+            (OwnKind::DataOffer, "offer") => {
+                if let [Argument::Str(Some(ref mime))] = msg.args[..] {
+                    if let Some(mimes) = self.host_offers.get_mut(&id) {
+                        mimes.push(mime.to_string_lossy().into_owned());
+                    }
+                }
+            }
+            (OwnKind::DataDevice, "selection") => {
+                let offer = match msg.args[..] {
+                    [Argument::Object(offer)] if offer != 0 => Some(offer),
+                    _ => None,
+                };
+                self.host_selection_changed(offer, own, out);
+            }
+            (OwnKind::DataDevice, "enter") => {
+                // a drag over the window: the proxy takes no part
+                if let Some(old) = self.host_dnd.take() {
+                    self.destroy_host_offer(old, own, out);
+                }
+                if let Some(&Argument::Object(offer)) = msg.args.get(4) {
+                    if offer != 0 {
+                        self.host_dnd = Some(offer);
+                    }
+                }
+            }
+            (OwnKind::DataDevice, "leave") | (OwnKind::DataDevice, "drop") => {
+                if let Some(old) = self.host_dnd.take() {
+                    self.destroy_host_offer(old, own, out);
+                }
+            }
+            (OwnKind::DataSource, "send") => {
+                let mut args = std::mem::take(&mut msg.args).into_iter();
+                let (Some(Argument::Str(Some(mime))), Some(Argument::Fd(fd))) = (args.next(), args.next()) else {
+                    return;
+                };
+                let mime = mime.to_string_lossy();
+                let Some(source) = self.host_sources.get(&id) else {
+                    return;
+                };
+                let data = if is_text(&mime) {
+                    source.text.clone()
+                } else if mime.eq_ignore_ascii_case(PNG) {
+                    source.png.clone()
+                } else {
+                    None
+                };
+                match data {
+                    Some(data) => spawn_writer(fd, data, "the guest's selection to the host"),
+                    None => debug!("clipboard: the host asked for {mime}, not offered"),
+                }
+            }
+            (OwnKind::DataSource, "cancelled") => {
+                // once: KWin 6.8 sent a data-control source cancelled twice (2026-10-08), and a
+                // request on a destroyed id is a protocol error that ends the connection - here
+                // the nested desktop's own
+                if self.host_sources.remove(&id).is_none() {
+                    return;
+                }
+                out.push(Message {
+                    sender_id: id,
+                    opcode: request_opcode(&WL_DATA_SOURCE_INTERFACE, "destroy"),
+                    args: smallvec![],
+                });
+                if self.host_current == Some(id) {
+                    self.host_current = None;
+                    debug!("clipboard: the guest's selection is no longer the host's");
+                }
+            }
+            _ => {}
+        }
+    }
+
+    fn destroy_host_offer(&mut self, offer: u32, own: &mut OwnObjects, out: &mut Vec<HostRequest>) {
+        if self.host_offers.remove(&offer).is_some() {
+            out.push(Message {
+                sender_id: offer,
+                opcode: request_opcode(&WL_DATA_OFFER_INTERFACE, "destroy"),
+                args: smallvec![],
+            });
+            own.remove_server(offer);
+        }
+    }
+
+    /// The host offered its selection (the window has the focus): its text is
+    /// read now, its image only when the guest asks for it.
+    fn host_selection_changed(&mut self, offer: Option<u32>, own: &mut OwnObjects, out: &mut Vec<HostRequest>) {
+        if let Some(old) = self.host_selection.take() {
+            if Some(old) != offer {
+                self.destroy_host_offer(old, own, out);
+            }
+        }
+        self.host_selection = offer;
+        self.host_generation += 1;
+        let Some(offer) = offer else {
+            return;
+        };
+        let mimes = self.host_offers.get(&offer).cloned().unwrap_or_default();
+        if has(&mimes, &MARKER) {
+            debug!("clipboard: the host's selection is the guest's own");
+            return;
+        }
+        let png = self.images() && has(&mimes, PNG);
+        let Some(text) = best_text(&mimes) else {
+            if png {
+                self.apply_to_guest(GuestSource { text: None, png });
+            } else {
+                debug!("clipboard: nothing to copy in the host's selection ({mimes:?})");
+            }
+            return;
+        };
+        let (read, write) = match pipe() {
+            Ok(p) => p,
+            Err(e) => {
+                warn!("clipboard: {e}");
+                return;
+            }
+        };
+        out.push(Message {
+            sender_id: offer,
+            opcode: request_opcode(&WL_DATA_OFFER_INTERFACE, "receive"),
+            args: smallvec![
+                Argument::Str(Some(Box::new(CString::new(text).unwrap()))),
+                Argument::Fd(write),
+            ],
+        });
+        let generation = self.host_generation;
+        self.notify.read(read, move |data| Done::HostText { generation, data });
+    }
+
+    /// Sets the host's selection in the guest, unless the guest has it already.
+    fn apply_to_guest(&mut self, source: GuestSource) {
+        let key = (hash_of(source.text.as_deref().map(|t| t.as_slice()), None), source.png);
+        if self.guest_current.is_some() && self.guest_applied == Some(key) {
+            debug!("clipboard: the guest has the host's selection already");
+            return;
+        }
+        let Some(guest) = self.guest.as_mut().filter(|g| g.ready()) else {
+            self.guest_pending = Some(source);
+            return;
+        };
+        match guest.set_selection(&offered_types(source.text.is_some(), source.png)) {
+            Ok(Some(id)) => {
+                info!("clipboard: host -> guest ({})", describe(source.text.as_deref().map(Vec::len), source.png.then_some(None)));
+                self.guest_sources.insert(id, source);
+                self.guest_current = Some(id);
+                self.guest_applied = Some(key);
+            }
+            Ok(None) => self.guest_pending = Some(source),
+            Err(e) => {
+                warn!("clipboard: the nested compositor: {e}");
+                self.guest = None;
+            }
+        }
+    }
+
+    /// The guest's selection changed (not to the proxy's own): read it, to
+    /// offer it to the host if the window has the focus.
+    fn guest_selection_changed(&mut self, offer: u32, mimes: Vec<String>) {
+        self.guest_generation += 1;
+        self.guest_read = None;
+        if has(&mimes, &MARKER) {
+            return;
+        }
+        self.guest_current = None;
+        if !self.focused {
+            debug!("clipboard: the guest's selection changed while the window is not focused: it stays in the guest");
+            return;
+        }
+        let generation = self.guest_generation;
+        let mut read = GuestRead {
+            generation,
+            text: Part::Unused,
+            png: Part::Unused,
+        };
+        let Some(guest) = self.guest.as_mut() else {
+            return;
+        };
+        let wanted = [
+            (false, best_text(&mimes).map(str::to_owned)),
+            (true, (self.cfg.mode == ClipboardMode::Focus && has(&mimes, PNG)).then(|| PNG.to_owned())),
+        ];
+        for (png, mime) in wanted {
+            let Some(mime) = mime else { continue };
+            match guest.receive(offer, &mime) {
+                Ok(fd) => {
+                    *(if png { &mut read.png } else { &mut read.text }) = Part::Reading;
+                    self.notify.read(fd, move |data| Done::Guest { generation, png, data });
+                }
+                Err(e) => warn!("clipboard: reading the guest's selection: {e}"),
+            }
+        }
+        if read.text.done() && read.png.done() {
+            debug!("clipboard: nothing to copy in the guest's selection ({mimes:?})");
+            return;
+        }
+        self.guest_read = Some(read);
+    }
+
+    /// The guest's selection has been read: the host's selection now, if the
+    /// window had the focus when it was copied.
+    fn offer_to_host(&mut self, own: &mut OwnObjects, out: &mut Vec<HostRequest>) {
+        let Some(mut read) = self.guest_read.take() else { return };
+        let text = read.text.take().map(Arc::new);
+        let png = read.png.take().map(Arc::new);
+        if text.is_none() && png.is_none() {
+            return;
+        }
+        let hash = hash_of(text.as_deref().map(|t| t.as_slice()), png.as_deref().map(|p| p.as_slice()));
+        if self.host_current.is_some() && self.host_hash == Some(hash) {
+            debug!("clipboard: the host has the guest's selection already");
+            return;
+        }
+        let (Some(manager), Some(device), Some(serial)) = (self.manager, self.device, self.serial) else {
+            return;
+        };
+        let Some(id) = own.alloc(&WL_DATA_SOURCE_INTERFACE, OwnKind::DataSource) else {
+            warn!("clipboard: no free proxy object id for a selection");
+            return;
+        };
+        out.push(Message {
+            sender_id: manager,
+            opcode: request_opcode(&WL_DATA_DEVICE_MANAGER_INTERFACE, "create_data_source"),
+            args: smallvec![Argument::NewId(id)],
+        });
+        for mime in offered_types(text.is_some(), png.is_some()) {
+            out.push(Message {
+                sender_id: id,
+                opcode: request_opcode(&WL_DATA_SOURCE_INTERFACE, "offer"),
+                args: smallvec![Argument::Str(Some(Box::new(CString::new(mime).unwrap())))],
+            });
+        }
+        out.push(Message {
+            sender_id: device,
+            opcode: request_opcode(&WL_DATA_DEVICE_INTERFACE, "set_selection"),
+            args: smallvec![Argument::Object(id), Argument::Uint(serial)],
+        });
+        info!("clipboard: guest -> host ({})", describe(text.as_deref().map(Vec::len), png.as_deref().map(|p| Some(p.len()))));
+        self.host_sources.insert(id, HostSource { text, png });
+        self.host_current = Some(id);
+        self.host_hash = Some(hash);
+    }
+
+    /// The guest asked the proxy's selection for `mime`.
+    fn guest_send(&mut self, source: u32, mime: String, fd: OwnedFd, out: &mut Vec<HostRequest>) {
+        let Some(data) = self.guest_sources.get(&source) else {
+            return;
+        };
+        if is_text(&mime) {
+            if let Some(text) = data.text.clone() {
+                spawn_writer(fd, text, "the host's text to the guest");
+            }
+            return;
+        }
+        if !(mime.eq_ignore_ascii_case(PNG) && data.png) {
+            return;
+        }
+        // the image of the host's current offer, read for this request
+        let Some(offer) = self.host_selection.filter(|o| self.host_offers.get(o).is_some_and(|m| has(m, PNG))) else {
+            debug!("clipboard: the guest asked for the host's image, the host offers none now");
+            return;
+        };
+        let (read, write) = match pipe() {
+            Ok(p) => p,
+            Err(e) => {
+                warn!("clipboard: {e}");
+                return;
+            }
+        };
+        out.push(Message {
+            sender_id: offer,
+            opcode: request_opcode(&WL_DATA_OFFER_INTERFACE, "receive"),
+            args: smallvec![Argument::Str(Some(Box::new(CString::new(PNG).unwrap()))), Argument::Fd(write)],
+        });
+        spawn("clipboard-image", move || {
+            match read_all(&read, MAX_SIZE, READ_TIMEOUT) {
+                Ok(data) => {
+                    let len = data.len();
+                    match write_all(fd, &data, WRITE_TIMEOUT) {
+                        Ok(()) => info!("clipboard: host -> guest, a {len} byte image"),
+                        Err(e) => debug!("clipboard: writing the host's image to the guest: {e}"),
+                    }
+                }
+                Err(e) => warn!("clipboard: reading the host's image: {e}"),
+            }
+        });
+    }
+
+    fn on_done(&mut self, done: Done, own: &mut OwnObjects, out: &mut Vec<HostRequest>) {
+        match done {
+            Done::HostText { generation, data } => {
+                if generation != self.host_generation {
+                    return;
+                }
+                let Some(offer) = self.host_selection else { return };
+                let png = self.images() && self.host_offers.get(&offer).is_some_and(|m| has(m, PNG));
+                let text = data.filter(|d| !d.is_empty()).map(Arc::new);
+                if text.is_some() || png {
+                    self.apply_to_guest(GuestSource { text, png });
+                }
+            }
+            Done::Guest { generation, png, data } => {
+                let Some(read) = self.guest_read.as_mut().filter(|r| r.generation == generation) else {
+                    return;
+                };
+                *(if png { &mut read.png } else { &mut read.text }) = Part::Read(data);
+                if read.text.done() && read.png.done() {
+                    self.offer_to_host(own, out);
+                }
+            }
+        }
+    }
+
+    fn on_guest_event(&mut self, event: GuestEvent, out: &mut Vec<HostRequest>) {
+        match event {
+            GuestEvent::Ready => {
+                if let Some(source) = self.guest_pending.take() {
+                    self.apply_to_guest(source);
+                }
+            }
+            GuestEvent::Missing => {
+                warn!("clipboard: the nested compositor offers no ext_data_control_manager_v1: the host's clipboard does not reach the guest");
+            }
+            GuestEvent::Selection { offer, mimes } => self.guest_selection_changed(offer, mimes),
+            GuestEvent::Send { source, mime, fd } => self.guest_send(source, mime, fd, out),
+            GuestEvent::Cancelled { source } => {
+                self.guest_sources.remove(&source);
+                if self.guest_current == Some(source) {
+                    self.guest_current = None;
+                }
+            }
+        }
+    }
+
+    /// Finished transfers and the nested compositor's events; `out` receives
+    /// requests of the proxy to send to the host.
+    pub(super) fn dispatch(&mut self, own: &mut OwnObjects, out: &mut Vec<HostRequest>) {
+        // the event loop passes here for every batch of messages: one syscall when idle
+        if !self.enabled() || !self.pending() {
+            return;
+        }
+        let mut count = [0u8; 8];
+        // SAFETY: reading the counter of a non-blocking eventfd
+        unsafe { libc::read(self.notify.wake.as_raw_fd(), count.as_mut_ptr().cast(), 8) };
+        while let Ok(done) = self.rx.try_recv() {
+            self.on_done(done, own, out);
+        }
+        let Some(guest) = self.guest.as_mut() else { return };
+        let mut events = Vec::new();
+        let result = guest.dispatch(&mut events).and_then(|()| guest.flush());
+        for event in events {
+            self.on_guest_event(event, out);
+        }
+        if let Some(guest) = self.guest.as_mut() {
+            if let Err(e) = result.and_then(|()| guest.flush()) {
+                warn!("clipboard: lost the nested compositor: {e}");
+                self.guest = None;
+                self.guest_sources.clear();
+                self.guest_current = None;
+                self.guest_read = None;
+            }
+        }
+    }
+}
+
+/// `wl_registry.bind` on the proxy's registry.
+fn bind(name: u32, interface: &str, version: u32, id: u32) -> HostRequest {
+    Message {
+        sender_id: FIRST_OWN,
+        opcode: request_opcode(&WL_REGISTRY_INTERFACE, "bind"),
+        args: smallvec![
+            Argument::Uint(name),
+            Argument::Str(Some(Box::new(CString::new(interface).unwrap()))),
+            Argument::Uint(version),
+            Argument::NewId(id),
+        ],
+    }
+}
+
+/// What the nested compositor's events mean for the clipboard.
+#[derive(Debug)]
+enum GuestEvent {
+    /// The data device exists: the guest's selection can be set.
+    Ready,
+    /// The nested compositor has no ext_data_control_manager_v1.
+    Missing,
+    /// The guest's selection changed to an offer of `mimes`.
+    Selection { offer: u32, mimes: Vec<String> },
+    /// The guest asked a selection of the proxy for `mime`.
+    Send { source: u32, mime: String, fd: OwnedFd },
+    /// A selection of the proxy is no longer the guest's.
+    Cancelled { source: u32 },
+}
+
+/// The proxy's own client connection to the nested compositor.
+struct GuestClient {
+    sock: BufferedSocket,
+    objects: HashMap<u32, &'static Interface>,
+    next_id: u32,
+    free_ids: Vec<u32>,
+    /// ids the proxy destroyed, until the compositor's delete_id: their events are dropped
+    dying: HashSet<u32>,
+    registry: u32,
+    sync: Option<u32>,
+    manager: Option<u32>,
+    seat: Option<u32>,
+    device: Option<u32>,
+    offers: HashMap<u32, Vec<String>>,
+    selection: Option<u32>,
+}
+
+type Args = SmallVec<[Argument<u32, OwnedFd>; 4]>;
+
+impl GuestClient {
+    fn connect(path: &Path) -> io::Result<Self> {
+        let stream = UnixStream::connect(path)?;
+        stream.set_nonblocking(true)?;
+        Self::new(stream)
+    }
+
+    fn new(stream: UnixStream) -> io::Result<Self> {
+        let mut client = GuestClient {
+            sock: BufferedSocket::new(Socket::from(stream)),
+            objects: HashMap::from([(1, &WL_DISPLAY_INTERFACE)]),
+            next_id: 2,
+            free_ids: Vec::new(),
+            dying: HashSet::new(),
+            registry: 0,
+            sync: None,
+            manager: None,
+            seat: None,
+            device: None,
+            offers: HashMap::new(),
+            selection: None,
+        };
+        let registry = client.new_id(&WL_REGISTRY_INTERFACE);
+        client.request(1, &WL_DISPLAY_INTERFACE, "get_registry", smallvec![Argument::NewId(registry)])?;
+        client.registry = registry;
+        // its done event says whether the globals had the data control manager
+        let sync = client.new_id(&WL_CALLBACK_INTERFACE);
+        client.request(1, &WL_DISPLAY_INTERFACE, "sync", smallvec![Argument::NewId(sync)])?;
+        client.sync = Some(sync);
+        client.flush()?;
+        Ok(client)
+    }
+
+    fn ready(&self) -> bool {
+        self.device.is_some()
+    }
+
+    fn new_id(&mut self, interface: &'static Interface) -> u32 {
+        let id = self.free_ids.pop().unwrap_or_else(|| {
+            self.next_id += 1;
+            self.next_id - 1
+        });
+        self.objects.insert(id, interface);
+        id
+    }
+
+    fn request(&mut self, sender: u32, interface: &Interface, name: &str, args: Args) -> io::Result<()> {
+        debug!("clipboard: guest <- {}@{sender}.{name}({:?})", interface.name, args);
+        self.sock.write_message(&Message {
+            sender_id: sender,
+            opcode: request_opcode(interface, name),
+            args,
+        })
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        match self.sock.flush() {
+            Err(e) if e.kind() == io::ErrorKind::WouldBlock => Ok(()),
+            other => other,
+        }
+    }
+
+    fn bind(&mut self, name: u32, interface: &'static Interface, version: u32) -> io::Result<u32> {
+        let id = self.new_id(interface);
+        let args = smallvec![
+            Argument::Uint(name),
+            Argument::Str(Some(Box::new(CString::new(interface.name).unwrap()))),
+            Argument::Uint(version),
+            Argument::NewId(id),
+        ];
+        self.request(self.registry, &WL_REGISTRY_INTERFACE, "bind", args)?;
+        Ok(id)
+    }
+
+    /// Asks the guest's selection for `mime`; returns the pipe's read end.
+    fn receive(&mut self, offer: u32, mime: &str) -> io::Result<OwnedFd> {
+        let (read, write) = pipe()?;
+        let mime = CString::new(mime).map_err(io::Error::other)?;
+        self.request(
+            offer,
+            &EXT_DATA_CONTROL_OFFER_V1_INTERFACE,
+            "receive",
+            smallvec![Argument::Str(Some(Box::new(mime))), Argument::Fd(write)],
+        )?;
+        self.flush()?;
+        Ok(read)
+    }
+
+    /// Sets the guest's selection to a new source offering `mimes`.
+    fn set_selection(&mut self, mimes: &[&str]) -> io::Result<Option<u32>> {
+        let (Some(manager), Some(device)) = (self.manager, self.device) else {
+            return Ok(None);
+        };
+        let source = self.new_id(&EXT_DATA_CONTROL_SOURCE_V1_INTERFACE);
+        self.request(
+            manager,
+            &EXT_DATA_CONTROL_MANAGER_V1_INTERFACE,
+            "create_data_source",
+            smallvec![Argument::NewId(source)],
+        )?;
+        for mime in mimes {
+            let mime = CString::new(*mime).unwrap();
+            self.request(source, &EXT_DATA_CONTROL_SOURCE_V1_INTERFACE, "offer", smallvec![Argument::Str(Some(Box::new(mime)))])?;
+        }
+        self.request(device, &EXT_DATA_CONTROL_DEVICE_V1_INTERFACE, "set_selection", smallvec![Argument::Object(source)])?;
+        self.flush()?;
+        Ok(Some(source))
+    }
+
+    fn destroy(&mut self, id: u32) -> io::Result<()> {
+        let Some(interface) = self.objects.get(&id).copied() else {
+            return Ok(());
+        };
+        if id < SERVER_ID_START && !self.dying.insert(id) {
+            return Ok(());
+        }
+        self.request(id, interface, "destroy", smallvec![])?;
+        if id >= SERVER_ID_START {
+            // no delete_id for the server's ids
+            self.objects.remove(&id);
+            self.offers.remove(&id);
+        }
+        Ok(())
+    }
+
+    /// Reads and handles the nested compositor's events until none is left.
+    fn dispatch(&mut self, events: &mut Vec<GuestEvent>) -> io::Result<()> {
+        loop {
+            let objects = &self.objects;
+            let parsed = self.sock.read_one_message(|id, opcode| {
+                objects
+                    .get(&id)
+                    .and_then(|i| i.events.get(opcode as usize))
+                    .map(|e| e.signature)
+            });
+            match parsed {
+                Ok(msg) => self.handle(msg, events)?,
+                Err(MessageParseError::MissingData) | Err(MessageParseError::MissingFD) => {
+                    match self.sock.fill_incoming_buffers() {
+                        Ok(()) => continue,
+                        Err(e) if e.kind() == io::ErrorKind::WouldBlock => return Ok(()),
+                        Err(e) => return Err(e),
+                    }
+                }
+                Err(MessageParseError::Malformed) => {
+                    if self.sock.skip_one_message().is_none() {
+                        return Err(io::Error::other("malformed event"));
+                    }
+                }
+            }
+        }
+    }
+
+    fn handle(&mut self, msg: Message<u32, OwnedFd>, events: &mut Vec<GuestEvent>) -> io::Result<()> {
+        let Some(interface) = self.objects.get(&msg.sender_id).copied() else {
+            return Ok(());
+        };
+        let event = interface.events[msg.opcode as usize].name;
+        if self.dying.contains(&msg.sender_id) {
+            // KWin 6.8 sent a source cancelled twice (2026-10-08): a second destroy killed the
+            // connection with "invalid object"
+            debug!("clipboard: guest -> {}@{}.{event} after its destroy: dropped", interface.name, msg.sender_id);
+            return Ok(());
+        }
+        debug!("clipboard: guest -> {}@{}.{event}({:?})", interface.name, msg.sender_id, msg.args);
+        match (interface.name, event) {
+            ("wl_display", "error") => {
+                return Err(io::Error::other(format!("protocol error {:?}", msg.args)));
+            }
+            ("wl_display", "delete_id") => {
+                if let [Argument::Uint(id)] = msg.args[..] {
+                    self.objects.remove(&id);
+                    self.dying.remove(&id);
+                    self.free_ids.push(id);
+                }
+            }
+            ("wl_registry", "global") => {
+                if let [Argument::Uint(name), Argument::Str(Some(ref interface)), Argument::Uint(_)] = msg.args[..] {
+                    match interface.to_bytes() {
+                        b"ext_data_control_manager_v1" if self.manager.is_none() => {
+                            self.manager = Some(self.bind(name, &EXT_DATA_CONTROL_MANAGER_V1_INTERFACE, 1)?);
+                        }
+                        b"wl_seat" if self.seat.is_none() => {
+                            self.seat = Some(self.bind(name, &WL_SEAT_INTERFACE, 1)?);
+                        }
+                        _ => {}
+                    }
+                    if let (Some(manager), Some(seat), None) = (self.manager, self.seat, self.device) {
+                        let device = self.new_id(&EXT_DATA_CONTROL_DEVICE_V1_INTERFACE);
+                        self.request(
+                            manager,
+                            &EXT_DATA_CONTROL_MANAGER_V1_INTERFACE,
+                            "get_data_device",
+                            smallvec![Argument::NewId(device), Argument::Object(seat)],
+                        )?;
+                        self.device = Some(device);
+                        events.push(GuestEvent::Ready);
+                    }
+                }
+            }
+            ("wl_callback", "done") => {
+                if self.sync == Some(msg.sender_id) {
+                    self.sync = None;
+                    if self.manager.is_none() {
+                        events.push(GuestEvent::Missing);
+                    }
+                }
+            }
+            ("ext_data_control_device_v1", "data_offer") => {
+                if let [Argument::NewId(offer)] = msg.args[..] {
+                    self.objects.insert(offer, &EXT_DATA_CONTROL_OFFER_V1_INTERFACE);
+                    self.offers.insert(offer, Vec::new());
+                }
+            }
+            ("ext_data_control_offer_v1", "offer") => {
+                if let [Argument::Str(Some(ref mime))] = msg.args[..] {
+                    if let Some(mimes) = self.offers.get_mut(&msg.sender_id) {
+                        mimes.push(mime.to_string_lossy().into_owned());
+                    }
+                }
+            }
+            ("ext_data_control_device_v1", "selection") => {
+                let offer = match msg.args[..] {
+                    [Argument::Object(offer)] if offer != 0 => Some(offer),
+                    _ => None,
+                };
+                if let Some(old) = self.selection.take() {
+                    if Some(old) != offer {
+                        self.destroy(old)?;
+                    }
+                }
+                self.selection = offer;
+                if let Some(offer) = offer {
+                    let mimes = self.offers.get(&offer).cloned().unwrap_or_default();
+                    events.push(GuestEvent::Selection { offer, mimes });
+                }
+            }
+            ("ext_data_control_device_v1", "primary_selection") => {
+                if let [Argument::Object(offer)] = msg.args[..] {
+                    if offer != 0 {
+                        self.destroy(offer)?;
+                    }
+                }
+            }
+            ("ext_data_control_device_v1", "finished") => {
+                // the seat is gone; the connection is of no further use
+                return Err(io::Error::other("the guest's data device finished"));
+            }
+            ("ext_data_control_source_v1", "send") => {
+                let mut args = msg.args.into_iter();
+                if let (Some(Argument::Str(Some(mime))), Some(Argument::Fd(fd))) = (args.next(), args.next()) {
+                    events.push(GuestEvent::Send {
+                        source: msg.sender_id,
+                        mime: mime.to_string_lossy().into_owned(),
+                        fd,
+                    });
+                }
+            }
+            ("ext_data_control_source_v1", "cancelled") => {
+                self.destroy(msg.sender_id)?;
+                events.push(GuestEvent::Cancelled { source: msg.sender_id });
+            }
+            _ => {}
+        }
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
