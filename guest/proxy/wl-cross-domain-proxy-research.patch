+    #[test]
+    fn fullscreen_chord_toggles_and_keeps_its_key_from_the_guest() {
+        let mut sh = Shell::default();
+        sh.on_request("xdg_wm_base", "get_xdg_surface", &mut ev(4, smallvec![Argument::NewId(10), Argument::Object(3)]));
+        sh.on_request("xdg_surface", "get_toplevel", &mut ev(10, smallvec![Argument::NewId(11)]));
+        let mut own = OwnObjects::new();
+        let mut sc = Shortcuts::new(ShortcutConfig {
+            enabled: true,
+            ..Default::default()
+        });
+        let mut out = Vec::new();
+        let configure = |states: Vec<u8>| {
+            ev(11, smallvec![Argument::Int(0), Argument::Int(0), Argument::Array(Box::new(states))])
+        };
+        let key = |k: u32, state: u32| {
+            ev(20, smallvec![Argument::Uint(2), Argument::Uint(0), Argument::Uint(k), Argument::Uint(state)])
+        };
+        let is = |m: &HostRequest, request: &str| {
+            m.sender_id == guest_to_host(11) && m.opcode == request_opcode(&XDG_TOPLEVEL_INTERFACE, request)
+        };
+
+        // shown in full screen, focused
+        let mut full = ev(11, smallvec![Argument::Int(1920), Argument::Int(1080), Argument::Array(Box::new(2u32.to_ne_bytes().to_vec()))]);
+        assert!(!sc.on_event("xdg_toplevel", "configure", &mut full, &sh, &mut own, &mut out));
+        let mut enter = ev(20, smallvec![Argument::Uint(1), Argument::Object(3), Argument::Array(Box::new(vec![]))]);
+        assert!(!sc.on_event("wl_keyboard", "enter", &mut enter, &sh, &mut own, &mut out));
+        out.clear();
+
+        // Ctrl+Alt+F: out of full screen, capture released; F never reaches the guest
+        assert!(!sc.on_event("wl_keyboard", "key", &mut key(29, 1), &sh, &mut own, &mut out));
+        assert!(!sc.on_event("wl_keyboard", "key", &mut key(56, 1), &sh, &mut own, &mut out));
+        assert!(sc.on_event("wl_keyboard", "key", &mut key(33, 1), &sh, &mut own, &mut out));
+        assert!(out.iter().any(|m| is(m, "unset_fullscreen")));
+        assert!(sc.released());
+        assert!(sc.on_event("wl_keyboard", "key", &mut key(33, 2), &sh, &mut own, &mut out)); // repeat
+        assert!(sc.on_event("wl_keyboard", "key", &mut key(33, 0), &sh, &mut own, &mut out));
+        assert!(!sc.on_event("wl_keyboard", "key", &mut key(56, 0), &sh, &mut own, &mut out));
+        assert!(!sc.on_event("wl_keyboard", "key", &mut key(29, 0), &sh, &mut own, &mut out));
+
+        // the host leaves the size to the guest: it gets four fifths of the full-screen size
+        let mut windowed = configure(vec![]);
+        sc.on_event("xdg_toplevel", "configure", &mut windowed, &sh, &mut own, &mut out);
+        assert!(matches!(windowed.args[..], [Argument::Int(1536), Argument::Int(864), _]));
+        // a later 0x0 configure is the guest's business again
+        let mut later = configure(vec![]);
+        sc.on_event("xdg_toplevel", "configure", &mut later, &sh, &mut own, &mut out);
+        assert!(matches!(later.args[..], [Argument::Int(0), Argument::Int(0), _]));
+
+        // windowed now: the chord again goes back to full screen and captures again
+        out.clear();
+        sc.on_event("wl_keyboard", "key", &mut key(97, 1), &sh, &mut own, &mut out); // right Ctrl
+        sc.on_event("wl_keyboard", "key", &mut key(100, 1), &sh, &mut own, &mut out); // AltGr
+        assert!(sc.on_event("wl_keyboard", "key", &mut key(33, 1), &sh, &mut own, &mut out));
+        assert!(out.iter().any(|m| is(m, "set_fullscreen")));
+        assert!(!sc.released());
+
+        // other keys pass, and F alone is no chord
+        sc.on_event("wl_keyboard", "key", &mut key(97, 0), &sh, &mut own, &mut out);
+        sc.on_event("wl_keyboard", "key", &mut key(100, 0), &sh, &mut own, &mut out);
+        sc.on_event("wl_keyboard", "key", &mut key(33, 0), &sh, &mut own, &mut out);
+        assert!(!sc.on_event("wl_keyboard", "key", &mut key(33, 1), &sh, &mut own, &mut out));
+        assert!(!sc.on_event("wl_keyboard", "key", &mut key(33, 0), &sh, &mut own, &mut out));
+    }
+}
diff -ruN a/src/session/stats.rs b/src/session/stats.rs
--- a/src/session/stats.rs
+++ b/src/session/stats.rs
@@ -0,0 +1,885 @@
+//! Live performance numbers of the forwarded window, like a VM viewer's:
+//! frames per second and latencies, over a rolling window (1 s), shown in the
+//! window title and optionally logged per frame to a CSV file.
+//!
+//! Everything comes from messages the proxy forwards anyway; it adds no
+//! request with a reply. All times are the guest's presentation clock
+//! (CLOCK_MONOTONIC), `presented` timestamps after the proxy's translation of
+//! the host clock (see [`crate::clock`]). That translation is late by the
+//! smallest recent event delivery delay (about 0.1 ms), so latencies ending at
+//! a presentation are overestimated by that much at most.
+//!
+//! * A **frame** is a `wl_surface.commit` of a toplevel's surface that asked
+//!   for `wp_presentation` feedback (nested KWin asks for every output frame).
+//! * **fps**: `presented` feedback per second; **commits**: frames committed
+//!   per second; **dropped**: `discarded` feedback per second.
+//! * **frame latency**: from the proxy receiving the frame's commit from the
+//!   guest to its presentation on the host. It includes the fence gate's hold,
+//!   the transport, and the host compositor's latch, composition and scanout.
+//! * **input latency**: from the arrival of a host input event at the proxy
+//!   (pointer motion, button press, scroll, key press, touch) to the
+//!   presentation of the first frame committed after it; inputs without a
+//!   frame within 250 ms are not counted (nothing changed on screen). A frame
+//!   already being drawn when the input arrived counts as well, so this is the
+//!   floor of what the guest could show, not what one app took to react.
+//! * **hold**: from receipt to forwarding of the frame's commit, what the
+//!   proxy adds to the frame latency: the fence gate's wait for the guest's GPU
+//!   (dma-buf frames), or the copy into host memory (shm frames, the software
+//!   fallback), and any request queued before the commit (a new shm pool costs
+//!   a round trip to the host).
+
+use std::cell::RefCell;
+use std::collections::{HashMap, VecDeque};
+use std::fs::File;
+use std::io::{self, BufWriter, Write};
+use std::os::fd::OwnedFd;
+use std::path::Path;
+use std::rc::Rc;
+
+use log::{info, warn};
+use wayland_server::backend::protocol::{Argument, Message};
+
+const NS_PER_MS: f64 = 1e6;
+/// Inputs older than this at the next frame are dropped (no visible effect).
+const INPUT_MAX_AGE_NS: i64 = 250_000_000;
+/// Inputs within this of the previous one count once (one host event batch).
+const INPUT_DEDUP_NS: i64 = 100_000;
+const MAX_PENDING_INPUTS: usize = 64;
+/// Bounds for the per-object maps, should feedback never come back.
+const MAX_TRACKED: usize = 1024;
+/// Frames in the overlay's graphs (one second at 240 Hz).
+const GRAPH_FRAMES: usize = 240;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum StatsMode {
+    Off,
+    /// "240 fps · 5.1 ms" (and "input 9.8 ms" / "N dropped" when there are any)
+    Title,
+    /// medians and p99 of every number, commits and the proxy's hold
+    Detail,
+}
+
+impl std::str::FromStr for StatsMode {
+    type Err = String;
+    fn from_str(s: &str) -> Result<Self, String> {
+        match s {
+            "off" | "none" | "0" => Ok(StatsMode::Off),
+            "title" | "on" | "1" => Ok(StatsMode::Title),
+            "detail" | "title-detail" => Ok(StatsMode::Detail),
+            _ => Err(format!("{s:?}: expected off, title or detail")),
+        }
+    }
+}
+
+/// Per-frame CSV rows, shared by all connections of the proxy.
+#[derive(Debug)]
+pub struct CsvLog {
+    out: BufWriter<File>,
+    dirty: bool,
+    next_conn: u32,
+}
+
+pub type SharedCsv = Rc<RefCell<CsvLog>>;
+
+impl CsvLog {
+    pub fn create(path: &Path) -> io::Result<SharedCsv> {
+        let mut out = BufWriter::new(File::create(path)?);
+        writeln!(
+            out,
+            "conn,status,presented_ns,commit_ns,forwarded_ns,frame_latency_ms,hold_ms,refresh_ns,flags,inputs,input_latency_oldest_ms,input_latency_newest_ms,ready_ns"
+        )?;
+        out.flush()?;
+        Ok(Rc::new(RefCell::new(CsvLog {
+            out,
+            dirty: false,
+            next_conn: 1,
+        })))
+    }
+
+    fn flush(&mut self) {
+        if self.dirty {
+            if let Err(err) = self.out.flush() {
+                warn!("stats: writing the CSV log failed: {err}");
+            }
+            self.dirty = false;
+        }
+    }
+}
+
+#[derive(Debug, Clone)]
+pub struct StatsConfig {
+    pub mode: StatsMode,
+    pub log: Option<SharedCsv>,
+    /// Title updates, in ns.
+    pub interval_ns: i64,
+    /// Rolling window of the numbers, in ns.
+    pub window_ns: i64,
+}
+
+impl Default for StatsConfig {
+    fn default() -> Self {
+        StatsConfig {
+            mode: StatsMode::Off,
+            log: None,
+            interval_ns: 500_000_000,
+            window_ns: 1_000_000_000,
+        }
+    }
+}
+
+impl StatsConfig {
+    pub fn active(&self) -> bool {
+        self.mode != StatsMode::Off || self.log.is_some()
+    }
+}
+
+struct Frame {
+    rx: i64,
+    fwd: i64,
+    inputs: Vec<i64>,
+    /// the host's content_update_ready (presentation-time v4, ours), guest clock
+    ready: Option<i64>,
+}
+
+/// Median and 99th percentile of a slice (sorted in place), ns.
+fn percentiles(v: &mut [i64]) -> Option<(i64, i64)> {
+    if v.is_empty() {
+        return None;
+    }
+    v.sort_unstable();
+    let at = |p: f64| v[(((p * v.len() as f64).ceil() as usize).max(1) - 1).min(v.len() - 1)];
+    Some((at(0.5), at(0.99)))
+}
+
+fn prune(q: &mut VecDeque<i64>, since: i64) {
+    while q.front().is_some_and(|t| *t < since) {
+        q.pop_front();
+    }
+}
+
+fn prune_pairs(q: &mut VecDeque<(i64, i64)>, since: i64) {
+    while q.front().is_some_and(|(t, _)| *t < since) {
+        q.pop_front();
+    }
+}
+
+fn values(q: &VecDeque<(i64, i64)>) -> Vec<i64> {
+    q.iter().map(|(_, v)| *v).collect()
+}
+
+fn ms(ns: i64) -> f64 {
+    ns as f64 / NS_PER_MS
+}
+
+/// One summary of the window.
+#[derive(Debug, Default, Clone, PartialEq)]
+pub struct Summary {
+    pub presented: usize,
+    pub commits: usize,
+    pub dropped: usize,
+    pub feedback_seen: bool,
+    pub frame: Option<(i64, i64)>,
+    pub input: Option<(i64, i64)>,
+    pub hold: Option<(i64, i64)>,
+    pub window_ns: i64,
+}
+
+impl Summary {
+    fn per_second(&self, n: usize) -> f64 {
+        n as f64 * 1e9 / self.window_ns as f64
+    }
+
+    pub fn text(&self, mode: StatsMode) -> String {
+        let mut s;
+        if !self.feedback_seen && self.commits > 0 {
+            // a client that never asks for presentation feedback
+            s = format!("{:.0} commits/s", self.per_second(self.commits));
+        } else {
+            s = format!("{:.0} fps", self.per_second(self.presented));
+        }
+        match mode {
+            StatsMode::Off => String::new(),
+            StatsMode::Title => {
+                if let Some((p50, _)) = self.frame {
+                    s += &format!(" \u{b7} {:.1} ms", ms(p50));
+                }
+                if let Some((p50, _)) = self.input {
+                    s += &format!(" \u{b7} input {:.1} ms", ms(p50));
+                }
+                if self.dropped > 0 {
+                    s += &format!(" \u{b7} {} dropped", self.dropped);
+                }
+                s
+            }
+            StatsMode::Detail => {
+                s += &format!(
+                    " ({:.0} commits, {} dropped)",
+                    self.per_second(self.commits),
+                    self.dropped
+                );
+                if let Some((p50, p99)) = self.frame {
+                    s += &format!(" \u{b7} frame {:.1}/{:.1} ms", ms(p50), ms(p99));
+                }
+                if let Some((p50, p99)) = self.input {
+                    s += &format!(" \u{b7} input {:.1}/{:.1} ms", ms(p50), ms(p99));
+                }
+                if let Some((p50, p99)) = self.hold {
+                    s += &format!(" \u{b7} hold {:.2}/{:.2} ms", ms(p50), ms(p99));
+                }
+                s
+            }
+        }
+    }
+}
+
+pub(super) struct Stats {
+    cfg: StatsConfig,
+    conn: u32,
+    /// wp_presentation_feedback -> surface, requested but not yet committed
+    requested: HashMap<u32, u32>,
+    /// wp_presentation_feedback of committed frames, awaiting presented/discarded
+    frames: HashMap<u32, Frame>,
+    pending_inputs: Vec<i64>,
+    commits: VecDeque<i64>,
+    presented: VecDeque<i64>,
+    dropped: VecDeque<i64>,
+    frame_lat: VecDeque<(i64, i64)>,
+    input_lat: VecDeque<(i64, i64)>,
+    hold: VecDeque<(i64, i64)>,
+    feedback_seen: bool,
+    last_text: Option<String>,
+    /// the overlay is shown: track frames whatever --stats says
+    overlay: bool,
+    /// presentation times of the last presented frames, for the overlay's graph
+    present_times: VecDeque<i64>,
+    /// forwarding times of the last commits, for the overlay's graph
+    commit_times: VecDeque<i64>,
+    /// the host's refresh period, from the last presented frame (ns, 0: unknown)
+    refresh_ns: u32,
+    // journal summary over a longer interval
+    journal_interval_ns: i64,
+    journal_since: Option<i64>,
+    j_presented: u64,
+    j_commits: u64,
+    j_dropped: u64,
+    j_frame: Vec<i64>,
+    j_input: Vec<i64>,
+    j_hold: Vec<i64>,
+}
+
+impl Stats {
+    pub(super) fn new(cfg: StatsConfig, journal_interval_s: i64) -> Self {
+        let conn = cfg.log.as_ref().map_or(0, |log| {
+            let mut log = log.borrow_mut();
+            log.next_conn += 1;
+            log.next_conn - 1
+        });
+        Stats {
+            cfg,
+            conn,
+            requested: HashMap::new(),
+            frames: HashMap::new(),
+            pending_inputs: Vec::new(),
+            commits: VecDeque::new(),
+            presented: VecDeque::new(),
+            dropped: VecDeque::new(),
+            frame_lat: VecDeque::new(),
+            input_lat: VecDeque::new(),
+            hold: VecDeque::new(),
+            feedback_seen: false,
+            last_text: None,
+            overlay: false,
+            present_times: VecDeque::new(),
+            commit_times: VecDeque::new(),
+            refresh_ns: 0,
+            journal_interval_ns: journal_interval_s.max(0) * 1_000_000_000,
+            journal_since: None,
+            j_presented: 0,
+            j_commits: 0,
+            j_dropped: 0,
+            j_frame: Vec::new(),
+            j_input: Vec::new(),
+            j_hold: Vec::new(),
+        }
+    }
+
+    pub(super) fn active(&self) -> bool {
+        self.cfg.active() || self.overlay
+    }
+
+    /// The overlay is shown (frames are tracked for it) or hidden.
+    pub(super) fn set_overlay(&mut self, shown: bool) {
+        self.overlay = shown;
+        self.present_times.clear();
+        self.commit_times.clear();
+    }
+
+    pub(super) fn mode(&self) -> StatsMode {
+        self.cfg.mode
+    }
+
+    pub(super) fn interval_ns(&self) -> i64 {
+        self.cfg.interval_ns
+    }
+
+    /// A guest request being forwarded: `received` when the proxy read it
+    /// from the guest, `now` = forwarding time.
+    pub(super) fn on_request(
+        &mut self,
+        interface: &str,
+        request: &str,
+        msg: &Message<u32, OwnedFd>,
+        received: i64,
+        now: i64,
+        toplevel_surface: bool,
+    ) {
+        if !self.active() {
+            return;
+        }
+        match (interface, request) {
+            ("wp_presentation", "feedback") => {
+                if let [Argument::Object(surface), Argument::NewId(feedback)] = msg.args[..] {
+                    if self.requested.len() >= MAX_TRACKED {
+                        self.requested.clear();
+                    }
+                    self.requested.insert(feedback, surface);
+                }
+            }
+            ("wl_surface", "commit") => {
+                let surface = msg.sender_id;
+                // feedback applies to the surface's next commit
+                let feedbacks: Vec<u32> = self
+                    .requested
+                    .iter()
+                    .filter(|(_, s)| **s == surface)
+                    .map(|(f, _)| *f)
+                    .collect();
+                for feedback in &feedbacks {
+                    self.requested.remove(feedback);
+                }
+                if !toplevel_surface {
+                    return;
+                }
+                self.commits.push_back(now);
+                self.j_commits += 1;
+                if self.overlay {
+                    if self.commit_times.len() > GRAPH_FRAMES {
+                        self.commit_times.pop_front();
+                    }
+                    self.commit_times.push_back(now);
+                }
+                if feedbacks.is_empty() {
+                    return;
+                }
+                // the inputs that arrived before this commit, and not too long before
+                let mut inputs = Vec::new();
+                self.pending_inputs.retain(|t| {
+                    if *t <= received {
+                        if received - *t <= INPUT_MAX_AGE_NS {
+                            inputs.push(*t);
+                        }
+                        false
+                    } else {
+                        true
+                    }
+                });
+                self.hold.push_back((now, (now - received).max(0)));
+                self.j_hold.push((now - received).max(0));
+                if self.frames.len() >= MAX_TRACKED {
+                    self.frames.clear();
+                }
+                for feedback in feedbacks {
+                    self.frames.insert(
+                        feedback,
+                        Frame {
+                            rx: received,
+                            fwd: now,
+                            inputs: std::mem::take(&mut inputs),
+                            ready: None,
+                        },
+                    );
+                }
+            }
+            ("wl_surface", "destroy") => {
+                let surface = msg.sender_id;
+                self.requested.retain(|_, s| *s != surface);
+            }
+            _ => {}
+        }
+    }
+
+    /// A host event about to reach the guest (guest ids, translated times).
+    pub(super) fn on_event(&mut self, interface: &str, event: &str, msg: &Message<u32, OwnedFd>, now: i64) {
+        if !self.active() {
+            return;
+        }
+        match (interface, event) {
+            ("wp_presentation_feedback", "presented") => {
+                // frames of the toplevel only (feedback of other surfaces is not tracked)
+                let Some(frame) = self.frames.remove(&msg.sender_id) else {
+                    return;
+                };
+                self.feedback_seen = true;
+                self.presented.push_back(now);
+                self.j_presented += 1;
+                let [
+                    Argument::Uint(hi),
+                    Argument::Uint(lo),
+                    Argument::Uint(nsec),
+                    Argument::Uint(refresh),
+                    _,
+                    _,
+                    Argument::Uint(flags),
+                ] = msg.args[..]
+                else {
+                    return;
+                };
+                let presented = ((((hi as u64) << 32) | lo as u64) as i64)
+                    .saturating_mul(1_000_000_000)
+                    .saturating_add(nsec as i64);
+                if self.overlay {
+                    if self.present_times.len() > GRAPH_FRAMES {
+                        self.present_times.pop_front();
+                    }
+                    self.present_times.push_back(presented);
+                    self.refresh_ns = refresh;
+                }
+                let latency = presented - frame.rx;
+                // a frame is shown at most a few refreshes later; anything else
+                // is a clock translation still settling
+                let valid = (0..=2_000_000_000).contains(&latency);
+                if valid {
+                    self.frame_lat.push_back((now, latency));
+                    self.j_frame.push(latency);
+                }
+                let (mut oldest, mut newest) = (None, None);
+                for t in &frame.inputs {
+                    let l = presented - t;
+                    if valid && l >= 0 {
+                        self.input_lat.push_back((now, l));
+                        self.j_input.push(l);
+                        oldest = Some(oldest.map_or(l, |o: i64| o.max(l)));
+                        newest = Some(newest.map_or(l, |n: i64| n.min(l)));
+                    }
+                }
+                self.csv_row(
+                    "presented",
+                    Some(presented),
+                    &frame,
+                    Some(refresh),
+                    Some(flags),
+                    oldest,
+                    newest,
+                );
+            }
+            ("wp_presentation_feedback", "content_update_ready") => {
+                if let (Some(frame), [Argument::Uint(hi), Argument::Uint(lo), Argument::Uint(nsec)]) =
+                    (self.frames.get_mut(&msg.sender_id), &msg.args[..])
+                {
+                    frame.ready = Some(
+                        ((((*hi as u64) << 32) | *lo as u64) as i64)
+                            .saturating_mul(1_000_000_000)
+                            .saturating_add(*nsec as i64),
+                    );
+                }
+            }
+            ("wp_presentation_feedback", "discarded") => {
+                if let Some(frame) = self.frames.remove(&msg.sender_id) {
+                    self.feedback_seen = true;
+                    self.dropped.push_back(now);
+                    self.j_dropped += 1;
+                    self.csv_row("discarded", None, &frame, None, None, None, None);
+                }
+            }
+            ("wl_pointer", "motion")
+            | ("wl_pointer", "axis")
+            | ("wl_pointer", "axis_value120")
+            | ("wl_pointer", "axis_discrete")
+            | ("wl_touch", "down")
+            | ("wl_touch", "motion")
+            | ("zwp_relative_pointer_v1", "relative_motion") => self.input(now),
+            ("wl_pointer", "button") | ("wl_keyboard", "key") => {
+                // presses only: wl_pointer.button(serial, time, button, state),
+                // wl_keyboard.key(serial, time, key, state)
+                if let Some(Argument::Uint(1)) = msg.args.get(3) {
+                    self.input(now);
+                }
+            }
+            _ => {}
+        }
+    }
+
+    fn input(&mut self, now: i64) {
+        if self
+            .pending_inputs
+            .last()
+            .is_some_and(|t| now - *t < INPUT_DEDUP_NS)
+        {
+            return;
+        }
+        if self.pending_inputs.len() < MAX_PENDING_INPUTS {
+            self.pending_inputs.push(now);
+        }
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    fn csv_row(
+        &mut self,
+        status: &str,
+        presented: Option<i64>,
+        frame: &Frame,
+        refresh: Option<u32>,
+        flags: Option<u32>,
+        input_oldest: Option<i64>,
+        input_newest: Option<i64>,
+    ) {
+        let Some(log) = &self.cfg.log else { return };
+        let mut log = log.borrow_mut();
+        let opt = |v: Option<i64>| v.map(|v| v.to_string()).unwrap_or_default();
+        let opt_ms = |v: Option<i64>| v.map(|v| format!("{:.3}", ms(v))).unwrap_or_default();
+        let latency = presented.map(|p| p - frame.rx);
+        let res = writeln!(
+            log.out,
+            "{},{},{},{},{},{},{:.3},{},{},{},{},{},{}",
+            self.conn,
+            status,
+            opt(presented),
+            frame.rx,
+            frame.fwd,
+            opt_ms(latency),
+            ms(frame.fwd - frame.rx),
+            refresh.map(|r| r.to_string()).unwrap_or_default(),
+            flags.map(|f| format!("{f:#x}")).unwrap_or_default(),
+            frame.inputs.len(),
+            opt_ms(input_oldest),
+            opt_ms(input_newest),
+            opt(frame.ready),
+        );
+        if let Err(err) = res {
+            warn!("stats: writing the CSV log failed: {err}");
+        }
+        log.dirty = true;
+    }
+
+    /// The numbers of the current window.
+    pub(super) fn summary(&mut self, now: i64) -> Summary {
+        let since = now - self.cfg.window_ns;
+        prune(&mut self.commits, since);
+        prune(&mut self.presented, since);
+        prune(&mut self.dropped, since);
+        prune_pairs(&mut self.frame_lat, since);
+        prune_pairs(&mut self.input_lat, since);
+        prune_pairs(&mut self.hold, since);
+        Summary {
+            presented: self.presented.len(),
+            commits: self.commits.len(),
+            dropped: self.dropped.len(),
+            feedback_seen: self.feedback_seen,
+            frame: percentiles(&mut values(&self.frame_lat)),
+            input: percentiles(&mut values(&self.input_lat)),
+            hold: percentiles(&mut values(&self.hold)),
+            window_ns: self.cfg.window_ns,
+        }
+    }
+
+    /// Frames per second of the last burst in `times` (consecutive frames
+    /// each within 2.5 refresh periods of the previous, at least 8), if it
+    /// went on until less than half a second before `now`: an animation's
+    /// rate, which the second's average dilutes with the pauses around it.
+    fn burst_rate(&self, times: &VecDeque<i64>, now: i64) -> Option<f64> {
+        let period = if self.refresh_ns > 0 { self.refresh_ns as i64 } else { 16_666_667 };
+        let last = *times.back()?;
+        // presentation times (translated) and commit times are both the guest's CLOCK_MONOTONIC
+        if now - last > 500_000_000 {
+            return None;
+        }
+        let mut first = last;
+        let mut frames = 1;
+        for (a, b) in times.iter().rev().skip(1).zip(times.iter().rev()) {
+            if b - a > period * 5 / 2 {
+                break;
+            }
+            first = *a;
+            frames += 1;
+        }
+        (frames >= 8 && last > first).then(|| (frames - 1) as f64 * 1e9 / (last - first) as f64)
+    }
+
+    /// The overlay's JSON (see overlay.rs) for the current window.
+    pub(super) fn overlay_json(&mut self, now: i64) -> String {
+        let sum = self.summary(now);
+        let pair = |v: Option<(i64, i64)>| {
+            v.map(|(a, b)| format!("[{:.2},{:.2}]", ms(a), ms(b)))
+                .unwrap_or_else(|| "null".to_owned())
+        };
+        let intervals = |q: &VecDeque<i64>| {
+            let v: Vec<String> = q
+                .iter()
+                .zip(q.iter().skip(1))
+                .map(|(a, b)| format!("{:.2}", ms(b - a)))
+                .collect();
+            v.join(",")
+        };
+        let burst = |r: Option<f64>| r.map(|r| format!("{r:.1}")).unwrap_or_else(|| "null".to_owned());
+        format!(
+            "{{\"fps\":{:.1},\"ups\":{:.1},\"burst_fps\":{},\"burst_ups\":{},\"dropped\":{:.0},\"refresh_hz\":{:.2},\"frame\":{},\"input\":{},\"hold\":{},\"present_ms\":[{}],\"commit_ms\":[{}]}}\n",
+            sum.per_second(sum.presented),
+            sum.per_second(sum.commits),
+            burst(self.burst_rate(&self.present_times, now)),
+            burst(self.burst_rate(&self.commit_times, now)),
+            sum.per_second(sum.dropped),
+            if self.refresh_ns > 0 { 1e9 / self.refresh_ns as f64 } else { 0.0 },
+            pair(sum.frame),
+            pair(sum.input),
+            pair(sum.hold),
+            intervals(&self.present_times),
+            intervals(&self.commit_times),
+        )
+    }
+
+    /// Periodic: flushes the CSV log, writes the journal summary, and returns
+    /// the title text when it changed.
+    pub(super) fn tick(&mut self, now: i64) -> Option<String> {
+        if let Some(log) = &self.cfg.log {
+            log.borrow_mut().flush();
+        }
+        self.journal(now);
+        if self.cfg.mode == StatsMode::Off {
+            return None;
+        }
+        let text = self.summary(now).text(self.cfg.mode);
+        if self.last_text.as_deref() == Some(text.as_str()) {
+            return None;
+        }
+        self.last_text = Some(text.clone());
+        Some(text)
+    }
+
+    fn journal(&mut self, now: i64) {
+        if self.journal_interval_ns == 0 {
+            return;
+        }
+        let since = *self.journal_since.get_or_insert(now);
+        if now - since < self.journal_interval_ns || (self.j_commits == 0 && self.j_presented == 0) {
+            if self.j_commits == 0 && self.j_presented == 0 {
+                self.journal_since = Some(now);
+            }
+            return;
+        }
+        let secs = (now - since) as f64 / 1e9;
+        let fmt = |v: &mut Vec<i64>| {
+            percentiles(v)
+                .map(|(a, b)| format!("{:.2}/{:.2} ms", ms(a), ms(b)))
+                .unwrap_or_else(|| "-".to_owned())
+        };
+        info!(
+            "stats: {:.0} s: {:.1} fps presented, {:.1} commits/s, {} dropped; median/p99 frame latency {}, input latency {} ({} inputs), proxy hold {}",
+            secs,
+            self.j_presented as f64 / secs,
+            self.j_commits as f64 / secs,
+            self.j_dropped,
+            fmt(&mut self.j_frame),
+            fmt(&mut self.j_input),
+            self.j_input.len(),
+            fmt(&mut self.j_hold),
+        );
+        self.journal_since = Some(now);
+        self.j_presented = 0;
+        self.j_commits = 0;
+        self.j_dropped = 0;
+        self.j_frame.clear();
+        self.j_input.clear();
+        self.j_hold.clear();
+    }
+}
+
+impl Drop for Stats {
+    fn drop(&mut self) {
+        if let Some(log) = &self.cfg.log {
+            log.borrow_mut().flush();
+        }
+    }
+}
