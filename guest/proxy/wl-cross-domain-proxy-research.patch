+    // drm_fourcc.h: AMD_FMT_MOD | TILE_VERSION(GFX11 = 4) | TILE(64K_R_X = 27) | DCC ...
+    const AMD: u64 = 0x02 << 56;
+    const GFX11_64K_R_X: u64 = AMD | 4 | (27 << 8);
+
+    #[test]
+    fn amd_dcc_only() {
+        assert!(!is_amd_dcc(0)); // LINEAR
+        assert!(!is_amd_dcc(0x00ff_ffff_ffff_ffff)); // INVALID
+        assert!(!is_amd_dcc(GFX11_64K_R_X));
+        assert!(is_amd_dcc(GFX11_64K_R_X | 1 << 13));
+        assert!(is_amd_dcc(GFX11_64K_R_X | 1 << 13 | 1 << 17 | 2 << 18)); // independent 128B, max 128B
+        // Intel (vendor 0x01) with bit 13 set: not AMD
+        assert!(!is_amd_dcc((0x01 << 56) | 1 << 13));
+    }
+
+    #[test]
+    fn displayable_dcc_is_retile() {
+        // the host KWin's own screen buffers on a 780M: GFX11 64K_R_X DCC RETILE (0x0200000010467b04)
+        assert!(is_amd_displayable_dcc(0x0200_0000_1046_7b04));
+        // its advertised displayable variant (independent 64B+128B, max 64B, RETILE)
+        assert!(is_amd_displayable_dcc(0x0200_0000_1043_7b04));
+        // render-only DCC (no RETILE) and no DCC at all
+        assert!(!is_amd_displayable_dcc(GFX11_64K_R_X | 1 << 13 | 1 << 17));
+        assert!(!is_amd_displayable_dcc(GFX11_64K_R_X | 1 << 14)); // RETILE bit without DCC
+        assert!(!is_amd_displayable_dcc(0x0200_0000_1040_1b04));
+    }
+}
diff -ruN a/src/source/local.rs b/src/source/local.rs
--- a/src/source/local.rs
+++ b/src/source/local.rs
@@ -0,0 +1,278 @@
+//! Local test transport: forwards a client to a Wayland socket on the same
+//! machine instead of a virtio-gpu cross-domain context.
+//!
+//! File descriptors pass through unchanged, so this needs no VM. It runs the
+//! same message parsing, global filtering and presentation clock translation
+//! as the virtio-gpu path, which makes the clock handling testable (with an
+//! injected offset) against a normal desktop.
+
+use std::{
+    io,
+    os::{fd::OwnedFd, unix::net::UnixStream},
+    path::{Path, PathBuf},
+};
+
+use anyhow::Context;
+use calloop::{EventSource, Interest, Mode, Poll, PostAction, Readiness, Token, TokenFactory, generic::Generic};
+use log::{debug, warn};
+
+use crate::{
+    clock::SharedClock,
+    session::{Session, SessionConfig, request_to_host},
+    wl_proto::{BufferedSocket, ClientConnection, MessageParseError, Socket},
+};
+
+/// Globals the virtio-gpu transport hides; the local transport hides them too,
+/// so that local tests see what a guest sees.
+pub const VIRTIO_FILTERED_GLOBALS: [&str; 3] = [
+    "wl_drm",
+    "wp_linux_drm_syncobj_manager_v1",
+    "wp_drm_lease_device_v1",
+];
+
+/// Resolves a Wayland display name or path like libwayland does.
+pub fn resolve_display(display: &str) -> anyhow::Result<PathBuf> {
+    if display.contains('/') {
+        Ok(PathBuf::from(display))
+    } else {
+        let dir = std::env::var_os("XDG_RUNTIME_DIR")
+            .context("XDG_RUNTIME_DIR is not set, give --host-display as a path")?;
+        Ok(Path::new(&dir).join(display))
+    }
+}
+
+pub struct LocalChannel {
+    local: ClientConnection,
+    host: Generic<BufferedSocket, io::Error>,
+    clock: SharedClock,
+    session: Session,
+    fence_source: Generic<OwnedFd, anyhow::Error>,
+}
+
+fn nonfatal_flush(res: io::Result<()>) -> io::Result<()> {
+    match res {
+        Err(e) if e.kind() == io::ErrorKind::WouldBlock => {
+            debug!("flush would block, keeping data buffered");
+            Ok(())
+        }
+        other => other,
+    }
+}
+
+impl LocalChannel {
+    pub fn new(
+        client: UnixStream,
+        host_display: &Path,
+        mut filters: Vec<String>,
+        clock: SharedClock,
+        session_cfg: &SessionConfig,
+    ) -> anyhow::Result<Self> {
+        let host = UnixStream::connect(host_display).with_context(|| {
+            format!("Failed to connect to host display {}", host_display.display())
+        })?;
+        host.set_nonblocking(true)
+            .context("Failed to set host stream non-blocking")?;
+        filters.extend(VIRTIO_FILTERED_GLOBALS.iter().map(|s| s.to_string()));
+        let mut host = BufferedSocket::new(Socket::from(host));
+        // the proxy's own objects come first on the host connection
+        let mut session =
+            Session::new(session_cfg, clock.clone()).context("Failed to set up the session")?;
+        for msg in session.startup() {
+            host.write_message(&msg)
+                .context("Failed to queue the proxy's startup requests")?;
+        }
+        nonfatal_flush(host.flush()).context("Failed to send the proxy's startup requests")?;
+        let fence_source = Generic::new_with_error(
+            session.fd().try_clone_to_owned()?,
+            Interest::READ,
+            Mode::Level,
+        );
+        Ok(LocalChannel {
+            local: ClientConnection::new(client, filters),
+            host: Generic::new(host, Interest::READ, Mode::Level),
+            clock,
+            session,
+            fence_source,
+        })
+    }
+}
+
+impl EventSource for LocalChannel {
+    type Event = ();
+    type Metadata = ();
+    type Ret = ();
+    type Error = anyhow::Error;
+
+    fn process_events<F>(
+        &mut self,
+        readiness: Readiness,
+        token: Token,
+        _callback: F,
+    ) -> Result<PostAction, anyhow::Error>
+    where
+        F: FnMut(Self::Event, &mut Self::Metadata) -> Self::Ret,
+    {
+        let LocalChannel {
+            local,
+            host,
+            clock,
+            session,
+            fence_source,
+        } = self;
+
+        // client -> fence gate, in order
+        let res = local.process_events(readiness, token, |msg, obj| {
+            session.push_request(msg, obj.clone());
+            Ok(PostAction::Continue)
+        })?;
+        if res == PostAction::Remove {
+            return Ok(PostAction::Remove);
+        }
+        fence_source.process_events(readiness, token, |_, _| Ok(PostAction::Continue))?;
+        let mut own_requests = Vec::new();
+        let mut guest_events = Vec::new();
+        session.dispatch(&mut own_requests, &mut guest_events);
+        // SAFETY: the socket is not replaced
+        for own in &own_requests {
+            unsafe { host.get_mut() }
+                .write_message(own)
+                .context("Failed to send a request of the proxy to the host")?;
+        }
+
+        // fence gate -> host compositor
+        while let Some((mut msg, obj, received)) = session.pop_request() {
+            let mut pre = Vec::new();
+            let mut post = Vec::new();
+            let forward = session.before_request(&mut msg, &obj, received, &mut pre, &mut post);
+            // SAFETY: the socket is not replaced
+            let sock = unsafe { host.get_mut() };
+            for own in &pre {
+                sock.write_message(own)
+                    .context("Failed to send a request of the proxy to the host")?;
+            }
+            if !forward {
+                for own in &post {
+                    sock.write_message(own)
+                        .context("Failed to send a request of the proxy to the host")?;
+                }
+                continue;
+            }
+            let request = obj.interface.requests[msg.opcode as usize].name;
+            clock
+                .borrow_mut()
+                .filter_request(obj.interface.name, request, &mut msg);
+            request_to_host(&mut msg);
+            sock.write_message(&msg)
+                .context("Failed to forward request to the host")?;
+            for own in &post {
+                sock.write_message(own)
+                    .context("Failed to send a request of the proxy to the host")?;
+            }
+        }
+        // SAFETY: the socket is not replaced
+        if let Err(e) = nonfatal_flush(unsafe { host.get_mut() }.flush()) {
+            warn!("Host connection failed: {e}");
+            return Ok(PostAction::Remove);
+        }
+
+        // events of the proxy for the client (a resize that settled)
+        if !guest_events.is_empty() {
+            for mut msg in guest_events {
+                let Some(obj) = local.map.find(msg.sender_id) else {
+                    continue;
+                };
+                let event = obj.interface.events[msg.opcode as usize].name;
+                clock
+                    .borrow_mut()
+                    .filter_event(obj.interface.name, event, &mut msg);
+                session.event_to_guest(&msg, &obj);
+                local.write_message(&msg)?;
+            }
+            nonfatal_flush(local.flush())?;
+        }
+
+        // host compositor -> client
+        let res = host.process_events(readiness, token, |_, sock| {
+            // SAFETY: the socket is not replaced
+            let sock = unsafe { sock.get_mut() };
+            let mut own = Vec::new();
+            loop {
+                let parsed = sock.read_one_message(|id, opcode| {
+                    session
+                        .interface_of(id, &local.map)
+                        .and_then(|i| i.events.get(opcode as usize))
+                        .map(|desc| desc.signature)
+                });
+                match parsed {
+                    Ok(msg) => {
+                        let interface = session
+                            .interface_of(msg.sender_id, &local.map)
+                            .expect("object resolved during parsing");
+                        let mut before = Vec::new();
+                        let msg = session.host_event(msg, interface, &mut before, &mut own);
+                        for mut msg in before.into_iter().chain(msg) {
+                            let Some(obj) = local.map.find(msg.sender_id) else {
+                                warn!("host event for unknown guest object {}", msg.sender_id);
+                                continue;
+                            };
+                            let event = obj.interface.events[msg.opcode as usize].name;
+                            clock
+                                .borrow_mut()
+                                .filter_event(obj.interface.name, event, &mut msg);
+                            session.event_to_guest(&msg, &obj);
+                            local.write_message(&msg)?;
+                        }
+                    }
+                    Err(MessageParseError::MissingData) | Err(MessageParseError::MissingFD) => {
+                        match sock.fill_incoming_buffers() {
+                            Ok(()) => continue,
+                            Err(e) if e.kind() == io::ErrorKind::WouldBlock => break,
+                            Err(e) => return Err(e),
+                        }
+                    }
+                    Err(MessageParseError::Malformed) => match sock.skip_one_message() {
+                        Some((id, opcode)) => {
+                            warn!("Skipping host event for unknown object {id} (opcode {opcode})");
+                        }
+                        None => return Err(rustix::io::Errno::PROTO.into()),
+                    },
+                }
+            }
+            for request in &own {
+                sock.write_message(request)?;
+            }
+            nonfatal_flush(sock.flush())?;
+            nonfatal_flush(local.flush())?;
+            Ok(PostAction::Continue)
+        });
+        match res {
+            Ok(action) => Ok(action),
+            Err(e) => {
+                warn!("Host connection ended: {e}");
+                Ok(PostAction::Remove)
+            }
+        }
+    }
+
+    fn register(&mut self, poll: &mut Poll, token_factory: &mut TokenFactory) -> calloop::Result<()> {
+        self.local.register(poll, token_factory)?;
+        self.fence_source.register(poll, token_factory)?;
+        self.host.register(poll, token_factory)
+    }
+
+    fn reregister(
+        &mut self,
+        poll: &mut Poll,
+        token_factory: &mut TokenFactory,
+    ) -> calloop::Result<()> {
+        self.local.reregister(poll, token_factory)?;
+        self.fence_source.reregister(poll, token_factory)?;
+        self.host.reregister(poll, token_factory)
+    }
+
+    fn unregister(&mut self, poll: &mut Poll) -> calloop::Result<()> {
+        self.local.unregister(poll)?;
+        self.fence_source.unregister(poll)?;
+        self.host.unregister(poll)
+    }
+}
