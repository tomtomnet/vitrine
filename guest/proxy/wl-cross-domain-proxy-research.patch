+impl BufferedSocket {
+    /// Drops the first complete message of the incoming buffer, for messages
+    /// whose signature is unknown (for example events of an unknown object).
+    ///
+    /// Returns its object id and opcode, or `None` if no complete message is
+    /// buffered.
+    pub fn skip_one_message(&mut self) -> Option<(u32, u16)> {
+        let data = self.in_data.get_contents();
+        if data.len() < 2 * 4 {
+            return None;
+        }
+        let object_id = u32::from_ne_bytes([data[0], data[1], data[2], data[3]]);
+        let word_2 = u32::from_ne_bytes([data[4], data[5], data[6], data[7]]);
+        let opcode = (word_2 & 0x0000_FFFF) as u16;
+        let len = (word_2 >> 16) as usize;
+        if len < 2 * 4 || len > data.len() {
+            return None;
+        }
+        self.in_data.offset(len);
+        Some((object_id, opcode))
+    }
