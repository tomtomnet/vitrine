+/// --drop-dcc-modifiers (set once at startup): the dma-buf feedback the proxy's clients get
+/// carries no AMD DCC modifiers (see the help text and `wayland::filter_host_message`).
+pub static DROP_DCC_MODIFIERS: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+/// --keep-displayable-dcc (set once at startup, with --drop-dcc-modifiers): the AMD DCC modifiers the display
+/// can read (DCC_RETILE: radeonsi keeps a displayable copy of the metadata) stay offered; only the
+/// render-only DCC layouts are left out.
+pub static KEEP_DISPLAYABLE_DCC: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+/// On unless --no-batch-sends (set once at startup): the messages one pass of the event loop forwards to the
+/// host go out together, in as few CROSS_DOMAIN_CMD_SENDs as they fit in (4096 bytes, 28
+/// identifiers), instead of one SEND each. Every SEND is an execbuffer and a notification of
+/// virtio-gpu's control queue, and a nested compositor's frame is ~20 messages (2026-10-07: 6 us
+/// each in the guest, 13 under QEMU without ioeventfd; the proxy's hold from a commit to the host
+/// 0.2-0.36 ms). The host writes a SEND's bytes and descriptors to its Wayland socket in one
+/// sendmsg, as libwayland flushes a client's buffered messages.
+pub static BATCH_SENDS: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(true);
+
+/// Sends one Wayland message to the host over the cross-domain channel.
+fn send_to_host(drm: &DrmDevice, msg: &Message<u32, Identifier>) -> anyhow::Result<()> {
+    let mut buffer = [0; MAX_BYTES_OUT];
+    let mut identifiers = Vec::with_capacity(MAX_FDS_OUT);
+    let len = write_to_buffers(msg, &mut buffer, &mut identifiers)
+        .context("Failed to write out message")?;
+    send_data(drm, &buffer[..len], &identifiers)
+}
+
+/// One CROSS_DOMAIN_CMD_SEND of serialized Wayland messages and the identifiers of their file
+/// descriptors, in order; then closes the identifiers' buffer handles, each once (a dma-buf two
+/// messages of one SEND carry is imported once: one handle).
+fn send_data(drm: &DrmDevice, data: &[u8], identifiers: &[Identifier]) -> anyhow::Result<()> {
+    let mut buffer = [0; MAX_BYTES_OUT + mem::size_of::<CrossDomainSendReceive>()];
+    let total_size = mem::size_of::<CrossDomainSendReceive>() + data.len();
+    buffer[mem::size_of::<CrossDomainSendReceive>()..total_size].copy_from_slice(data);
+
+    let mut cmd = CrossDomainSendReceive {
+        hdr: CrossDomainHeader {
+            cmd: CROSS_DOMAIN_CMD_SEND,
+            ring_idx: CROSS_DOMAIN_RING_NONE as u8,
+            cmd_size: total_size as u16,
+            pad: 0,
+        },
+        opaque_data_size: data.len() as u32,
+        num_identifiers: identifiers.len() as u32,
+        identifiers: [0; CROSS_DOMAIN_MAX_IDENTIFIERS],
+        identifier_sizes: [0; CROSS_DOMAIN_MAX_IDENTIFIERS],
+        identifier_types: [0; CROSS_DOMAIN_MAX_IDENTIFIERS],
+    };
+
+    let mut bos = SmallVec::<[BufferHandle; CROSS_DOMAIN_MAX_IDENTIFIERS]>::new();
+    for (i, ident) in identifiers.iter().enumerate() {
+        cmd.identifier_types[i] = ident.type_;
+        cmd.identifier_sizes[i] = ident.size as u32;
+        cmd.identifiers[i] = ident.identifier.into();
+        if let Some(bo) = ident.bo {
+            if !bos.contains(&bo) {
+                bos.push(bo);
+            }
+        }
+    }
+
+    cmd.write_to(&mut buffer[0..mem::size_of::<CrossDomainSendReceive>()])
+        .unwrap();
+    drm.execbuffer(&buffer[0..total_size], None)
+        .context("send-receive execbuffer failed")?;
+    for bo in bos {
+        drm.close_buffer(bo)
+            .context("Failed to close buffer handle")?;
+    }
+    Ok(())
+}
+
+/// The messages one pass of the event loop sends to the host, in order: queued and sent
+/// together ([`BATCH_SENDS`]), or one by one with --no-batch-sends.
+struct SendBatch {
+    data: Vec<u8>,
+    identifiers: Vec<Identifier>,
+}
+
+impl SendBatch {
+    fn new() -> Self {
+        SendBatch {
+            data: Vec::new(),
+            identifiers: Vec::new(),
+        }
+    }
+
+    /// A guest message (host ids by now): queued, after sending what is queued if it would not
+    /// fit, or sent at once with --no-batch-sends.
+    fn push(&mut self, drm: &DrmDevice, msg: &Message<u32, Identifier>) -> anyhow::Result<()> {
+        if !BATCH_SENDS.load(std::sync::atomic::Ordering::Relaxed) {
+            return send_to_host(drm, msg);
+        }
+        let mut buffer = [0; MAX_BYTES_OUT];
+        let mut identifiers = Vec::with_capacity(MAX_FDS_OUT);
+        let len = write_to_buffers(msg, &mut buffer, &mut identifiers)
+            .context("Failed to write out message")?;
+        if self.data.len() + len > MAX_BYTES_OUT
+            || self.identifiers.len() + identifiers.len() > CROSS_DOMAIN_MAX_IDENTIFIERS
+        {
+            self.flush(drm)?;
+        }
+        self.data.extend_from_slice(&buffer[..len]);
+        self.identifiers.extend(identifiers);
+        Ok(())
+    }
+
+    /// Sends what is queued.
+    fn flush(&mut self, drm: &DrmDevice) -> anyhow::Result<()> {
+        if self.data.is_empty() {
+            return Ok(());
+        }
+        let result = send_data(drm, &self.data, &self.identifiers);
+        self.data.clear();
+        self.identifiers.clear();
+        result
+    }
+}
+
+/// Sends a request of the proxy itself (host ids, no file descriptors).
+fn send_own_to_host(drm: &DrmDevice, msg: HostRequest) -> anyhow::Result<()> {
+    send_to_host(
+        drm,
+        &msg.map_fd(|_| -> Identifier { unreachable!("proxy requests carry no fds") }),
+    )
+}
+
+/// A request of the proxy itself (host ids) for the host. Its only file descriptors are the write
+/// ends of the clipboard's pipes in wl_data_offer.receive, which become READ_PIPE identifiers as in
+/// the guest's own receive requests (the host's data then arrives with CROSS_DOMAIN_CMD_READ).
+fn own_request(
+    protocol_state: &mut ProtocolState,
+    pipes_write_from_host: &mut HashMap<u32, OwnedFd>,
+    msg: HostRequest,
+) -> anyhow::Result<Message<u32, Identifier>> {
+    if msg.args.iter().any(|a| matches!(a, Argument::Fd(_))) {
+        return protocol_state
+            .own_receive(pipes_write_from_host, msg)
+            .context("Failed to set up a pipe for the proxy's own receive");
+    }
+    Ok(msg.map_fd(|_| -> Identifier { unreachable!("no fds") }))
+}
