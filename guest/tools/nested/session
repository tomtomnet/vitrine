#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-or-later
# "Plasma (nested desktop)": the whole Plasma session as one window of the
# host's desktop - in vitrine's window, or a window of its own. The session's
# KWin runs nested (its Wayland backend) on wl-cross-domain-proxy, which
# forwards the Wayland protocol to the host compositor over the virtio-gpu
# cross-domain context. Rendering stays on the GPU through DRM native context
# on the same virtio-gpu device.
#
# vitrine guest tools: the research's crosvm-desktop session
# (virtio-gpu-desktop, src/crosvm-desktop/host-package/guest/files/session),
# with the local changes listed in README.md beside it. The display manager
# offers it in place of Plasma only in nested-desktop boots: those whose
# words (QEMU's fw_cfg, from vitrine) say crosvm_desktop=1, which
# vitrine-nested-boot.service reads.
#
# Plasma starts as usual (systemd boot: plasma-workspace.target, so
# graphical-session.target is reached and D-Bus activated user services such
# as xdg-desktop-portal work; GTK 4 reads its settings through that portal).
# For this login only, a runtime drop-in in $XDG_RUNTIME_DIR/systemd/user
# makes plasma-kwin_wayland.service start KWin through the
# kwin_wayland_wrapper shim, which adds the nested-window options. The shim
# does nothing without this session's variables, and the drop-in and the
# variables are removed again at logout. Nothing else changes.
set -u
conf=/etc/vitrine-guest-tools/nested.conf
# shellcheck disable=SC1090
[ -r "$conf" ] && . "$conf"
: "${CROSVM_DESKTOP_WIDTH:=1600}" "${CROSVM_DESKTOP_HEIGHT:=900}" "${CROSVM_DESKTOP_SCALE:=auto}"
: "${CROSVM_DESKTOP_FULLSCREEN:=0}" "${CROSVM_DESKTOP_SOFTWARE:=0}" "${CROSVM_DESKTOP_PROXY_ARGS:=}"
: "${CROSVM_DESKTOP_CAPTURE_SHORTCUTS:=1}" "${CROSVM_DESKTOP_RELEASE_CHORD:=meta+shift+esc}"
# 1: the capture follows the pointer as in QEMU's SDL window (host shortcuts with the pointer on the
# title bar or elsewhere, 2026-10-12); 0: captured whenever the window has keyboard focus
: "${CROSVM_DESKTOP_FOLLOW_POINTER:=1}"
: "${CROSVM_DESKTOP_FENCE_WAIT:=1}" "${CROSVM_DESKTOP_STATS:=title}" "${CROSVM_DESKTOP_STATS_LOG:=}"
: "${CROSVM_DESKTOP_DROP_DCC:=1}" "${CROSVM_DESKTOP_OPAQUE:=1}" "${CROSVM_DESKTOP_KWIN_UNSET:=}"
: "${CROSVM_DESKTOP_NESTED_OVERLAYS:=0}" "${CROSVM_DESKTOP_CLIPBOARD:=focus}" "${CROSVM_DESKTOP_RESIZE_SETTLE_MS:=200}"
: "${CROSVM_DESKTOP_OVERLAY_CHORD:=ctrl+alt+s}" "${CROSVM_DESKTOP_HOST_GPU:=auto}"
: "${CROSVM_DESKTOP_KWIN_ENV=KWIN_RENDER_JOURNAL_VARIANCE_TIME_MS=100 KWIN_WAYLAND_DEADLINE=1 KWIN_WAYLAND_COMMIT_TIMING=1 KWIN_STEADY_ANIMATION_CLOCK=1 KWIN_ANIMATION_START_STEP=1 KWIN_LONE_FRAME_LEAD_US=2500 KWIN_ASYNC_CURSOR_MOVES=1}"
# the launcher's words for this boot: the kernel command line and QEMU's fw_cfg, merged at boot by
# vitrine-nested-boot.service (a GRUB boot has them only in fw_cfg); /proc/cmdline before that unit
launcher_words=/run/vitrine-nested/cmdline
[ -r "$launcher_words" ] || launcher_words=/proc/cmdline
# The nested KWin makes a udmabuf of every wl_shm client buffer and tries to import it for the GPU.
# The host takes those only with QEMU's x-guest-dmabuf, which its launcher announces with
# crosvm_desktop_guest_dmabuf=1 on the kernel command line; otherwise every attempt fails after
# host round trips and KWin copies anyway - skip it (2026-10-08, the launcher under three resizing
# Konsoles: refreshes with a new image, close 74 -> 77.5 %, open 74 -> 75.5 %; ab/udmabuf_import_ab.sh).
# A KWIN_DISABLE_UDMABUF_IMPORT of your own in CROSVM_DESKTOP_KWIN_ENV wins.
case " $CROSVM_DESKTOP_KWIN_ENV " in
*" KWIN_DISABLE_UDMABUF_IMPORT="*) ;;
*) grep -qw crosvm_desktop_guest_dmabuf=1 "$launcher_words" ||
	CROSVM_DESKTOP_KWIN_ENV="${CROSVM_DESKTOP_KWIN_ENV:+$CROSVM_DESKTOP_KWIN_ENV }KWIN_DISABLE_UDMABUF_IMPORT=1" ;;
esac
export CROSVM_DESKTOP_WIDTH CROSVM_DESKTOP_HEIGHT CROSVM_DESKTOP_SCALE CROSVM_DESKTOP_FULLSCREEN CROSVM_DESKTOP_KWIN_UNSET
export CROSVM_DESKTOP_NESTED_OVERLAYS CROSVM_DESKTOP_KWIN_ENV
LIBEXEC=/usr/libexec/vitrine-guest-tools/nested
PROXY=/usr/bin/wl-cross-domain-proxy
sock=$XDG_RUNTIME_DIR/crosvm-desktop-host
dropin_dir=$XDG_RUNTIME_DIR/systemd/user/plasma-kwin_wayland.service.d
dropin=$dropin_dir/50-crosvm-desktop.conf
shell_dropin_dir=$XDG_RUNTIME_DIR/systemd/user/plasma-plasmashell.service.d
shell_dropin=$shell_dropin_dir/50-crosvm-desktop.conf
log() { echo "crosvm-desktop: $1" | systemd-cat -t crosvm-desktop -p "${2:-info}"; }

# vitrine: KWin's settings for the host's GPU. The GPU is the one the virtio-gpu native context
# reports - what the guest's Mesa renders on: vitrine-virtio-gpu-check.service asks at boot
# (/run/vitrine-guest-tools/host-gpu, its finding in that unit's journal), the helper itself where
# that file is missing; CROSVM_DESKTOP_HOST_GPU (nested.conf) can name it instead. An Intel xe host
# gets three settings (the research's on its Arc Pro B50, which it sets when it builds a guest for
# an Intel host); a value of your own in CROSVM_DESKTOP_KWIN_ENV wins:
#  - KWIN_DISABLE_UDMABUF_IMPORT=1: the clients' shared-memory buffers are not imported as
#    udmabufs of guest RAM, which reach the host's xe through x-guest-dmabuf: the VM's window
#    operations went from 22 to 6.3-7.3 repeated refreshes a second at 4K 120, from 96 to 11.5 at
#    4K 240 (2026-10-23);
#  - KWIN_WAYLAND_SCANOUT_BUFFERS=1: the output's buffers allocated for scanout, the only ones xe
#    puts on a plane (the research's KWin 0073; vitrine's 6.7.5 allocates them so already and
#    ignores the variable, which is for a KWin 6.8);
#  - KWIN_LONE_FRAME_LEAD_US=1500 in place of the 2500 tuned on AMD hosts: keys 11.4 -> 10.1-10.6 ms
#    on the B50, the launcher no worse (2026-10-23).
kwin_env_value() {   # the value VAR has in CROSVM_DESKTOP_KWIN_ENV; status 1 if it has none
    local kv
    for kv in $CROSVM_DESKTOP_KWIN_ENV; do
        case $kv in "$1="*) printf '%s' "${kv#*=}"; return 0 ;; esac
    done
    return 1
}
kwin_env_put() {     # VAR=VALUE into CROSVM_DESKTOP_KWIN_ENV, in place of VAR's value if it has one
    local kv out=
    for kv in $CROSVM_DESKTOP_KWIN_ENV; do
        case $kv in "${1%%=*}="*) ;; *) out="${out:+$out }$kv" ;; esac
    done
    CROSVM_DESKTOP_KWIN_ENV="${out:+$out }$1"
}
host_gpu_file=/run/vitrine-guest-tools/host-gpu
if [ "$CROSVM_DESKTOP_HOST_GPU" != auto ]; then
    host_gpu=$CROSVM_DESKTOP_HOST_GPU host_gpu_from="CROSVM_DESKTOP_HOST_GPU"
elif [ -r "$host_gpu_file" ]; then
    host_gpu=$(sed -n 's/^NATIVE_CONTEXT=//p' "$host_gpu_file") host_gpu_from="the native context, at boot"
else
    host_gpu=$(/usr/libexec/vitrine-guest-tools/host-gpu 2>/dev/null | sed -n 's/^NATIVE_CONTEXT=//p')
    host_gpu_from="the native context, asked now ($host_gpu_file missing)"
fi
if [ "$host_gpu" = xe ]; then
    xe_own=
    for kv in KWIN_DISABLE_UDMABUF_IMPORT=1 KWIN_WAYLAND_SCANOUT_BUFFERS=1 KWIN_LONE_FRAME_LEAD_US=1500; do
        # a value of your own stays; the lead's 2500 is the default, for AMD hosts
        if have=$(kwin_env_value "${kv%%=*}") &&
            ! { [ "${kv%%=*}" = KWIN_LONE_FRAME_LEAD_US ] && [ "$have" = 2500 ]; }; then
            [ "$have" = "${kv#*=}" ] || xe_own="${xe_own:+$xe_own }${kv%%=*}=$have"
            continue
        fi
        kwin_env_put "$kv"
    done
    log "host GPU: Intel xe (from $host_gpu_from): this session's KWin gets KWIN_DISABLE_UDMABUF_IMPORT=$(kwin_env_value KWIN_DISABLE_UDMABUF_IMPORT) KWIN_WAYLAND_SCANOUT_BUFFERS=$(kwin_env_value KWIN_WAYLAND_SCANOUT_BUFFERS) KWIN_LONE_FRAME_LEAD_US=$(kwin_env_value KWIN_LONE_FRAME_LEAD_US)${xe_own:+ (your own: $xe_own)}"
else
    log "host GPU: ${host_gpu:-unknown} (from $host_gpu_from): none of the Intel xe settings"
fi

rm -f "$sock" "$sock.lock"
proxy_args=(--socket-path "$sock" --clock-log-interval 60)
if [ "$CROSVM_DESKTOP_CAPTURE_SHORTCUTS" = 1 ]; then
    proxy_args+=(--inhibit-shortcuts --shortcuts-release "$CROSVM_DESKTOP_RELEASE_CHORD")
    [ "$CROSVM_DESKTOP_FOLLOW_POINTER" = 1 ] || proxy_args+=(--no-follow-pointer)
fi
[ "$CROSVM_DESKTOP_FENCE_WAIT" = 1 ] || proxy_args+=(--no-fence-wait)
# AMD: nested KWin's output buffers without DCC, so the host can show them directly
[ "$CROSVM_DESKTOP_DROP_DCC" = 1 ] && proxy_args+=(--drop-dcc-modifiers)
# 2: only the DCC layouts the display cannot read; the displayable ones (DCC_RETILE) stay (2026-10-13)
[ "$CROSVM_DESKTOP_DROP_DCC" = 2 ] && proxy_args+=(--drop-dcc-modifiers --keep-displayable-dcc)
# the desktop's window opaque for the host, so it goes straight to the screen from its
# first frame (KWin renders it ARGB without saying it is opaque)
[ "$CROSVM_DESKTOP_OPAQUE" = 1 ] && proxy_args+=(--opaque-toplevels)
# the clipboard between the host and this desktop, following the window's focus like VM tools
# (KWin, started below, takes wayland-0: the proxy's own socket has another name)
case $CROSVM_DESKTOP_CLIPBOARD in
    focus | text) proxy_args+=(--clipboard "$CROSVM_DESKTOP_CLIPBOARD" --clipboard-guest-display wayland-0) ;;
    off | "") ;;
    *)
        log "CROSVM_DESKTOP_CLIPBOARD=$CROSVM_DESKTOP_CLIPBOARD is not focus, text or off: using focus" warning
        proxy_args+=(--clipboard focus --clipboard-guest-display wayland-0)
        ;;
esac
# the launcher's name for this VM before the window title (crosvm_desktop_label= on the kernel
# command line: [QEMU] / [crosvm]), to tell two VMs apart on the host
label=$(sed -n 's/.*crosvm_desktop_label=\([^ ]*\).*/\1/p' "$launcher_words")
[ -n "$label" ] && proxy_args+=(--title-label "$label")
# a new window size reaches this desktop once the window has kept it for a moment (the proxy
# shows the old frame scaled meanwhile, as QEMU's SDL window does): every size is an output
# mode change for KWin and Plasma, and several a second killed plasmashell (2026-10-08)
case $CROSVM_DESKTOP_RESIZE_SETTLE_MS in
    '' | 0) ;;
    *[!0-9]*) log "CROSVM_DESKTOP_RESIZE_SETTLE_MS=$CROSVM_DESKTOP_RESIZE_SETTLE_MS is not a number: using 200" warning
        proxy_args+=(--resize-settle-ms 200) ;;
    *) proxy_args+=(--resize-settle-ms "$CROSVM_DESKTOP_RESIZE_SETTLE_MS") ;;
esac
# live numbers in the window title (fps, latencies)
case $CROSVM_DESKTOP_STATS in
    title | detail) proxy_args+=(--stats "$CROSVM_DESKTOP_STATS") ;;
    off | "") ;;
    *)
        log "CROSVM_DESKTOP_STATS=$CROSVM_DESKTOP_STATS is not title, detail or off: using title" warning
        proxy_args+=(--stats title)
        ;;
esac
if [ -n "$CROSVM_DESKTOP_STATS_LOG" ]; then
    stats_log=$CROSVM_DESKTOP_STATS_LOG
    [ "${stats_log#/}" = "$stats_log" ] && stats_log=$HOME/$stats_log
    if [ -w "$(dirname -- "$stats_log")" ]; then
        proxy_args+=(--stats-log "$stats_log")
    else
        log "cannot write $stats_log (CROSVM_DESKTOP_STATS_LOG): no per-frame log" warning
    fi
fi
# the stats overlay: the chord shows FPS/UPS, latencies and frame graphs inside the desktop (a
# layer-shell QML window the proxy starts and stops; it reads the proxy's JSON file)
case $CROSVM_DESKTOP_OVERLAY_CHORD in
    none | off | "") ;;
    *)
        if [ -r "$LIBEXEC/stats-overlay.qml" ] && [ -x /usr/lib64/qt6/bin/qml ]; then
            proxy_args+=(--overlay-chord "$CROSVM_DESKTOP_OVERLAY_CHORD" --overlay-command
                "WAYLAND_DISPLAY=wayland-0 QT_QPA_PLATFORM=wayland QML_XHR_ALLOW_FILE_READ=1 exec /usr/lib64/qt6/bin/qml $LIBEXEC/stats-overlay.qml -- \"\$CROSVM_DESKTOP_STATS_FILE\"")
        else
            log "no $LIBEXEC/stats-overlay.qml or /usr/lib64/qt6/bin/qml: no stats overlay" warning
        fi
        ;;
esac
# The proxy logs to the user journal: journalctl --user -t crosvm-desktop-proxy
# shellcheck disable=SC2086
systemd-cat -t crosvm-desktop-proxy "$PROXY" "${proxy_args[@]}" $CROSVM_DESKTOP_PROXY_ARGS &
proxy=$!
for _ in $(seq 100); do [ -S "$sock" ] && break; sleep 0.05; done
if [ ! -S "$sock" ]; then
    echo "crosvm-desktop: wl-cross-domain-proxy did not start (no cross-domain context on this" \
         "virtio-gpu?). Starting the normal Plasma session instead." | systemd-cat -t crosvm-desktop -p err
    exec /usr/bin/startplasma-wayland
fi

# The window's first size and scale, from the host's screens (wayland-info through the proxy). The
# nested KWin starts at CROSVM_DESKTOP_SCALE and takes the host's scale only with a configure that
# changes the window's size (the proxy turns the others into "your choice"): "auto" starts it at the
# host's scale, so that its frames are not drawn at another density and scaled by the host (the
# laptop at 1.3, 2026-10-13: 3200x1800 frames shown at 2080x1170 until a resize). The window
# shrinks, its shape kept, to fit 90 % of the host's smallest screen (1600x900 is wider than the
# laptop's 1477x923). Several screens: the largest scale among them.
host_info=$(WAYLAND_DISPLAY=$sock timeout 5 wayland-info 2>/dev/null)
host_rc=$?
host_screens() {   # one line per host screen: logical_w logical_h physical_w physical_h
    printf '%s\n' "$host_info" | awk '
        /^interface: / { sect = $2; gsub(/[^a-z0-9_]/, "", sect); if (sect == "wl_output") out = $NF }
        sect == "zxdg_output_manager_v1" && $1 == "output:" { xo = $2 }
        sect == "zxdg_output_manager_v1" && $1 == "logical_width:" { sub(/,/, "", $2); lw[xo] = $2; lh[xo] = $4 }
        sect == "wl_output" && $1 == "width:" && $3 == "px," { pw[out] = $2; ph[out] = $5 }
        END { for (o in lw) if ((o in pw) && lw[o] > 0 && lh[o] > 0) print lw[o], lh[o], pw[o], ph[o] }'
}
screens=$(host_screens)
# vitrine: no answer from the host at all, wayland-info's 5 s out (timeout's 124) or not one global
# listed (the host hung up at once). In vitrine's window (its D-Bus display), vitrine is not running:
# QEMU's cross-domain found no socket to connect to. With rutabaga_gfx before the research's 8ecffaf
# the proxy never heard of it and KWin waited for its host forever, the session stuck without a
# window; since, the guest's channel hangs up, and KWin, failing to connect, was restarted ten times
# before the session ended, its clients crashing. End it at once instead: the guest waits at its
# login screen, where the user logs in once vitrine shows it. Status 0: the display manager shows
# its login screen after a session that ended (after one that failed, it takes it for a failed
# login and shows nothing).
if [ "$host_rc" = 124 ] || ! printf '%s\n' "$host_info" | grep -q '^interface: '; then
    log "no answer from the host's display (vitrine not running?): ending the session" err
    kill "$proxy" 2>/dev/null
    exit 0
fi
if [ -n "$screens" ]; then
    read -r CROSVM_DESKTOP_WIDTH CROSVM_DESKTOP_HEIGHT host_scale < <(printf '%s\n' "$screens" |
        awk -v w="$CROSVM_DESKTOP_WIDTH" -v h="$CROSVM_DESKTOP_HEIGHT" '
            { lmax = ($1 > $2 ? $1 : $2); pmax = ($3 > $4 ? $3 : $4); s = int(pmax / lmax * 120 + 0.5) / 120
              if (s > scale) scale = s
              if (minw == "" || $1 * $2 < minw * minh) { minw = $1; minh = $2 } }
            END { f = 1
                  if (w > 0.9 * minw) f = 0.9 * minw / w
                  if (h * f > 0.9 * minh) f = 0.9 * minh / h
                  printf "%d %d %s\n", int(w * f / 2) * 2, int(h * f / 2) * 2, scale }')
    [ "$CROSVM_DESKTOP_SCALE" = auto ] && CROSVM_DESKTOP_SCALE=$host_scale
    log "host screens (logical, physical): $(printf '%s\n' "$screens" | tr '\n' ';') window ${CROSVM_DESKTOP_WIDTH}x$CROSVM_DESKTOP_HEIGHT, scale $CROSVM_DESKTOP_SCALE"
elif [ "$CROSVM_DESKTOP_SCALE" = auto ]; then
    CROSVM_DESKTOP_SCALE=2
    log "no host screens from wayland-info: window ${CROSVM_DESKTOP_WIDTH}x$CROSVM_DESKTOP_HEIGHT, scale 2" warning
fi

export CROSVM_DESKTOP_SESSION=1 CROSVM_DESKTOP_HOST_DISPLAY=$sock
vars=(CROSVM_DESKTOP_SESSION CROSVM_DESKTOP_HOST_DISPLAY CROSVM_DESKTOP_WIDTH
      CROSVM_DESKTOP_HEIGHT CROSVM_DESKTOP_SCALE CROSVM_DESKTOP_FULLSCREEN CROSVM_DESKTOP_KWIN_UNSET
      CROSVM_DESKTOP_NESTED_OVERLAYS CROSVM_DESKTOP_KWIN_ENV)
# Fallback if the host cannot use the guest's GPU buffers: CPU compositing,
# shared-memory buffers to the host (clients still render on the GPU).
if [ "$CROSVM_DESKTOP_SOFTWARE" = 1 ]; then
    export KWIN_COMPOSE=Q
    vars+=(KWIN_COMPOSE)
fi

cleanup() {
    rm -f "$dropin" "$shell_dropin"
    rmdir "$dropin_dir" "$shell_dropin_dir" 2>/dev/null
    systemctl --user unset-environment "${vars[@]}" 2>/dev/null
    systemctl --user daemon-reload 2>/dev/null
    kill "$proxy" 2>/dev/null
}
trap cleanup EXIT
trap 'exit 143' TERM HUP INT

mkdir -p "$dropin_dir"
cat > "$dropin" <<EOF
# crosvm-desktop, this login only (removed at logout; the shim does nothing
# without the "Plasma (crosvm window)" session's variables)
[Service]
ExecStart=
ExecStart=$LIBEXEC/bin/kwin_wayland_wrapper --xwayland
EOF
# Plasma's shell can be killed by a Wayland protocol error when the window's size changes many
# times a second (Ctrl+Alt+F pressed repeatedly, 2026-10-08: "not a valid new object id ...
# mode(n)", output modes replaced faster than the shell drops the old ones); its unit gave up after
# four restarts within a second and the desktop stayed without panel or wallpaper. This login:
# wait 2 s before a restart, up to 20 times a minute.
mkdir -p "$shell_dropin_dir"
cat > "$shell_dropin" <<EOF
# crosvm-desktop, this login only (removed at logout)
[Unit]
StartLimitIntervalSec=60
StartLimitBurst=20
[Service]
RestartSec=2
EOF
systemctl --user import-environment "${vars[@]}"
systemctl --user daemon-reload
log "systemd boot, KWin through $LIBEXEC/bin/kwin_wayland_wrapper, proxy ${proxy_args[*]}, KWin settings $CROSVM_DESKTOP_KWIN_ENV"

/usr/bin/startplasma-wayland
rc=$?
exit $rc
