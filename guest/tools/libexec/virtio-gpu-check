#!/bin/sh
# vitrine guest tools: is the patched virtio-gpu driver the one running?
#
# modinfo only says what modprobe would load; the driver in use comes from
# the initramfs.  The taint field is the honest answer: O (out of tree), with
# a parameter only vitrine's patches add (another out-of-tree virtio-gpu
# taints O as well), is ours.  Then it asks what the host's GPU is (below),
# gives the guest's own sessions KWin's lone-frame lead where the guest has a
# native context, and sets the options of this boot: blob_flush_fence for the KWin installed,
# and those of a nested-desktop boot.
# Runs at boot, before the display manager; the
# journal has its findings (journalctl -b -u vitrine-virtio-gpu-check).
set -u
state=/var/lib/vitrine-guest-tools
kver=$(uname -r)
taint=$(cat /sys/module/virtio_gpu/taint 2> /dev/null || true)
rc=0

# a virtio GPU in the VM (virtio device id 16)
gpu_present() {
	grep -qsx 0x0010 /sys/bus/virtio/devices/*/device
}

secure_boot() {
	# EFI's global variable SecureBoot: 4 bytes of attributes, then its value;
	# mokutil's answer where the variable cannot be read
	var=/sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c
	if [ -r "$var" ]; then
		[ "$(od -An -t u1 -j4 -N1 "$var" | tr -d ' ')" = 1 ]
	else
		mokutil --sb-state 2> /dev/null | grep -q 'SecureBoot enabled'
	fi
}

if [ ! -d /sys/module/virtio_gpu ]; then
	gpu_present || exit 0
	if secure_boot; then
		why="Secure Boot is on, and the kernel refused the driver, which is not signed"
	else
		why="see: journalctl -b -k | grep -i virtio"
	fi
	echo "<3>no virtio-gpu driver runs, the VM has no graphics driver: $why"
	exit 1
fi

ours=no
case "$taint" in
*O*) [ -e /sys/module/virtio_gpu/parameters/blob_flush_fence ] && ours=yes ;;
esac

case "$ours$taint" in
yes*)
	echo "the patched virtio-gpu driver runs (taint $taint)"
	;;
*O*)
	echo "<4>an out-of-tree virtio-gpu driver runs (taint $taint), not the guest tools' one: install the guest tools again"
	rc=1
	;;
*)
	if secure_boot; then
		why="Secure Boot is on, and the patched driver is not signed"
	elif ! dkms status -m vitrine-virtio-gpu -k "$kver" 2> /dev/null | grep -q ': installed'; then
		if [ -e "/lib/modules/$kver/build/Makefile" ]; then
			why="it is not built for $kver (sudo dkms autoinstall -k $kver; /var/lib/dkms/vitrine-virtio-gpu/*/build/make.log)"
		else
			why="$kver has no kernel headers (sudo dnf install kernel-devel-$kver, or update the kernel and reboot)"
		fi
	else
		why="it is built for $kver but not in the initramfs (sudo dracut -f --kver $kver, then reboot)"
	fi
	echo "<4>the stock virtio-gpu driver runs: $why"
	rc=1
	;;
esac

# The host's GPU, as the virtio-gpu native context reports it (host-gpu: the
# context type the host's virglrenderer offers, xe or amdgpu...; its finding
# goes to this unit's journal), in /run/vitrine-guest-tools/host-gpu for this
# boot: the nested desktop's session reads it, and gives its KWin the settings
# of an Intel xe host on one.  The capset does not change while the VM runs.
run=/run/vitrine-guest-tools
mkdir -p "$run"
context=
if host_gpu=$(/usr/libexec/vitrine-guest-tools/host-gpu); then
	printf '%s\n' "$host_gpu" > "$run/host-gpu.new" && mv -f "$run/host-gpu.new" "$run/host-gpu"
	context=$(printf '%s\n' "$host_gpu" | sed -n 's/^NATIVE_CONTEXT=//p')
else
	rm -f "$run/host-gpu"
	echo "<4>could not ask the virtio GPU what the host's GPU is: the nested desktop's KWin gets no settings for it, the guest's own sessions no lone-frame lead"
fi

# The guest's own sessions (Plasma on the VM's screen; the nested desktop's
# KWin gets its settings from its session), where the guest reaches the
# host's GPU through a native context: KWin's lone-frame lead 1000 us,
# through a file in /run/environment.d, which each user's systemd reads as
# it starts.  This unit runs before the first one
# (Before=systemd-user-sessions.service).  Unset, the lead is off, and the
# guest's KWin held a key's frame up to ~2 ms to meet its own vblank, which
# the host does not wait for.  In QEMU's window, animations unchanged: keys
# 11.01 -> 10.29 ms mean on the research's Arc Pro B50, the guest's part
# 3.48 -> 2.44 (2026-11-07, its ef7974d: guest tools 0.1.0-38, Intel xe
# hosts only); 9.1-9.5 -> 7.4-7.6 ms p50 on its RX 6900 XT at 240 Hz
# (2026-11-12, its 5a4f677: every native context since 0.1.0-45).  None
# without one (none: virgl alone, which nothing measured).  Written at each
# boot from the native context alone: a VM moved to another host keeps no
# stale setting.  The file is whole or absent (.new, then a rename;
# environment.d reads *.conf only).  nested.md: "KWin's lone-frame lead".
lead=/run/environment.d/45-vitrine-lone-frame.conf
case $context in
"" | none)
	if [ -e "$lead" ]; then
		rm -f "$lead" && echo "no native context: $lead removed"
	fi
	;;
*)
	if mkdir -p /run/environment.d && printf '%s\n' \
		"# vitrine guest tools: written at boot by vitrine-virtio-gpu-check.service where the" \
		"# guest reaches the host's GPU through a native context: KWin's lone-frame lead for" \
		"# the guest's own sessions.  A file of yours in ~/.config/environment.d or" \
		"# /etc/environment.d whose name sorts after this one's overrides it; one of this" \
		"# same name there replaces it (empty: no lead).  More in" \
		"# /usr/share/doc/vitrine-guest-tools/nested.md." \
		KWIN_LONE_FRAME_LEAD_US=1000 > "$lead.new" && mv -f "$lead.new" "$lead"; then
		echo "the host's GPU through a native context ($context): the guest's own sessions get KWIN_LONE_FRAME_LEAD_US=1000 ($lead)"
	else
		rm -f "$lead.new"
		echo "<4>could not write $lead: the guest's own sessions get no lone-frame lead"
	fi
	;;
esac

# blob_flush_fence: 3 with the KWin the installer put in (it waits for the
# fence the driver puts on the buffers, KWIN_SWAPCHAIN_WAIT_READERS), else 1:
# with another KWin, 3 makes the host turn zero copy off.  Set here, at run
# time, as the driver reads it at each flush: the driver loads from the
# initramfs, and dracut does not copy /etc/modprobe.d there, so the
# installer's /etc/modprobe.d/vitrine-virtio-gpu.conf does not reach it.
#
# A nested-desktop boot (vitrine-nested-boot.service) runs as the research's
# nested guests do: blob_flush_fence 0, the VM's screen showing only the login
# screen; and hide_virgl 1: an app whose own Mesa lacks the GPU's native
# context (a Flatpak runtime's) renders in software instead of through virgl,
# whose buffers the nested desktop's KWin, on the native context, cannot show.
fence=/sys/module/virtio_gpu/parameters/blob_flush_fence
hide=/sys/module/virtio_gpu/parameters/hide_virgl
if [ -e /run/vitrine-nested/nested ]; then
	value=0
	if [ -w "$hide" ] && [ "$(cat "$hide")" != 1 ]; then
		echo 1 > "$hide" && echo "nested desktop: hide_virgl 1"
	fi
else
	want=$(cat "$state/kwin" 2> /dev/null || true)
	have=$(rpm -q kwin 2> /dev/null || true)
	if [ -n "$want" ] && [ "$have" = "$want" ]; then
		value=3
	else
		value=1
		[ -n "$want" ] && echo "<4>KWin is ${have:-not installed}, not the one of the guest tools ($want): blob_flush_fence 1; install the guest tools again"
	fi
fi
if [ -w "$fence" ] && [ "$(cat "$fence")" != "$value" ]; then
	echo "$value" > "$fence" && echo "blob_flush_fence $value"
fi
exit $rc
