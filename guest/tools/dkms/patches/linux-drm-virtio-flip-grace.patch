+/*
+ * The host ticks the vblank early, a lead before its own vertical blank,
+ * so that a frame flipped at the tick reaches the screen at that blank.  A
+ * flip a little after the tick still makes it, the host shows it at the
+ * same blank: complete it for the tick just gone, with its count and time,
+ * or the compositor would take the frame for a refresh late and skip the
+ * next one.
+ */
+bool virtio_gpu_flip_in_grace(struct virtio_gpu_output *output)
+{
+	unsigned long flags;
+	ktime_t last;
+	bool in;
+
+	if (!virtio_gpu_modparam_host_vblank || virtio_gpu_modparam_flip_grace_us <= 0)
+		return false;
+	spin_lock_irqsave(&output->vblank_lock, flags);
+	last = output->vblank_host_time;
+	spin_unlock_irqrestore(&output->vblank_lock, flags);
+	if (!last)
+		return false;
+	in = ktime_before(ktime_get(),
+			  ktime_add_us(last, virtio_gpu_modparam_flip_grace_us));
+	return in;
+}
