virtio-gpu: a deferred map that cannot be queued fails the mmap instead of hanging it

With DRM_VIRTGPU_BLOB_FLAG_HINT_DEFER_MAPPING a mappable blob is mapped into the
host-visible region at its first mmap. virtio_gpu_vram_map_deferred() ignored
the result of virtio_gpu_vram_map(): when the region had no room left
(drm_mm_insert_node -ENOSPC) no map command was sent, map_state stayed
STATE_INITIALIZING, and virtio_gpu_vram_mmap() waited for it forever in
uninterruptible sleep. 2026-10-24, an Arc Pro B50 guest (xe native context,
4 GiB hostmem): llama.cpp's Vulkan backend mapping a 7B model's weights in
~1 GB buffers hung in D state after the third. Return the error instead.
(One line of context: the code before virtio_gpu_vram_map_deferred differs between 7.2.8 and 7.2.9.)

--- a/drivers/gpu/drm/virtio/virtgpu_drv.h
+++ b/drivers/gpu/drm/virtio/virtgpu_drv.h
@@ -538,3 +538,3 @@
 				   enum dma_data_direction dir);
-void virtio_gpu_vram_map_deferred(struct virtio_gpu_object_vram *vram);
+int virtio_gpu_vram_map_deferred(struct virtio_gpu_object_vram *vram);
 
--- a/drivers/gpu/drm/virtio/virtgpu_vram.c
+++ b/drivers/gpu/drm/virtio/virtgpu_vram.c
@@ -46,3 +46,6 @@
 
-	virtio_gpu_vram_map_deferred(vram);
+	/* a map that could not be queued (no room left in the host-visible region) never answers */
+	ret = virtio_gpu_vram_map_deferred(vram);
+	if (ret)
+		return ret;
 
@@ -242,6 +245,8 @@
 
-void virtio_gpu_vram_map_deferred(struct virtio_gpu_object_vram *vram)
+int virtio_gpu_vram_map_deferred(struct virtio_gpu_object_vram *vram)
 {
+	int ret = 0;
+
 	if (!(vram->base.blob_flags & VIRTGPU_BLOB_FLAG_USE_MAPPABLE))
-		return;
+		return 0;
 
@@ -249,4 +254,5 @@
 	if (!drm_mm_node_allocated(&vram->vram_node))
-		virtio_gpu_vram_map(&vram->base);
+		ret = virtio_gpu_vram_map(&vram->base);
 	mutex_unlock(&map_lock);
+	return ret;
 }
