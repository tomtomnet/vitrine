--- a/drivers/gpu/drm/virtio/virtgpu_plane.c	2026-10-03 03:40:21.049606839 +0200
+++ b/drivers/gpu/drm/virtio/virtgpu_plane.c	2026-10-03 03:40:21.051141109 +0200
@@ -59,6 +59,42 @@
 	DRM_FORMAT_MOD_INVALID,
 };
 
+/*
+ * tiled_scanout: linear and GFX11's 256 KiB and 64 KiB R_X swizzles without
+ * DCC, for every count of pipes and packers - the GPU is the host's, which
+ * this driver does not know; guest Mesa only takes the ones of its GPU from
+ * the list, and the host finds the layout in the buffer's metadata.  DCC is
+ * left out: its planes would have to be passed along.
+ */
+#define VIRTIO_GPU_TILED_MODIFIERS (1 + 2 * 8 * 8 + 1)
+static uint64_t virtio_gpu_tiled_modifiers[VIRTIO_GPU_TILED_MODIFIERS];
+
+static const uint64_t *virtio_gpu_primary_modifiers(void)
+{
+	static const int tiles[] = {
+		AMD_FMT_MOD_TILE_GFX11_256K_R_X,
+		AMD_FMT_MOD_TILE_GFX9_64K_R_X,
+	};
+	int n = 0, t, pipes, packers;
+
+	if (!virtio_gpu_modparam_tiled_scanout)
+		return virtio_gpu_modparam_linear_scanout ?
+			virtio_gpu_linear_modifiers : NULL;
+	if (virtio_gpu_tiled_modifiers[VIRTIO_GPU_TILED_MODIFIERS - 1] == DRM_FORMAT_MOD_INVALID)
+		return virtio_gpu_tiled_modifiers;
+	for (t = 0; t < ARRAY_SIZE(tiles); t++)
+		for (pipes = 0; pipes < 8; pipes++)
+			for (packers = 0; packers < 8; packers++)
+				virtio_gpu_tiled_modifiers[n++] = AMD_FMT_MOD |
+					AMD_FMT_MOD_SET(TILE_VERSION, AMD_FMT_MOD_TILE_VER_GFX11) |
+					AMD_FMT_MOD_SET(TILE, tiles[t]) |
+					AMD_FMT_MOD_SET(PIPE_XOR_BITS, pipes) |
+					AMD_FMT_MOD_SET(PACKERS, packers);
+	virtio_gpu_tiled_modifiers[n++] = DRM_FORMAT_MOD_LINEAR;
+	virtio_gpu_tiled_modifiers[n] = DRM_FORMAT_MOD_INVALID;
+	return virtio_gpu_tiled_modifiers;
+}
+
 uint32_t virtio_gpu_translate_format(uint32_t drm_fourcc)
 {
 	uint32_t format;
@@ -776,8 +812,11 @@
 	plane = drmm_universal_plane_alloc(dev, struct drm_plane, dev,
 					   1 << index, &virtio_gpu_plane_funcs,
 					   formats, nformats,
-					   virtio_gpu_modparam_linear_scanout ?
-					   virtio_gpu_linear_modifiers : NULL,
+					   type == DRM_PLANE_TYPE_CURSOR ?
+					   (virtio_gpu_modparam_linear_scanout ||
+					    virtio_gpu_modparam_tiled_scanout ?
+					    virtio_gpu_linear_modifiers : NULL) :
+					   virtio_gpu_primary_modifiers(),
 					   type, NULL);
 	if (IS_ERR(plane))
 		return plane;
