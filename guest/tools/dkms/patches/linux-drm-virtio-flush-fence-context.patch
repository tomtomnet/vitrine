+++ b/drivers/gpu/drm/virtio/virtgpu_drv.h	2026-10-02 10:28:50.720223047 +0200
@@ -227,6 +227,7 @@
 	 * are under the device's event_lock.
 	 */
 	struct dma_fence *flip_fence;	/* from the plane update to the crtc flush */
+	u64 flush_fence_context;	/* the held flush fences' own (see prepare_fb) */
 	struct drm_pending_vblank_event *gated_event;
 	struct dma_fence *gate_fence;
