diff -ru a/drivers/gpu/drm/virtio/virtgpu_fence.c b/drivers/gpu/drm/virtio/virtgpu_fence.c
--- a/drivers/gpu/drm/virtio/virtgpu_fence.c	2026-10-02 10:28:50.705800436 +0200
+++ b/drivers/gpu/drm/virtio/virtgpu_fence.c	2026-10-02 10:28:50.720253955 +0200
@@ -81,6 +81,19 @@
 	return fence;
 }
 
+/*
+ * Move a fence not emitted yet to a dma-fence context of its own.  Fences of a
+ * context complete in order: virtio_gpu_fence_event_process() signals the
+ * earlier ones of a context with each, which is wrong for a fence the host
+ * completes late on purpose (the flush held for the compositor's release, zero
+ * copy).  The command still goes out without a ring index.
+ */
+void virtio_gpu_fence_own_context(struct virtio_gpu_fence *fence, u64 context)
+{
+	dma_fence_init(&fence->f, &virtio_gpu_fence_ops, &fence->drv->lock,
+		       context, 0);
+}
+
 void virtio_gpu_fence_emit(struct virtio_gpu_device *vgdev,
 			  struct virtio_gpu_ctrl_hdr *cmd_hdr,
 			  struct virtio_gpu_fence *fence)
