 	u64 gate_events, gate_waited, gate_timeouts;
 	u64 gate_wait_ns, gate_wait_max_ns;
+	/*
+	 * The flip grace once a tick (flip_grace_once): the vblank the last
+	 * flip event went out for, or is due at - under the device's
+	 * event_lock.  A second flip in the grace of a tick that has one waits
+	 * for the next tick.  debugfs: flips completed in a grace, and second
+	 * flips in the grace of a tick that had one (refused the grace with
+	 * flip_grace_once, completed for the same tick without).
+	 */
+	u64 flip_seq;
+	bool flip_seq_set;
+	u64 grace_used, grace_second;
 };
