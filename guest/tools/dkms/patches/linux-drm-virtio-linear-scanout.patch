Zero-copy display: the module option linear_scanout=1 advertises the linear
modifier on the planes (the driver otherwise says it supports no modifiers),
so that the compositor allocates linear scanout buffers.

With zero copy the host puts the guest's scanout buffer on its screen as it
is, and virtio-gpu tells it nothing of the buffer's layout.  Without
modifiers, Mesa (radeonsi over the amdgpu native context) allocates the
compositor's scanout buffers 64KB_R_X tiled with DCC - right for the copy
path, which imports them with their metadata, and noise on the screen when
the host takes them for linear.  Read at probe (0444): set it in modprobe.d.

diff -ru a/drivers/gpu/drm/virtio/virtgpu_display.c b/drivers/gpu/drm/virtio/virtgpu_display.c
--- a/drivers/gpu/drm/virtio/virtgpu_display.c	2026-10-02 09:35:43.600631614 +0200
+++ b/drivers/gpu/drm/virtio/virtgpu_display.c	2026-10-02 09:35:43.612536149 +0200
@@ -94,6 +94,17 @@
 MODULE_PARM_DESC(blob_flush_fence, "Fence the flush of host blob scanouts too and hold the flip event until it completes (zero-copy display, default 0)");
 module_param_named(blob_flush_fence, virtio_gpu_modparam_blob_flush_fence, int, 0644);
 
+/*
+ * Zero copy: the host puts the guest's scanout buffer on its screen as it
+ * is, and virtio-gpu tells it nothing of the buffer's layout, so the buffer
+ * has to be linear.  Advertising the linear modifier on the planes makes the
+ * compositor here allocate its scanout buffers so (without modifiers Mesa
+ * tiles and compresses them).  Read at probe: a module option.
+ */
+int virtio_gpu_modparam_linear_scanout;
+MODULE_PARM_DESC(linear_scanout, "Advertise the linear modifier, so that scanout buffers are linear (zero-copy display, default 0)");
+module_param_named(linear_scanout, virtio_gpu_modparam_linear_scanout, int, 0444);
+
 static ktime_t virtio_gpu_vblank_interval(struct virtio_gpu_output *output)
 {
 	/* 60 Hz until there is a mode */
@@ -758,7 +769,8 @@
 	vgdev->ddev->mode_config.max_width = XRES_MAX;
 	vgdev->ddev->mode_config.max_height = YRES_MAX;
 
-	vgdev->ddev->mode_config.fb_modifiers_not_supported = true;
+	vgdev->ddev->mode_config.fb_modifiers_not_supported =
+		!virtio_gpu_modparam_linear_scanout;
 
 	for (i = 0 ; i < vgdev->num_scanouts; ++i)
 		vgdev_output_init(vgdev, i);
diff -ru a/drivers/gpu/drm/virtio/virtgpu_drv.h b/drivers/gpu/drm/virtio/virtgpu_drv.h
--- a/drivers/gpu/drm/virtio/virtgpu_drv.h	2026-10-02 09:35:43.600716814 +0200
+++ b/drivers/gpu/drm/virtio/virtgpu_drv.h	2026-10-02 09:35:43.612579790 +0200
@@ -239,6 +239,7 @@
 extern int virtio_gpu_modparam_host_vblank;
 extern int virtio_gpu_modparam_flip_grace_us;
 extern int virtio_gpu_modparam_blob_flush_fence;
+extern int virtio_gpu_modparam_linear_scanout;
 bool virtio_gpu_flip_in_grace(struct virtio_gpu_output *output);
 bool virtio_gpu_host_vblank_irq(struct virtio_gpu_device *vgdev);
 void virtio_gpu_host_vblank(struct virtio_gpu_device *vgdev, u32 mask);
diff -ru a/drivers/gpu/drm/virtio/virtgpu_plane.c b/drivers/gpu/drm/virtio/virtgpu_plane.c
--- a/drivers/gpu/drm/virtio/virtgpu_plane.c	2026-10-02 09:35:43.600955412 +0200
+++ b/drivers/gpu/drm/virtio/virtgpu_plane.c	2026-10-02 09:35:43.612658438 +0200
@@ -53,6 +53,12 @@
 	DRM_FORMAT_HOST_ARGB8888,
 };
 
+/* linear_scanout: the one layout the host can show without being told */
+static const uint64_t virtio_gpu_linear_modifiers[] = {
+	DRM_FORMAT_MOD_LINEAR,
+	DRM_FORMAT_MOD_INVALID,
+};
+
 uint32_t virtio_gpu_translate_format(uint32_t drm_fourcc)
 {
 	uint32_t format;
@@ -742,7 +748,10 @@
 
 	plane = drmm_universal_plane_alloc(dev, struct drm_plane, dev,
 					   1 << index, &virtio_gpu_plane_funcs,
-					   formats, nformats, NULL, type, NULL);
+					   formats, nformats,
+					   virtio_gpu_modparam_linear_scanout ?
+					   virtio_gpu_linear_modifiers : NULL,
+					   type, NULL);
 	if (IS_ERR(plane))
 		return plane;
 
