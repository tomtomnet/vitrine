+/*
+ * The gated flip event (zero copy): out once its fence completed and its
+ * vblank was counted, or after 100 ms whatever the host did, or now with
+ * @force.  Called with the event_lock held, at the commit, at every tick
+ * and after every batch of host responses.
+ */
+static void virtio_gpu_flip_gate_try(struct virtio_gpu_output *output, bool force)
+{
+	struct drm_crtc *crtc = &output->crtc;
+	s64 waited;
+
+	lockdep_assert_held(&crtc->dev->event_lock);
+	if (!output->gated_event)
+		return;
+	waited = ktime_to_ns(ktime_sub(ktime_get(), output->gate_time));
+	if (!force &&
+	    (!test_bit(DMA_FENCE_FLAG_SIGNALED_BIT, &output->gate_fence->flags) ||
+	     (s64)(drm_crtc_vblank_count(crtc) - output->gate_count) < 0)) {
+		if (waited < 100 * NSEC_PER_MSEC)
+			return;
+		output->gate_timeouts++;
+		pr_warn_ratelimited("virtio-gpu: flip event let go after 100 ms without the host's release\n");
+	}
+	drm_crtc_send_vblank_event(crtc, output->gated_event);
+	output->gated_event = NULL;
+	if (output->gate_ref)
+		drm_crtc_vblank_put(crtc);
+	output->gate_ref = false;
+	dma_fence_put(output->gate_fence);
+	output->gate_fence = NULL;
+	output->gate_wait_ns += waited;
+	if (waited > output->gate_wait_max_ns)
+		output->gate_wait_max_ns = waited;
+}
+
+static void virtio_gpu_flip_gate_poll_one(struct virtio_gpu_output *output)
+{
+	struct drm_device *dev = output->crtc.dev;
+	unsigned long flags;
+
+	if (!READ_ONCE(output->gated_event))
+		return;
+	spin_lock_irqsave(&dev->event_lock, flags);
+	virtio_gpu_flip_gate_try(output, false);
+	spin_unlock_irqrestore(&dev->event_lock, flags);
+}
+
+/* After the host's responses were processed: a gate's fence may be done. */
+void virtio_gpu_flip_gate_poll(struct virtio_gpu_device *vgdev)
+{
+	int i;
+
+	if (!virtio_gpu_modparam_blob_flush_fence)
+		return;
+	for (i = 0; i < vgdev->num_scanouts; i++)
+		virtio_gpu_flip_gate_poll_one(&vgdev->outputs[i]);
+}
