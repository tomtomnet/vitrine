# The research guests booted with preempt=full drm.vblankoffdelay=0; this
# sets both at run time instead, with no kernel argument to carry over to
# every kernel (and drm is built into Fedora's kernels: its modprobe.d
# options never apply).
[Unit]
Description=vitrine: full preemption, vblank interrupts kept on
ConditionVirtualization=vm
After=sys-kernel-debug.mount
Before=display-manager.service plasmalogin.service sddm.service gdm.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/vitrine-guest-tools/kernel-settings
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
