[Unit]
Description=vitrine: check that the patched virtio-gpu driver runs
Documentation=file:/usr/src/vitrine-virtio-gpu-@VERSION@/prepare.sh
ConditionVirtualization=vm
ConditionPathExists=/sys/module/virtio_gpu
# it may lower blob_flush_fence before a compositor uses the GPU
Before=display-manager.service plasmalogin.service sddm.service gdm.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/vitrine-guest-tools/virtio-gpu-check
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
