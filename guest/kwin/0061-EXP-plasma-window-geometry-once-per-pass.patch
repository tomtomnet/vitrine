     quint32 windowId = 0;
     QHash<SurfaceInterface *, Rect> minimizedGeometries;
@@ -105,6 +134,11 @@ public:
     QString m_resourceName;
     Rect clientGeometry;
     bool mapped = false;
+    // An interactive move changes the geometry at every pointer event, thousands of times a second
+    // with some mice. The clients get the latest geometry once per pass of the event loop.
+    QTimer geometryTimer;
+    bool geometryPending = false;
+    bool clientGeometryPending = false;
 
 protected:
     Resource *org_kde_plasma_window_allocate() override;
@@ -359,6 +393,11 @@ PlasmaWindowInterfacePrivate::PlasmaWindowInterfacePrivate(PlasmaWindowManagemen
     , wm(wm)
     , q(q)
 {
+    geometryTimer.setSingleShot(true);
+    geometryTimer.setInterval(0);
+    geometryTimer.callOnTimeout(q, [this]() {
+        sendGeometries();
+    });
 }
 
 QtWaylandServer::org_kde_plasma_window::Resource *PlasmaWindowInterfacePrivate::org_kde_plasma_window_allocate()
@@ -630,14 +669,32 @@ void PlasmaWindowInterfacePrivate::setGeometry(const Rect &geo)
     if (!geometry.isValid()) {
         return;
     }
+    geometryPending = true;
+    scheduleGeometries();
+}
+
+void PlasmaWindowInterfacePrivate::scheduleGeometries()
+{
+    if (!coalesceGeometries()) {
+        sendGeometries();
+    } else if (!geometryTimer.isActive()) {
+        geometryTimer.start();
+    }
+}
 
+void PlasmaWindowInterfacePrivate::sendGeometries()
+{
     const auto clientResources = resourceMap();
     for (auto resource : clientResources) {
-        if (resource->version() < ORG_KDE_PLASMA_WINDOW_GEOMETRY_SINCE_VERSION) {
-            continue;
+        if (clientGeometryPending && clientGeometry.isValid() && resource->version() >= ORG_KDE_PLASMA_WINDOW_CLIENT_GEOMETRY_SINCE_VERSION) {
+            send_client_geometry(resource->handle, clientGeometry.x(), clientGeometry.y(), clientGeometry.width(), clientGeometry.height());
+        }
+        if (geometryPending && geometry.isValid() && resource->version() >= ORG_KDE_PLASMA_WINDOW_GEOMETRY_SINCE_VERSION) {
+            send_geometry(resource->handle, geometry.x(), geometry.y(), geometry.width(), geometry.height());
         }
-        send_geometry(resource->handle, geometry.x(), geometry.y(), geometry.width(), geometry.height());
     }
+    geometryPending = false;
+    clientGeometryPending = false;
 }
 
 void PlasmaWindowInterfacePrivate::setApplicationMenuPaths(const QString &service, const QString &object)
@@ -1136,14 +1193,8 @@ void PlasmaWindowInterfacePrivate::setClientGeometry(const Rect &geometry)
     if (!clientGeometry.isValid()) {
         return;
     }
-
-    const auto clientResources = resourceMap();
-    for (auto resource : clientResources) {
-        if (resource->version() < ORG_KDE_PLASMA_WINDOW_CLIENT_GEOMETRY_SINCE_VERSION) {
-            continue;
-        }
-        send_client_geometry(resource->handle, clientGeometry.x(), clientGeometry.y(), clientGeometry.width(), clientGeometry.height());
