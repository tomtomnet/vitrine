From: tomtomnet <tompere8000@proton.me>
Subject: [PATCH] opengl/eglswapchain: KWIN_SWAPCHAIN_WAIT_READERS - a slot is busy while its dma-buf has readers

For a virtual machine whose host shows the guest's buffers themselves (zero
copy): the buffer flipped away from may still be on the host's screen.  The
guest's virtio-gpu driver (blob_flush_fence=3) puts a fence on it that
completes once the host released it; with this a slot whose dma-buf still has
such a fence counts as busy (poll POLLOUT on the dma-buf), so it is not
rendered into before, and the flip events no longer have to wait for the host
- holding them had made the compositor miss refreshes (4-9 % of the frames a
refresh late against 0).  acquire() then takes another slot, or allocates one.

--- a/src/opengl/eglswapchain.cpp	2026-10-02 14:20:24.736887481 +0200
+++ b/src/opengl/eglswapchain.cpp	2026-10-02 14:20:24.747644720 +0200
@@ -18,6 +18,7 @@
 
 #include <drm_fourcc.h>
 #include <errno.h>
+#include <poll.h>
 
 namespace KWin
 {
@@ -58,11 +59,31 @@
     return m_age;
 }
 
+// KWIN_SWAPCHAIN_WAIT_READERS=1: a slot is also busy while its dma-buf has
+// fences of readers.  In a virtual machine whose host shows the guest's buffers
+// themselves (zero copy), the guest's virtio-gpu driver (blob_flush_fence=3)
+// puts on the buffer flipped away from a fence that completes once the host
+// released it: the buffer is not rendered into while the host may still scan
+// it out, and the flip events need not wait for the host.
+static const bool s_waitReaders = environmentVariableBoolValue("KWIN_SWAPCHAIN_WAIT_READERS").value_or(false);
+
+static bool hasReaders(GraphicsBuffer *buffer)
+{
+    const DmaBufAttributes *attributes = buffer->dmabufAttributes();
+    if (!attributes || !attributes->fd[0].isValid()) {
+        return false;
+    }
+    // POLLOUT: no fence of any kind left on the dma-buf, readers' included
+    pollfd pfd{.fd = attributes->fd[0].get(), .events = POLLOUT, .revents = 0};
+    return poll(&pfd, 1, 0) == 0;
+}
+
 bool EglSwapchainSlot::isBusy() const
 {
     return m_buffer->isReferenced()
         || m_releasePoint.use_count() > 1
-        || (m_releasePoint->releaseFd().isValid() && !m_releasePoint->releaseFd().isReadable());
+        || (m_releasePoint->releaseFd().isValid() && !m_releasePoint->releaseFd().isReadable())
+        || (s_waitReaders && hasReaders(m_buffer));
 }
 
 const FileDescriptor &EglSwapchainSlot::releaseFd() const
