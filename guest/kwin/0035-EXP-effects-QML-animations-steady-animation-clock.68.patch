+    void advanceToNextFrame(std::chrono::nanoseconds nextPresentation, std::chrono::nanoseconds refreshInterval = std::chrono::nanoseconds::zero());
 
     /*
      * The overrides are for Qt's usage
@@ -37,6 +40,9 @@ private:
     std::optional<std::chrono::nanoseconds> m_nextTime = std::nullopt;
     // the elapsed time is a relative offset to when the animationDriver starts
     std::optional<std::chrono::nanoseconds> m_offset = std::nullopt;
+    // KWIN_STEADY_ANIMATION_CLOCK: the last presentation time, and the steady time
+    std::optional<std::chrono::nanoseconds> m_lastPresentation = std::nullopt;
+    SteadyAnimationTime m_steady;
 };
 
