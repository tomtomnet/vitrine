+/*
+ * Poll the sync files of the buffers until all are readable or @p until
+ * comes; the frames get the time the last one became readable.
+ */
+void DrmCommitThread::watchGpu(std::vector<DrmAtomicCommit::Watched> &&watched, TimePoint until)
+{
+    std::vector<pollfd> fds;
+    for (const auto &w : watched) {
+        if (!w.buffer->isReadable()) {
+            const auto &fd = w.buffer->syncFd();
+            if (fd.isValid()) {
+                fds.push_back(pollfd{.fd = fd.get(), .events = POLLIN, .revents = 0});
+            }
+        }
+    }
+    if (fds.empty()) {
+        // done before the commit was handed over, or nothing to poll
+        return;
+    }
+    while (true) {
+        const auto now = std::chrono::steady_clock::now();
+        if (now >= until) {
+            return;
+        }
+        const auto left = std::chrono::duration_cast<std::chrono::milliseconds>(until - now);
+        const int ret = poll(fds.data(), fds.size(), std::max<int>(1, left.count() + 1));
+        if (ret < 0 && errno != EINTR) {
+            return;
+        }
+        bool all = true;
+        for (const auto &w : watched) {
+            if (!w.buffer->isReadable()) {
+                all = false;
+                break;
+            }
+        }
+        if (all) {
+            const auto done = std::chrono::steady_clock::now();
+            for (const auto &w : watched) {
+                if (w.frame) {
+                    w.frame->setGpuDone(done);
+                }
+            }
+            return;
+        }
+        std::erase_if(fds, [&](const pollfd &p) {
+            return p.revents & (POLLIN | POLLERR | POLLHUP | POLLNVAL);
+        });
+        if (fds.empty()) {
+            return;
+        }
+    }
+}
