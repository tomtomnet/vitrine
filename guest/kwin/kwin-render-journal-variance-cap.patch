+/*
+ * The estimate is the smoothed render time plus twice the largest recent
+ * excess over it, and that excess decays over seconds.  Where single long
+ * frames are a fact of life (virtual machines: the first CPU touch of a
+ * new buffer costs milliseconds) one such frame keeps the compositor two
+ * vblanks ahead for seconds afterwards, a whole refresh of latency for
+ * nothing.  KWIN_RENDER_JOURNAL_VARIANCE_CAP_US bounds the excess that is
+ * remembered; unset, nothing changes.
+ */
+static std::chrono::nanoseconds varianceCapFromEnvironment()
+{
+    bool ok = false;
+    const int us = qEnvironmentVariableIntValue("KWIN_RENDER_JOURNAL_VARIANCE_CAP_US", &ok);
+    if (!ok || us <= 0) {
+        return std::chrono::nanoseconds::max();
+    }
+    return std::chrono::microseconds(us);
+}
