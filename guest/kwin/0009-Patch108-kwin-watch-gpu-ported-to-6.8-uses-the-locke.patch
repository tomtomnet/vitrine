+std::vector<DrmAtomicCommit::Watched> DrmAtomicCommit::watched() const
+{
+    std::vector<Watched> ret;
+    for (const auto &[plane, buffer] : m_buffers) {
+        if (!buffer) {
+            continue;
+        }
+        const auto it = m_frames.find(plane);
+        ret.push_back(Watched{
+            .buffer = buffer,
+            .frame = it == m_frames.end() ? nullptr : it->second,
+        });
+    }
+    return ret;
+}
