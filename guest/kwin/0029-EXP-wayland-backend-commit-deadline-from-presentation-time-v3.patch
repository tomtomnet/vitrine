@@ -0,0 +1,284 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<protocol name="presentation_time">
+  <!-- Local copy: wayland-protocols' stable presentation-time with the proposed
+       version 3 (content_update_deadline, wayland-protocols merge request 454,
+       not merged as of 2026-10-07), for an experimental host build. -->
+<!-- wrap:70 -->
+
