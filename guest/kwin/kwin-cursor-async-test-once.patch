+/**
+ * KWIN_CURSOR_TEST_EVERY_MOVE=1 tests and queues every asynchronous update (the behaviour before
+ * this change), =2 drops updates that change nothing but tests every other one.
+ * $XDG_RUNTIME_DIR/kwin-cursor-test-every-move holding 0, 1 or 2 decides instead while it exists,
+ * read at most once a second (an A/B in a running session)
+ */
+static int asyncTestMode()
+{
+    static const int s_environment = environmentVariableIntValue("KWIN_CURSOR_TEST_EVERY_MOVE").value_or(0);
+    static const QString s_path = qEnvironmentVariable("XDG_RUNTIME_DIR") + QStringLiteral("/kwin-cursor-test-every-move");
+    static int s_mode = s_environment;
+    static std::chrono::steady_clock::time_point s_lastRead;
+    const auto now = std::chrono::steady_clock::now();
+    if (now - s_lastRead >= std::chrono::seconds(1)) {
+        s_lastRead = now;
+        s_mode = s_environment;
+        QFile file(s_path);
+        if (file.open(QIODevice::ReadOnly)) {
+            bool ok = false;
+            const int value = file.readAll().trimmed().toInt(&ok);
+            if (ok) {
+                s_mode = value;
+            }
+        }
+    }
+    return s_mode;
+}
+
+static constexpr uint32_t s_littleVisible = (1 << 4) | (1 << 5);
+
+/**
+ * The edges of the crtc that @a rect reaches past, and along which of them less than 64 pixels
+ * of it remain visible (s_littleVisible). Drivers restrict plane positions only at the edges (i915
+ * refuses the cursor across the left edge of pipe C on Cherryview, amdgpu a plane with less than
+ * 24x12 pixels visible), so a test is only reused while this stays the same, and never with
+ * little of the plane visible
+ */
+static uint32_t crtcEdgeFlags(const Rect &rect, const QSize &crtcSize)
+{
+    const Rect visible = rect.intersected(Rect(QPoint(0, 0), crtcSize));
+    uint32_t ret = 0;
+    if (rect.x() < 0) {
+        ret |= 1 << 0;
+    }
+    if (rect.x() + rect.width() > crtcSize.width()) {
+        ret |= 1 << 1;
+    }
+    if (rect.y() < 0) {
+        ret |= 1 << 2;
+    }
+    if (rect.y() + rect.height() > crtcSize.height()) {
+        ret |= 1 << 3;
+    }
+    if ((ret & 0b0011) && visible.width() < 64) {
+        ret |= 1 << 4;
+    }
+    if ((ret & 0b1100) && visible.height() < 64) {
+        ret |= 1 << 5;
+    }
+    return ret;
+}
