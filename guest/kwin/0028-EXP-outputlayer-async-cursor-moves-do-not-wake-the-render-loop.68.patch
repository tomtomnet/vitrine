+// KWIN_ASYNC_CURSOR_MOVES=1 (EXP), or $XDG_RUNTIME_DIR/kwin-async-cursor-moves holding 1 or 0 (read at most
+// once a second, for A/B tests without a restart): a cursor move the compositor pushed out on its own (a
+// cursor-plane-only commit, presentAsync) doesn't also wake the render loop. That wake made composite()
+// present an empty frame which claimed the next vblank, so a client redrawing in response to the same
+// pointer move - a VM's window during a drag, ready ~1.8 ms before that vblank (2026-10-10) - could only
+// take the one after. Everything else that needs a frame still schedules its own repaint.
+static bool asyncCursorMoves()
+{
+    static const bool environment = qEnvironmentVariableIntValue("KWIN_ASYNC_CURSOR_MOVES") == 1;
+    static bool value = environment;
+    static std::chrono::steady_clock::time_point checked{};
+    const auto now = std::chrono::steady_clock::now();
+    if (checked != std::chrono::steady_clock::time_point{} && now - checked < std::chrono::seconds(1)) {
+        return value;
+    }
+    checked = now;
+    value = environment;
+    QFile file(qEnvironmentVariable("XDG_RUNTIME_DIR") + QStringLiteral("/kwin-async-cursor-moves"));
+    if (file.open(QIODevice::ReadOnly)) {
+        const QByteArray content = file.readAll().trimmed();
+        if (content == "1") {
+            value = true;
+        } else if (content == "0") {
+            value = false;
+        }
+    }
+    return value;
+}
+
 void OutputLayer::scheduleRepaint(Item *item, std::optional<std::chrono::steady_clock::time_point> targetTime)
 {
     if (!m_output) {
         return;
     }
     m_repaintScheduled = true;
+    if (type() == OutputLayerType::CursorOnly && asyncCursorMoves()) {
+        // the compositor's cursor handler runs from a 0 ms timer started by repaintScheduled() and pushes a
+        // pure move out on its own (dropDeferredRepaint); this layer's own 0 ms timer, started after it,
+        // wakes the render loop for whatever the handler left to composite() - or if no handler ran
+        if (!m_deferredRepaint) {
+            m_deferredRepaint = true;
+            m_deferredItem = item;
+            m_deferredTarget = targetTime;
+        } else if (!targetTime || (m_deferredTarget && *targetTime < *m_deferredTarget)) {
+            // the earliest target wins, none = as soon as possible
+            m_deferredTarget = targetTime;
+        }
+        Q_EMIT repaintScheduled();
+        if (!m_deferredTimer) {
+            m_deferredTimer = new QTimer(this);
+            m_deferredTimer->setSingleShot(true);
+            m_deferredTimer->setInterval(0);
+            connect(m_deferredTimer, &QTimer::timeout, this, [this]() {
+                const bool wake = std::exchange(m_deferredRepaint, false);
+                const auto item = std::exchange(m_deferredItem, nullptr);
+                const auto target = std::exchange(m_deferredTarget, std::nullopt);
+                if (wake && m_renderLoop) {
+                    m_renderLoop->scheduleRepaint(item.data(), this, target);
+                }
+            });
+        }
+        m_deferredTimer->start();
+        return;
+    }
     if (m_renderLoop) {
         m_renderLoop->scheduleRepaint(item, this, targetTime);
     }
     Q_EMIT repaintScheduled();
 }
 
+void OutputLayer::dropDeferredRepaint()
+{
+    m_deferredRepaint = false;
+    m_deferredItem.clear();
+    m_deferredTarget.reset();
+}
