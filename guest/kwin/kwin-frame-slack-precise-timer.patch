+
+void RenderLoopPrivate::stopCompositeTimer()
+{
+    if (!preciseTimerNotifier) {
+        compositeTimer.stop();
+        return;
+    }
+    const itimerspec spec{};
+    timerfd_settime(preciseTimer.get(), 0, &spec, nullptr);
+    preciseTimerArmed = false;
