     DrmPlane *plane() const;
 
diff --git a/src/backends/drm/drm_pipeline.cpp b/src/backends/drm/drm_pipeline.cpp
index 55de7ad..de45a78 100644
--- a/src/backends/drm/drm_pipeline.cpp
+++ b/src/backends/drm/drm_pipeline.cpp
@@ -15,6 +15,7 @@
 #include "core/iccprofile.h"
 #include "core/session.h"
 #include "drm_backend.h"
+#include "drm_blob.h"
 #include "drm_buffer.h"
 #include "drm_commit.h"
 #include "drm_commit_thread.h"
@@ -76,6 +77,9 @@ DrmPipeline::Error DrmPipeline::present(const QList<OutputLayer *> &layersToUpda
             if (Error err = prepareAtomicPlane(partialUpdate.get(), pipelineLayer->plane(), pipelineLayer, frame); err != Error::None) {
                 return err;
             }
+            if (pipelineLayer->plane()) {
+                pipelineLayer->plane()->setQueuedBuffer(pipelineLayer->isEnabled() ? pipelineLayer->currentBuffer() : nullptr);
+            }
         }
         if (layersToUpdate.isEmpty()) {
             // work around amdgpu not giving us a valid pageflip timestamp
@@ -83,6 +87,9 @@ DrmPipeline::Error DrmPipeline::present(const QList<OutputLayer *> &layersToUpda
             if (Error err = prepareAtomicPlane(partialUpdate.get(), m_pending.layers.front()->plane(), m_pending.layers.front(), frame); err != Error::None) {
                 return err;
             }
+            if (const auto plane = m_pending.layers.front()->plane()) {
+                plane->setQueuedBuffer(m_pending.layers.front()->isEnabled() ? m_pending.layers.front()->currentBuffer() : nullptr);
+            }
         }
         if (m_pending.needsModesetProperties && !prepareAtomicModeset(partialUpdate.get())) {
             return Error::InvalidArguments;
@@ -269,7 +276,40 @@ DrmPipeline::Error DrmPipeline::prepareAtomicPlane(DrmAtomicCommit *commit, DrmP
         commit->addProperty(plane->zpos, layer->zpos());
     }
     if (plane->fbDamage.isValid()) {
-        commit->addProperty(plane->fbDamage, 0);
+        /*
+         * What changed since the buffer of the last presentation queued for
+         * this plane - the kernel applies commits in order: drivers that
+         * copy the scanout (a virtual GPU whose host copies the guest's frame
+         * into its own window) or update a panel selectively need not do it
+         * all.  Every 240th such commit says "everything" again, in case a
+         * commit got lost.  KWIN_DRM_DAMAGE_CLIPS=0: always everything (0).
+         *
+         * The kernel takes only clips inside the framebuffer and fails the
+         * whole commit otherwise (EINVAL, "invalid damage clip"), while a full
+         * repaint is an infinite region and windows reach past the screen in
+         * the overview or a desktop switch: clip to the buffer, and say
+         * "everything" when that leaves the whole buffer or nothing.
+         */
+        static const bool s_damageClips = environmentVariableBoolValue("KWIN_DRM_DAMAGE_CLIPS").value_or(true);
+        std::shared_ptr<DrmBlob> blob;
+        if (s_damageClips && fb != plane->queuedBuffer() && fb->buffer()) {
+            const auto damage = layer->damageSince(plane->queuedBuffer());
+            const QSize size = fb->buffer()->size();
+            const Rect bounds(0, 0, size.width(), size.height());
+            const Region clipped = damage ? damage->intersected(bounds) : Region();
+            if (!clipped.isEmpty() && !(clipped == Region(bounds)) && ++plane->damageCommits % 240 != 0) {
+                std::vector<drm_mode_rect> clips;
+                for (const Rect &r : clipped.rects()) {
+                    clips.push_back(drm_mode_rect{r.left(), r.top(), r.right(), r.bottom()});
+                }
+                blob = DrmBlob::create(gpu(), clips.data(), clips.size() * sizeof(drm_mode_rect));
+            }
+        }
+        if (blob) {
+            commit->addBlob(plane->fbDamage, blob);
+        } else {
+            commit->addProperty(plane->fbDamage, 0);
+        }
     }
 
     const auto colorPipelines = plane->colorPipelines();
