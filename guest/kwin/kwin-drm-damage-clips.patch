 }
 
+std::shared_ptr<DrmFramebuffer> DrmPlane::queuedBuffer() const
+{
+    return m_queued;
+}
+
+void DrmPlane::setQueuedBuffer(const std::shared_ptr<DrmFramebuffer> &b)
+{
+    m_queued = b;
+}
+
 std::shared_ptr<DrmFramebuffer> DrmPlane::currentBuffer() const
 {
     return m_current;
