index 80f5602..91b7e86 100644
--- a/src/backends/drm/drm_plane.h
+++ b/src/backends/drm/drm_plane.h
@@ -48,6 +48,15 @@ public:
 
     std::shared_ptr<DrmFramebuffer> currentBuffer() const;
     void setCurrentBuffer(const std::shared_ptr<DrmFramebuffer> &b);
+    /**
+     * The buffer of the last presentation handed to the commit thread for
+     * this plane: the kernel applies commits in order, so the next one's
+     * damage is relative to it.
+     */
+    std::shared_ptr<DrmFramebuffer> queuedBuffer() const;
+    void setQueuedBuffer(const std::shared_ptr<DrmFramebuffer> &b);
+    /** counts commits with damage clips, for a full one now and then */
+    int damageCommits = 0;
     void releaseCurrentBuffer();
 
     void set(DrmAtomicCommit *commit, const Rect &src, const Rect &dst);
@@ -114,6 +123,7 @@ public:
 
 private:
     std::shared_ptr<DrmFramebuffer> m_current;
+    std::shared_ptr<DrmFramebuffer> m_queued;
     std::deque<std::shared_ptr<DrmFramebufferData>> m_lastBuffers;
 
     FormatModifierMap m_supportedFormats;
