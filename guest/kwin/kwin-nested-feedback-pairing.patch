-void WaylandOutput::frameDiscarded()
+// Feedback events are matched to their frame by the feedback object, not by order: the events
+// of different frames may come in any order - a frame replaced before it was shown gets its
+// discarded event while the frame before it still waits for presented (commit-timing makes
+// that common). Taking the oldest frame for each event then dropped the wrong one, whose
+// presented event was lost with its destroyed feedback object, and every later presentation
+// was attributed to the frame before it for the rest of the session: a nested desktop at
+// 240 Hz stuck at half rate (2026-10-07).
+void WaylandOutput::frameDiscarded(struct wp_presentation_feedback *feedback)
 {
-    m_frames.pop_front();
+    const auto it = std::ranges::find_if(m_frames, [feedback](const FrameData &frame) {
+        return frame.presentationFeedback == feedback;
+    });
+    if (it != m_frames.end()) {
+        m_frames.erase(it);
+    }
 }
 
-void WaylandOutput::framePresented(std::chrono::nanoseconds timestamp, uint32_t refreshRate)
+void WaylandOutput::framePresented(struct wp_presentation_feedback *feedback, std::chrono::nanoseconds timestamp, uint32_t refreshRate)
 {
+    const auto it = std::ranges::find_if(m_frames, [feedback](const FrameData &frame) {
+        return frame.presentationFeedback == feedback;
+    });
+    if (it == m_frames.end()) {
+        return;
+    }
+    // older frames can no longer be shown: dropped (their OutputFrame reports it when it goes)
+    m_frames.erase(m_frames.begin(), it);
+
     if (refreshRate != this->refreshRate()) {
         m_refreshRate = refreshRate;
         const auto mode = std::make_shared<OutputMode>(OutputModeline(pixelSize(), m_refreshRate));
