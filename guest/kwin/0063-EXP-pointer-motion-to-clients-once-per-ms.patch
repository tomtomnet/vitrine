     d->lastPosition = position;
 
     if (!d->focusedSurface) {
@@ -412,11 +428,36 @@ void PointerInterface::sendWarp(const QPointF &position)
 
 void PointerInterface::sendFrame()
 {
+    if (d->heldMotion) {
+        // goes out with the held motion
+        d->heldFrame = true;
+        return;
+    }
     if (d->focusedSurface) {
         d->sendFrame();
     }
 }
 
+void PointerInterface::setMotionHeld(bool hold)
+{
+    d->holdMotion = hold;
+}
+
+void PointerInterface::flushHeldMotion()
+{
+    if (!d->heldMotion) {
+        return;
+    }
+    const QPointF position = *std::exchange(d->heldMotion, std::nullopt);
+    const bool frame = std::exchange(d->heldFrame, false);
+    const bool hold = std::exchange(d->holdMotion, false);
+    sendMotion(position);
+    if (frame) {
+        sendFrame();
+    }
+    d->holdMotion = hold;
+}
+
 SeatInterface *PointerInterface::seat() const
 {
     return d->seat;
