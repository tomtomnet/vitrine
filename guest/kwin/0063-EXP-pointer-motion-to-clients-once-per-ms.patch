@@ -2112,7 +2154,34 @@ public:
         if (event->warp) {
             seat->notifyPointerWarp(event->position);
         } else {
+            // A mouse that reports at 4000-8000 Hz moved the pointer every 125-250 us, and every
+            // motion went to the client under it: its toolkit handled each one (hover, picking),
+            // while the screen shows one position per refresh. Motions closer than
+            // pointerMotionInterval() to the last one sent are held, and the latest is sent when
+            // the interval is over, or before any other pointer event; a 1000 Hz mouse is not
+            // affected. A locked or confined pointer (games) gets every motion.
+            using namespace std::chrono_literals;
+            PointerInterface *pointer = seat->pointer();
+            const auto interval = pointerMotionInterval();
+            SurfaceInterface *focus = seat->focusedPointerSurface();
+            const bool hold = pointer && interval > 0us && m_sinceMotion.isValid() && m_sinceMotion.durationElapsed() < interval
+                && !(focus && (focus->lockedPointer() || focus->confinedPointer()));
+            if (pointer) {
+                pointer->setMotionHeld(hold);
+            }
             seat->notifyPointerMotion(event->position);
+            if (pointer) {
+                pointer->setMotionHeld(false);
+            }
+            if (hold) {
+                if (!m_motionTimer.isActive()) {
+                    const auto remaining = interval - std::chrono::duration_cast<std::chrono::microseconds>(m_sinceMotion.durationElapsed());
+                    m_motionTimer.start(std::chrono::ceil<std::chrono::milliseconds>(remaining));
+                }
+            } else {
+                m_motionTimer.stop();
+                m_sinceMotion.start();
+            }
             if (!event->delta.isNull()) {
                 seat->relativePointerMotion(event->delta, event->deltaUnaccelerated, event->timestamp);
             }
@@ -2549,6 +2618,10 @@ public:
         dial->sendFrame(std::chrono::duration_cast<std::chrono::milliseconds>(event->time).count());
         return true;
     }
+
+private:
+    QTimer m_motionTimer;
+    QElapsedTimer m_sinceMotion;
 };
 
