+/**
+ * KWIN_POINTER_MOTION_INTERVAL_US: the shortest interval between two pointer motions sent to a client [750: a 1000 Hz
+ * mouse's events, about 1000 us apart with some jitter, all pass];
+ * 0 sends every one, as before. A host KWin keeps its wrapper's environment from login, so
+ * $XDG_RUNTIME_DIR/kwin-pointer-motion-interval-us holding a number decides instead while it exists, read at
+ * most once a second (an A/B in a running session)
+ */
+static std::chrono::microseconds pointerMotionInterval()
+{
+    static const int s_environment = environmentVariableIntValue("KWIN_POINTER_MOTION_INTERVAL_US").value_or(750);
+    static const QString s_path = qEnvironmentVariable("XDG_RUNTIME_DIR") + QStringLiteral("/kwin-pointer-motion-interval-us");
+    static int s_value = s_environment;
+    static std::chrono::steady_clock::time_point s_lastRead;
+    const auto now = std::chrono::steady_clock::now();
+    if (now - s_lastRead >= std::chrono::seconds(1)) {
+        s_lastRead = now;
+        s_value = s_environment;
+        QFile file(s_path);
+        if (file.open(QIODevice::ReadOnly)) {
+            bool ok = false;
+            const int value = file.readAll().trimmed().toInt(&ok);
+            if (ok && value >= 0) {
+                s_value = value;
+            }
+        }
+    }
+    return std::chrono::microseconds(s_value);
+}
