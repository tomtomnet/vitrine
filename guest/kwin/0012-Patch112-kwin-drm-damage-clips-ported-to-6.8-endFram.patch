diff --git a/src/backends/drm/drm_layer.h b/src/backends/drm/drm_layer.h
index c5129c9cdb..0d943e4105 100644
--- a/src/backends/drm/drm_layer.h
+++ b/src/backends/drm/drm_layer.h
@@ -42,6 +42,12 @@ public:
     FormatModifierMap supportedAsyncDrmFormats() const override;
 
     virtual std::shared_ptr<DrmFramebuffer> currentBuffer() const = 0;
+    /**
+     * What changed in currentBuffer() since @p previous, in buffer pixels,
+     * when the layer knows it (it rendered the two one after the other);
