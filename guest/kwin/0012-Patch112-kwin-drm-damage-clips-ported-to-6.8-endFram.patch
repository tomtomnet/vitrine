diff --git a/src/backends/drm/drm_commit.cpp b/src/backends/drm/drm_commit.cpp
index a152bed47a..afdb19477a 100644
--- a/src/backends/drm/drm_commit.cpp
+++ b/src/backends/drm/drm_commit.cpp
@@ -14,6 +14,7 @@
 #include "drm_crtc.h"
 #include "drm_gpu.h"
 #include "drm_object.h"
+#include "drm_plane.h"
 #include "drm_property.h"
 
 #include <QCoreApplication>
@@ -311,6 +312,14 @@ const std::unordered_set<DrmPlane *> &DrmAtomicCommit::modifiedPlanes() const
 
 void DrmAtomicCommit::merge(DrmAtomicCommit *onTop)
 {
+    // a plane both commits give a buffer to: the first one never reaches the
+    // screen, so the damage of the second (relative to it) is not the plane's
+    std::vector<DrmPlane *> damageLost;
+    for (const auto &[plane, buffer] : onTop->m_buffers) {
+        if (m_buffers.contains(plane) && plane->fbDamage.isValid()) {
+            damageLost.push_back(plane);
+        }
+    }
     for (const auto &[obj, properties] : onTop->m_properties) {
         auto &ownProperties = m_properties[obj];
         for (const auto &[prop, value] : properties) {
@@ -325,6 +334,10 @@ void DrmAtomicCommit::merge(DrmAtomicCommit *onTop)
     for (const auto &[prop, blob] : onTop->m_blobs) {
         m_blobs[prop] = blob;
     }
+    for (DrmPlane *plane : damageLost) {
+        addProperty(plane->fbDamage, 0);
+        m_blobs.erase(&plane->fbDamage);
+    }
     if (onTop->m_vrr) {
         m_vrr = onTop->m_vrr;
     }
diff --git a/src/backends/drm/drm_egl_layer.cpp b/src/backends/drm/drm_egl_layer.cpp
index 2bdaea15f9..7d6d29142c 100644
--- a/src/backends/drm/drm_egl_layer.cpp
+++ b/src/backends/drm/drm_egl_layer.cpp
@@ -71,7 +71,28 @@ std::optional<OutputLayerBeginFrameInfo> EglGbmLayer::beginFrame(OutputFrame *fr
 
 bool EglGbmLayer::endFrame(const Region &renderedDeviceRegion, const Region &damagedDeviceRegion, OutputFrame *frame)
 {
-    return m_surface.endRendering(damagedDeviceRegion, frame);
+    const std::shared_ptr<DrmFramebuffer> before = m_surface.currentBuffer();
+    if (!m_surface.endRendering(damagedDeviceRegion, frame)) {
+        m_damageBuffer.reset();
+        return false;
+    }
+    m_previousBuffer = before;
+    m_damageBuffer = m_surface.currentBuffer();
+    m_damage = damagedDeviceRegion;
+    return true;
+}
+
+std::optional<Region> EglGbmLayer::damageSince(const std::shared_ptr<DrmFramebuffer> &previous) const
+{
+    // only for a buffer rendered right after @previous, 1:1
+    if (m_scanoutBuffer || !previous || !m_damageBuffer
+        || m_damageBuffer != m_surface.currentBuffer()
+        || m_previousBuffer != previous
+        || drmOutput()->needsShadowBuffer()
+        || offloadTransform() != OutputTransform::Kind::Normal) {
+        return std::nullopt;
+    }
+    return m_damage;
 }
 
 bool EglGbmLayer::preparePresentationTest()
diff --git a/src/backends/drm/drm_egl_layer.h b/src/backends/drm/drm_egl_layer.h
index f8d544dabf..7fb025fb54 100644
--- a/src/backends/drm/drm_egl_layer.h
+++ b/src/backends/drm/drm_egl_layer.h
@@ -32,6 +32,7 @@ public:
     bool endFrame(const Region &renderedDeviceRegion, const Region &damagedDeviceRegion, OutputFrame *frame) override;
     bool preparePresentationTest() override;
     std::shared_ptr<DrmFramebuffer> currentBuffer() const override;
+    std::optional<Region> damageSince(const std::shared_ptr<DrmFramebuffer> &previous) const override;
     void releaseBuffers() override;
 
 private:
@@ -41,6 +42,10 @@ private:
 
     EglGbmLayerSurface m_surface;
     std::shared_ptr<DrmFramebuffer> m_scanoutBuffer;
+    // the last rendered buffer, the one rendered before it, and what changed between them
+    std::shared_ptr<DrmFramebuffer> m_damageBuffer;
+    std::shared_ptr<DrmFramebuffer> m_previousBuffer;
+    Region m_damage;
 };
 
 }
