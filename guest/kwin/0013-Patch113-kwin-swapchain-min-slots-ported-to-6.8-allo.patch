From: tomtomnet <tompere8000@proton.me>
Date: Sat, 3 Oct 2026 14:31:19 +0200
Subject: [PATCH 13/22] Patch113 kwin-swapchain-min-slots (ported to 6.8:
 allocate(m_options))

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/opengl/eglswapchain.cpp | 36 +++++++++++++++++++++++++++++++-----
 1 file changed, 31 insertions(+), 5 deletions(-)

diff --git a/src/opengl/eglswapchain.cpp b/src/opengl/eglswapchain.cpp
index 6d94803a7c..58cb581fc1 100644
--- a/src/opengl/eglswapchain.cpp
+++ b/src/opengl/eglswapchain.cpp
@@ -15,6 +15,7 @@
 #include "opengl/eglcontext.h"
 #include "opengl/glutils.h"
 #include "utils/common.h"
+#include "utils/envvar.h"
 
 #include <drm_fourcc.h>
 #include <errno.h>
@@ -133,13 +134,38 @@ const std::shared_ptr<EglContext> &EglSwapchain::context() const
     return m_context;
 }
 
+// KWIN_SWAPCHAIN_MIN_SLOTS=N: at least N buffers, reused oldest first.  In a
+// virtual machine whose host shows the guest's buffers themselves (zero copy),
+// a buffer may only be rendered into again once the host stopped showing it:
+// reused oldest first out of four, a buffer comes back three frames after it
+// was shown, and the guest's flip event only has to wait for the host to
+// release the buffer before the previous one - normally done a refresh earlier.
+// The first free one, as by default, can be the buffer the screen still shows.
+static const int s_minSlots = environmentVariableIntValue("KWIN_SWAPCHAIN_MIN_SLOTS").value_or(0);
+
 std::shared_ptr<EglSwapchainSlot> EglSwapchain::acquire()
 {
-    const auto it = std::ranges::find_if(std::as_const(m_slots), [](const auto &slot) {
-        return !slot->isBusy();
-    });
-    if (it != m_slots.cend()) {
-        return *it;
+    if (s_minSlots > 0 && m_slots.count() >= s_minSlots) {
+        // the free slot used longest ago; age 0 = never rendered into, the oldest
+        std::shared_ptr<EglSwapchainSlot> oldest;
+        for (const auto &slot : std::as_const(m_slots)) {
+            if (slot->isBusy()) {
+                continue;
+            }
+            if (!oldest || slot->m_age == 0 || (oldest->m_age != 0 && slot->m_age > oldest->m_age)) {
+                oldest = slot;
+            }
+        }
+        if (oldest) {
+            return oldest;
+        }
+    } else if (s_minSlots <= 0) {
+        const auto it = std::ranges::find_if(std::as_const(m_slots), [](const auto &slot) {
+            return !slot->isBusy();
+        });
+        if (it != m_slots.cend()) {
+            return *it;
+        }
     }
 
     GraphicsBuffer *buffer = m_allocator->allocate(m_options);
