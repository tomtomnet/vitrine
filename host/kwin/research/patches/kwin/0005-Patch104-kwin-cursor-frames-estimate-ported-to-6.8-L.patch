diff --git a/src/core/renderloop.cpp b/src/core/renderloop.cpp
index 3675bf609d..4d99f9c30d 100644
--- a/src/core/renderloop.cpp
+++ b/src/core/renderloop.cpp
@@ -27,6 +27,8 @@ static const bool s_printDebugInfo = qEnvironmentVariableIntValue("KWIN_LOG_PERF
 // panel it shows no gain, and it costs up to a refresh of latency long after a loaded phase),
 // KWIN_LATE_FLIP_STEP_US sets how much earlier frames start per late flip (500 by default)
 static const bool s_lateFlipCompensation = qEnvironmentVariableIntValue("KWIN_LATE_FLIP_COMPENSATION") != 0;
+// KWIN_RENDER_ESTIMATE_UPSTREAM=1: the frames for which only the cursor was rendered count for the render time estimate
+static const bool s_upstreamEstimate = qEnvironmentVariableIntValue("KWIN_RENDER_ESTIMATE_UPSTREAM") != 0;
 static const std::chrono::nanoseconds s_lateFlipStep = std::chrono::microseconds(qEnvironmentVariableIsEmpty("KWIN_LATE_FLIP_STEP_US") ? 500 : std::max(10, qEnvironmentVariableIntValue("KWIN_LATE_FLIP_STEP_US")));
 
 RenderLoopPrivate::RenderLoopPrivate(RenderLoop *q, BackendOutput *output)
@@ -161,14 +163,14 @@ void RenderLoopPrivate::notifyFrameCompleted(std::chrono::nanoseconds timestamp,
 {
     if (output && s_printDebugInfo && !m_debugOutput) {
         m_debugOutput = std::fstream(qPrintable("kwin perf statistics " + output->name() + ".csv"), std::ios::out);
-        *m_debugOutput << "target pageflip timestamp,pageflip timestamp,render start,render end,safety margin,refresh duration,vrr,tearing,predicted render time,late flip compensation\n";
+        *m_debugOutput << "target pageflip timestamp,pageflip timestamp,render start,render end,safety margin,refresh duration,vrr,tearing,predicted render time,late flip compensation,cursor rendered,content rendered\n";
     }
     if (m_debugOutput) {
         auto times = renderTime.value_or(RenderTimeSpan{});
         const bool vrr = mode == PresentationMode::AdaptiveSync || mode == PresentationMode::AdaptiveAsync;
         const bool tearing = mode == PresentationMode::Async || mode == PresentationMode::AdaptiveAsync;
         *m_debugOutput << frame->targetPageflipTime().time_since_epoch().count() << "," << timestamp.count() << "," << times.start.time_since_epoch().count() << "," << times.end.time_since_epoch().count()
-                       << "," << safetyMargin.count() << "," << frame->refreshDuration().count() << "," << (vrr ? 1 : 0) << "," << (tearing ? 1 : 0) << "," << frame->predictedRenderTime().count() << "," << lateFlipCompensation.count() << "\n";
+                       << "," << safetyMargin.count() << "," << frame->refreshDuration().count() << "," << (vrr ? 1 : 0) << "," << (tearing ? 1 : 0) << "," << frame->predictedRenderTime().count() << "," << lateFlipCompensation.count() << "," << (frame->cursorRendered() ? 1 : 0) << "," << (frame->contentRendered() ? 1 : 0) << "\n";
     }
 
     Q_ASSERT(pendingFrameCount > 0);
@@ -176,7 +178,20 @@ void RenderLoopPrivate::notifyFrameCompleted(std::chrono::nanoseconds timestamp,
 
     notifyVblank(timestamp);
 
-    if (renderTime) {
+    if (renderTime && !s_upstreamEstimate && frame && frame->onlyCursorRendered()) {
+        // The estimate is the smoothed render time plus twice the largest recent
+        // excess over it, remembered for seconds, and the next frames start that
+        // much earlier. While a client's buffers go straight to the screen a frame
+        // takes 0.1 ms; the frame for which the cursor is rendered, because its
+        // shape changed, counts as 2 ms at least, as anything rendered with OpenGL.
+        // One such frame takes the estimate from 0.2 to 4.7 ms: the compositor
+        // works two refreshes ahead for seconds, and the client's frames are shown
+        // a refresh later (key to screen with a fullscreen client on bare metal:
+        // 14.2 ms, and 18.4 ms when the pointer's shape changes with every key).
+        // The time it takes to render the cursor says nothing about the frames
+        // with content.
+        renderJournal.skip(timestamp);
+    } else if (renderTime) {
         // timings are pretty unpredictable in the sub-millisecond range; this minimum
         // ensures that when CPU or GPU power states change, we don't drop any frames
         const std::chrono::nanoseconds minimumTime = std::chrono::milliseconds(2);
