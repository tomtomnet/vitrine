+++ b/src/core/renderjournal.cpp
@@ -74,6 +74,11 @@ void RenderJournal::add(std::chrono::nanoseconds renderTime, std::chrono::nanose
     m_result = mix(renderTime, m_result, ratio);
 }
 
+void RenderJournal::skip(std::chrono::nanoseconds presentationTimestamp)
+{
+    add(m_result, presentationTimestamp);
+}
+
 std::chrono::nanoseconds RenderJournal::result() const
 {
     return m_result + m_variance * 2;
diff --git a/src/core/renderjournal.h b/src/core/renderjournal.h
