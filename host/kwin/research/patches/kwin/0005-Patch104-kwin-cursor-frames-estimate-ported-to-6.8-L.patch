+void OutputFrame::setCursorRendered()
+{
+    m_cursorRendered = true;
+}
+
+void OutputFrame::setContentRendered()
+{
+    m_contentRendered = true;
+}
+
+bool OutputFrame::onlyCursorRendered() const
+{
+    return m_cursorRendered && !m_contentRendered;
+}
+
+bool OutputFrame::cursorRendered() const
+{
+    return m_cursorRendered;
+}
+
+bool OutputFrame::contentRendered() const
+{
+    return m_contentRendered;
+}
+
 std::optional<double> OutputFrame::brightness() const
 {
