---
 src/backends/drm/drm_commit_thread.cpp | 12 ++++++++++--
 src/opengl/eglcontext.cpp              | 11 +++++++++--
 src/opengl/eglcontext.h                |  2 +-
 src/opengl/egldisplay.cpp              |  5 +++++
 src/opengl/egldisplay.h                |  1 +
 5 files changed, 26 insertions(+), 5 deletions(-)

diff --git a/src/backends/drm/drm_commit_thread.cpp b/src/backends/drm/drm_commit_thread.cpp
index 353104bf2f..e2802e348f 100644
--- a/src/backends/drm/drm_commit_thread.cpp
+++ b/src/backends/drm/drm_commit_thread.cpp
@@ -362,15 +362,23 @@ void DrmCommitThread::clearDroppedCommits()
 
 // TODO reduce the default for this, once we have a more accurate way to know when an atomic commit
 // is actually applied. Waiting for the commit returning seems to work on Intel and AMD, but not with NVidia
-static const std::chrono::microseconds s_safetyMarginMinimum{environmentVariableIntValue("KWIN_DRM_OVERRIDE_SAFETY_MARGIN").value_or(1000)};
+static const std::optional<int> s_safetyMarginOverride = environmentVariableIntValue("KWIN_DRM_OVERRIDE_SAFETY_MARGIN");
+static constexpr std::chrono::microseconds s_defaultSafetyMarginMinimum{1000};
+// In virtual machines, commits usually wait for the host to process the new frame,
+// which takes longer and varies more than with real hardware
+static constexpr std::chrono::microseconds s_virtualMachineSafetyMarginMinimum{2500};
 
 std::chrono::nanoseconds DrmCommitThread::setModeInfo(uint32_t maximum, std::chrono::nanoseconds vblankTime)
 {
     std::unique_lock lock(m_mutex);
     m_minVblankInterval = std::chrono::nanoseconds(1'000'000'000'000ull / maximum);
+    std::chrono::microseconds safetyMarginMinimum = m_gpu->drmDevice()->isVirtualMachine() ? s_virtualMachineSafetyMarginMinimum : s_defaultSafetyMarginMinimum;
+    if (s_safetyMarginOverride) {
+        safetyMarginMinimum = std::chrono::microseconds(*s_safetyMarginOverride);
+    }
     // the kernel rejects commits that happen during vblank
     // the 1.5ms on top of that was chosen experimentally, for the time it takes to commit + scheduling inaccuracies
-    m_baseSafetyMargin = vblankTime + s_safetyMarginMinimum;
+    m_baseSafetyMargin = vblankTime + safetyMarginMinimum;
     m_safetyMargin = m_baseSafetyMargin + m_additionalSafetyMargin;
     return m_safetyMargin;
 }
diff --git a/src/opengl/eglcontext.cpp b/src/opengl/eglcontext.cpp
index 210a939f0b..35afa92df0 100644
--- a/src/opengl/eglcontext.cpp
+++ b/src/opengl/eglcontext.cpp
@@ -79,7 +79,7 @@ EglContext::EglContext(EglDisplay *display, EGLConfig config, ::EGLContext conte
     , m_vendor((const char *)glGetString(GL_VENDOR))
     , m_renderer((const char *)glGetString(GL_RENDERER))
     , m_extensions(getExtensions(this))
-    , m_supportsTimerQueries(checkTimerQuerySupport())
+    , m_supportsTimerQueries(checkTimerQuerySupport(display))
     , m_supportsTextureStorage(hasVersion(Version(3, 0)) || hasOpenglExtension(QByteArrayLiteral("GL_EXT_texture_storage")))
     , m_supportsTextureSwizzle(hasVersion(Version(3, 0)))
     , m_supportsARGB32Textures(hasOpenglExtension(QByteArrayLiteral("GL_EXT_texture_format_BGRA8888")))
@@ -265,11 +265,18 @@ std::shared_ptr<GLTexture> EglContext::importDmaBufAsTexture(const DmaBufAttribu
     }
 }
 
-bool EglContext::checkTimerQuerySupport() const
+bool EglContext::checkTimerQuerySupport(EglDisplay *display) const
 {
     if (qEnvironmentVariableIsSet("KWIN_NO_TIMER_QUERY")) {
         return false;
     }
+    // With virtual GPUs, reading the GPU clock can be a synchronous round trip to the host
+    // (e.g. with virtio-gpu native contexts). That delays every frame, and the measured
+    // render times include the transport delays, so they are inflated. Without them,
+    // though, the estimate has no GPU time in it at all: KWIN_FORCE_TIMER_QUERY=1 keeps them
+    if (display->isVirtualMachine() && !qEnvironmentVariableIntValue("KWIN_FORCE_TIMER_QUERY")) {
+        return false;
+    }
     // 3.0 is required so query functions can be used without "EXT" suffix.
     // Timer queries are still not part of the core OpenGL ES specification.
     return openglVersion() >= Version(3, 0) && hasOpenglExtension("GL_EXT_disjoint_timer_query");
diff --git a/src/opengl/eglcontext.h b/src/opengl/eglcontext.h
index aff3cbb19d..b4797dd886 100644
--- a/src/opengl/eglcontext.h
+++ b/src/opengl/eglcontext.h
@@ -115,7 +115,7 @@ public:
 
 private:
     static ::EGLContext createContext(EglDisplay *display, EGLConfig config, ::EGLContext sharedContext);
-    bool checkTimerQuerySupport() const;
+    bool checkTimerQuerySupport(EglDisplay *display) const;
     void setShaderManager(ShaderManager *manager);
     void setStreamingBuffer(GLVertexBuffer *vbo);
     void setIndexBuffer(IndexBuffer *buffer);
diff --git a/src/opengl/egldisplay.cpp b/src/opengl/egldisplay.cpp
index 59c8a4d9a9..7bf6539c8f 100644
--- a/src/opengl/egldisplay.cpp
+++ b/src/opengl/egldisplay.cpp
@@ -227,6 +227,11 @@ bool EglDisplay::isSoftwareRenderer() const
     return m_isSoftwareRenderer;
 }
 
+bool EglDisplay::isVirtualMachine() const
+{
+    return m_drmDevice && m_drmDevice->isVirtualMachine();
+}
+
 EGLImageKHR EglDisplay::importDmaBufAsImage(const DmaBufAttributes &dmabuf,
                                             YUVMatrixCoefficients coefficients,
                                             EncodingRange range) const
diff --git a/src/opengl/egldisplay.h b/src/opengl/egldisplay.h
index cdfcbbd25e..62ff36bddc 100644
--- a/src/opengl/egldisplay.h
+++ b/src/opengl/egldisplay.h
@@ -44,6 +44,7 @@ public:
     std::optional<dev_t> renderDevNode() const;
 
     bool isSoftwareRenderer() const;
+    bool isVirtualMachine() const;
     bool supportsBufferAge() const;
     bool supportsNativeFence() const;
 
