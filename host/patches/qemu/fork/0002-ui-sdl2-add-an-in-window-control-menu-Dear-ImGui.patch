diff --git a/subprojects/packagefiles/imgui/imgui_impl_opengl3_epoxy.cpp b/subprojects/packagefiles/imgui/imgui_impl_opengl3_epoxy.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..6495aa2c1cf5e3180d79260cf2e1f4065e75b947
--- /dev/null
+++ b/subprojects/packagefiles/imgui/imgui_impl_opengl3_epoxy.cpp
@@ -0,0 +1,8 @@
+/*
+ * Build the OpenGL 3 renderer backend on top of libepoxy instead of its
+ * bundled loader, so that it shares QEMU's GL dispatch.  The backend detects
+ * GLES 3 contexts at runtime, so this works for both desktop GL and GLES.
+ */
+#include <epoxy/gl.h>
+#define IMGUI_IMPL_OPENGL_LOADER_CUSTOM
+#include "backends/imgui_impl_opengl3.cpp"
diff --git a/subprojects/packagefiles/imgui/meson.build b/subprojects/packagefiles/imgui/meson.build
new file mode 100644
index 0000000000000000000000000000000000000000..1893d44404257258a4c1d2f47a2c6a285e35627f
--- /dev/null
+++ b/subprojects/packagefiles/imgui/meson.build
@@ -0,0 +1,38 @@
+project('imgui', 'cpp',
+  version: '1.92.9',
+  license: 'MIT',
+  meson_version: '>=1.6.0',
+  default_options: ['cpp_std=c++17', 'warning_level=0'])
+
+sdl2_dep = dependency('sdl2')
+epoxy_dep = dependency('epoxy', required: get_option('opengl'))
+
+imgui_args = ['-DIMGUI_DISABLE_OBSOLETE_FUNCTIONS', '-DIMGUI_DISABLE_DEMO_WINDOWS']
+
+imgui_sources = files(
+  'imgui.cpp',
+  'imgui_demo.cpp',
+  'imgui_draw.cpp',
+  'imgui_tables.cpp',
+  'imgui_widgets.cpp',
+  'backends/imgui_impl_sdl2.cpp',
+  'backends/imgui_impl_sdlrenderer2.cpp',
+)
+imgui_deps = [sdl2_dep]
+if epoxy_dep.found()
+  imgui_sources += files('imgui_impl_opengl3_epoxy.cpp')
+  imgui_deps += epoxy_dep
+endif
+
+# pic: the SDL display may be built as a loadable module
+imgui_lib = static_library('imgui', imgui_sources,
+  cpp_args: imgui_args,
+  include_directories: include_directories('.', 'backends'),
+  dependencies: imgui_deps,
+  pic: true)
+
+imgui_dep = declare_dependency(
+  link_with: imgui_lib,
+  compile_args: imgui_args,
+  include_directories: include_directories('.', 'backends', is_system: true),
+  dependencies: imgui_deps)
