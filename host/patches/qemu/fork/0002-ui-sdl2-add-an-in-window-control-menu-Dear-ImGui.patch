+static std::string format_date(int64_t date)
+{
+    GDateTime *dt = g_date_time_new_from_unix_local(date);
+    char *str = dt ? g_date_time_format(dt, "%Y-%m-%d %H:%M") : nullptr;
+    std::string res = str ? str : "?";
+
+    g_free(str);
+    if (dt) {
+        g_date_time_unref(dt);
+    }
+    return res;
+}
