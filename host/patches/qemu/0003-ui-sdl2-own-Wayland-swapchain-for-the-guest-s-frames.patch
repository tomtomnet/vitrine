+#define SDL_PRESENTS_FIRST 2
+/* the guest's damage of the last presents, for buffers up to this old */
+#define DAMAGE_HISTORY 8
+
+typedef struct SwapRect {
+    int x, y, w, h;         /* w or h 0: empty */
+} SwapRect;
+
+typedef struct SwapBuffer {
+    struct gbm_bo *bo;
+    struct wl_buffer *buffer;
+    QemuDmaBuf *dmabuf;
+    egl_fb fb;
+    bool busy;              /* with the compositor */
+    bool ever;              /* attached once: released events tell */
+    uint64_t frame;         /* the present it was last filled for, 0: never */
+    uint64_t epoch;         /* the layout it was filled with */
+    SwapRect gui;           /* where the menu painted over the guest in it */
+} SwapBuffer;
+
+typedef struct GuestBuffer GuestBuffer;
+
+struct sdl2_swapchain {
+    struct sdl2_console *scon;
+    struct wl_display *display;
+    struct wl_event_queue *queue;
+    struct wl_surface *surface;
+    struct zwp_linux_dmabuf_v1 *dmabuf;
+    struct zwp_linux_dmabuf_feedback_v1 *feedback;
+    /* the compositor's format table, and the modifiers for our format */
+    void *table;
+    size_t table_size;
+    uint64_t modifiers[MAX_MODIFIERS];
+    int n_modifiers;
+    uint64_t tranche[MAX_MODIFIERS];
+    int n_tranche;
+    bool tranche_scanout;
+    bool chosen_scanout;
+    bool feedback_done;
+    bool feedback_changed;
+    struct gbm_device *gbm;
+    int drm_fd;
+    SwapBuffer bufs[SWAPCHAIN_BUFFERS];
+    int width, height;
+    int presents;
+    bool failed;
+    /* partial copies: the presents, the guest damage of each, the layout */
+    uint64_t frame;
+    SwapRect history[DAMAGE_HISTORY];
+    uint64_t epoch;
+    int layout_menu_top, layout_w, layout_h;
+    bool layout_flip;
+    uint64_t guest_presents;    /* zero-copy presents, for the buffers' age */
+    GuestBuffer *guest_current; /* the guest buffer on the surface */
+    GuestBuffer *guest_awaited; /* the one whose release completes the flush */
+    /* direct scanout or not: how many buffers the compositor keeps */
+    int64_t committed_ns;   /* the last commit */
+    int in_a_row;           /* commits within a refresh and a half of the last */
+    uint8_t held_votes;     /* one bit per recent commit: two buffers held */
+    int n_votes;
+};
+
+/* --- the compositor's formats -------------------------------------------- */
+
+static void feedback_done(void *data, struct zwp_linux_dmabuf_feedback_v1 *fb)
+{
+    struct sdl2_swapchain *sc = data;
+
+    sc->feedback_done = true;
+    if (sc->n_modifiers) {
+        sc->feedback_changed = true;
+    }
+}
+
+static void feedback_format_table(void *data,
+                                  struct zwp_linux_dmabuf_feedback_v1 *fb,
+                                  int32_t fd, uint32_t size)
+{
+    struct sdl2_swapchain *sc = data;
+
+    if (sc->table) {
+        munmap(sc->table, sc->table_size);
+        sc->table = NULL;
+    }
+    sc->table = mmap(NULL, size, PROT_READ, MAP_PRIVATE, fd, 0);
+    if (sc->table == MAP_FAILED) {
+        sc->table = NULL;
+    }
+    sc->table_size = size;
+    close(fd);
+}
+
+static void feedback_main_device(void *data,
+                                 struct zwp_linux_dmabuf_feedback_v1 *fb,
+                                 struct wl_array *device)
+{
+}
+
+static void feedback_tranche_done(void *data,
+                                  struct zwp_linux_dmabuf_feedback_v1 *fb)
+{
+    struct sdl2_swapchain *sc = data;
+
+    /* the scanout tranche wins; else the first with our format */
+    if (sc->n_tranche &&
+        (!sc->n_modifiers || (sc->tranche_scanout && !sc->chosen_scanout))) {
+        memcpy(sc->modifiers, sc->tranche, sc->n_tranche * sizeof(uint64_t));
+        sc->n_modifiers = sc->n_tranche;
+        sc->chosen_scanout = sc->tranche_scanout;
+    }
+    sc->n_tranche = 0;
+    sc->tranche_scanout = false;
+}
+
+static void feedback_tranche_target_device(void *data,
+                                           struct zwp_linux_dmabuf_feedback_v1 *fb,
+                                           struct wl_array *device)
+{
+}
+
+static void feedback_tranche_formats(void *data,
+                                     struct zwp_linux_dmabuf_feedback_v1 *fb,
+                                     struct wl_array *indices)
+{
+    struct sdl2_swapchain *sc = data;
+    const uint16_t *idx;
+    struct {
+        uint32_t format;
+        uint32_t pad;
+        uint64_t modifier;
+    } *entries = sc->table;
+    size_t n = sc->table ? sc->table_size / sizeof(*entries) : 0;
+
+    sc->n_tranche = 0;
+    if (!entries) {
+        return;
+    }
+    wl_array_for_each(idx, indices) {
+        if (*idx < n && entries[*idx].format == SWAPCHAIN_FORMAT &&
+            sc->n_tranche < MAX_MODIFIERS) {
+            sc->tranche[sc->n_tranche++] = entries[*idx].modifier;
+        }
+    }
+}
+
+static void feedback_tranche_flags(void *data,
+                                   struct zwp_linux_dmabuf_feedback_v1 *fb,
+                                   uint32_t flags)
+{
+    struct sdl2_swapchain *sc = data;
+
+    sc->tranche_scanout = flags & ZWP_LINUX_DMABUF_FEEDBACK_V1_TRANCHE_FLAGS_SCANOUT;
+}
+
+static const struct zwp_linux_dmabuf_feedback_v1_listener feedback_listener = {
+    .done = feedback_done,
+    .format_table = feedback_format_table,
+    .main_device = feedback_main_device,
+    .tranche_done = feedback_tranche_done,
+    .tranche_target_device = feedback_tranche_target_device,
+    .tranche_formats = feedback_tranche_formats,
+    .tranche_flags = feedback_tranche_flags,
+};
+
+static void registry_global(void *data, struct wl_registry *registry,
+                            uint32_t name, const char *interface,
+                            uint32_t version)
+{
+    struct sdl2_swapchain *sc = data;
+
+    if (!strcmp(interface, zwp_linux_dmabuf_v1_interface.name) && version >= 4) {
+        sc->dmabuf = wl_registry_bind(registry, name,
+                                      &zwp_linux_dmabuf_v1_interface, 4);
+    }
+}
+
+static void registry_global_remove(void *data, struct wl_registry *registry,
+                                   uint32_t name)
+{
+}
+
+static const struct wl_registry_listener registry_listener = {
+    .global = registry_global,
+    .global_remove = registry_global_remove,
+};
+
+/* --- the buffers ---------------------------------------------------------- */
+
+static void buffer_release(void *data, struct wl_buffer *buffer)
+{
+    SwapBuffer *b = data;
+
+    b->busy = false;
+}
+
+static const struct wl_buffer_listener buffer_listener = {
+    .release = buffer_release,
+};
+
+static void buffer_destroy(SwapBuffer *b)
+{
+    if (b->buffer) {
+        wl_buffer_destroy(b->buffer);
+        b->buffer = NULL;
+    }
+    if (b->dmabuf) {
+        egl_fb_destroy(&b->fb);
+        egl_dmabuf_release_texture(b->dmabuf);
+        for (int i = 0; i < 4; i++) {
+            int fd = qemu_dmabuf_get_fds(b->dmabuf, NULL)[i];
+
+            if (fd >= 0) {
+                close(fd);
+            }
+        }
+        qemu_dmabuf_free(b->dmabuf);
+        b->dmabuf = NULL;
+    }
+    if (b->bo) {
+        gbm_bo_destroy(b->bo);
+        b->bo = NULL;
+    }
+    b->busy = false;
+    b->ever = false;
+}
+
+static bool buffer_create(struct sdl2_swapchain *sc, SwapBuffer *b,
+                          int width, int height)
+{
+    struct zwp_linux_buffer_params_v1 *params;
+    uint64_t modifier;
+    uint32_t offsets[4] = {}, strides[4] = {};
+    int32_t fds[4] = { -1, -1, -1, -1 };
+    int planes, i;
+
+    b->bo = gbm_bo_create_with_modifiers2(sc->gbm, width, height,
+                                          SWAPCHAIN_FORMAT, sc->modifiers,
+                                          sc->n_modifiers,
+                                          GBM_BO_USE_RENDERING | GBM_BO_USE_SCANOUT);
+    if (!b->bo) {
+        b->bo = gbm_bo_create(sc->gbm, width, height, SWAPCHAIN_FORMAT,
+                              GBM_BO_USE_RENDERING | GBM_BO_USE_SCANOUT |
+                              GBM_BO_USE_LINEAR);
+        if (!b->bo) {
+            error_report("sdl2 swapchain: no GBM buffer of %dx%d", width, height);
+            return false;
+        }
+    }
+    modifier = gbm_bo_get_modifier(b->bo);
+    planes = gbm_bo_get_plane_count(b->bo);
+    if (planes > 4) {
+        planes = 4;
+    }
+    params = zwp_linux_dmabuf_v1_create_params(sc->dmabuf);
+    for (i = 0; i < planes; i++) {
+        fds[i] = gbm_bo_get_fd_for_plane(b->bo, i);
+        offsets[i] = gbm_bo_get_offset(b->bo, i);
+        strides[i] = gbm_bo_get_stride_for_plane(b->bo, i);
+        if (fds[i] < 0) {
+            error_report("sdl2 swapchain: no fd for plane %d", i);
+            zwp_linux_buffer_params_v1_destroy(params);
+            goto fail;
+        }
+        zwp_linux_buffer_params_v1_add(params, fds[i], i, offsets[i], strides[i],
+                                       modifier >> 32, modifier & 0xffffffff);
+    }
+    b->buffer = zwp_linux_buffer_params_v1_create_immed(params, width, height,
+                                                        SWAPCHAIN_FORMAT, 0);
+    zwp_linux_buffer_params_v1_destroy(params);
+    wl_buffer_add_listener(b->buffer, &buffer_listener, b);
+
+    /* the same buffer as a GL framebuffer, to blit the guest into */
+    b->dmabuf = qemu_dmabuf_new(width, height, offsets, strides, 0, 0,
+                                width, height, SWAPCHAIN_FORMAT, modifier,
+                                fds, planes, false, false);
+    egl_dmabuf_import_texture(b->dmabuf);
+    if (!qemu_dmabuf_get_texture(b->dmabuf)) {
+        error_report("sdl2 swapchain: the buffer does not import into EGL");
+        goto fail;
+    }
+    egl_fb_setup_for_tex(&b->fb, width, height,
+                         qemu_dmabuf_get_texture(b->dmabuf), false);
+    return true;
+
+fail:
+    for (i = 0; i < planes; i++) {
+        if (fds[i] >= 0 && !b->dmabuf) {
+            close(fds[i]);
+        }
+    }
+    buffer_destroy(b);
+    return false;
+}
+
+static void buffers_destroy(struct sdl2_swapchain *sc)
+{
+    int i;
+
+    for (i = 0; i < SWAPCHAIN_BUFFERS; i++) {
+        buffer_destroy(&sc->bufs[i]);
+    }
+    sc->width = sc->height = 0;
+}
+
+static bool buffers_create(struct sdl2_swapchain *sc, int width, int height)
+{
+    int i;
+
+    buffers_destroy(sc);
+    for (i = 0; i < SWAPCHAIN_BUFFERS; i++) {
+        if (!buffer_create(sc, &sc->bufs[i], width, height)) {
+            buffers_destroy(sc);
+            return false;
+        }
+    }
+    sc->width = width;
+    sc->height = height;
+    sc->feedback_changed = false;
+    for (i = 0; i < SWAPCHAIN_BUFFERS; i++) {
+        sc->bufs[i].frame = 0;
+        sc->bufs[i].gui = (SwapRect) { 0 };
+    }
+    return true;
+}
+
+/* --- setup ---------------------------------------------------------------- */
+
+static bool swapchain_init(struct sdl2_swapchain *sc)
+{
+    SDL_SysWMinfo info;
+    struct wl_display *wrapper;
+    struct wl_registry *registry;
+    EGLDeviceEXT device = EGL_NO_DEVICE_EXT;
+    const char *node;
+
+    SDL_VERSION(&info.version);
+    if (!SDL_GetWindowWMInfo(sc->scon->real_window, &info) ||
+        info.subsystem != SDL_SYSWM_WAYLAND) {
+        return false;
+    }
+    sc->display = info.info.wl.display;
+    sc->surface = info.info.wl.surface;
+
+    /* the render device of the EGL display: the buffers come from it */
+    if (!epoxy_has_egl_extension(qemu_egl_display, "EGL_EXT_device_query") ||
+        !eglQueryDisplayAttribEXT(qemu_egl_display, EGL_DEVICE_EXT,
+                                  (EGLAttrib *)&device) ||
+        device == EGL_NO_DEVICE_EXT) {
+        error_report("sdl2 swapchain: no EGL device");
+        return false;
+    }
+    node = eglQueryDeviceStringEXT(device, EGL_DRM_RENDER_NODE_FILE_EXT);
+    if (!node) {
+        node = eglQueryDeviceStringEXT(device, EGL_DRM_DEVICE_FILE_EXT);
+    }
+    if (!node) {
+        error_report("sdl2 swapchain: the EGL device has no DRM node");
+        return false;
+    }
+    sc->drm_fd = open(node, O_RDWR | O_CLOEXEC);
+    if (sc->drm_fd < 0) {
+        error_report("sdl2 swapchain: %s: %s", node, strerror(errno));
+        return false;
+    }
+    sc->gbm = gbm_create_device(sc->drm_fd);
+    if (!sc->gbm) {
+        error_report("sdl2 swapchain: no GBM device on %s", node);
+        return false;
+    }
+
+    sc->queue = wl_display_create_queue(sc->display);
+    wrapper = wl_proxy_create_wrapper(sc->display);
+    wl_proxy_set_queue((struct wl_proxy *)wrapper, sc->queue);
+    registry = wl_display_get_registry(wrapper);
+    wl_registry_add_listener(registry, &registry_listener, sc);
+    wl_display_roundtrip_queue(sc->display, sc->queue);
+    wl_registry_destroy(registry);
+    wl_proxy_wrapper_destroy(wrapper);
+    if (!sc->dmabuf) {
+        error_report("sdl2 swapchain: no linux-dmabuf v4");
+        return false;
+    }
+    sc->feedback = zwp_linux_dmabuf_v1_get_surface_feedback(sc->dmabuf,
+                                                            sc->surface);
+    zwp_linux_dmabuf_feedback_v1_add_listener(sc->feedback, &feedback_listener,
+                                              sc);
+    wl_display_roundtrip_queue(sc->display, sc->queue);
+    if (!sc->feedback_done || !sc->n_modifiers) {
+        error_report("sdl2 swapchain: the compositor offers no modifier for XRGB8888");
+        return false;
+    }
+    sc->feedback_changed = false;
+    trace_sdl2_swapchain_init(sc->scon->idx, node, sc->n_modifiers,
+                              sc->chosen_scanout);
+    return true;
+}
+
+/*
+ * Whether the host's compositor puts the window's buffers straight on the
+ * display plane.  It does not tell: KWin's presentation feedback never says
+ * zero-copy, and its scanout tranche only comes when a buffer failed its
+ * checks.  What shows it is how long it keeps a buffer.  On the display
+ * plane a buffer stays with the compositor until the flip away from it, so
+ * between two frames of a burst it holds two of ours: the one on the screen
+ * and the one waiting for the next flip.  Composited, it releases a buffer
+ * as soon as it rendered from the next one, before that one's vblank, so
+ * when the next frame comes it holds one.  Counted from the third frame of
+ * a run of frames each within a refresh and a half of the previous (the
+ * second may find the first already flipped and the older buffer long
+ * released), after reading the releases.
+ */
+static void swapchain_vote(struct sdl2_swapchain *sc, int64_t now)
+{
+    int64_t gap = sc->scon->refresh_rate ?
+        1500LL * NANOSECONDS_PER_SECOND / sc->scon->refresh_rate :
+        25 * SCALE_MS;
+    int i, held = 0;
+
+    if (sc->committed_ns && now - sc->committed_ns < gap) {
+        sc->in_a_row++;
+    } else {
+        sc->in_a_row = 0;
+    }
+    sc->committed_ns = now;
+    if (sc->in_a_row < 2) {
+        return;
+    }
+    for (i = 0; i < SWAPCHAIN_BUFFERS; i++) {
+        held += sc->bufs[i].busy;
+    }
+    sc->held_votes = sc->held_votes << 1 | (held >= 2);
+    sc->n_votes = MIN(sc->n_votes + 1, 8);
+}
+
+static struct sdl2_swapchain *swapchain_get(struct sdl2_console *scon);
+
+/* --- the guest's own buffer on the surface (zero copy) -------------------- */
+
+/*
+ * QEMU_SDL_ZERO_COPY=1: the guest's scanout buffer is attached to the
+ * surface as it is, instead of being blitted into a buffer of ours.  Its
+ * dmabuf is the one QEMU imports as the scanout texture; a wl_buffer is
+ * made for it once (the guest rotates a few) and kept, the fds dup'd, until
+ * the guest drops the buffer and the compositor released it.  Only for a
+ * buffer of the window's size with no menu bar docked over it (the bar
+ * cannot be drawn into the guest's buffer).
+ *
+ * Caveat of this first version: the guest's flip completes at QEMU's tick,
+ * before the host's vblank, so the guest may render into a buffer the host
+ * still shows (see research/zero-copy-scanout-plan.md).
+ */
+#define GUEST_BUFFERS 8
+
+struct GuestBuffer {
+    ino_t ino;                  /* the dmabuf's inode: the same buffer whatever handle QEMU has */
+    struct sdl2_swapchain *sc;
+    struct wl_buffer *buffer;
+    int fds[4];
+    int planes;
+    uint32_t width, height;
+    uint64_t used;              /* the present that last used it */
+    bool busy;                  /* with the compositor */
+    bool dropped;               /* replaced: freed once the compositor released it */
+};
+
+static GuestBuffer guest_bufs[GUEST_BUFFERS];
+
+static bool zero_copy_wanted(void)
+{
+    static int wanted = -1;
+
+    if (wanted < 0) {
+        wanted = !!getenv("QEMU_SDL_ZERO_COPY");
+    }
+    return wanted;
+}
+
+static void guest_buffer_free(GuestBuffer *gb)
+{
+    struct sdl2_swapchain *sc = gb->sc;
+    int i;
+
+    if (sc) {
+        if (sc->guest_awaited == gb) {
+            sc->guest_awaited = NULL;
+            graphic_hw_gl_flush_done(sc->scon->dcl.con);
+        }
+        if (sc->guest_current == gb) {
+            sc->guest_current = NULL;
+        }
+    }
+    if (gb->buffer) {
+        wl_buffer_destroy(gb->buffer);
+    }
+    for (i = 0; i < gb->planes; i++) {
+        if (gb->fds[i] >= 0) {
+            close(gb->fds[i]);
+        }
+    }
+    memset(gb, 0, sizeof(*gb));
+}
+
+static void guest_buffer_release(void *data, struct wl_buffer *buffer)
+{
+    GuestBuffer *gb = data;
+    struct sdl2_swapchain *sc = gb->sc;
+
+    gb->busy = false;
+    if (sc && sc->guest_awaited == gb) {
+        /* the guest's flush is complete: it may render into this one again */
+        sc->guest_awaited = NULL;
+        graphic_hw_gl_flush_done(sc->scon->dcl.con);
+    }
+    if (gb->dropped) {
+        guest_buffer_free(gb);
+    }
+}
+
+static const struct wl_buffer_listener guest_buffer_listener = {
+    .release = guest_buffer_release,
+};
+
+static GuestBuffer *guest_buffer_get(struct sdl2_swapchain *sc, QemuDmaBuf *dmabuf)
+{
+    struct zwp_linux_buffer_params_v1 *params;
+    GuestBuffer *gb = NULL;
+    const int *fds;
+    const uint32_t *offsets, *strides;
+    uint64_t modifier;
+    struct stat st;
+    int i, planes;
+
+    planes = qemu_dmabuf_get_num_planes(dmabuf);
+    fds = qemu_dmabuf_get_fds(dmabuf, NULL);
+    offsets = qemu_dmabuf_get_offsets(dmabuf, NULL);
+    strides = qemu_dmabuf_get_strides(dmabuf, NULL);
+    modifier = qemu_dmabuf_get_modifier(dmabuf);
+    if (planes < 1 || planes > 4 || !fds || !offsets || !strides ||
+        fstat(fds[0], &st) < 0) {
+        return NULL;
+    }
+    for (i = 0; i < GUEST_BUFFERS; i++) {
+        if (guest_bufs[i].buffer && guest_bufs[i].ino == st.st_ino &&
+            !guest_bufs[i].dropped) {
+            return &guest_bufs[i];
+        }
+    }
+    /* a free slot, else the one used longest ago that the compositor does not hold */
+    for (i = 0; i < GUEST_BUFFERS; i++) {
+        if (!guest_bufs[i].buffer) {
+            gb = &guest_bufs[i];
+            break;
+        }
+        if (!guest_bufs[i].busy && (!gb || guest_bufs[i].used < gb->used)) {
+            gb = &guest_bufs[i];
+        }
+    }
+    if (!gb) {
+        return NULL;
+    }
+    if (gb->buffer) {
+        guest_buffer_free(gb);
+    }
+    memset(gb, 0, sizeof(*gb));
+    gb->ino = st.st_ino;
+    gb->sc = sc;
+    /*
+     * virtio-gpu's scanout commands carry no modifier and QEMU says
+     * "invalid", which the compositor cannot scan out (it needs to know the
+     * layout).  The guest's display plane offers linear only, so that is
+     * what its scanout buffers are.
+     */
+    if (modifier == DRM_FORMAT_MOD_INVALID) {
+        modifier = DRM_FORMAT_MOD_LINEAR;
+    }
+    for (i = 0; i < 4; i++) {
+        gb->fds[i] = -1;
+    }
+    params = zwp_linux_dmabuf_v1_create_params(sc->dmabuf);
+    for (i = 0; i < planes; i++) {
+        gb->fds[i] = fcntl(fds[i], F_DUPFD_CLOEXEC, 0);
+        if (gb->fds[i] < 0) {
+            zwp_linux_buffer_params_v1_destroy(params);
+            gb->planes = i;
+            guest_buffer_free(gb);
+            return NULL;
+        }
+        zwp_linux_buffer_params_v1_add(params, gb->fds[i], i, offsets[i],
+                                       strides[i], modifier >> 32,
+                                       modifier & 0xffffffff);
+    }
+    gb->planes = planes;
+    gb->width = qemu_dmabuf_get_backing_width(dmabuf);
+    gb->height = qemu_dmabuf_get_backing_height(dmabuf);
+    gb->buffer = zwp_linux_buffer_params_v1_create_immed(params, gb->width,
+                                                         gb->height,
+                                                         qemu_dmabuf_get_fourcc(dmabuf),
+                                                         0);
+    zwp_linux_buffer_params_v1_destroy(params);
+    wl_buffer_add_listener(gb->buffer, &guest_buffer_listener, gb);
+    trace_sdl2_swapchain_guest_buffer(sc->scon->idx, gb->width, gb->height,
+                                      qemu_dmabuf_get_fourcc(dmabuf), modifier);
+    return gb;
+}
+
+bool sdl2_swapchain_present_guest(struct sdl2_console *scon, int width,
+                                  int height, QemuDmaBuf *dmabuf,
+                                  int x, int y, int w, int h)
+{
+    struct sdl2_swapchain *sc;
+    GuestBuffer *gb;
+
+    if (!zero_copy_wanted() || !dmabuf) {
+        return false;
+    }
+    sc = swapchain_get(scon);
+    if (!sc || sc->presents < SDL_PRESENTS_FIRST) {
+        return false;   /* SDL maps the window with its first swaps */
+    }
+    if (qemu_dmabuf_get_backing_width(dmabuf) != width ||
+        qemu_dmabuf_get_backing_height(dmabuf) != height ||
+        qemu_dmabuf_get_fourcc(dmabuf) != SWAPCHAIN_FORMAT) {
+        return false;
+    }
+    /* the compositor's releases, for the buffers the guest dropped */
+    wl_display_dispatch_queue_pending(sc->display, sc->queue);
+    gb = guest_buffer_get(sc, dmabuf);
+    if (!gb) {
+        return false;
+    }
+    sdl2_stats_present_begin(scon);
+    wl_surface_attach(sc->surface, gb->buffer, 0, 0);
+    wl_surface_damage_buffer(sc->surface, x, y, w, h);
+    wl_surface_commit(sc->surface);
+    wl_display_flush(sc->display);
+    gb->busy = true;
+    gb->used = ++sc->guest_presents;
+    /*
+     * The buffer shown before this one is with the compositor until it
+     * flipped to this one: the guest's flush completes with its release
+     */
+    if (sc->guest_current && sc->guest_current != gb &&
+        sc->guest_current->busy) {
+        sc->guest_awaited = sc->guest_current;
+        graphic_hw_gl_flush_pending(scon->dcl.con);
+    } else {
+        sc->guest_awaited = NULL;
+    }
+    sc->guest_current = gb;
+    trace_sdl2_swapchain_guest_present(scon->idx, (uint64_t)gb->ino,
+                                       sc->guest_awaited != NULL);
+    sdl2_stats_present_end(scon);
+    return true;
+}
+
+/* The compositor's events for the window's own buffers, as they come */
+void sdl2_swapchain_dispatch(struct sdl2_console *scon)
+{
+    struct sdl2_swapchain *sc = scon->swapchain;
+
+    if (sc && !sc->failed && sc->queue) {
+        wl_display_dispatch_queue_pending(sc->display, sc->queue);
+    }
+}
+
+/*
+ * QEMU dropped a handle on a guest buffer: nothing to do, the buffer is
+ * known by its inode and kept (with its own fds) until it is replaced.
+ */
+void sdl2_swapchain_guest_released(struct sdl2_console *scon, QemuDmaBuf *dmabuf)
+{
+}
+
+int sdl2_swapchain_scanout(struct sdl2_console *scon)
+{
+    struct sdl2_swapchain *sc = scon->swapchain;
+    int i, yes = 0;
+
+    if (!sc || sc->failed || !sc->width || sc->n_votes < 4) {
+        return -1;      /* no buffers of our own, or no burst seen yet */
+    }
+    for (i = 0; i < sc->n_votes; i++) {
+        yes += sc->held_votes >> i & 1;
+    }
+    return yes * 2 > sc->n_votes;
+}
+
+void sdl2_swapchain_destroy(struct sdl2_console *scon)
+{
+    struct sdl2_swapchain *sc = scon->swapchain;
+
+    if (!sc) {
+        return;
+    }
+    scon->swapchain = NULL;
+    buffers_destroy(sc);
+    if (sc->feedback) {
+        zwp_linux_dmabuf_feedback_v1_destroy(sc->feedback);
+    }
+    if (sc->dmabuf) {
+        zwp_linux_dmabuf_v1_destroy(sc->dmabuf);
+    }
+    if (sc->table) {
+        munmap(sc->table, sc->table_size);
+    }
+    if (sc->queue) {
+        wl_display_dispatch_queue_pending(sc->display, sc->queue);
+        wl_event_queue_destroy(sc->queue);
+    }
+    if (sc->gbm) {
+        gbm_device_destroy(sc->gbm);
+    }
+    if (sc->drm_fd >= 0) {
+        close(sc->drm_fd);
+    }
+    g_free(sc);
+}
+
+static struct sdl2_swapchain *swapchain_get(struct sdl2_console *scon)
+{
+    struct sdl2_swapchain *sc = scon->swapchain;
+
+    if (sc) {
+        return sc->failed ? NULL : sc;
+    }
+    sc = g_new0(struct sdl2_swapchain, 1);
+    sc->scon = scon;
+    sc->drm_fd = -1;
+    scon->swapchain = sc;
+    if (getenv("QEMU_SDL_NO_SWAPCHAIN") || !swapchain_init(sc)) {
+        sc->failed = true;
+        return NULL;
+    }
+    return sc;
+}
+
+/* --- a frame -------------------------------------------------------------- */
+
+static bool rect_empty(const SwapRect *r)
+{
+    return r->w <= 0 || r->h <= 0;
+}
+
+static void rect_union(SwapRect *a, const SwapRect *b)
+{
+    int x1, y1;
+
+    if (rect_empty(b)) {
+        return;
+    }
+    if (rect_empty(a)) {
+        *a = *b;
+        return;
+    }
+    x1 = MAX(a->x + a->w, b->x + b->w);
+    y1 = MAX(a->y + a->h, b->y + b->h);
+    a->x = MIN(a->x, b->x);
+    a->y = MIN(a->y, b->y);
+    a->w = x1 - a->x;
+    a->h = y1 - a->y;
+}
+
+/* to the rectangle (0, 0, w, h) */
+static void rect_clip(SwapRect *r, int w, int h)
+{
+    int x1 = MIN(r->x + r->w, w), y1 = MIN(r->y + r->h, h);
+
+    r->x = MAX(r->x, 0);
+    r->y = MAX(r->y, 0);
+    r->w = x1 - r->x;
+    r->h = y1 - r->y;
+    if (rect_empty(r)) {
+        *r = (SwapRect) { 0 };
+    }
+}
+
+/*
+ * The rectangle @r of the guest's frame (rows from its top, as its flushes
+ * give them) into the same place below the menu bar, 1:1 and without a
+ * clear: the rest of the buffer keeps what it had.  The same mapping as
+ * egl_fb_blit() into (0, menu_top) - the buffer's first row is the top of
+ * the image, the guest's frame is read upside down if @flip.
+ */
+static void blit_rect(egl_fb *dst, egl_fb *src, bool flip, int menu_top,
+                      int src_h, const SwapRect *r)
+{
+    int sy0 = flip ? src_h - r->y : r->y;
+    int sy1 = flip ? src_h - r->y - r->h : r->y + r->h;
+
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, src->framebuffer);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, dst->framebuffer);
+    glBlitFramebuffer(r->x, sy0, r->x + r->w, sy1,
+                      r->x, menu_top + r->y, r->x + r->w, menu_top + r->y + r->h,
+                      GL_COLOR_BUFFER_BIT, GL_NEAREST);
+}
+
+static SwapBuffer *swapchain_free_buffer(struct sdl2_swapchain *sc)
+{
+    int i, tries;
+
+    for (tries = 0; tries < 2; tries++) {
+        wl_display_dispatch_queue_pending(sc->display, sc->queue);
+        for (i = 0; i < SWAPCHAIN_BUFFERS; i++) {
+            if (!sc->bufs[i].busy) {
+                return &sc->bufs[i];
+            }
+        }
+        /* the compositor may have released one we did not read yet */
+        sdl2_stats_read_wayland();
+    }
+    return NULL;
+}
+
+/*
+ * QEMU_SDL_COPY_VERIFY=N, for checking only: every N-th partial copy, the
+ * buffer is compared with a full copy of the guest's frame (both read back:
+ * tens of ms), and the pixels the partial copies left stale are traced.
+ */
+static void swapchain_verify(struct sdl2_console *scon, SwapBuffer *b, egl_fb *guest,
+                             bool flip, int menu_top, int gw, int gh)
+{
+    static int every = -1, count;
+    static egl_fb scratch;
+    static uint32_t *want, *have;
+    int x0 = gw, y0 = gh, x1 = -1, y1 = -1, x, y;
+    long stale = 0;
+
+    if (every < 0) {
+        const char *e = getenv("QEMU_SDL_COPY_VERIFY");
+
+        every = e ? atoi(e) : 0;
+    }
+    if (every <= 0 || ++count % every) {
+        return;
+    }
+    if (scratch.width != gw || scratch.height != gh + menu_top) {
+        egl_fb_destroy(&scratch);
+        egl_fb_setup_new_tex(&scratch, gw, gh + menu_top);
+        g_free(want);
+        g_free(have);
+        want = g_new(uint32_t, (size_t)gw * gh);
+        have = g_new(uint32_t, (size_t)gw * gh);
+    }
+    /* the full copy, as the full path makes it */
+    scratch.y = menu_top;
+    scratch.height = gh;
+    egl_fb_blit(&scratch, guest, flip);
+    scratch.y = 0;
+    scratch.height = gh + menu_top;
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, scratch.framebuffer);
+    glReadPixels(0, menu_top, gw, gh, GL_BGRA, GL_UNSIGNED_BYTE, want);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, b->fb.framebuffer);
+    glReadPixels(0, menu_top, gw, gh, GL_BGRA, GL_UNSIGNED_BYTE, have);
+    for (y = 0; y < gh; y++) {
+        const uint32_t *w = want + (size_t)y * gw, *h = have + (size_t)y * gw;
+
+        for (x = 0; x < gw; x++) {
+            if ((w[x] ^ h[x]) & 0x00ffffff) {
+                stale++;
+                x0 = MIN(x0, x);
+                x1 = MAX(x1, x);
+                y0 = MIN(y0, y);
+                y1 = MAX(y1, y);
+            }
+        }
+    }
+    trace_sdl2_swapchain_verify(scon->idx, stale, stale ? x0 : 0, stale ? y0 : 0,
+                                stale ? x1 - x0 + 1 : 0, stale ? y1 - y0 + 1 : 0);
+}
+
+bool sdl2_swapchain_present(struct sdl2_console *scon, int width, int height,
+                            int menu_top, egl_fb *guest, bool flip)
+{
+    struct sdl2_swapchain *sc = swapchain_get(scon);
+    SwapRect damage, gui = { 0 }, copy = { 0 };
+    bool partial, full = false;
+    SwapBuffer *b;
+    int gw, gh;
+
+    if (!sc) {
+        return false;
+    }
+    if (sc->presents < SDL_PRESENTS_FIRST) {
+        /* SDL maps the window with its first swaps */
+        sc->presents++;
+        return false;
+    }
+    if (width != sc->width || height != sc->height || sc->feedback_changed) {
+        if (!buffers_create(sc, width, height)) {
+            sc->failed = true;
+            buffers_destroy(sc);
+            return false;
+        }
+    }
+    b = swapchain_free_buffer(sc);
+    if (!b) {
+        /* every buffer is with the compositor: this frame stays in the guest's */
+        trace_sdl2_swapchain_no_buffer(scon->idx);
+        return true;
+    }
+    swapchain_vote(sc, get_clock());
+
+    /* the guest's frame as it is below the menu bar: then a part will do */
+    gw = guest->dmabuf ? (int)qemu_dmabuf_get_width(guest->dmabuf) : guest->width;
+    gh = guest->dmabuf ? (int)qemu_dmabuf_get_height(guest->dmabuf) : guest->height;
+    partial = getenv("QEMU_SDL_PARTIAL_COPY") && !getenv("QEMU_SDL_FULL_COPY") &&
+              gw == width && gh == height - menu_top && gh <= guest->height &&
+              (!guest->dmabuf || (!qemu_dmabuf_get_x(guest->dmabuf) &&
+                                  !qemu_dmabuf_get_y(guest->dmabuf)));
+    if (menu_top != sc->layout_menu_top || gw != sc->layout_w ||
+        gh != sc->layout_h || flip != sc->layout_flip) {
+        sc->epoch++;
+        sc->layout_menu_top = menu_top;
+        sc->layout_w = gw;
+        sc->layout_h = gh;
+        sc->layout_flip = flip;
+    }
+    /* this present's guest damage, and where the menu paints over the guest */
+    sc->frame++;
+    damage = (SwapRect) { scon->damage_x, scon->damage_y,
+                          scon->damage_w, scon->damage_h };
+    rect_clip(&damage, gw, gh);
+    sc->history[sc->frame % DAMAGE_HISTORY] = damage;
+    if (sdl2_menu_painted_rect(scon, &gui.x, &gui.y, &gui.w, &gui.h)) {
+        gui.y -= menu_top;
+        rect_clip(&gui, gw, gh);
+    }
+    if (partial && b->frame && b->epoch == sc->epoch &&
+        sc->frame - b->frame <= DAMAGE_HISTORY) {
+        uint64_t f;
+
+        for (f = b->frame + 1; f <= sc->frame; f++) {
+            rect_union(&copy, &sc->history[f % DAMAGE_HISTORY]);
+        }
+        rect_union(&copy, &b->gui);     /* the menu's old pixels in it */
+        rect_union(&copy, &gui);        /* fresh guest pixels under the menu */
+        if (!rect_empty(&copy)) {
+            blit_rect(&b->fb, guest, flip, menu_top, gh, &copy);
+        }
+        swapchain_verify(scon, b, guest, flip, menu_top, gw, gh);
+    } else {
+        /*
+         * Into the buffer: row 0 is the top of the image the compositor
+         * shows, and the top of GL's framebuffer here, unlike the window's.
+         * The guest goes below the menu bar.
+         */
+        b->fb.x = 0;
+        b->fb.y = menu_top;
+        b->fb.height = height - menu_top;
+        egl_fb_blit(&b->fb, guest, flip);
+        b->fb.y = 0;
+        b->fb.height = height;
+        copy = (SwapRect) { 0, 0, gw, gh };
+        full = true;
+    }
+    b->frame = sc->frame;
+    b->epoch = sc->epoch;
+    b->gui = gui;
+    trace_sdl2_swapchain_copy(scon->idx, full, copy.x, copy.y, copy.w, copy.h,
+                              damage.w, damage.h, gui.w, gui.h);
+    glBindFramebuffer(GL_FRAMEBUFFER, b->fb.framebuffer);
+    glViewport(0, 0, width, height);
+    sdl2_draw_menu_into(scon, true);
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    /* the GPU work is queued before the compositor hears of the buffer */
+    glFlush();
+
+    sdl2_stats_present_begin(scon);
+    wl_surface_attach(sc->surface, b->buffer, 0, 0);
+    /* QEMU_SDL_FULL_DAMAGE=1: tell the compositor everything changed, whatever was copied */
+    if (full || getenv("QEMU_SDL_FULL_DAMAGE")) {
+        wl_surface_damage_buffer(sc->surface, 0, 0, width, height);
+    } else {
+        /* what changed on the surface: the copied part, the menu bar, the menu */
+        copy.y += menu_top;
+        if (menu_top) {
+            rect_union(&copy, &(SwapRect) { 0, 0, width, menu_top });
+        }
+        if (!rect_empty(&gui)) {
+            gui.y += menu_top;
+            rect_union(&copy, &gui);
+        }
+        if (!rect_empty(&copy)) {
+            wl_surface_damage_buffer(sc->surface, copy.x, copy.y, copy.w, copy.h);
+        }
+    }
+    scon->damage_w = scon->damage_h = 0;    /* presented */
+    wl_surface_commit(sc->surface);
+    wl_display_flush(sc->display);
+    b->busy = true;
+    b->ever = true;
+    sdl2_stats_present_end(scon);
+    return true;
+}
