+/*
+ * A frame handed to the compositor just before its vertical blank, or just
+ * after, reaches the screen at the blank after: no sooner than one handed a
+ * moment later.  But the EGL swapchain only gets the buffer of the frame
+ * shown until then back with the compositor's events after the blank, so a
+ * frame handed just before is drawn into a fourth buffer, which the swapchain
+ * allocates, then frees again twenty frames later (Mesa's
+ * BUFFER_TRIM_AGE_HYSTERESIS), and the first flip of a new buffer waits for
+ * the kernel to move it into contiguous memory: 2.8 ms for 4K, a refresh
+ * lost.  So a frame that comes within HOLD_BEFORE of the blank waits until
+ * HOLD_AFTER past it, and the buffer released at the blank is taken.
+ * QEMU_SDL_HOLD=1 enables the wait (an experiment: see sdl2_gl_hold_frame).
+ */
+#define HOLD_BEFORE_NS 1000000
+#define HOLD_AFTER_NS 250000
+/* only frames in a row: an isolated one may still make the blank */
+#define HOLD_IN_A_ROW_NS 6000000
+
+static void sdl2_gl_hold_fired(void *opaque)
+{
+    struct sdl2_console *scon = opaque;
+
+    scon->held = false;
+    /* the buffer released at the blank: let the swapchain see it */
+    sdl2_stats_read_wayland();
+    sdl2_gl_scanout_present(scon);
+}
+
+static bool sdl2_gl_hold_frame(struct sdl2_console *scon)
+{
+    static int disabled = -1;
+    int64_t now, vblank, period, until;
+
+    if (disabled < 0) {
+        /*
+         * Off unless asked: the swapchain of sdl2-swapchain.c is what ends
+         * the churn, and a held frame at the start of a burst, which the
+         * idle compositor would have shown at the blank, comes a refresh late.
+         */
+        disabled = !getenv("QEMU_SDL_HOLD");
+    }
+    if (disabled) {
+        return false;
+    }
+    if (scon->held) {
+        return true;
+    }
+    now = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+    if (now - scon->last_flush_ns > HOLD_IN_A_ROW_NS) {
+        scon->last_flush_ns = now;
+        return false;
+    }
+    scon->last_flush_ns = now;
+    vblank = sdl2_stats_next_vblank(scon, now, &period);
+    if (!vblank) {
+        return false;
+    }
+    if (vblank - now < HOLD_BEFORE_NS) {
+        until = vblank + HOLD_AFTER_NS;
+    } else if (now - (vblank - period) < HOLD_AFTER_NS) {
+        until = vblank - period + HOLD_AFTER_NS;
+    } else {
+        return false;
+    }
+    if (!scon->hold_timer) {
+        scon->hold_timer = timer_new_ns(QEMU_CLOCK_REALTIME, sdl2_gl_hold_fired,
+                                        scon);
+    }
+    scon->held = true;
+    timer_mod_ns(scon->hold_timer, until);
+    return true;
+}
+
 void sdl2_gl_scanout_flush(DisplayChangeListener *dcl,
                            uint32_t x, uint32_t y, uint32_t w, uint32_t h)
 {
@@ -272,6 +364,30 @@ void sdl2_gl_scanout_flush(DisplayChangeListener *dcl,
         scon->frames++;
         sdl2_stats_flush(scon);
     }
+    scon->flush_x = x;
+    scon->flush_y = y;
+    scon->flush_w = w;
+    scon->flush_h = h;
+    /* every flush until the window presents: what its next copy must cover */
+    if (w && h) {
+        if (!scon->damage_w || !scon->damage_h) {
+            scon->damage_x = x;
+            scon->damage_y = y;
+            scon->damage_w = w;
+            scon->damage_h = h;
+        } else {
+            int x1 = MAX(scon->damage_x + scon->damage_w, (int)(x + w));
+            int y1 = MAX(scon->damage_y + scon->damage_h, (int)(y + h));
+
+            scon->damage_x = MIN(scon->damage_x, (int)x);
+            scon->damage_y = MIN(scon->damage_y, (int)y);
+            scon->damage_w = x1 - scon->damage_x;
+            scon->damage_h = y1 - scon->damage_y;
+        }
+    }
+    if (sdl2_gl_hold_frame(scon)) {
+        return;
+    }
     sdl2_gl_scanout_present(scon);
 }
 
