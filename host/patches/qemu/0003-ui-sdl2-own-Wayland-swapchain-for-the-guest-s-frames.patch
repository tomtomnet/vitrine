+/*
+ * The window's own buffers for the GL scanout path, on Wayland.
+ *
+ * SDL's EGL window surface takes its buffers from Mesa, which frees a
+ * buffer unused for twenty frames and allocates one again when the
+ * compositor holds three: a flip that comes a refresh late makes it hold
+ * three, and the first scanout of a new buffer waits for the kernel to move
+ * it into contiguous memory (2.8 ms for a 4K buffer, amdgpu), which is a
+ * flip a refresh late.  Frames then repeat on the screen in a chain.
+ *
+ * Here the buffers are made once, as GBM buffers on the render device of
+ * the EGL display, with the modifiers the compositor offers for the surface
+ * (its scanout tranche when it names one), and attached to SDL's surface
+ * through linux-dmabuf.  The guest's frame is blitted into the buffer, the
+ * menu drawn over it, and the surface committed, with the presentation
+ * feedback and frame callback of sdl2-stats.c around it, as around SDL's
+ * swap.  A buffer is used again once the compositor released it.
+ *
+ * Anything missing (no linux-dmabuf, no GBM, an import that fails) leaves
+ * the window with SDL's swap.  QEMU_SDL_NO_SWAPCHAIN=1 does too.
+ *
+ * Only what changed is copied: the guest's flushes say which rectangle of
+ * its frame changed since its previous one, and a buffer last filled k
+ * presents ago gets the union of the last k of them, plus where the menu
+ * painted over the guest in it then and paints now.  A whole 3840x2112
+ * frame is ~1 ms of GPU work and 32 MB of memory traffic on the 780M, on
+ * the ring the guest's own rendering waits on.  Anything unusual (a new or
+ * too old buffer, another size or menu bar, a scaled or offset guest frame)
+ * copies everything.  Opt-in for now, QEMU_SDL_PARTIAL_COPY=1: verified
+ * correct (QEMU_SDL_COPY_VERIFY), fewer repeats under the Super hammer, but
+ * more in the launcher's open/close loop after pauses (cause unknown).
+ * It needs a guest that sends damage (KWin 1.16 + blob_damage module).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/error-report.h"
+#include "qemu/timer.h"
+#include "ui/console.h"
+#include "ui/sdl2.h"
+#include "ui/egl-helpers.h"
+#include "trace.h"
+
+#include <fcntl.h>
+#include <poll.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <drm_fourcc.h>
+#include <gbm.h>
+#include <wayland-client.h>
+#include <SDL_syswm.h>
+#include <epoxy/egl.h>
+#include "linux-dmabuf-v1-client-protocol.h"
+
+#ifndef EGL_DRM_RENDER_NODE_FILE_EXT
+#define EGL_DRM_RENDER_NODE_FILE_EXT 0x3377
+#endif
+
