+/*
+ * Mirror the draw data top to bottom: for a texture, whose first row is the
+ * top of the image, when the GL backend draws for a window, whose first row
+ * is the bottom.  Done twice, it is undone.
+ */
+static void mirror_draw_data(ImDrawData *dd)
+{
+    const float h = dd->DisplayPos.y * 2 + dd->DisplaySize.y;
+
+    for (int n = 0; n < dd->CmdLists.Size; n++) {
+        ImDrawList *list = dd->CmdLists[n];
+
+        for (int i = 0; i < list->VtxBuffer.Size; i++) {
+            list->VtxBuffer[i].pos.y = h - list->VtxBuffer[i].pos.y;
+        }
+        for (int i = 0; i < list->CmdBuffer.Size; i++) {
+            ImVec4 &r = list->CmdBuffer[i].ClipRect;
+            const float top = r.y;
+
+            r.y = h - r.w;
+            r.w = h - top;
+        }
+    }
+}
+
 void sdl2_gui_render(void)
+{
+    sdl2_gui_render_into(false);
+}
+
+bool sdl2_gui_painted_rect(int *x, int *y, int *w, int *h)
+{
+    ImDrawData *dd;
+    float x0 = 0, y0 = 0, x1 = 0, y1 = 0;
+    float sx, sy;
+    bool any = false;
+
+    if (!gui.ctx || !gui.drawn) {
+        return false;
+    }
+    ImGui::SetCurrentContext(gui.ctx);
+    dd = ImGui::GetDrawData();
+    if (!dd || !dd->Valid) {
+        return false;
+    }
+    /*
+     * What a command paints: its triangles' vertices (those not entirely
+     * transparent) inside its clip rectangle - the clip rectangle alone can
+     * be the whole display for a window that paints a bar at its top.
+     */
+    for (const ImDrawList *list : dd->CmdLists) {
+        for (const ImDrawCmd &cmd : list->CmdBuffer) {
+            float cx0 = 0, cy0 = 0, cx1 = 0, cy1 = 0;
+            bool painted = false;
+
+            if (!cmd.ElemCount || cmd.UserCallback) {
+                continue;
+            }
+            for (unsigned int i = 0; i < cmd.ElemCount; i++) {
+                const ImDrawVert &v =
+                    list->VtxBuffer[list->IdxBuffer[cmd.IdxOffset + i] + cmd.VtxOffset];
+
+                if (!((v.col >> IM_COL32_A_SHIFT) & 0xff)) {
+                    continue;
+                }
+                if (!painted) {
+                    cx0 = cx1 = v.pos.x;
+                    cy0 = cy1 = v.pos.y;
+                    painted = true;
+                    continue;
+                }
+                cx0 = std::min(cx0, v.pos.x);
+                cy0 = std::min(cy0, v.pos.y);
+                cx1 = std::max(cx1, v.pos.x);
+                cy1 = std::max(cy1, v.pos.y);
+            }
+            cx0 = std::max(cx0, cmd.ClipRect.x);
+            cy0 = std::max(cy0, cmd.ClipRect.y);
+            cx1 = std::min(cx1, cmd.ClipRect.z);
+            cy1 = std::min(cy1, cmd.ClipRect.w);
+            if (!painted || cx1 <= cx0 || cy1 <= cy0) {
+                continue;
+            }
+            if (!any) {
+                x0 = cx0;
+                y0 = cy0;
