+/*
+ * The pointer's position from the compositor itself (Wayland), see
+ * sdl2-stats.c.  Its unit is that of the surface; SDL's is the window's,
+ * which is another one when the compositor scales.  The factor between the
+ * two shows when SDL reports the same positions: a multiple of 1/120, as in
+ * the fractional scale protocol.
+ */
+static struct sdl2_console *wl_pointer_scon;
+static double wl_pointer_x, wl_pointer_y;
+static double wl_pointer_scale;         /* window units per surface unit */
+static int wl_pointer_agreed;           /* positions of SDL that fit it */
+
+static bool sdl2_wl_pointer_usable(struct sdl2_console *scon)
+{
+    return wl_pointer_scon == scon && wl_pointer_scale > 0 &&
+           wl_pointer_agreed >= 3;
+}
+
+/* SDL's position for the same pointer: learn the factor, or check it */
+static void sdl2_wl_pointer_compare(struct sdl2_console *scon, int x, int y)
+{
+    double scale;
+
+    if (wl_pointer_scon != scon || wl_pointer_x < 200) {
+        return;
+    }
+    scale = round(x / wl_pointer_x * 120) / 120;
+    if (scale < 0.5 || scale > 8) {
+        return;
+    }
+    /* the two positions are at most a few moves apart */
+    if (fabs(x - wl_pointer_x * scale) > 8 * scale + 2) {
+        return;
+    }
+    if (scale == wl_pointer_scale) {
+        if (wl_pointer_agreed < 3) {
+            wl_pointer_agreed++;
+        }
+    } else if (fabs(x - wl_pointer_x * wl_pointer_scale) > 2 * scale + 2 ||
+               !wl_pointer_scale) {
+        /* another scale, or none yet */
+        wl_pointer_scale = scale;
+        wl_pointer_agreed = 0;
+    }
+}
+
+/* The position on the guest's display, in sixteenths of its pixels */
+static bool sdl2_wl_pointer_guest(struct sdl2_console *scon, int *x16, int *y16)
+{
+    int scr_w, scr_h;
+    double px, py;
+
+    if (!sdl2_wl_pointer_usable(scon)) {
+        return false;
+    }
+    SDL_GetWindowSize(scon->real_window, &scr_w, &scr_h);
+    scr_h = sdl2_guest_height(scon, scr_h);
+    /* a position is the middle of a pixel */
+    px = (wl_pointer_x * wl_pointer_scale + 0.5) *
+         surface_width(scon->surface) / scr_w;
+    py = (MAX(wl_pointer_y * wl_pointer_scale - scon->menu_top, 0) + 0.5) *
+         surface_height(scon->surface) / scr_h;
+    *x16 = lround(MIN(px, surface_width(scon->surface)) * 16);
+    *y16 = lround(MIN(py, surface_height(scon->surface)) * 16);
+    return true;
