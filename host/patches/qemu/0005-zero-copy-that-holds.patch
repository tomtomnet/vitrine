+/*
+ * The guest's buffer goes to the compositor as linear - virtio-gpu tells
+ * nothing of a scanout's layout - so it has to be: the guest's compositor
+ * allocates linear scanout buffers when the guest's virtio-gpu driver
+ * advertises the linear modifier (linear_scanout=1 of the fork's module);
+ * otherwise Mesa tiles them, and compresses them, and the screen shows
+ * noise.  amdgpu keeps a buffer's tiling in its metadata: 1 linear, 0 not,
+ * -1 when the driver cannot tell (anything but amdgpu).  On a handle space
+ * of its own (query_fd), so that closing the handle closes nobody else's.
+ */
+static int dmabuf_linear(int fd, int dmabuf_fd)
+{
+    char name[16] = "";
+    struct drm_version ver = { .name_len = sizeof(name) - 1, .name = name };
+    struct drm_prime_handle prime = { .fd = dmabuf_fd };
+    struct drm_amdgpu_gem_metadata md = { 0 };
+    struct drm_gem_close gem_close = { 0 };
+    int ret;
+
+    if (fd < 0 || ioctl(fd, DRM_IOCTL_VERSION, &ver) || strcmp(name, "amdgpu")) {
+        return -1;
+    }
+    if (ioctl(fd, DRM_IOCTL_PRIME_FD_TO_HANDLE, &prime)) {
+        return -1;
+    }
+    md.handle = prime.handle;
+    md.op = AMDGPU_GEM_METADATA_OP_GET_METADATA;
+    ret = ioctl(fd, DRM_IOCTL_AMDGPU_GEM_METADATA, &md);
+    gem_close.handle = prime.handle;
+    ioctl(fd, DRM_IOCTL_GEM_CLOSE, &gem_close);
+    if (ret) {
+        return -1;
+    }
+    return AMDGPU_TILING_GET(md.data.tiling_info, SWIZZLE_MODE) == 0 &&
+           AMDGPU_TILING_GET(md.data.tiling_info, DCC_OFFSET_256B) == 0;
+}
+
+/* The buffers found not linear, so that each is checked once */
