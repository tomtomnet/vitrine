+static ino_t refused_bufs[REFUSED_BUFFERS];
+static int n_refused;
+
+/* Whether this guest buffer may go to the compositor as linear */
+static bool guest_buffer_attachable(struct sdl2_swapchain *sc, int dmabuf_fd,
+                                    ino_t ino)
+{
+    static bool warned;
+    int i, linear;
+
+    for (i = 0; i < REFUSED_BUFFERS; i++) {
+        if (refused_bufs[i] == ino) {
+            return false;
+        }
+    }
+    linear = dmabuf_linear(sc->query_fd, dmabuf_fd);
+    if (linear == 1 || (linear < 0 && !g_strcmp0(getenv("QEMU_SDL_ZERO_COPY"), "force"))) {
+        return true;
+    }
+    refused_bufs[n_refused++ % REFUSED_BUFFERS] = ino;
+    trace_sdl2_swapchain_guest_refused(sc->scon->idx, (uint64_t)ino, linear);
