+/*
+ * Out-of-tree extension: config event bits 16 and up, one per scanout, tell
+ * the guest that the host has just shown a frame of that scanout.  A guest
+ * driver that knows the bits ticks its vblank on them instead of on its
+ * free-running timer, so it paces itself on the real display.
+ */
+/* the most the tick moves earlier at once: the guest's compositor planned on the old one */
+#define VBLANK_LEAD_LONGER_NS   (400 * SCALE_US)
+
+static int64_t vblank_mod(int64_t a, int64_t period)
+{
+    a %= period;
+    return a < 0 ? a + period : a;
+}
+
+/*
+ * The lead of the next tick: the configured one, or the one that
+ * x-vblank-lead-auto regulates.  One lead for every frame: a second one for
+ * frames by themselves (2.3 ms suits a key's frame a little better, 12.7 ms
+ * key to screen against 13.2) makes the tick jump at the start of every
+ * burst of frames, and the launcher's animation then repeats 4-5 frames a
+ * second instead of one.
+ */
+static void virtio_gpu_vblank_next_lead(VirtIOGPUBase *g,
+                                        struct virtio_gpu_scanout *s,
+                                        int64_t now)
+{
+    int64_t base = (int64_t)g->vblank_lead_us * SCALE_US;
+    int64_t period = s->vblank_period_ns;
+    int64_t wanted = base, earlier;
+
+    if (g->vblank_lead_auto && s->vblank_auto_set) {
+        wanted = s->vblank_lead_auto_ns;
+    }
+    if (!s->vblank_lead_ns || !period) {
+        s->vblank_lead_ns = wanted;
+        return;
+    }
+    earlier = vblank_mod(wanted - s->vblank_lead_ns, period);
+    if (!earlier) {
+        return;
+    }
+    if (earlier < period / 2) {
+        /* earlier, in steps that the guest's compositor can follow */
+        s->vblank_lead_ns = vblank_mod(s->vblank_lead_ns +
+                                       MIN(earlier, VBLANK_LEAD_LONGER_NS),
+                                       period);
+        s->vblank_moved_ns = now;
+    } else {
+        s->vblank_lead_ns = wanted;
+    }
+}
+
+static void virtio_gpu_vblank_tick(void *opaque)
+{
+    struct virtio_gpu_scanout *s = opaque;
+    VirtIOGPUBase *g = s->vblank_g;
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+    int64_t next;
+
+    /* this tick's time on the grid (the timer may run a little late) */
+    g->vblank_config[s->vblank_head] = cpu_to_le64(s->vblank_next_ns ? s->vblank_next_ns : now);
+    virtio_gpu_notify_event(g, 1u << (16 + s->vblank_head));
+    /* the next tick, one period on, on the presentation grid minus the lead */
+    virtio_gpu_vblank_next_lead(g, s, get_clock());
+    next = s->vblank_phase_ns - s->vblank_lead_ns;
+    while (next <= now) {
+        next += s->vblank_period_ns;
+    }
+    s->vblank_next_ns = next;
+    timer_mod_ns(s->vblank_timer, next);
+}
+
+/* x-vblank-lead-auto */
+/* frames in a row looked at before the lead may move: 0.6 s at 240 Hz */
+#define VBLANK_WINDOW           144
+/* frames of a burst before those looked at: an idle compositor takes them at once */
+#define VBLANK_BURST_START      4
+/*
+ * What the frames should take from their swap to the screen.  The host's
+ * compositor (KWin, 4K) takes a frame for a vblank if it is swapped 3.9 ms
+ * before it, 5 ms for a while after any late flip; with a millisecond of
+ * margin the frame's place is 6 ms before the vblank that shows it.  (At
+ * 5.5 ms a key's frame, which an idle compositor tries to show at once,
+ * raced that: key to screen p90 19 ms instead of 15-16.)
+ */
+/*
+ * How long before the vblank that shows them the frames of a burst are to
+ * be swapped: the host compositor's need (~3.9 ms at 240 Hz with a copy it
+ * must wait for, ~1.8 ms when the guest's own buffer is on its surface)
+ * plus room for its late moments.  Property x-vblank-swap-target (us).
+ */
+#define VBLANK_SWAP_TARGET_NS   ((int64_t)g->vblank_swap_target_us * SCALE_US)
+/* no move while the frames are that close to it */
+#define VBLANK_SWAP_SLACK_NS    (350 * SCALE_US)
+/* the most the lead moves after a window */
+#define VBLANK_STEP_NS          (350 * SCALE_US)
+
+static int vblank_cmp(const void *a, const void *b)
+{
+    int64_t x = *(const int64_t *)a, y = *(const int64_t *)b;
+
+    return x < y ? -1 : x > y;
+}
+
+/*
+ * x-vblank-lead-auto: tick the guest so that its frames reach the host's
+ * compositor when it needs them.
+ *
+ * A compositor makes its frame for a vblank some time before it, at a time
+ * of its own choosing that changes (KWin's follows its estimate of its
+ * render time, which one slow frame raises for seconds).  A frame of the
+ * guest that arrives before that is shown at that vblank; one that arrives
+ * after it waits for the next, and so does every frame after it for as
+ * long as they keep coming if the compositor had something else to show.
+ *
+ * Measured with fixed leads on a 4K 240 Hz host (KWin guest, which commits
+ * 0.9 ms before its tick; desktop-bench/lead_sweep.sh): the frame is shown
+ * at the vblank following its swap if it is swapped 3.9 ms before it, and
+ * of a 4.17 ms refresh that leaves a place 0.3 ms wide that drifts - frames
+ * put there land on either side (leads of 2.4-3.1 ms: 4-7 frames repeated
+ * per second in an animation).  Swapped 5.4-6.1 ms before the vblank that
+ * shows them, a refresh later than the ideal, none is passed by (leads of
+ * 0.3-1 ms: 1 per second).  At 144 Hz the same 5.5 ms are within one
+ * refresh.
+ *
+ * So the lead is regulated, slowly, to have the frames swapped about that long
+ * before they are shown: over a window of frames in a row the median time
+ * from swap to presentation is compared with the target, and the tick
+ * moves a step if it is off by more than a step.  The median, not the
+ * quickest: an idle compositor takes a frame at once, and the bursts of
+ * frames one behind that the host has whatever the place must not move
+ * the tick either.  This places a guest that commits after its tick
+ * (Hyprland, niri: render on the page flip) as well as one that commits
+ * before it, at any refresh rate, and once there it does not move.
+ *
+ * Tried and dropped (2026-09-30): reading the wait for the compositor's
+ * frame callback (an idle compositor answers within a millisecond whenever
+ * the frame comes; at 240 Hz the tick went round and round the period),
+ * counting frames passed by and trying neighbouring places (the host's
+ * bursts look the same as a bad place, the tick kept walking), a second
+ * lead for frames by themselves (see virtio_gpu_vblank_next_lead).
+ */
+static void
+virtio_gpu_vblank_lead_auto(VirtIOGPUBase *g, struct virtio_gpu_scanout *s,
+                            uint32_t head, int64_t when_ns,
+                            int64_t compositor_lead_ns, int64_t swap_lead_ns)
+{
+    int64_t period = s->vblank_period_ns;
+    int64_t lead = s->vblank_lead_auto_ns;
+    int64_t median, off;
+
+    if (!s->vblank_auto_set) {
+        /* a guest that commits a millisecond before its tick lands on the target */
+        lead = vblank_mod(VBLANK_SWAP_TARGET_NS - SCALE_MS, period);
+        s->vblank_auto_set = true;
+    }
+    if (s->vblank_shown_ns && when_ns - s->vblank_shown_ns < period + period / 2) {
+        s->vblank_in_a_row++;
+    } else {
+        s->vblank_in_a_row = 0;
+    }
+    s->vblank_shown_ns = when_ns;
+    /*
+     * Frames made before the tick moved say nothing about where it is now,
+     * and neither do frames made while it is on its way
+     */
+    if (s->vblank_in_a_row < VBLANK_BURST_START ||
+        swap_lead_ns <= 0 || swap_lead_ns > 4 * period ||
+        when_ns - s->vblank_moved_ns < 4 * period ||
+        s->vblank_lead_ns != lead) {
+        goto out;
+    }
+    s->vblank_swap_ns[s->vblank_window++] = swap_lead_ns;
+    if (s->vblank_window < VBLANK_WINDOW) {
+        goto out;
+    }
+    s->vblank_window = 0;
+    qsort(s->vblank_swap_ns, VBLANK_WINDOW, sizeof(s->vblank_swap_ns[0]), vblank_cmp);
+    median = s->vblank_swap_ns[VBLANK_WINDOW / 2];
+    /*
+     * The same place a whole refresh earlier or later is no better: only
+     * the part of a refresh counts.  A median more than half a refresh
+     * beyond the target means the host shows the frames a refresh later
+     * than their swap allows (its own compositor running a frame ahead):
+     * nothing here changes that, but it is said.
+     */
+    if (median > VBLANK_SWAP_TARGET_NS + period / 2) {
+        trace_virtio_gpu_vblank_behind(head, median);
+    }
+    off = vblank_mod(median - VBLANK_SWAP_TARGET_NS + period / 2, period) - period / 2;
+    if (off > VBLANK_SWAP_SLACK_NS) {
+        /* swapped too early: a later tick */
+        lead = vblank_mod(lead - MIN(off, VBLANK_STEP_NS), period);
+    } else if (off < -VBLANK_SWAP_SLACK_NS) {
+        lead = vblank_mod(lead + MIN(-off, VBLANK_STEP_NS), period);
+    } else {
+        goto out;
+    }
+    trace_virtio_gpu_vblank_lead(head, lead, median, off);
+out:
+    s->vblank_lead_auto_ns = lead;
+}
+
+/*
+ * A frame of this scanout was just shown: anchor the vblank phase.  With a
+ * lead, a timer on the presentation grid ticks the guest before each vblank
+ * so its compositor commits early enough for the host's own pipeline;
+ * without one, the guest is ticked at the presentation itself.
+ */
+static void
+virtio_gpu_gl_presented(void *opaque, uint32_t head, int64_t when_ns,
+                        int64_t period_ns, int64_t compositor_lead_ns,
+                        int64_t swap_lead_ns)
+{
+    VirtIOGPUBase *g = opaque;
+    struct virtio_gpu_scanout *s;
+
+    if (!g->host_vblank || head >= 16 || head >= VIRTIO_GPU_MAX_SCANOUTS) {
+        return;
+    }
+    s = &g->scanout[head];
+    s->vblank_phase_ns = when_ns;
+    if (period_ns > 0) {
+        s->vblank_period_ns = period_ns;
+    }
+    if (g->vblank_lead_auto && g->vblank_lead_us && s->vblank_period_ns) {
+        virtio_gpu_vblank_lead_auto(g, s, head, when_ns, compositor_lead_ns,
+                                    swap_lead_ns);
+    }
+    if (!g->vblank_lead_us || !s->vblank_period_ns) {
+        g->vblank_config[head] = cpu_to_le64(when_ns);
+        virtio_gpu_notify_event(g, 1u << (16 + head));
+        return;
+    }
+    if (!s->vblank_timer) {
+        s->vblank_g = g;
+        s->vblank_head = head;
+        s->vblank_timer = timer_new_ns(QEMU_CLOCK_REALTIME, virtio_gpu_vblank_tick, s);
+        virtio_gpu_vblank_tick(s);
+    }
+}
+
 static int
 virtio_gpu_get_flags(void *opaque)
 {
@@ -169,6 +412,79 @@ virtio_gpu_get_flags(void *opaque)
     return flags;
 }
 
+/* Zero copy: the display's word on the previous buffer (see console.h) */
+static void virtio_gpu_gl_flush_pending(void *opaque, uint32_t head)
+{
+    VirtIOGPUBase *g = opaque;
+
+    if (head < g->conf.max_outputs) {
+        g->scanout[head].flush_pending = true;
+    }
+}
+
+void virtio_gpu_flush_fence_now(VirtIOGPUBase *g, uint32_t head)
+{
+    struct virtio_gpu_scanout *s = &g->scanout[head];
+    VirtIOGPUBaseClass *vgc = VIRTIO_GPU_BASE_GET_CLASS(g);
+
+    if (!s->fence_deferred) {
+        return;
+    }
+    s->fence_deferred = false;
+    if (s->deferred_fence_timer) {
+        timer_del(s->deferred_fence_timer);
+    }
+    if (vgc->flush_fence) {
+        vgc->flush_fence(g, head);
+    }
+}
+
+static void virtio_gpu_gl_flush_done(void *opaque, uint32_t head)
+{
+    VirtIOGPUBase *g = opaque;
+
+    if (head < g->conf.max_outputs) {
+        virtio_gpu_flush_fence_now(g, head);
+    }
+}
+
+static void virtio_gpu_deferred_fence_timeout(void *opaque)
+{
+    struct virtio_gpu_scanout *s = opaque;
+    VirtIOGPUBase *g = s->deferred_fence_g;
+
+    trace_virtio_gpu_flush_fence_timeout(s - g->scanout);
+    virtio_gpu_flush_fence_now(g, s - g->scanout);
+}
+
+/*
+ * A flush of @head with fence @fence_id: hold the fence while the display
+ * waits for the compositor to release the previous buffer.  True when held.
+ */
+bool virtio_gpu_defer_flush_fence(VirtIOGPUBase *g, uint32_t head,
+                                  uint32_t fence_id)
+{
+    struct virtio_gpu_scanout *s = &g->scanout[head];
+    int64_t period = s->vblank_period_ns ? s->vblank_period_ns : 16666667;
+
+    if (!s->flush_pending) {
+        return false;
+    }
+    s->flush_pending = false;
+    /* one is at most held: the older one goes out first (fences are in order) */
+    virtio_gpu_flush_fence_now(g, head);
+    s->fence_deferred = true;
+    s->deferred_fence = fence_id;
+    if (!s->deferred_fence_timer) {
+        s->deferred_fence_g = g;
+        s->deferred_fence_timer = timer_new_ns(QEMU_CLOCK_REALTIME,
+                                               virtio_gpu_deferred_fence_timeout, s);
+    }
+    timer_mod_ns(s->deferred_fence_timer, get_clock() + 2 * period);
+    trace_virtio_gpu_flush_fence_deferred(head, fence_id);
+    return true;
+}
+
