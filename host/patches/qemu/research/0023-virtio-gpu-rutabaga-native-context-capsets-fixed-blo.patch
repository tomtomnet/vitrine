+/*
+ * x-guest-dmabuf: a DRM native context only imports resources by dma-buf, so
+ * the shareable guest-memory blobs the guest's driver makes for dma-bufs of
+ * other guest devices it imports (a compositor's udmabuf around a wl_shm
+ * client buffer, for instance) get a udmabuf of their pages, which rutabaga
+ * hands to virglrenderer (virgl_renderer_resource_set_guest_dmabuf, our
+ * virglrenderer), as virtio-gpu-gl does.  Without it the guest's import
+ * fails and its compositor uploads each such buffer through fresh staging
+ * blobs (2026-10-08: 123 blobs, 2.1 GB per Konsole resize test).  Context 0
+ * only: a cross-domain context's blobs keep their own handling.
+ */
+static bool rutabaga_wants_guest_dmabuf(VirtIOGPURutabaga *vr,
+                                        const struct virtio_gpu_resource_create_blob *cblob)
+{
+    return vr->guest_dmabuf && cblob->hdr.ctx_id == 0 &&
+           cblob->blob_mem == VIRTIO_GPU_BLOB_MEM_GUEST &&
+           (cblob->blob_flags & VIRTIO_GPU_BLOB_FLAG_USE_SHAREABLE) &&
+           (vr->capset_mask & (1ULL << RUTABAGA_CAPSET_DRM));
+}
