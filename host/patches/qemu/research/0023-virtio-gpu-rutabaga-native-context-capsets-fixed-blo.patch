     g_autofree struct virtio_gpu_simple_resource *res = NULL;
     struct virtio_gpu_resource_create_blob cblob;
     struct rutabaga_create_blob rc_blob = { 0 };
+    struct rutabaga_handle handle = { .os_handle = -1 };
 
     VirtIOGPURutabaga *vr = VIRTIO_GPU_RUTABAGA(g);
 
@@ -644,6 +721,27 @@ rutabaga_cmd_resource_create_blob(VirtIOGPU *g,
         CHECK(!result, cmd);
     }
 
+    if (rutabaga_wants_guest_dmabuf(vr, &cblob)) {
+        int fd = virtio_gpu_create_udmabuf_fd(res);
