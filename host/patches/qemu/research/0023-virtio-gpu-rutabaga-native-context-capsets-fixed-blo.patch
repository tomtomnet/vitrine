+/*
+ * Undo the mapping of a slot. A fixed one goes back to the anonymous
+ * background (KVM's MMU notifier drops just that range from the guest's page
+ * tables); a subregion leaves the hostmem container (a memory transaction and
+ * a KVM memslot update) and rutabaga's own mapping is released.
+ */
+static int32_t
+virtio_gpu_rutabaga_unmap_slot(VirtIOGPURutabaga *vr, uint32_t slot)
+{
+    VirtIOGPUBase *vb = VIRTIO_GPU_BASE(vr);
+    struct MemoryRegionInfo *mri = &vr->memory_regions[slot];
+    int32_t result = 0;
+
+    if (mri->fixed) {
+        if (mmap(mri->fixed, mri->fixed_size, PROT_READ | PROT_WRITE,
+                 MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED | MAP_NORESERVE,
+                 -1, 0) == MAP_FAILED) {
+            error_report("%s: failed to unmap(fixed) resource %" PRIu32 ": %s",
+                         __func__, mri->resource_id, strerror(errno));
+            result = -errno;
+        }
+        mri->fixed = NULL;
+        mri->fixed_size = 0;
+    } else {
+        memory_region_del_subregion(&vb->hostmem, &mri->mr);
+        result = rutabaga_resource_unmap(vr->rutabaga, mri->resource_id);
+    }
+    mri->resource_id = 0;
+    mri->used = 0;
+    return result;
+}
+
+static int
+virtio_gpu_rutabaga_find_slot(VirtIOGPURutabaga *vr, uint32_t resource_id)
+{
+    uint32_t slot;
+
+    for (slot = 0; slot < MAX_SLOTS; slot++) {
+        if (vr->memory_regions[slot].used &&
+            vr->memory_regions[slot].resource_id == resource_id) {
+            return slot;
+        }
+    }
+    return -1;
+}
