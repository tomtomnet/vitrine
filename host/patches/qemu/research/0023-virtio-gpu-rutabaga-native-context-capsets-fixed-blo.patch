 }
 
+/*
+ * rutabaga's poll descriptor, when its renderer has one: readable when fences may be retired
+ * by polling it (crosvm registers it the same way). rutabaga runs virglrenderer with
+ * asynchronous fence callbacks, which retire fences from virglrenderer's own threads, so with
+ * it this is for completeness.
+ */
+static void virtio_gpu_rutabaga_poll_cb(void *opaque)
+{
+    VirtIOGPURutabaga *vr = opaque;
+
+    rutabaga_poll(vr->rutabaga);
+}
+
 static bool virtio_gpu_rutabaga_init(VirtIOGPU *g, Error **errp)
 {
     int result;
@@ -1054,6 +1292,11 @@ static bool virtio_gpu_rutabaga_init(VirtIOGPU *g, Error **errp)
         return false;
     }
 
+    vr->poll_fd = -1;
+    if (!rutabaga_poll_descriptor(vr->rutabaga, &vr->poll_fd) && vr->poll_fd >= 0) {
+        qemu_set_fd_handler(vr->poll_fd, virtio_gpu_rutabaga_poll_cb, NULL, vr);
+    }
+
     return true;
 }
 
