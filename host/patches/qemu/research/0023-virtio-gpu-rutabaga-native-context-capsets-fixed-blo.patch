 #if HOST_BIG_ENDIAN
     error_setg(errp, "rutabaga is not supported on bigendian platforms");
@@ -1115,6 +1359,25 @@ static void virtio_gpu_rutabaga_realize(DeviceState *qdev, Error **errp)
         goto fail;
