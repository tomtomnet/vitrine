 }
 
+/*
+ * Fixed blob mapping, as crosvm's fixed-blob-mapping: the blob's fd is
+ * mmap()ed in place into the hostmem background, which is one RAM region and
+ * so one KVM memslot for the whole window. A blob mapped as a memory region of
+ * its own costs a memory transaction on the main loop and a KVM memslot update
+ * at each map and unmap (2026-10-07, a nested desktop over cross-domain and drm
+ * native contexts: 366 updates in 200 s, up to 7 ms each; the guest's renderer
+ * waits for its map, the frames it was drawing missed their refresh).
+ * False when the blob cannot be mapped that way: the caller falls back to a
+ * subregion.
+ */
+/*
+ * x-prefault-blobs: a blob mmap()ed into the fixed mapping is mapped into KVM's stage-2 page
+ * tables at once (KVM_PRE_FAULT_MEMORY, on a vCPU thread, before the guest gets its answer)
+ * instead of one KVM page fault per 4 KiB page at the guest's first touch. A nested compositor
+ * uploads each new-size frame of a wl_shm client through fresh 8-32 MiB blobs that the guest
+ * then writes: one Konsole resize test (2026-10-08) took 211k such faults, 2-4 us each in KVM
+ * plus the exits, about a second of vCPU time on the compositor's vCPU.
+ */
+typedef struct RutabagaPrefault {
+    uint64_t gpa;
+    uint64_t size;
+    int ret;
+} RutabagaPrefault;
+
+static void rutabaga_prefault_on_cpu(CPUState *cpu, run_on_cpu_data data)
+{
+    RutabagaPrefault *p = data.host_ptr;
+
+    p->ret = kvm_cpu_pre_fault_memory(cpu, p->gpa, p->size);
+}
+
+static void virtio_gpu_rutabaga_prefault(VirtIOGPURutabaga *vr, uint64_t offset,
+                                         uint64_t size)
+{
+    VirtIOGPUBase *vb = VIRTIO_GPU_BASE(vr);
+    MemoryRegionSection sec;
+    RutabagaPrefault p = { .size = size };
+
+    if (!vr->prefault_blobs || !kvm_enabled() || !first_cpu) {
+        return;
+    }
+    sec = memory_region_find(&vb->hostmem, offset, size);
+    if (!sec.mr) {
+        return;
+    }
+    p.gpa = sec.offset_within_address_space;
+    memory_region_unref(sec.mr);
+    run_on_cpu(first_cpu, rutabaga_prefault_on_cpu, RUN_ON_CPU_HOST_PTR(&p));
+    if (p.ret < 0) {
+        warn_report("virtio-gpu-rutabaga: KVM_PRE_FAULT_MEMORY failed (%s): "
+                    "x-prefault-blobs off", strerror(-p.ret));
+        vr->prefault_blobs = false;
+    }
+}
+
+static bool
+virtio_gpu_rutabaga_map_fixed(VirtIOGPURutabaga *vr,
+                              struct virtio_gpu_simple_resource *res,
+                              uint64_t offset, uint32_t map_info, uint32_t slot)
+{
+    VirtIOGPUBase *vb = VIRTIO_GPU_BASE(vr);
+    uint64_t page = qemu_real_host_page_size();
+    uint64_t size = QEMU_ALIGN_UP(res->blob_size, page);
+    struct rutabaga_handle handle = { 0 };
+    int prot = PROT_READ | PROT_WRITE;
+    void *at, *ptr;
+    int err;
+
+    if (!size || size < res->blob_size || offset % page ||
+        offset > vb->conf.hostmem || size > vb->conf.hostmem - offset) {
+        return false;
+    }
+    if (rutabaga_resource_export_blob(vr->rutabaga, res->resource_id,
+                                      &handle)) {
+        return false;
+    }
+    /* an opaque fd (Vulkan memory) cannot be mmap()ed */
+    if (handle.handle_type != RUTABAGA_HANDLE_TYPE_MEM_DMABUF &&
+        handle.handle_type != RUTABAGA_HANDLE_TYPE_MEM_SHM) {
+        close(handle.os_handle);
+        return false;
+    }
+    if ((map_info & RUTABAGA_MAP_ACCESS_MASK) == RUTABAGA_MAP_ACCESS_READ) {
+        prot = PROT_READ;
+    }
+    at = (uint8_t *)vr->hostmem_mmap + offset;
+    ptr = mmap(at, size, prot, MAP_SHARED | MAP_FIXED, handle.os_handle, 0);
+    err = errno;
+    close(handle.os_handle);
+    if (ptr == MAP_FAILED) {
+        /* a failed MAP_FIXED may have taken the background with it */
+        mmap(at, size, PROT_READ | PROT_WRITE,
+             MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED | MAP_NORESERVE, -1, 0);
+        qemu_log_mask(LOG_GUEST_ERROR, "%s: resource %" PRIu32 ": mmap of "
+                      "its fd failed (%s), mapped as a subregion\n", __func__,
+                      res->resource_id, strerror(err));
+        return false;
+    }
+    vr->memory_regions[slot].fixed = ptr;
+    vr->memory_regions[slot].fixed_size = size;
+    vr->memory_regions[slot].resource_id = res->resource_id;
+    vr->memory_regions[slot].used = 1;
+    virtio_gpu_rutabaga_prefault(vr, offset, size);
+    return true;
+}
+
 static void
 rutabaga_cmd_resource_map_blob(VirtIOGPU *g,
                                struct virtio_gpu_ctrl_command *cmd)
@@ -699,6 +904,25 @@ rutabaga_cmd_resource_map_blob(VirtIOGPU *g,
