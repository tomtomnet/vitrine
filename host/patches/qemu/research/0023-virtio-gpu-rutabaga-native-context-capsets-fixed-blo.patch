+            }
+        }
+        CHECK(slot < MAX_SLOTS, cmd);
+        if (virtio_gpu_rutabaga_map_fixed(vr, res, mblob.offset, map_info,
+                                          slot)) {
+            resp.hdr.type = VIRTIO_GPU_RESP_OK_MAP_INFO;
+            virtio_gpu_ctrl_response(g, cmd, &resp.hdr, sizeof(resp));
+            return;
+        }
+        /* not exportable as an fd that can be mmap()ed: a subregion */
+    }
+
     result = rutabaga_resource_map(vr->rutabaga, mblob.resource_id, &mapping);
     CHECK(!result, cmd);
 
@@ -719,7 +943,8 @@ rutabaga_cmd_resource_map_blob(VirtIOGPU *g,
