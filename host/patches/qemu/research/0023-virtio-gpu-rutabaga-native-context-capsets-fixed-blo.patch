+         */
         if (signaled_ctx_specific &&
-           (cmd->cmd_hdr.ring_idx != fence_data.ring_idx)) {
+           (cmd->cmd_hdr.ctx_id != fence_data.ctx_id ||
+            cmd->cmd_hdr.ring_idx != (uint8_t)fence_data.ring_idx)) {
