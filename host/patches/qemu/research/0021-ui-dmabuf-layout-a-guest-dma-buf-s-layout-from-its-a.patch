   opengl_ss.add(when: [opengl],
                if_true: files('shader.c', 'console-gl.c', 'egl-helpers.c', 'egl-context.c'))
+  # the layout of a guest's dma-buf, for zero copy (SDL window, D-Bus display)
+  opengl_ss.add(when: [opengl, gbm], if_true: files('dmabuf-layout.c'))
   ui_modules += {'opengl' : opengl_ss}
 endif
 
