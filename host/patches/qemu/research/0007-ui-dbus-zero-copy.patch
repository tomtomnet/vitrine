+/*
+ * Zero copy: the client holds the guest buffer @token (an UpdateDMABUF went
+ * out for it); the listener asks whether the one shown before is still held
+ */
+void dbus_display_console_zc_hold(DBusDisplayConsole *ddc, uint64_t token)
+{
+    int i, free = -1;
+
+    for (i = 0; i < DBUS_ZC_BUFFERS; i++) {
+        if (ddc->zc_held[i] == token) {
+            return;
+        }
+        if (!ddc->zc_held[i] && free < 0) {
+            free = i;
+        }
+    }
+    if (free >= 0) {
+        ddc->zc_held[free] = token;
+    }
+}
+
+bool dbus_display_console_zc_held(DBusDisplayConsole *ddc, uint64_t token)
+{
+    int i;
+
+    for (i = 0; i < DBUS_ZC_BUFFERS; i++) {
+        if (ddc->zc_held[i] == token) {
+            return true;
+        }
+    }
+    return false;
+}
+
+/* the client is done with @token: a flush waiting for it completes */
+void dbus_display_console_zc_release(DBusDisplayConsole *ddc, uint64_t token)
+{
+    int i;
+
+    for (i = 0; i < DBUS_ZC_BUFFERS; i++) {
+        if (ddc->zc_held[i] == token) {
+            ddc->zc_held[i] = 0;
+        }
+    }
+    graphic_hw_gl_flush_done(ddc->dcl.con, token);
+}
+
+/* every buffer back (the client went away): nothing may wait for it */
+void dbus_display_console_zc_release_all(DBusDisplayConsole *ddc)
+{
+    int i;
+
+    for (i = 0; i < DBUS_ZC_BUFFERS; i++) {
+        if (ddc->zc_held[i]) {
+            uint64_t token = ddc->zc_held[i];
+
+            ddc->zc_held[i] = 0;
+            graphic_hw_gl_flush_done(ddc->dcl.con, token);
+        }
+    }
+    graphic_hw_gl_zero_copy(ddc->dcl.con, false);
+}
+
+static gboolean
+dbus_presentation_released(DBusDisplayConsole *ddc,
+                           GDBusMethodInvocation *invocation,
+                           guint64 arg_token)
+{
+    trace_dbus_zc_released(arg_token);
+    dbus_display_console_zc_release(ddc, arg_token);
+    qemu_dbus_display1_presentation_complete_released(
+        ddc->iface_presentation, invocation);
+    return DBUS_METHOD_INVOCATION_HANDLED;
+}
+
+static gboolean
+dbus_presentation_zero_copy(DBusDisplayConsole *ddc,
+                            GDBusMethodInvocation *invocation,
+                            gboolean arg_on)
+{
+    trace_dbus_zc_scanout(arg_on);
+    graphic_hw_gl_zero_copy(ddc->dcl.con, arg_on);
+    qemu_dbus_display1_presentation_complete_zero_copy(
+        ddc->iface_presentation, invocation);
+    return DBUS_METHOD_INVOCATION_HANDLED;
+}
+
 static gboolean
 dbus_ui_info_get(DBusDisplayConsole *ddc,
                  GDBusMethodInvocation *invocation)
