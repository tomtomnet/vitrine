   <!--
+      org.qemu.Display1.Listener.Unix.ZeroCopy:
+
+      This optional client-side interface has no methods.  A listener that
+      lists it in its :dbus:prop:`org.qemu.Display1.Listener.Interfaces`
+      (with ``AsyncUpdate`` and ``ScanoutDMABUF2``) may attach the guest's
+      scanout DMABUF to its compositor's surface as it is.  QEMU then sends
+      ``ScanoutDMABUF2`` with the buffer's real layout (modifier and planes,
+      read from the driver's metadata) when the guest can be held until the
+      client is done with a buffer, and ``DRM_FORMAT_MOD_INVALID`` when not -
+      the client copies those.  For every ``UpdateDMABUF`` the client calls
+      :dbus:meth:`org.qemu.Display1.Presentation.Released` once it is done
+      with that buffer; QEMU holds the guest's next frame while the client
+      still holds the one shown before (at most a few refreshes).
+  -->
+  <?if $(env.HOST_OS) != windows?>
+  <interface name="org.qemu.Display1.Listener.Unix.ZeroCopy">
+  </interface>
+  <?endif?>
+
+  <!--
       org.qemu.Display1.Clipboard:
 
       This interface must be implemented by both the client and the server on
@@ -1264,5 +1284,29 @@
       <arg name="compositor_lead" type="x" direction="in"/>
       <arg name="swap_lead" type="x" direction="in"/>
     </method>
+    <!--
+        Released:
+        @token: the scanout DMABUF's inode (``fstat()`` of its fd).
+
+        Zero copy (see :dbus:iface:`org.qemu.Display1.Listener.Unix.ZeroCopy`):
+        the client is done with the buffer - its compositor released it and
+        finished reading it, or the client copied it, or skipped it.  QEMU
+        may let the guest render into it again.  Call it for every buffer of
+        an ``UpdateDMABUF``, with ``NO_REPLY_EXPECTED``.
+    -->
+    <method name="Released">
+      <arg name="token" type="t" direction="in"/>
+    </method>
+    <!--
+        ZeroCopy:
+        @on: the client's frames go to the screen as they are, neither copied
+          nor composited (the guest's buffer scanned out directly).
+
+        Such frames can be handed over later before the vertical blank that
+        shows them: the display device uses its zero-copy target while on.
+    -->
+    <method name="ZeroCopy">
+      <arg name="on" type="b" direction="in"/>
+    </method>
   </interface>
 </node>
