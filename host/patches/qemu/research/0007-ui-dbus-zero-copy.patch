 /*
- * The guest's buffer goes to the compositor as linear - virtio-gpu tells
- * nothing of a scanout's layout - so it has to be: the guest's compositor
- * allocates linear scanout buffers when the guest's virtio-gpu driver
- * advertises the linear modifier (linear_scanout=1 of the fork's module);
- * otherwise Mesa tiles them, and compresses them, and the screen shows
- * noise.  amdgpu keeps a buffer's tiling in its metadata: 1 linear, 0 not,
- * -1 when the driver cannot tell (anything but amdgpu).  On a handle space
- * of its own (query_fd), so that closing the handle closes nobody else's.
+ * The guest's buffer goes to the compositor with its real layout - virtio-gpu
+ * tells nothing of it, but amdgpu keeps it in the buffer's metadata, read on
+ * a handle space of our own (query_fd): ui/dmabuf-layout.c.  Linear goes as
+ * linear; tiled needs QEMU_SDL_ZC_TILED (below), else the buffer is copied
+ * (a guest with linear_scanout=1 or tiled_scanout=1 makes it attachable).
  */
-/*
- * The amdgpu metadata of a dma-buf: the tiling word and the opaque words of
- * the user-mode driver (Mesa's, up to @umd_words); false when the driver
- * cannot tell (anything but amdgpu)
- */
-static bool dmabuf_metadata(int fd, int dmabuf_fd, uint64_t *tiling,
-                            uint32_t *umd, int umd_words, int *umd_bytes)
-{
-    char name[16] = "";
-    struct drm_version ver = { .name_len = sizeof(name) - 1, .name = name };
-    struct drm_prime_handle prime = { .fd = dmabuf_fd };
-    struct drm_amdgpu_gem_metadata md = { 0 };
-    struct drm_gem_close gem_close = { 0 };
-    int ret;
-
-    if (fd < 0 || ioctl(fd, DRM_IOCTL_VERSION, &ver) || strcmp(name, "amdgpu")) {
-        return false;
-    }
-    if (ioctl(fd, DRM_IOCTL_PRIME_FD_TO_HANDLE, &prime)) {
-        return false;
-    }
-    md.handle = prime.handle;
-    md.op = AMDGPU_GEM_METADATA_OP_GET_METADATA;
-    ret = ioctl(fd, DRM_IOCTL_AMDGPU_GEM_METADATA, &md);
-    gem_close.handle = prime.handle;
-    ioctl(fd, DRM_IOCTL_GEM_CLOSE, &gem_close);
-    if (ret) {
-        return false;
-    }
-    *tiling = md.data.tiling_info;
-    if (umd) {
-        int n = MIN(umd_words, (int)ARRAY_SIZE(md.data.data));
-
-        memcpy(umd, md.data.data, n * sizeof(uint32_t));
-        *umd_bytes = MIN((int)md.data.data_size_bytes, n * (int)sizeof(uint32_t));
-    }
-    return true;
-}
-
-static int dmabuf_linear(int fd, int dmabuf_fd)
-{
-    uint64_t tiling;
-
-    if (!dmabuf_metadata(fd, dmabuf_fd, &tiling, NULL, 0, NULL)) {
-        return -1;
-    }
-    return AMDGPU_TILING_GET(tiling, SWIZZLE_MODE) == 0 &&
-           AMDGPU_TILING_GET(tiling, DCC_OFFSET_256B) == 0;
-}
-
-#define AMD_MOD_GET(m, field) \
-    (((m) >> AMD_FMT_MOD_##field##_SHIFT) & AMD_FMT_MOD_##field##_MASK)
-
-/*
- * The layout of a tiled guest buffer as an explicit modifier, with its DCC
