+        glBindFramebuffer(GL_FRAMEBUFFER, gb->vfbo);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                               GL_TEXTURE_2D, gb->vtex, 0);
+    }
