+        row_size = words;
+    }
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, gb->vfbo);
+    for (i = 0; i < VERIFY_ROWS; i++) {
+        int y = (2 * i + 1) * (int)gb->height / (2 * VERIFY_ROWS);
+        uint64_t h = 0x9e3779b97f4a7c15ull;
+        size_t k;
