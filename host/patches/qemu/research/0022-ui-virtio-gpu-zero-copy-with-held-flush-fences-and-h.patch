+            EGL_LINUX_DRM_FOURCC_EXT, gb->fourcc,
+            EGL_DMA_BUF_PLANE0_FD_EXT, gb->fds[0],
+            EGL_DMA_BUF_PLANE0_OFFSET_EXT, gb->offset0,
+            EGL_DMA_BUF_PLANE0_PITCH_EXT, gb->stride0,
+            EGL_DMA_BUF_PLANE0_MODIFIER_LO_EXT, gb->modifier & 0xffffffff,
+            EGL_DMA_BUF_PLANE0_MODIFIER_HI_EXT, gb->modifier >> 32,
+            EGL_NONE,
+        };
+
+        if (gb->modifier != DRM_FORMAT_MOD_LINEAR) {
+            attrs[12] = EGL_NONE;   /* implicit: the driver reads the metadata */
+        }
+        EGLImageKHR image = eglCreateImageKHR(qemu_egl_display, EGL_NO_CONTEXT,
+                                              EGL_LINUX_DMA_BUF_EXT, NULL, attrs);
