-bool sdl2_gui_painted_rect(int *x, int *y, int *w, int *h)
-{
-    ImDrawData *dd;
-    float x0 = 0, y0 = 0, x1 = 0, y1 = 0;
-    float sx, sy;
-    bool any = false;
-
-    if (!gui.ctx || !gui.drawn) {
-        return false;
-    }
-    ImGui::SetCurrentContext(gui.ctx);
-    dd = ImGui::GetDrawData();
-    if (!dd || !dd->Valid) {
-        return false;
-    }
-    /*
-     * What a command paints: its triangles' vertices (those not entirely
-     * transparent) inside its clip rectangle - the clip rectangle alone can
-     * be the whole display for a window that paints a bar at its top.
-     */
-    for (const ImDrawList *list : dd->CmdLists) {
-        for (const ImDrawCmd &cmd : list->CmdBuffer) {
-            float cx0 = 0, cy0 = 0, cx1 = 0, cy1 = 0;
-            bool painted = false;
-
-            if (!cmd.ElemCount || cmd.UserCallback) {
-                continue;
-            }
-            for (unsigned int i = 0; i < cmd.ElemCount; i++) {
-                const ImDrawVert &v =
