-void sdl2_gui_usb_access_done(const SDL2GuiUsbDevice *dev, bool granted,
-                              const char *errmsg)
-{
-    Request req = make_request(Op::UsbAttach);
-
-    if (!gui.ctx) {
-        return;
-    }
-    gui.usb_waiting = false;
-    forget_lists();
-    if (granted) {
-        /* what access was asked for */
-        req.usb = *dev;
-        req.usb.accessible = true;
-        queue(req);
-    } else if (errmsg) {
-        gui.error = errmsg;
-    }
-}
