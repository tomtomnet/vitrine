+/*
+ * x-vblank-deadline: the host compositor says, with each presentation, how
+ * long before it it latched the frame (wp_presentation v3's
+ * content_update_deadline, proposed in wayland-protocols merge request 454):
+ * a frame committed later waits for the next refresh.  The fixed swap targets
+ * stand in for that number, tuned on one host - its deadline moves with the
+ * GPU, the compositor's version and what it does (scanning the guest's buffer
+ * out or compositing it).  Over a window of presentations the swap target
+ * becomes the deadline most frames had (the 90th percentile: the earliest
+ * latching but for outliers, such as a flip that went a refresh late) plus
+ * x-vblank-deadline-margin for QEMU's own way from the swap to the host and
+ * the spread of the guest's frames.  The regulator moves the tick to it as
+ * to a fixed target: the first one restarts it from there, later changes are
+ * taken only when two windows agree (see below).
+ */
+static void virtio_gpu_vblank_deadline(VirtIOGPUBase *g,
+                                       struct virtio_gpu_scanout *s,
+                                       uint32_t head, int64_t deadline_ns)
+{
+    int64_t p90, target, cur, pend;
+
+    s->vblank_deadline_ns[s->vblank_deadline_n++] = deadline_ns;
+    if (s->vblank_deadline_n < VBLANK_WINDOW) {
+        return;
+    }
+    s->vblank_deadline_n = 0;
+    qsort(s->vblank_deadline_ns, VBLANK_WINDOW, sizeof(s->vblank_deadline_ns[0]),
+          vblank_cmp);
+    p90 = s->vblank_deadline_ns[VBLANK_WINDOW * 9 / 10];
+    target = p90 + (int64_t)g->vblank_deadline_margin_us * SCALE_US;
+    cur = s->vblank_deadline_target_ns;
+    if (!cur) {
+        /* the first: the regulator starts from it */
+        trace_virtio_gpu_vblank_deadline(head, s->vblank_deadline_ns[VBLANK_WINDOW / 2],
+                                         p90, target);
+        s->vblank_deadline_target_ns = target;
+        s->vblank_auto_set = false;
+        s->vblank_window = 0;
+        return;
+    }
+    if (llabs(target - cur) <= VBLANK_SWAP_SLACK_NS) {
+        s->vblank_deadline_pending_ns = 0;
+        return;
+    }
+    /*
+     * A host that composites moves its deadline with its own render
+     * estimate (2026-10-07, the VM in a window: 5.2-6.0 ms, once 8.3 ms
+     * under GPU load), and following every window kept the regulator on the
+     * move (39-50 new targets per run) without fewer repeated frames.  A
+     * new target needs two windows in a row on the same side, and then the
+     * nearer of the two; the regulator walks to it in its own steps.
+     */
+    pend = s->vblank_deadline_pending_ns;
+    if (!pend || (pend > cur) != (target > cur)) {
+        s->vblank_deadline_pending_ns = target;
+        return;
+    }
+    s->vblank_deadline_pending_ns = 0;
+    target = llabs(pend - cur) < llabs(target - cur) ? pend : target;
+    trace_virtio_gpu_vblank_deadline(head, s->vblank_deadline_ns[VBLANK_WINDOW / 2],
+                                     p90, target);
+    s->vblank_deadline_target_ns = target;
+}
+
+/*
+ * The display switched between frames the host has to copy or composite and
+ * the guest's buffers going to the screen as they are (zero copy in full
+ * screen): the frames have another target, and the regulator starts over
+ * from it - its window of frames was measured against the other one
+ */
+static void virtio_gpu_gl_zero_copy(void *opaque, uint32_t head, bool on)
+{
+    VirtIOGPUBase *g = opaque;
+    struct virtio_gpu_scanout *s;
+
+    if (head >= g->conf.max_outputs) {
+        return;
+    }
+    s = &g->scanout[head];
+    if (s->zero_copy == on) {
+        return;
+    }
+    s->zero_copy = on;
+    /*
+     * the host's deadline belongs to the mode too (a compositing host
+     * latches earlier than one scanning the buffer out): its window starts
+     * over, and the new mode's fixed target stands in until it is known
+     */
+    if (s->vblank_deadline_target_ns || s->vblank_deadline_n) {
+        s->vblank_deadline_target_ns = 0;
+        s->vblank_deadline_pending_ns = 0;
+        s->vblank_deadline_n = 0;
+        s->vblank_auto_set = false;
+        s->vblank_window = 0;
+    }
+    trace_virtio_gpu_zero_copy(head, on, VBLANK_SWAP_TARGET_NS);
+    if (g->vblank_swap_target_zc_us &&
+        g->vblank_swap_target_zc_us != g->vblank_swap_target_us) {
+        s->vblank_auto_set = false;
+        s->vblank_window = 0;
+    }
+}
