+/* An own buffer for SDL's surface with the menu bar on top, black below */
+static SwapBuffer *bar_buffer(struct sdl2_swapchain *sc, int width, int height)
+{
+    SwapBuffer *b;
+
+    if (width != sc->width || height != sc->height || sc->feedback_changed) {
+        if (!buffers_create(sc, width, height)) {
+            sc->failed = true;
+            buffers_destroy(sc);
+            return NULL;
+        }
+    }
+    b = swapchain_free_buffer(sc);
+    if (!b) {
+        return NULL;
+    }
+    glBindFramebuffer(GL_FRAMEBUFFER, b->fb.framebuffer);
+    glViewport(0, 0, width, height);
+    glClearColor(0, 0, 0, 1);
+    glClear(GL_COLOR_BUFFER_BIT);
