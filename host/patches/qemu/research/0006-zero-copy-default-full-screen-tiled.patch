+    }
+    if (sc->sub_viewport) {
+        wp_viewport_destroy(sc->sub_viewport);
+    }
+    if (sc->subsurface) {
+        wl_subsurface_destroy(sc->subsurface);
+    }
+    if (sc->sub) {
+        wl_surface_destroy(sc->sub);
+    }
+    sc->sub_scale = NULL;
+    sc->sub_viewport = NULL;
+    sc->subsurface = NULL;
+    sc->sub = NULL;
