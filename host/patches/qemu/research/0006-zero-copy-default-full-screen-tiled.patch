 /*
+ * The display switched between frames the host has to copy or composite and
+ * the guest's buffers going to the screen as they are (zero copy in full
+ * screen): the frames have another target, and the regulator starts over
+ * from it - its window of frames was measured against the other one
+ */
+static void virtio_gpu_gl_zero_copy(void *opaque, uint32_t head, bool on)
+{
+    VirtIOGPUBase *g = opaque;
+    struct virtio_gpu_scanout *s;
+
+    if (head >= g->conf.max_outputs) {
+        return;
+    }
+    s = &g->scanout[head];
+    if (s->zero_copy == on) {
+        return;
+    }
+    s->zero_copy = on;
+    trace_virtio_gpu_zero_copy(head, on, VBLANK_SWAP_TARGET_NS);
+    if (g->vblank_swap_target_zc_us &&
+        g->vblank_swap_target_zc_us != g->vblank_swap_target_us) {
+        s->vblank_auto_set = false;
+        s->vblank_window = 0;
+    }
+}
+
+/*
  * A frame of this scanout was just shown: anchor the vblank phase.  With a
  * lead, a timer on the presentation grid ticks the guest before each vblank
  * so its compositor commits early enough for the host's own pipeline;
@@ -511,6 +543,14 @@
     virtio_gpu_held_process(g, head);
 }
 
+/* whether the flush the display is showing has a fence that can be held */
+static bool virtio_gpu_gl_flush_fenced(void *opaque, uint32_t head)
+{
+    VirtIOGPUBase *g = opaque;
+
+    return head < g->conf.max_outputs && g->scanout[head].flush_fenced;
+}
