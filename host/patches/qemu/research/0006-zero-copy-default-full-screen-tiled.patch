+/* --- the guest's buffer below a docked menu bar ---------------------------- */
+
+/*
+ * The menu bar cannot be drawn into the guest's buffer, so with the bar
+ * docked the guest's buffer goes on a subsurface of SDL's surface, placed
+ * below the bar, and SDL's surface keeps an own buffer with the bar at its
+ * top (black under the subsurface), drawn again when the bar changes.  The
+ * subsurface takes no input: the pointer stays SDL's.  It is desynchronized,
+ * so that a guest frame is one commit of its own, except while it shows up,
+ * moves or goes away, which takes effect together with a commit of SDL's
+ * surface (no frame with the bar but without the guest, or the reverse).
+ * Its size and position are whole units of SDL's surface, in which the
+ * compositor scales the window's pixels: the compositor's scale for the
+ * window (fractional-scale-v1) says how many; a bar or a window that does
+ * not fall on whole units is copied as before.
+ */
+static void sub_preferred_scale(void *data, struct wp_fractional_scale_v1 *fs,
+                                uint32_t scale)
+{
+    struct sdl2_swapchain *sc = data;
+
+    sc->scale120 = scale;
+}
+
+static const struct wp_fractional_scale_v1_listener sub_scale_listener = {
+    .preferred_scale = sub_preferred_scale,
+};
+
+static bool sub_create(struct sdl2_swapchain *sc)
+{
+    struct wl_region *region;
+
+    if (sc->sub_failed) {
+        return false;
+    }
+    if (!sc->compositor || !sc->subcompositor || !sc->viewporter ||
+        !sc->fractional) {
+        sc->sub_failed = true;
+        warn_report("sdl2: zero copy below the docked menu bar needs "
+                    "wl_subcompositor, wp_viewporter and fractional-scale-v1; "
+                    "copying instead");
+        return false;
+    }
+    sc->sub = wl_compositor_create_surface(sc->compositor);
+    /* the pointer goes through it, to SDL's surface */
+    region = wl_compositor_create_region(sc->compositor);
+    wl_surface_set_input_region(sc->sub, region);
+    wl_region_destroy(region);
+    region = wl_compositor_create_region(sc->compositor);
+    wl_region_add(region, 0, 0, INT32_MAX, INT32_MAX);
+    wl_surface_set_opaque_region(sc->sub, region);
+    wl_region_destroy(region);
+    sc->subsurface = wl_subcompositor_get_subsurface(sc->subcompositor, sc->sub,
+                                                     sc->surface);
+    wl_subsurface_place_above(sc->subsurface, sc->surface);
+    wl_subsurface_set_desync(sc->subsurface);
+    sc->sub_viewport = wp_viewporter_get_viewport(sc->viewporter, sc->sub);
+    sc->sub_scale = wp_fractional_scale_manager_v1_get_fractional_scale(sc->fractional,
