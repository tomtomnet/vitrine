+/// Gives a guest-memory resource a dma-buf of its pages (a udmabuf the VMM made), so that DRM
+/// native contexts, which import resources by dma-buf only, can use it - as QEMU's virtio-gpu-gl
+/// does. virgl_renderer_resource_set_guest_dmabuf() is our virglrenderer's (patch
+/// virglrenderer-main-guest-dmabuf-api), looked up at run time: upstream builds lack it, and
+/// the resource then stays as before (the guest's import fails, it copies instead).
+fn set_guest_dmabuf(resource_id: u32, fd: OwnedDescriptor) {
+    type SetGuestDmabuf = unsafe extern "C" fn(u32, c_int) -> c_int;
+    static FUNC: std::sync::OnceLock<Option<SetGuestDmabuf>> = std::sync::OnceLock::new();
+    let func = FUNC.get_or_init(|| {
+        // SAFETY: dlsym with a NUL-terminated name; the symbol has this signature
+        let sym = unsafe {
+            libc::dlsym(libc::RTLD_DEFAULT, c"virgl_renderer_resource_set_guest_dmabuf".as_ptr())
+        };
+        if sym.is_null() {
+            warn!("virglrenderer without virgl_renderer_resource_set_guest_dmabuf: guest-memory blobs get no dma-buf");
+            None
+        } else {
+            // SAFETY: see above
+            Some(unsafe { std::mem::transmute::<*mut c_void, SetGuestDmabuf>(sym) })
+        }
+    });
+    let Some(func) = func else { return };
+    let raw = fd.into_raw_descriptor();
+    // SAFETY: a valid fd; virglrenderer keeps it on success
+    let ret = unsafe { func(resource_id, raw) };
+    if ret != 0 {
+        // SAFETY: not taken: ours to close
+        drop(unsafe { OwnedDescriptor::from_raw_descriptor(raw) });
+        warn!("resource {resource_id}: virgl_renderer_resource_set_guest_dmabuf failed ({ret})");
+    }
+}
