+/// The descriptor that becomes readable when `rutabaga_poll` should be called, or -1 when the
+/// default component does not need polling. virglrenderer's drm (native) contexts retire their
+/// fences only from a poll; a VMM that never polls (QEMU's virtio-gpu-rutabaga before this) left
+/// them pending forever. The caller owns the descriptor.
+#[no_mangle]
+pub extern "C" fn rutabaga_poll_descriptor(ptr: &mut rutabaga, fd: &mut i32) -> i32 {
+    catch_unwind(AssertUnwindSafe(|| {
+        *fd = match ptr.poll_descriptor() {
+            Some(descriptor) => descriptor.into_raw_descriptor(),
+            None => -1,
+        };
+        NO_ERROR
+    }))
+    .unwrap_or(-ESRCH)
+}
+
+/// Process what the poll descriptor signalled (fence retirement of the default component).
+#[no_mangle]
+pub extern "C" fn rutabaga_poll(ptr: &mut rutabaga) -> i32 {
+    catch_unwind(AssertUnwindSafe(|| {
+        ptr.event_poll();
+        NO_ERROR
+    }))
+    .unwrap_or(-ESRCH)
+}
