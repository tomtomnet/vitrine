+/// rutabaga's and virglrenderer's messages go through the `log` crate, and a VMM using this
+/// library (QEMU) installs no logger: every message was dropped, virglrenderer's native-context
+/// errors included (a failed GEM_VA map of a texture, for instance, which the guest never hears
+/// of). This one writes warnings and errors to stderr (RUTABAGA_LOG=off|error|warn|info|debug|trace
+/// changes the level): bursts of up to LOG_BURST messages, then one a second, with a count of the
+/// suppressed ones, so that a message repeated every frame cannot fill the VMM's log.
+struct StderrLogger;
+
+const LOG_BURST: f64 = 50.0;
+
+struct LogBudget {
+    last: Option<std::time::Instant>,
+    tokens: f64,
+    suppressed: u64,
+}
+
+static LOG_BUDGET: Mutex<LogBudget> = Mutex::new(LogBudget {
+    last: None,
+    tokens: LOG_BURST,
+    suppressed: 0,
+});
+
+impl log::Log for StderrLogger {
+    fn enabled(&self, metadata: &log::Metadata) -> bool {
+        metadata.level() <= log::max_level()
+    }
+
+    fn log(&self, record: &log::Record) {
+        if !self.enabled(record.metadata()) {
+            return;
+        }
+        let Ok(mut budget) = LOG_BUDGET.lock() else { return };
+        let now = std::time::Instant::now();
+        if let Some(last) = budget.last {
+            let refill = now.duration_since(last).as_secs_f64();
+            budget.tokens = (budget.tokens + refill).min(LOG_BURST);
+        }
+        budget.last = Some(now);
+        if budget.tokens < 1.0 {
+            budget.suppressed += 1;
+            return;
+        }
+        budget.tokens -= 1.0;
+        let wall = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .unwrap_or_default();
+        if budget.suppressed > 0 {
+            eprintln!("rutabaga: {} messages suppressed", budget.suppressed);
+            budget.suppressed = 0;
+        }
+        eprintln!(
+            "rutabaga {}.{:03} {}: {}",
+            wall.as_secs(),
+            wall.subsec_millis(),
+            record.level(),
+            record.args().to_string().trim_end()
+        );
+    }
+
+    fn flush(&self) {}
+}
+
+static LOGGER: StderrLogger = StderrLogger;
+
+fn init_logger() {
+    let level = match std::env::var("RUTABAGA_LOG").as_deref() {
+        Ok("off") => log::LevelFilter::Off,
+        Ok("error") => log::LevelFilter::Error,
+        Ok("info") => log::LevelFilter::Info,
+        Ok("debug") => log::LevelFilter::Debug,
+        Ok("trace") => log::LevelFilter::Trace,
+        _ => log::LevelFilter::Warn,
+    };
+    // fails when the process has a logger already: that one stays
+    if log::set_logger(&LOGGER).is_ok() {
+        log::set_max_level(level);
+    }
+}
