+bool QWaylandShmBuffer::reuse(QWaylandDisplay *display, const QSize &size, QImage::Format format, qreal scale)
+{
+    if (busy() || !mShmPool || !mData || mFd < 0)
+        return false;
+
+    const int stride = alignTo(size.width() * 4, 256);
+    const size_t alloc = poolSizeFor(size);
+    if (alloc > mPoolSize) {
+        // grow with an eighth more, so that a window being made larger does not grow it every frame
+        const size_t grown = alignTo(int(alloc + alloc / 8), getpagesize());
+        if (ftruncate(mFd, off_t(grown)) != 0)
+            return false;
+#ifdef MREMAP_MAYMOVE
+        void *data = mremap(mData, mPoolSize, grown, MREMAP_MAYMOVE);
+#else
+        void *data = mmap(nullptr, grown, PROT_READ | PROT_WRITE, MAP_SHARED, mFd, 0);
+        if (data != MAP_FAILED)
+            munmap(mData, mPoolSize);
+#endif
+        if (data == MAP_FAILED)
+            return false;
+        mData = static_cast<uchar *>(data);
+        mPoolSize = grown;
+        wl_shm_pool_resize(mShmPool, int32_t(grown));
+    }
+
+    delete mMarginsImage;
+    mMarginsImage = nullptr;
+    mMargins = QMargins();
+    mImage = QImage(mData, size.width(), size.height(), stride, format);
+    mImage.setDevicePixelRatio(scale);
+    mDirtyRegion = QRegion(QRect(QPoint(0, 0), size / scale));
+
+    if (mBuffer)
+        wl_buffer_destroy(mBuffer);
+    QWaylandShm *shm = display->shm();
+    init(wl_shm_pool_create_buffer(mShmPool, 0, size.width(), size.height(), stride, shm->formatFrom(format)));
+    if (mEventQueue)
+        wl_proxy_set_queue(reinterpret_cast<struct wl_proxy *>(buffer()), mEventQueue);
+    return true;
+}
