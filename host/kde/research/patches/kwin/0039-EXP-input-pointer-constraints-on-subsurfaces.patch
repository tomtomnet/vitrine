+std::pair<SurfaceInterface *, QPointF> PointerInputRedirection::constraintTarget() const
+{
+    SurfaceInterface *mainSurface = focus() ? focus()->surface() : nullptr;
+    if (!mainSurface) {
+        return {nullptr, QPointF()};
+    }
+    const QPointF local = focus()->mapToLocal(m_pos);
+    // the input surface under the pointer or the nearest of its parents with a constraint of its own (an
+    // embedded view's surface may have subsurfaces of its own); without one, the main surface, whose
+    // constraint thus stays while the pointer crosses its subsurfaces (a video, a GL view)
+    for (SurfaceInterface *s = mainSurface->mapToInputSurface(local).first; s && s != mainSurface;) {
+        if (s->confinedPointerRegion() || s->lockedPointerRegion()) {
+            return {s, mainSurface->mapToChild(s, local)};
+        }
+        SubSurfaceInterface *subsurface = s->subSurface();
+        s = subsurface ? subsurface->parentSurface() : nullptr;
+    }
+    return {mainSurface, local};
+}
+
+QPointF PointerInputRedirection::constraintOffset(SurfaceInterface *surface) const
+{
+    // where a subsurface lies in the focused window's main surface, now (its parents' commits move it)
+    SurfaceInterface *mainSurface = focus() ? focus()->surface() : nullptr;
+    if (!mainSurface || !surface || surface == mainSurface) {
+        return QPointF();
+    }
+    return -mainSurface->mapToChild(surface, QPointF());
+}
+
+void PointerInputRedirection::watchInputSurface()
+{
+    // the subsurface under the pointer and its parents below the main surface: a constraint one of them
+    // asks for takes effect with its commit, as the main surface's does (whose commits are watched
+    // while it is the constrained surface)
+    SurfaceInterface *mainSurface = focus() ? focus()->surface() : nullptr;
+    SurfaceInterface *input = mainSurface ? mainSurface->mapToInputSurface(focus()->mapToLocal(m_pos)).first : nullptr;
+    if (input == mainSurface) {
+        input = nullptr;
+    }
+    if (input == m_watchedInputSurface) {
+        return;
+    }
+    for (const auto &connection : std::as_const(m_inputSurfaceCommittedConnections)) {
+        disconnect(connection);
+    }
+    m_inputSurfaceCommittedConnections.clear();
+    m_watchedInputSurface = input;
+    for (SurfaceInterface *s = input; s && s != mainSurface;) {
+        m_inputSurfaceCommittedConnections.append(connect(s, &SurfaceInterface::committed,
+                                                          this, &PointerInputRedirection::updatePointerConstraints));
+        SubSurfaceInterface *subsurface = s->subSurface();
+        s = subsurface ? subsurface->parentSurface() : nullptr;
+    }
+}
