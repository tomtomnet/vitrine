From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Local build <local@localhost>
Date: Sat, 24 Oct 2026 23:20:00 +0200
Subject: [PATCH] EXP compositor: a layer with no damage keeps its buffer instead of being rendered again
 (KWIN_SKIP_EMPTY_LAYER_RENDER, $XDG_RUNTIME_DIR/kwin-skip-empty-layer-render)

Item::scheduleFrame (frame callbacks, commit-timing targets) sets a layer's m_repaintScheduled: the layer is rendered
even when nothing in it is damaged. A windowed VM's nested KWin asks for a frame callback and stamps every commit on
its toplevel's surface (a one-pixel black buffer drawn in the scene layer) while its output goes to an underlay: every
VM frame rendered the unchanged scene layer again - a GPU job, ~5 fence ioctls, a second plane in the atomic commit -
and the frame's CPU time was 0.37 ms against 0.16 ms full screen (the Arc Pro B50 at 4K 240; b50wg2-3). The scanout
frames' render estimate followed (1.1 against 0.5 ms) and the host planned the VM's frames ~0.7 ms earlier: its keys
stayed ~1.3 ms behind full screen with 0081 (which only stopped counting such frames as composited).
With the switch, a layer with no damage is neither rendered nor committed - its plane keeps the buffer it shows - when
the output's last presented frame rendered or kept that same output layer in the same state (target and source
rectangle, colour description, required alpha bits, zpos, the frame's brightness, dimming and HDR headroom) and another layer
is updated in this frame (the commit is never empty because of it). Frame callbacks are unaffected (the scene's
framePainted runs for every frame), effects that transform the screen damage it all (PAINT_SCREEN_TRANSFORMED), and a
layer that was scanned out, disabled, moved or re-coloured is not in the kept state, so it renders as before (the colour
compared by value: a rendered layer gets a new ColorDescription object every frame). Unset =
as before; $XDG_RUNTIME_DIR/kwin-skip-empty-layer-render holding 0 or 1 decides while it exists, read at most once a
second.
---
diff --git a/src/compositor.cpp b/src/compositor.cpp
index 96d440a..cf2f809 100644
--- a/src/compositor.cpp
+++ b/src/compositor.cpp
@@ -558,6 +558,48 @@ static bool emptyRenderNotContent()
     return s_value;
 }
 
+bool Compositor::RenderedLayerState::operator==(const RenderedLayerState &other) const
+{
+    const bool sameColor = color.get() == other.color.get() || (color && other.color && *color == *other.color);
+    return layer == other.layer && targetRect == other.targetRect && sourceRect == other.sourceRect && sameColor
+        && requiredAlphaBits == other.requiredAlphaBits && zpos == other.zpos && brightness == other.brightness
+        && dimming == other.dimming && headroom == other.headroom;
+}
+
+/**
+ * KWIN_SKIP_EMPTY_LAYER_RENDER (EXP, 2026-10-24; unset or 0 = as before): a layer with no damage this frame - its
+ * repaint was scheduled only to deliver frame callbacks or a commit-timing target (Item::scheduleFrame) - is not
+ * rendered again when the output's last presented frame rendered or kept that same output layer in the same state
+ * (geometry, colour, alpha, zpos, brightness, dimming, headroom) and another layer is updated in this frame: its plane keeps
+ * the buffer it shows. A windowed VM's nested KWin asks for a frame callback and stamps every commit on its toplevel's
+ * surface, a one-pixel black buffer drawn in the scene layer, while its output goes to an underlay: every VM frame
+ * rendered the unchanged scene layer again (a GPU job, its fences, a second plane in the commit; the frame's CPU time
+ * 0.37 against 0.16 ms full screen on the Arc Pro B50 at 4K 240), and the host planned the VM's frames ~0.7 ms
+ * earlier than full screen's. $XDG_RUNTIME_DIR/kwin-skip-empty-layer-render holding 0 or 1 decides instead while it
+ * exists, read at most once a second (an A/B in a running session)
+ */
+static bool skipEmptyLayerRender()
+{
+    static const bool s_environment = qEnvironmentVariableIntValue("KWIN_SKIP_EMPTY_LAYER_RENDER") != 0;
+    static const QString s_path = qEnvironmentVariable("XDG_RUNTIME_DIR") + QStringLiteral("/kwin-skip-empty-layer-render");
+    static bool s_value = s_environment;
+    static std::chrono::steady_clock::time_point s_lastRead;
+    const auto now = std::chrono::steady_clock::now();
+    if (now - s_lastRead >= std::chrono::seconds(1)) {
+        s_lastRead = now;
+        s_value = s_environment;
+        QFile file(s_path);
+        if (file.open(QIODevice::ReadOnly)) {
+            bool ok = false;
+            const int value = file.readAll().trimmed().toInt(&ok);
+            if (ok) {
+                s_value = value != 0;
+            }
+        }
+    }
+    return s_value;
+}
+
 static bool renderLayer(RenderView *view, LogicalOutput *logicalOutput, BackendOutput *backendOutput, const std::shared_ptr<OutputFrame> &frame, const Region &surfaceDamage)
 {
     auto beginInfo = view->layer()->beginFrame(frame.get());
@@ -962,19 +1004,64 @@ void Compositor::composite(RenderLoop *renderLoop)
         }
     }
 
+    // EXP (KWIN_SKIP_EMPTY_LAYER_RENDER): the layers this frame renders or keeps, for the next frame
+    QList<RenderedLayerState> renderedLayers;
+    const auto layerState = [&](const LayerData &layer) {
+        OutputLayer *const outputLayer = layer.view->layer();
+        return RenderedLayerState{
+            .layer = outputLayer,
+            .targetRect = outputLayer->targetRect(),
+            .sourceRect = outputLayer->sourceRect(),
+            .color = outputLayer->colorDescription(),
+            .requiredAlphaBits = layer.requiredAlphaBits,
+            .zpos = outputLayer->zpos(),
+            .brightness = frame->brightness(),
+            .dimming = frame->dimmingFactor(),
+            .headroom = frame->artificialHdrHeadroom(),
+        };
+    };
     const auto renderLayers = [&]() -> std::expected<void, OutputError> {
-        for (auto &layer : layers) {
+        renderedLayers.clear();
+        const bool skipEmpty = skipEmptyLayerRender();
+        const QList<RenderedLayerState> &previous = m_renderedLayers[renderLoop];
+        const auto renderable = [](const LayerData &layer) {
+            return layer.view->layer()->isEnabled() && !layer.directScanout && !layer.cursor;
+        };
+        // first which layers need a repaint, with their damage, and which of them can keep what they show
+        std::vector<char> needed(layers.size(), 0);
+        std::vector<char> keep(layers.size(), 0);
+        bool othersUpdate = !toUpdate.empty();
+        for (size_t i = 0; i < size_t(layers.size()); i++) {
+            auto &layer = layers[i];
+            if (!layer.view->layer()->needsRepaint()) {
+                continue;
+            }
+            needed[i] = 1;
+            layer.surfaceDamage |= layer.view->collectDamage();
+            layer.surfaceDamage |= layer.view->layer()->deviceRepaints();
+            layer.view->layer()->resetRepaints();
+            keep[i] = skipEmpty && renderable(layer) && layer.surfaceDamage.isEmpty() && previous.contains(layerState(layer));
+            othersUpdate |= !keep[i];
+        }
+        for (size_t i = 0; i < size_t(layers.size()); i++) {
+            auto &layer = layers[i];
             if (layer.view->layer()->isEnabled() && layer.directScanout && !layer.cursor) {
                 // for the render time estimate: this frame's content is a client's buffer
                 frame->setContentScannedOut();
             }
-            if (!layer.view->layer()->needsRepaint()) {
+            if (!needed[i]) {
+                // untouched: what it shows is still what it was last rendered for
+                if (skipEmpty && renderable(layer) && previous.contains(layerState(layer))) {
+                    renderedLayers.push_back(layerState(layer));
+                }
+                continue;
+            }
+            if (keep[i] && othersUpdate) {
+                // nothing in it changed since the frame it was last rendered for: its plane keeps that buffer
+                renderedLayers.push_back(layerState(layer));
                 continue;
             }
             toUpdate.insert(layer.view->layer());
-            layer.surfaceDamage |= layer.view->collectDamage();
-            layer.surfaceDamage |= layer.view->layer()->deviceRepaints();
-            layer.view->layer()->resetRepaints();
             if (layer.view->layer()->isEnabled() && !layer.directScanout) {
                 // for the render time estimate: what this frame renders
                 if (layer.cursor) {
@@ -988,6 +1075,9 @@ void Compositor::composite(RenderLoop *renderLoop)
                         .message = QStringLiteral("Rendering a layer failed"),
                     });
                 }
+                if (!layer.cursor) {
+                    renderedLayers.push_back(layerState(layer));
+                }
             }
         }
         return {};
@@ -1051,6 +1141,13 @@ void Compositor::composite(RenderLoop *renderLoop)
         }
     }
 
+    // EXP (KWIN_SKIP_EMPTY_LAYER_RENDER): what the layers show from now on
+    if (result) {
+        m_renderedLayers[renderLoop] = renderedLayers;
+    } else {
+        m_renderedLayers.erase(renderLoop);
+    }
+
     scene->frame(primaryView, frame.get());
     primaryView->postPaint();
 
@@ -1112,6 +1209,7 @@ void Compositor::removeOutput(BackendOutput *output)
     m_overlayViews.erase(output->renderLoop());
     m_primaryViews.erase(output->renderLoop());
     m_brokenCursors.erase(output->renderLoop());
+    m_renderedLayers.erase(output->renderLoop());
 }
 
 void Compositor::assignOutputLayers(LogicalOutput *logicalOutput, BackendOutput *backendOutput)
@@ -1119,6 +1217,7 @@ void Compositor::assignOutputLayers(LogicalOutput *logicalOutput, BackendOutput
     const auto layers = m_backend->compatibleOutputLayers(backendOutput);
     const auto primaryLayer = findLayer(layers, OutputLayerType::Primary);
     Q_ASSERT(primaryLayer);
+    m_renderedLayers.erase(backendOutput->renderLoop());
     auto &sceneView = m_primaryViews[backendOutput->renderLoop()];
     if (sceneView) {
         sceneView->setLayer(primaryLayer);
diff --git a/src/compositor.h b/src/compositor.h
index 9358f88..950e2a0 100644
--- a/src/compositor.h
+++ b/src/compositor.h
@@ -18,6 +18,7 @@
 #include <QObject>
 
 #include <memory>
+#include <optional>
 
 namespace KWin
 {
@@ -136,6 +137,24 @@ protected:
     std::optional<bool> m_allowOverlaysEnv;
     RenderLoopDrivenQAnimationDriver *m_renderLoopDrivenAnimationDriver;
     RenderDevice *m_primaryDevice = nullptr;
+
+    // EXP (KWIN_SKIP_EMPTY_LAYER_RENDER): the layers each output's last presented frame rendered or kept, with what
+    // their content depends on; a layer with no damage whose state is among them still shows the right content
+    struct RenderedLayerState
+    {
+        OutputLayer *layer = nullptr;
+        Rect targetRect;
+        RectF sourceRect;
+        std::shared_ptr<ColorDescription> color;
+        uint32_t requiredAlphaBits = 0;
+        int zpos = 0;
+        std::optional<double> brightness;
+        std::optional<double> dimming;
+        std::optional<double> headroom;
+        // the colour by value: a rendered layer gets a new ColorDescription object every frame
+        bool operator==(const RenderedLayerState &other) const;
+    };
+    std::unordered_map<RenderLoop *, QList<RenderedLayerState>> m_renderedLayers;
 };
 
 } // namespace KWin
