+        const auto buffer = drmLayer->currentBuffer();
+        const Rect target = drmLayer->targetRect();
+        AsyncPlaneState state{
+            .layer = drmLayer,
+            .buffer = buffer,
+            .source = drmLayer->sourceRect().toRect(),
