From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Local build <local@localhost>
Date: Wed, 4 Nov 2026 09:50:00 +0100
Subject: [PATCH] FIX wayland: a wl_shm buffer's udmabuf made when first asked
 for

Every wl_shm buffer made a udmabuf of itself when created, which pins each of its pages - on the compositor's main
thread, ~5.5 ms for a 4K window's buffer on an Arc Pro B50 (bench/ab/kde_maximize_trace_1104.sh kmt3: udmabuf_create ->
memfd_pin_folios in the stall after a maximize) - plus a DMA_BUF_IOCTL_SYNC at every reference and release. Only the
EGL import samples a udmabuf, and it does not on NVIDIA, i915 and xe (0075), nor when switched off: there the work is
for nothing.

So ShmClientBuffer makes its udmabuf the first time udmabufAttributes() is called, with the START (and END, if the
client has handed the buffer over) it would have had since its creation, and EglDisplay::importBufferAsImage() asks
for it only when it imports udmabufs.
---
diff --git a/src/opengl/egldisplay.cpp b/src/opengl/egldisplay.cpp
index 164e326..509203f 100644
--- a/src/opengl/egldisplay.cpp
+++ b/src/opengl/egldisplay.cpp
@@ -471,7 +471,8 @@ EGLImageKHR EglDisplay::importBufferAsImage(GraphicsBuffer *buffer,
         // On Nvidia, sampling from udmabuf just results in black,
         // and on i915 there are glitches on some systems. On xe (Battlemage)
         // a CPU-drawn 4K window's frames cost the compositor 4-15 ms instead of 1
-    } else if (buffer->udmabufAttributes() && udmabufImportSwitch().value_or(!m_drmDevice || !s_disableUdmabuf.value_or(m_drmDevice->isNvidia() || m_drmDevice->isI915() || m_drmDevice->isIntelXE()))) {
+        // (the udmabuf asked for only when it is imported: wl_shm buffers make theirs when first asked)
+    } else if (udmabufImportSwitch().value_or(!m_drmDevice || !s_disableUdmabuf.value_or(m_drmDevice->isNvidia() || m_drmDevice->isI915() || m_drmDevice->isIntelXE())) && buffer->udmabufAttributes()) {
         image = importDmaBufAsImage(*buffer->udmabufAttributes(), coefficients, range);
     }
     m_importCache[key] = image;
diff --git a/src/wayland/shmclientbuffer.cpp b/src/wayland/shmclientbuffer.cpp
index 0d5f745..c864dc0 100644
--- a/src/wayland/shmclientbuffer.cpp
+++ b/src/wayland/shmclientbuffer.cpp
@@ -181,21 +181,8 @@ const struct wl_buffer_interface ShmClientBuffer::implementation = {
 ShmClientBuffer::ShmClientBuffer(ShmPool *pool, ShmAttributes attributes, wl_client *client, uint32_t id)
     : m_shmPool(pool)
     , m_shmAttributes(std::move(attributes))
-    , m_udmabufAttributes(GpuManager::self()->createUdmabuf(&m_shmAttributes))
 {
     m_shmPool->ref();
-    if (m_udmabufAttributes) {
-#if defined(Q_OS_LINUX)
-        // This START is for the corresponding END to work
-        // when the buffer is first referenced.
-        // It's needed to tell the kernel to take CPU-side
-        // writes into account for our future GPU-side reads.
-        struct dma_buf_sync sync = {
-            .flags = DMA_BUF_SYNC_START | DMA_BUF_SYNC_WRITE,
-        };
-        ioctl(m_udmabufAttributes->fd[0].get(), DMA_BUF_IOCTL_SYNC, &sync);
-#endif
-    }
 
     connect(this, &GraphicsBuffer::released, this, &ShmClientBuffer::onReleased);
     connect(this, &GraphicsBuffer::referenced, this, &ShmClientBuffer::onReferenced);
@@ -252,6 +239,28 @@ const ShmAttributes *ShmClientBuffer::shmAttributes() const
 
 const DmaBufAttributes *ShmClientBuffer::udmabufAttributes() const
 {
+    // The udmabuf is made when first asked for, not with the buffer: making it pins every page of the buffer (~5.5 ms
+    // for a 4K window on an Arc Pro B50, on the compositor's main thread), and where udmabuf is not imported (NVIDIA,
+    // i915, xe, or switched off) nothing ever reads it.
+    if (!m_udmabufTried) {
+        m_udmabufTried = true;
+        m_udmabufAttributes = GpuManager::self()->createUdmabuf(&m_shmAttributes);
+#if defined(Q_OS_LINUX)
+        if (m_udmabufAttributes) {
+            // as if made with the buffer: START, then END if the client has handed the buffer over
+            // (onReferenced() and onReleased() keep it so from now on). It's needed to tell the kernel
+            // to take CPU-side writes into account for our future GPU-side reads.
+            struct dma_buf_sync sync = {
+                .flags = DMA_BUF_SYNC_START | DMA_BUF_SYNC_WRITE,
+            };
+            ioctl(m_udmabufAttributes->fd[0].get(), DMA_BUF_IOCTL_SYNC, &sync);
+            if (isReferenced()) {
+                sync.flags = DMA_BUF_SYNC_END | DMA_BUF_SYNC_WRITE;
+                ioctl(m_udmabufAttributes->fd[0].get(), DMA_BUF_IOCTL_SYNC, &sync);
+            }
+        }
+#endif
+    }
     return m_udmabufAttributes ? &*m_udmabufAttributes : nullptr;
 }
 uint32_t ShmClientBuffer::format() const
diff --git a/src/wayland/shmclientbuffer_p.h b/src/wayland/shmclientbuffer_p.h
index a7d06eb..113e0a0 100644
--- a/src/wayland/shmclientbuffer_p.h
+++ b/src/wayland/shmclientbuffer_p.h
@@ -88,7 +88,9 @@ private:
     wl_resource *m_resource = nullptr;
     ShmPool *m_shmPool;
     ShmAttributes m_shmAttributes;
-    std::optional<DmaBufAttributes> m_udmabufAttributes;
+    // made the first time something asks for it (udmabufAttributes()): most never import it
+    mutable std::optional<DmaBufAttributes> m_udmabufAttributes;
+    mutable bool m_udmabufTried = false;
     std::optional<ShmAccess> m_shmAccess;
 };
 
