+// KWIN_MOVE_COALESCE=0 applies every pointer position of an interactive move at once: as before. A host KWin keeps its wrapper's environment from login, so
+// $XDG_RUNTIME_DIR/kwin-move-coalesce holding 0 or 1 decides instead while it exists, read at most once a second
+// (an A/B in a running session)
+static bool coalesceInteractiveMoves()
+{
+    static const bool s_environment = qEnvironmentVariable("KWIN_MOVE_COALESCE") != QStringLiteral("0");
+    static const QString s_path = qEnvironmentVariable("XDG_RUNTIME_DIR") + QStringLiteral("/kwin-move-coalesce");
+    static bool s_value = s_environment;
+    static std::chrono::steady_clock::time_point s_lastRead;
+    const auto now = std::chrono::steady_clock::now();
+    if (now - s_lastRead >= std::chrono::seconds(1)) {
+        s_lastRead = now;
+        s_value = s_environment;
+        QFile file(s_path);
+        if (file.open(QIODevice::ReadOnly)) {
+            const QByteArray value = file.readAll().trimmed();
+            if (value == "0" || value == "1") {
+                s_value = value == "1";
+            }
+        }
+    }
+    return s_value;
+}
