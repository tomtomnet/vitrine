+void Window::queueInteractiveMoveResize(const QPointF &global, Qt::KeyboardModifiers modifiers)
+{
+    // A move costs the same whether the screen shows it or not: geometry signals, effects, scene
+    // repaints and window management updates to the clients. A mouse can report thousands of
+    // positions a second. The first position after a frame started is applied at once, as
+    // before, so a slow drag reaches the screen as early as it did; later ones until the next
+    // frame starts are held back, and only the latest is applied right before that frame, as
+    // the frame would show the latest position anyway. Resizes are not held back here, their
+    // configure events are already sent once per pass of the event loop.
+    Compositor *compositor = Compositor::self();
+    SurfaceItem *item = surfaceItem();
+    if (!coalesceInteractiveMoves() || !isInteractiveMove() || !compositor || !compositor->isActive() || !item) {
+        updateInteractiveMoveResize(global, modifiers);
+        return;
+    }
+    if (!m_interactiveMoveResize.frameConnection) {
+        m_interactiveMoveResize.frameConnection = connect(compositor, &Compositor::aboutToPrepareFrame, this, &Window::applyQueuedInteractiveMoveResize);
+    }
+    if (!m_interactiveMoveResize.movedSinceFrame) {
+        m_interactiveMoveResize.movedSinceFrame = true;
+        updateInteractiveMoveResize(global, modifiers);
+        return;
+    }
+
+    const bool frameScheduled = m_interactiveMoveResize.queuedAnchor.has_value();
+    m_interactiveMoveResize.queuedAnchor = global;
+    m_interactiveMoveResize.queuedModifiers = modifiers;
+    if (!frameScheduled) {
+        // the frame must come even if nothing else changes on the screen
+        item->scheduleFrame();
+    }
+}
+
+void Window::applyQueuedInteractiveMoveResize()
+{
+    // a frame starts (or the move ends, or a key acts on it): the next position goes on at once again
+    m_interactiveMoveResize.movedSinceFrame = false;
+    if (const std::optional<QPointF> anchor = std::exchange(m_interactiveMoveResize.queuedAnchor, std::nullopt)) {
+        updateInteractiveMoveResize(*anchor, m_interactiveMoveResize.queuedModifiers);
+    }
+}
+
 void Window::updateInteractiveMoveResize(const QPointF &global, Qt::KeyboardModifiers modifiers)
 {
+    // this position supersedes the one that waits for the next frame, if any
+    m_interactiveMoveResize.queuedAnchor.reset();
+
     setInteractiveMoveResizeAnchor(global);
     setInteractiveMoveResizeModifiers(modifiers);
 
